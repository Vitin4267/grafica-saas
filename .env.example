# Copie este arquivo para .env e preencha os valores reais.

# Obrigatório — string de conexão do Postgres.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/grafica_saas?schema=public"

# Opcional — monitoramento de erro (Sentry, https://sentry.io, plano grátis
# disponível). Sem essas duas variáveis, o site funciona normalmente e nenhum
# erro é reportado a lugar nenhum (ver src/instrumentation.ts).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Fortemente recomendado em produção — URL fixa e pública do site (ex:
# "https://grafica-saas-peach.vercel.app", sem barra no final), usada pra
# montar link de reset de senha, link público de orçamento, e retorno do
# Stripe Checkout. Sem essa var, o app monta a URL a partir dos headers da
# requisição (funciona em dev local, mas é vulnerável a host header
# injection em produção — ver src/lib/url-publica.ts).
APP_URL=""

# Obrigatório pra cobrança por assinatura via Stripe (dashboard.stripe.com).
# Conta é NOSSA (do dono da plataforma), não da gráfica — diferente do token
# da Focus NFe/webhook n8n, que cada gráfica traz o próprio.
# Developers > API keys > Secret key (comece com a chave de teste, sk_test_...).
STRIPE_SECRET_KEY=""
# Developers > Webhooks > seu endpoint > Signing secret. Em dev local, use o
# valor que `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# imprime — é DIFERENTE do signing secret de produção.
STRIPE_WEBHOOK_SIGNING_SECRET=""
# 3 planos, mesmo Product no Stripe, um Price cada (Product catalog > seu
# produto > Pricing > + Add another price > Price ID, cada um price_...).
# Falta configurar uma dessas? O plano correspondente simplesmente some da
# tela /configuracoes/assinatura em vez de dar erro (ver obterPlanos em
# src/lib/billing/planos.ts).
STRIPE_PRICE_ID_BASICO=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_EMPRESARIAL=""

# Webhook ÚNICO da plataforma (não confundir com o webhook que cada gráfica
# configura em /configuracoes/automacao) — usado pra disparar e-mail de
# "esqueci minha senha" e de verificação de cadastro. Aponta pra um workflow
# n8n seu que manda o e-mail de verdade (ex: via nó do Gmail/Google
# Workspace). Sem essa env var, os fluxos continuam funcionando normalmente,
# só que nenhum e-mail sai (ver src/lib/email/webhook-email.ts). Precisa ser
# https:// (ver validarWebhookUrl em src/lib/webhook-assistente.ts).
EMAIL_WEBHOOK_URL=""

# Webhook ÚNICO da plataforma pro assistente de IA (ícone de chat, disponível
# pra qualquer usuário logado, sem configuração por gráfica). Aponta pra um
# workflow n8n com um AI Agent (ver src/lib/webhook-assistente.ts). Sem essa
# env var, o ícone do assistente simplesmente não aparece (ver
# verificarAssistenteDisponivel em src/components/ChatAssistente.actions.ts).
# Precisa ser https://.
ASSISTENTE_WEBHOOK_URL=""

# Backup diário automático (src/app/api/cron/backup/route.ts, disparado pelo
# Vercel Cron configurado em vercel.json) — camada EXTRA, não a principal
# (essa é o PITR do próprio Neon, ver scripts/backup-db.sh). As duas vars
# abaixo só existem em produção (Vercel), não em dev local:
# - BLOB_READ_WRITE_TOKEN: gerada sozinha ao habilitar "Blob" em Storage no
#   dashboard do projeto Vercel — não precisa criar/copiar nada manualmente.
# - CRON_SECRET: qualquer string aleatória longa que você mesmo gera (ex:
#   `openssl rand -hex 32`), configurada como env var na Vercel. Protege o
#   endpoint contra qualquer um disparar um backup só de saber a URL.
BLOB_READ_WRITE_TOKEN=""
CRON_SECRET=""

# Opcional — widget "não sou um robô" (Cloudflare Turnstile) na tela de
# login, além do rate limit que já existe (src/lib/auth/rate-limit.ts). Sem
# essas duas variáveis, o widget simplesmente não aparece e o login funciona
# normal (ver src/components/Turnstile.tsx e src/lib/turnstile.ts).
# Pra criar: dashboard.cloudflare.com > Turnstile > Add site > escolha
# "Managed" > domínio do site (em dev local pode usar "localhost" também).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY é pública (vai pro navegador); TURNSTILE_SECRET_KEY é secreta.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
