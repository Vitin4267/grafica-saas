// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Unidade de ENTRADA/EXIBIÇÃO de medida de item de orçamento — ver
// Grafica.unidadePadraoDimensao e src/lib/unidade-dimensao.ts. O banco
// sempre grava em centímetros (OrcamentoItem.larguraCm/alturaCm), então
// isto nunca é a unidade armazenada, só a unidade que a gráfica prefere
// digitar/ver.
enum UnidadeDimensao {
  MM
  CM
  M
}

// Cada gráfica é um tenant: todo dado abaixo pertence a uma Grafica
// e nunca deve vazar entre tenants nas queries da aplicação.
model Grafica {
  id        String   @id @default(cuid())
  nome      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Liga/desliga o compartilhamento da aba "Meu Negócio" com a equipe (não-DONO).
  // Controle fino de quem exatamente vê fica em Usuario.acessoMeuNegocio — os dois
  // precisam ser verdadeiros pra um funcionário enxergar a aba (ver podeVerMeuNegocio).
  compartilharMeuNegocio Boolean @default(false)

  // Logo da PRÓPRIA gráfica (não confundir com a marca do grafica-saas) —
  // usada no cabeçalho do PDF de orçamento (src/lib/pdf/OrcamentoDocumento.tsx)
  // no lugar da marca da plataforma. Opcional: sem logo, o PDF mostra só o
  // nome da gráfica em texto, nunca a marca "GrafPro".
  logoUrl String?

  // Cor de destaque usada no PDF de orçamento e nos e-mails transacionais
  // que vão pro CLIENTE FINAL da gráfica (aprovação de orçamento, arte,
  // etc.) — documentos com a cara da gráfica, não do GrafPro. Formato hex
  // ("#RRGGBB"), validado na action. null = mantém o teal padrão da
  // plataforma (comportamento de hoje, sem mudança pra quem nunca configurar).
  corPrimaria String?

  // Dados de contato (comerciais, não fiscais) que aparecem no PDF de orçamento
  // — mesmo nível de logoUrl/corPrimaria: identidade visual do documento
  // enviado pro cliente (ver src/lib/pdf/OrcamentoDocumento.tsx rodapé).
  // Aditivos, nunca vazam de nenhuma gráfica existente.
  telefone         String?
  emailContato     String?
  site             String?
  enderecoResumido String? // texto livre, uma linha — mesmo espírito de Filial.endereco

  // Dados de RECEBIMENTO da própria gráfica (achado F6 da Parte 7 da
  // auditoria de abrangência, pesquisa-abrangencia-modulos.md, 2026-08-31) —
  // identidade comercial, não fiscal (por isso mora aqui, não em
  // DadosFiscaisGrafica). SÓ EXIBIÇÃO: chavePix nunca é validada (não confere
  // CPF/CNPJ/e-mail/telefone real, é texto livre) e nada aqui confirma
  // pagamento automaticamente — ContaReceber/Pagamento continuam a única
  // fonte de verdade de "foi pago", baixados manualmente como hoje. Impresso
  // no PDF de orçamento e exibido em /o/[token] (só depois de APROVADO) só
  // quando preenchido — null = gráfica não cadastrou, comportamento de hoje
  // 100% preservado.
  chavePix     String?
  tipoChavePix TipoChavePix?
  // Nome de quem recebe o PIX — pode ser diferente de `nome`/razão social
  // (ex: sócio pessoa física, ou outra empresa do grupo). Puramente
  // declarativo, nunca comparado com nada.
  favorecidoPix String?
  // Texto livre pra quem prefere TED/depósito em vez de PIX (banco, agência,
  // conta) — sem cadastro estruturado de banco/agência/conta de propósito:
  // achado classificado 🟢 Barato cobre só recebimento básico, não um
  // cadastro bancário completo.
  dadosBancarios String?

  // Unidade padrão pra ENTRADA e EXIBIÇÃO de medidas de item de orçamento
  // (largura/altura) — não afeta como o dado é gravado: OrcamentoItem.
  // larguraCm/alturaCm continuam SEMPRE em centímetros, a unidade canônica
  // do motor de cálculo (ver src/lib/unidade-dimensao.ts). Default CM
  // preserva o comportamento de toda gráfica existente. Mais tarde um item
  // específico de orçamento poderá sobrescrever isso pontualmente — trocar
  // este padrão aqui nunca reconverte/altera orçamentos já salvos.
  unidadePadraoDimensao UnidadeDimensao @default(CM)

  // Perfil de negócio da gráfica (achado A6 da Parte 6 da auditoria de
  // abrangência, 2026-08-27) — DESCRITIVO, nunca restritivo: só semeia
  // defaults (categorias de custo sugeridas, pacote de dados de exemplo) e
  // filtra sugestões; uma gráfica ESTAMPARIA_VESTUARIO continua podendo
  // cadastrar uma prensa offset sem nenhuma trava. null = tenant anterior a
  // este campo, ou que ainda não respondeu — cai nos mesmos defaults de
  // sempre (perfil rótulo/etiqueta da gráfica-piloto), sem mudança de
  // comportamento. Pergunta opcional, respondida em /configuracoes/identidade.
  segmento      SegmentoGrafica?
  // Só obrigatório (validado no server) quando segmento = OUTRO — mesmo
  // padrão de Cliente.segmentoOutro/OrigemCliente.origemOutro.
  segmentoOutro String?

  // Segmentos SECUNDÁRIOS da gráfica (achado F9 da Parte 7 da auditoria de
  // abrangência, pesquisa-abrangencia-modulos.md, 2026-08-31) — gráfica real
  // quase nunca é uma coisa só (offset + gráfica rápida + comunicação visual
  // no mesmo CNPJ é a norma). MESMA REGRA DE OURO de `segmento` acima: 100%
  // DESCRITIVO, NUNCA RESTRITIVO. Só pode alimentar lógica ADITIVA (ex:
  // ampliar o pacote de dados de exemplo em src/lib/dados-exemplo.ts com
  // produtos extras dos segmentos secundários) — nunca uma condição que
  // esconde/bloqueia card, menu ou feature (ver correção de E1/E2 no mesmo
  // documento: usar `segmento`/`segmentosSecundarios` desse jeito já foi
  // sinalizado como potencialmente perigoso). Array vazio (default) =
  // comportamento de hoje, sem nenhuma mudança pra tenant existente. Não há
  // campo "Outro" irmão aqui (diferente de segmento/segmentoOutro): a lista
  // secundária é só um multi-select sobre o mesmo enum, sem texto livre.
  segmentosSecundarios SegmentoGrafica[] @default([])

  usuarios              Usuario[]
  clientes              Cliente[]
  itensGrafica          ItemGrafica[]
  itensCatalogoPrivados ItemCatalogo[]
  orcamentos            Orcamento[]
  pedidos               Pedido[]
  parametros            ParametrosGrafica?
  prensas               Prensa[]
  maquinasFlexografia   MaquinaFlexografia[]
  equipamentos          Equipamento[]
  impressorasDigitais   ImpressoraDigital[]
  maquinasSetupPorPeca  MaquinaSetupPorPeca[]
  // Achados A4/A6 da Parte 1 da auditoria de abrangência
  // (pesquisa-abrangencia-modulos.md) — ver model MaquinaBordado/MaquinaTempo.
  maquinasBordado       MaquinaBordado[]
  maquinasTempo         MaquinaTempo[]
  registrosManutencao   RegistroManutencao[]
  // Achado F1 da Parte 7 da auditoria de abrangência — ver model Ferramental.
  ferramentais          Ferramental[]
  // Achado A5 da auditoria de abrangência (Parte 6/Configurações) — ver
  // model PerfilAcesso.
  perfisAcesso          PerfilAcesso[]
  // Achado B1/B2 da Parte 2 (Produção) — histórico de transição de etapa
  // por pedido, ver ApontamentoEtapa.
  apontamentosEtapa     ApontamentoEtapa[]
  dadosFiscais          DadosFiscaisGrafica?
  notasFiscais          NotaFiscal[]
  automacao             AutomacaoGrafica?
  despesas              Despesa[]
  logsAuditoria         LogAuditoria[]
  assinatura            AssinaturaGrafica?
  comissoes             Comissao[]
  filiais               Filial[]
  arquivos              ArquivoArmazenado[]
  categoriasCusto       CategoriaCusto[]
  custosPedido          CustoPedido[]
  custosPrevisto        PedidoCustoPrevisto[]
  fornecedores          Fornecedor[]
  // Achado E1 da auditoria de abrangência (Parte 2/Produção) — ver model
  // EtapaTerceirizada.
  etapasTerceirizadas   EtapaTerceirizada[]
  contasPrepagas        ContaPrepaga[]
  contasReceber         ContaReceber[]
  condicoesPagamento    CondicaoPagamento[]
  importacoesPlanilha   ImportacaoPlanilha[]
  solicitacoesCompra    SolicitacaoCompra[]
  // Achado A9 da auditoria de abrangência (Parte 3/Compras, 2026-08-30) —
  // ver model ContratoFornecimento.
  contratosFornecimento ContratoFornecimento[]
  entregas              Entrega[]
  filaGangRun           FilaGangRun[]
  gruposGangRun         GrupoGangRun[]
  feriados              FeriadoGrafica[]
  // Achado A4 da Parte 6 da auditoria de abrangência
  // (pesquisa-abrangencia-modulos.md, 2026-09-02) — ver model AlcadaAprovacao.
  alcadasAprovacao      AlcadaAprovacao[]
  // Achado A1 da auditoria de abrangência (Parte 2/Produção), Fase 1 — ver
  // model EtapaGrafica.
  etapasGrafica         EtapaGrafica[]

  @@map("graficas")
}

// Parâmetros globais do motor de precificação avançado (M2/OFFSET), um por tenant.
// Os campos de custo de máquina (torres, custoHoraMaq etc.) viraram o modelo Prensa
// — um tenant pode ter várias prensas offset com custos/rendimentos diferentes.
model ParametrosGrafica {
  id        String @id @default(cuid())
  graficaId String @unique

  // Composição final do preço (spec §0 e §4)
  overheadPercent          Decimal @default(0.15) @db.Decimal(5, 4)
  margemPadrao             Decimal @default(0.20) @db.Decimal(5, 4)
  impostoPercent           Decimal @default(0.06) @db.Decimal(5, 4)
  comissaoPercent          Decimal @default(0) @db.Decimal(5, 4)
  taxaFinanceiraPercent    Decimal @default(0) @db.Decimal(5, 4)
  pedidoMinimo             Decimal @default(0) @db.Decimal(12, 2)
  incrementoArredondamento Decimal @default(0.10) @db.Decimal(6, 2)

  // Defaults de nesting em bobina (spec §1: s, g)
  margemSegurancaPadrao Decimal @default(0.02) @db.Decimal(5, 4)
  gapPecasPadrao        Decimal @default(0.008) @db.Decimal(5, 4)

  // Referência pro Cálculo de tinta com IA (ver OrcamentoItemTinta) — NUNCA
  // entra na composição de preço acima, é só multiplicado pelo ml estimado
  // na hora de EXIBIR o card, puramente informativo. Nulo = ainda não
  // configurado, o card não mostra linha de custo nenhuma nesse caso.
  custoTintaPorMl Decimal? @db.Decimal(10, 4)

  // Política de cálculo da comissão PAGA a vendedores (ver model Comissao)
  // — NÃO CONFUNDIR com `comissaoPercent` acima, que é markup de
  // precificação embutido no preço de venda (src/lib/pricing/compor.ts),
  // nunca pago a ninguém. Esta aqui decide se o valor-base da comissão de
  // cada vendedor é o total do orçamento ou o lucro (total - custo).
  comissaoVendedorBase BaseComissao @default(VALOR)

  // Achado A8 da auditoria de abrangência (pesquisa-abrangencia-modulos.md)
  // — hoje Comissao.usuarioId nasce sempre de Orcamento.usuarioId (quem
  // DIGITOU o orçamento no sistema), não de Cliente.vendedorId (quem
  // efetivamente atende o cliente). Quando ligada, o vendedor do CLIENTE
  // passa a ser a base de Comissao.usuarioId no fechamento (ver
  // atualizarStatusOrcamento em src/app/orcamento/[id]/actions.ts e
  // responderOrcamentoPublico em src/app/o/[token]/actions.ts), com
  // fallback pra Orcamento.usuarioId quando o cliente não tem vendedor
  // atribuído. default(false) preserva 100% do comportamento de hoje pra
  // quem já usa o sistema — muitas gráficas pequenas não distinguem "quem
  // atende o cliente" de "quem lança no sistema".
  comissaoSegueVendedorDoCliente Boolean @default(false)

  // Flags da fase "custo real" (fase-custo-real.md §1.5) — tudo que varia
  // entre gráficas nasce aqui, nunca hardcoded.
  custoAutomaticoConsumo        Boolean @default(true) // gerar CustoPedido automático na baixa Fila→Impressão
  categoriaCustoConsumoPadraoId String? // categoria pra matéria-prima sem categoriaCustoId própria
  comissaoEntraNoCustoPedido    Boolean @default(false)
  perdaEhCustoDoPedido          Boolean @default(true)
  margemFaixaBaixa              Decimal @default(10) @db.Decimal(5, 2) // % — abaixo disso o medidor mostra vermelho
  margemFaixaBoa                Decimal @default(25) @db.Decimal(5, 2) // % — acima disso o medidor mostra verde
  descontoMaxSemAprovacao       Decimal @default(100) @db.Decimal(5, 2) // % — 100 = sem trava (comportamento de hoje)
  diasPrecoInsumoDesatualizado  Int     @default(90)

  // Achado N13 da auditoria de abrangência — faixa de gramatura aceita pelo
  // validador do offset (ver validarPedidoOffset em src/lib/pricing/validar.ts).
  // Antes era uma constante fixa 30-500 g/m² no código: travava com erro
  // fatal a cotação de embalagem/cartonagem (duplex/triplex 450-600 g/m²,
  // micro-ondulado E-flute >500) e de editorial (papel bíblia 22-40 g/m²).
  // Defaults 30/500 preservam 100% do comportamento de hoje pra quem já usa
  // o sistema — mesmo espírito de descontoMaxSemAprovacao acima.
  gramaturaMinGm2 Decimal @default(30) @db.Decimal(6, 1)
  gramaturaMaxGm2 Decimal @default(500) @db.Decimal(6, 1)

  // Achado A6 da Parte 4 da auditoria de abrangência (2026-08-27) — mesmo
  // espírito de descontoMaxSemAprovacao acima: por padrão, estourar
  // Cliente.limiteCredito na aprovação de um orçamento é só um AVISO
  // (atualizarStatusOrcamento/responderOrcamentoPublico continuam aprovando).
  // Ligada, a aprovação passa a ser recusada de verdade quando a exposição
  // (ContaReceber pendente + este orçamento) ultrapassa o limite. Só afeta o
  // estouro AUTOMÁTICO de limite — o bloqueio manual
  // (Cliente.bloqueadoParaVenda/bloqueadoParaFaturamento) nunca bloqueia de
  // verdade, só avisa, independente desta flag. default(false) preserva o
  // comportamento de hoje pra quem já usa o sistema.
  bloqueiaAoUltrapassarLimiteCredito Boolean @default(false)
  // Quantos dias um orçamento fica válido depois de virar ENVIADO (ver
  // Orcamento.validoAteEm e orcamentoEstaExpirado em
  // src/lib/orcamento-status.ts). Nullable + default(15) de propósito: o
  // form sempre manda um inteiro, mas o nullable deixa espaço pra uma
  // futura opção de "sem expiração" sem precisar de sentinela mágico.
  diasValidadeOrcamentoPadrao        Int?    @default(15)

  // Variação admissível entre a quantidade CONTRATADA e a quantidade
  // efetivamente ENTREGUE, em %, sem que isso seja motivo de disputa —
  // padrão do mercado offset (quebra de máquina, acerto de cor). Snapshot
  // em Orcamento.toleranciaTiragemPercent no momento do ENVIO, mesmo
  // mecanismo de diasValidadeOrcamentoPadrao → validoAteEm acima. Nullable
  // + default(10) pelo mesmo motivo: form sempre manda um número, mas o
  // nullable deixa espaço pra uma futura opção de "tolerância zero" sem
  // sentinela mágico.
  toleranciaTiragemPadraoPercent Decimal? @default(10) @db.Decimal(5, 2)

  // Achado A13 da Parte 6 da auditoria de abrangência (2026-08-29) —
  // tolerância de tiragem configurável pela gráfica (usada no PDF de
  // termos-padrão e exibição de faixa aceitável na Ordem de Produção).
  // 0 = sem tolerância (comportamento padrão hoje); > 0 = % de variação
  // permitida exibida em documentos. Aditivo: zero mudança de comportamento
  // de faturamento (fora de escopo desta rodada, ver pesquisa-abrangencia-modulos.md).
  toleranciaTiragemPercent Decimal @default(0) @db.Decimal(5, 2)

  // Limiares do alerta de prazo por e-mail (ver src/lib/alerta-prazo-email.ts)
  // — antes fixos em 5/3/0 dias no código. Uma gráfica com ciclo de produção
  // de 1 dia acha 5 dias antes ruído inútil; uma com produção longa
  // (offset+laminação+hot stamping) quer aviso mais cedo. Ordem decrescente
  // sempre (limiar1 > limiar2 > limiar3) — validado na action, não aqui.
  alertaPrazoAtivo       Boolean @default(true)
  alertaPrazoLimiar1Dias Int     @default(5)
  alertaPrazoLimiar2Dias Int     @default(3)
  alertaPrazoLimiar3Dias Int     @default(0)

  // Quantos dias um orçamento ENVIADO fica sem resposta do cliente até
  // aparecer na lista de "parados" (ver Orcamento.enviadoEm e
  // orcamentoEstaParado em src/lib/orcamento-status.ts). Distinto de
  // diasValidadeOrcamentoPadrao acima: expiração é o prazo em que a proposta
  // deixa de valer, este é um aviso ANTERIOR pro vendedor cobrar o cliente
  // antes de chegar lá — pesquisa de mercado aponta "mandei e o cliente
  // sumiu" como o padrão mais comum de venda perdida numa gráfica.
  diasAlertaOrcamentoParado Int @default(5)

  // Bloco de termos e condições impresso no rodapé do PDF de orçamento
  // (src/lib/pdf/OrcamentoDocumento.tsx), usado tanto em /orcamento/[id]/pdf
  // quanto no link público /o/[token]/pdf. Null = gráfica nunca configurou
  // — o PDF cai no texto padrão do sistema (ver TERMOS_CONDICOES_PDF_PADRAO
  // em src/lib/pdf/termos-padrao.ts), nunca fica em branco por padrão
  // (exposição jurídica se um pedido for contestado). "" também vira null na
  // action (ver salvarParametros), pra "limpar o campo" sempre significar
  // "voltar pro padrão do sistema", nunca "sem cláusula nenhuma".
  termosCondicoesPdf String? @db.Text

  // Liga/desliga o bloco inteiro de especificações técnicas de etiqueta
  // (material, adesivo, verniz, laminação, hot/cold stamping, rebobinamento
  // — ver OrcamentoItemEtiqueta) no que o CLIENTE vê (link público e as duas
  // rotas de PDF), nunca na tela interna autenticada nem na Ordem de
  // Produção (chão de fábrica sempre precisa da especificação completa,
  // independente da preferência do cliente). Tudo ou nada de propósito —
  // usuário pediu explicitamente a versão simples em vez de um toggle por
  // campo (2026-08-23): "nem toda empresa quer que apareça". default true
  // preserva o comportamento de sempre mostrar (que já existia antes deste
  // campo existir) pra toda gráfica já cadastrada.
  mostrarEspecificacoesTecnicas Boolean @default(true)

  // Calendário de dias úteis por tenant (achado A2 da Parte 6 — auditoria de
  // abrangência, 2026-08-27): o PDF de orçamento promete "N dias úteis após
  // aprovação" (texto fixo em src/lib/pdf/OrcamentoDocumento.tsx e
  // src/app/o/[token]/page.tsx) mas nada no sistema sabia calcular um dia
  // útil de verdade — nem sequer sabia que cada gráfica tem feriados
  // municipais/estaduais próprios (Carnaval é feriado no Rio, não em SP; um
  // feriado municipal de Araxá não existe em Manaus). false = a gráfica cota
  // em dias corridos simples (ver somarDiasUteis em src/lib/dias-uteis.ts).
  prazoEmDiasUteis  Boolean @default(true)
  // Bitmask dos dias da semana em que a gráfica funciona — bit0=segunda,
  // bit1=terça, bit2=quarta, bit3=quinta, bit4=sexta, bit5=sábado,
  // bit6=domingo (bit ligado = funciona nesse dia). Default 31 = 0b0011111 =
  // segunda a sexta.
  diasFuncionamento Int     @default(31)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@map("parametros_grafica")
}

// Feriado (ou ponto facultativo tratado como feriado) de UMA gráfica — nunca
// um calendário nacional único: cada gráfica tem sua cidade/UF, com feriados
// municipais/estaduais próprios (ver comentário de
// ParametrosGrafica.prazoEmDiasUteis acima). Consumido por somarDiasUteis
// (src/lib/dias-uteis.ts) e por enviarAlertasPrazoEmail (src/lib/alerta-prazo-email.ts).
model FeriadoGrafica {
  id              String   @id @default(cuid())
  graficaId       String
  data            DateTime @db.Date
  descricao       String
  // 25/12 (Natal) é recorrente todo ano; Carnaval/Corpus Christi são datas
  // móveis e precisam ser recadastrados ano a ano — somarDiasUteis compara
  // só mês/dia (ignorando o ano) quando este flag está ligado, nunca a data
  // inteira.
  recorrenteAnual Boolean  @default(false)

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@unique([graficaId, data])
  @@index([graficaId])
  @@map("feriados_grafica")
}

enum BaseComissao {
  VALOR // % sobre o total do orçamento aprovado
  LUCRO // % sobre valor - custo estimado dos itens
}

// Uma prensa offset física do tenant. Produtos com modeloCalculo=OFFSET escolhem
// uma prensa específica em ItemGrafica.prensaId — cada prensa tem seu próprio
// custo de hora-máquina, chapas, torres etc. (ver spec §2, antes vivia em
// ParametrosGrafica como uma "prensa virtual" única por gráfica).
model Prensa {
  id        String  @id @default(cuid())
  graficaId String
  nome      String
  ativa     Boolean @default(true)

  custoHoraMaq       Decimal @default(0) @db.Decimal(12, 4)
  torres             Int     @default(4)
  custoChapa         Decimal @default(0) @db.Decimal(12, 4)
  folhasAcerto       Int     @default(150)
  tempoAcertoH       Decimal @default(0.5) @db.Decimal(6, 4)
  custoMilheiroRod   Decimal @default(0) @db.Decimal(12, 4)
  rodagemMinima      Decimal @default(0) @db.Decimal(12, 4)
  perdaPercentPadrao Decimal @default(0.03) @db.Decimal(5, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica             Grafica              @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  produtos            ItemGrafica[]
  registrosManutencao RegistroManutencao[]
  apontamentosEtapa   ApontamentoEtapa[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("prensas")
}

// Uma máquina flexográfica física do tenant. Produtos com modeloCalculo=FLEXOGRAFIA
// escolhem uma máquina específica em ItemGrafica.maquinaFlexografiaId — mesma
// filosofia da Prensa (custo de hora-máquina, setup e rodagem por máquina, não por
// gráfica). Tabela separada de Prensa (não polimórfica) de propósito: o projeto já
// trata SIMPLES/M2/OFFSET como caminhos paralelos não-unificados, e unificar Prensa
// numa estrutura polimórfica arriscaria migrar dado real de produção do Offset à
// toa. Nesting de material é 1D (largura da bobina, reaproveitando BobinaMaterial
// tal como já existe pro M2), não 2D como o Offset — a bobina define a largura útil,
// o cilindro define o comprimento fixo consumido por volta (passoCilindroM).
model MaquinaFlexografia {
  id        String  @id @default(cuid())
  graficaId String
  nome      String
  ativa     Boolean @default(true)

  // Teto físico de largura útil de impressão da máquina — usado como limite superior
  // no nesting (min contra a largura útil da bobina escolhida no produto), não como
  // a largura em si (essa vem da BobinaMaterial, igual M2).
  larguraMaquinaM     Decimal @default(0) @db.Decimal(6, 3)
  // Repeat do cilindro instalado — comprimento fixo consumido a cada volta,
  // independente do tamanho da peça (v1 assume 1 repeat por volta, ver
  // calcularFlexografia).
  passoCilindroM      Decimal @default(0) @db.Decimal(6, 3)
  // Nº de estações/cores da máquina — teto de cores por passagem, mesmo papel de
  // Prensa.torres.
  numeroEstacoesCores Int     @default(6)
  custoHoraMaq        Decimal @default(0) @db.Decimal(12, 4)
  tempoAcertoH        Decimal @default(1) @db.Decimal(6, 4)
  // Metros lineares de bobina perdidos no acerto/registro por entrada — equivalente
  // contínuo de Prensa.folhasAcerto (que é um nº de folhas, não de metros).
  metrosAcerto        Decimal @default(0) @db.Decimal(6, 3)
  custoMetroLinearRod Decimal @default(0) @db.Decimal(12, 4)
  rodagemMinima       Decimal @default(0) @db.Decimal(12, 4)
  perdaPercentPadrao  Decimal @default(0.03) @db.Decimal(5, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica             Grafica              @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  produtos            ItemGrafica[]
  registrosManutencao RegistroManutencao[]
  apontamentosEtapa   ApontamentoEtapa[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("maquinas_flexografia")
}

// Uma impressora digital física do tenant (pequeno formato, tiragem curta —
// HP Indigo, Xerox, Konica Minolta, Canon, Ricoh). Produtos com
// modeloCalculo=DIGITAL escolhem uma impressora específica em
// ItemGrafica.impressoraDigitalId — mesma filosofia de Prensa/
// MaquinaFlexografia (custo por máquina, não por gráfica), mas sem nesting:
// impressão digital não precisa de bobinas/folhas, só custo por clique +
// custo do substrato (ver src/lib/pricing/digital.ts).
model ImpressoraDigital {
  id        String  @id @default(cuid())
  graficaId String
  nome      String
  ativa     Boolean @default(true)

  custoPorClique Decimal @default(0) @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica             Grafica              @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  produtos            ItemGrafica[]
  registrosManutencao RegistroManutencao[]
  apontamentosEtapa   ApontamentoEtapa[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("impressoras_digitais")
}

// Tag de processo pra MaquinaSetupPorPeca — separada de propósito do
// ModeloCalculo do produto: aqui é só o filtro de qual máquina serve pra qual
// produto no <Select> de configuração, não o modelo de cálculo em si (os 4
// ModeloCalculo correspondentes chamam a mesma função calcularSetupPorPeca).
// TAMPOGRAFIA/GRAVACAO_LASER/DTG/TRANSFER/OUTRO (achado A3 da auditoria de
// abrangência) mapeiam pra ModeloCalculo.PERSONALIZACAO — diferente de
// SERIGRAFIA/SUBLIMACAO/ESTAMPAGEM_QUENTE, que continuam 1:1 com seu próprio
// ModeloCalculo homônimo. OUTRO segue o mesmo padrão enum-fechado + escape
// do resto do schema (ver CategoriaEquipamento/MaterialSubstrato/etc.) —
// pareado com MaquinaSetupPorPeca.tipoProcessoOutro.
enum ProcessoSetupPorPeca {
  SERIGRAFIA
  SUBLIMACAO
  ESTAMPAGEM_QUENTE
  TAMPOGRAFIA
  GRAVACAO_LASER
  DTG
  TRANSFER
  OUTRO
}

// Máquina física pros processos de "setup por peça" — serigrafia
// (tela/matriz), sublimação (prensa térmica), estampagem a quente (hot
// stamping) e a família PERSONALIZACAO (tampografia, gravação a laser, DTG,
// transfer e o que mais a gráfica cadastrar via OUTRO). Tabela ÚNICA pros
// vários processos (tag tipoProcesso), não uma tabela por processo: mesmo
// racional de "1 função de cálculo compartilhada" decidido pra
// src/lib/pricing (calcularSetupPorPeca), evita duplicar CRUD/schema pra um
// custo que tem exatamente a mesma forma em todos os processos (custo fixo
// de setup por arte/matriz/tela + custo variável por peça + piso do job).
model MaquinaSetupPorPeca {
  id                String               @id @default(cuid())
  graficaId         String
  nome              String
  tipoProcesso      ProcessoSetupPorPeca
  tipoProcessoOutro String? // só usado quando tipoProcesso = OUTRO
  ativa             Boolean              @default(true)

  custoPorSetup Decimal @default(0) @db.Decimal(12, 4) // R$ por tela/matriz/arte
  custoPorPeca  Decimal @default(0) @db.Decimal(12, 4) // variável por peça
  custoMinimo   Decimal @default(0) @db.Decimal(12, 4) // piso do job

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica             Grafica              @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  produtos            ItemGrafica[]
  registrosManutencao RegistroManutencao[]
  apontamentosEtapa   ApontamentoEtapa[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@index([tipoProcesso])
  @@map("maquinas_setup_por_peca")
}

// Achado A4 da Parte 1 da auditoria de abrangência (pesquisa-abrangencia-
// modulos.md): bordado não cabe em MaquinaSetupPorPeca (calcularSetupPorPeca)
// porque lá o custo por peça é FIXO na máquina (custoPorPeca) — em bordado o
// custo por peça varia com o número de PONTOS da arte de cada pedido, um
// logo de 3.000 pontos e uma arte de costas de 15.000 pontos custam 5×
// diferente na mesma máquina, na mesma camiseta. Por isso é um model (e um
// ModeloCalculo) próprio, não mais um tipoProcesso de MaquinaSetupPorPeca —
// mesmo padrão de FK/índice/@@map desse model, mas sem tipoProcesso (não há
// "sabor" de bordado, é sempre a mesma fórmula por pontos).
// custoPorMilPontos/custoMatrizDigitalizacao são o custo VARIÁVEL por pedido
// (ver OrcamentoItem.numeroPontos) — @default(0) só pra permitir criar a
// máquina com nome e ajustar os custos na tela seguinte (mesmo padrão de
// criarMaquinaSetupPorPeca/criarImpressoraDigital: "Nova máquina" grava só o
// nome, os custos ficam zerados até o usuário editar). cabecas é
// informativo/produtivo (não entra na fórmula de custo desta v1) —
// @default(1) pela mesma razão de criação com o mínimo de campos.
// custoHoraMaq/custoMinimo nullable = opcionais de verdade (nem todo bordado
// cobra hora de máquina separada nem tem piso de job).
model MaquinaBordado {
  id                       String   @id @default(cuid())
  graficaId                String
  nome                     String
  custoPorMilPontos        Decimal  @default(0) @db.Decimal(10, 2)
  custoMatrizDigitalizacao Decimal  @default(0) @db.Decimal(10, 2)
  cabecas                  Int      @default(1)
  custoHoraMaq             Decimal? @db.Decimal(10, 2)
  custoMinimo              Decimal? @db.Decimal(10, 2)
  ativa                    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica  Grafica       @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  produtos ItemGrafica[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("maquinas_bordado")
}

// Achado A6 da Parte 1 da auditoria de abrangência (pesquisa-abrangencia-
// modulos.md): corte/gravação a laser, router CNC, plotter de recorte,
// montagem de letra caixa/totem — nenhum modelo cobra por TEMPO DE MÁQUINA
// hoje (Equipamento.CORTE_LASER_ROUTER/PLOTTER_RECORTE existem só como
// cadastro informativo, nunca influenciam preço — ver comentário do model
// Equipamento). Mesmo padrão de FK/índice/@@map de MaquinaSetupPorPeca, sem
// tipoProcesso (não há "sabor" — a gráfica escolhe cobrar por tempo, por
// metro de corte, ou os dois somados, tudo na mesma máquina). custoHoraMaq/
// custoSetupPorJob são o custo VARIÁVEL por pedido (ver
// OrcamentoItem.tempoEstimadoMin/metrosCorte) — @default(0) pela mesma razão
// de MaquinaBordado acima (criar só com nome, ajustar custo depois).
// custoMinimo/custoPorMetroCorte nullable = opcionais de verdade (corte a
// metro só faz sentido pra plotter/router; nem toda máquina tem piso).
model MaquinaTempo {
  id                 String   @id @default(cuid())
  graficaId          String
  nome               String
  custoHoraMaq       Decimal  @default(0) @db.Decimal(10, 2)
  custoSetupPorJob   Decimal  @default(0) @db.Decimal(10, 2)
  custoMinimo        Decimal? @db.Decimal(10, 2)
  custoPorMetroCorte Decimal? @db.Decimal(10, 2)
  ativa              Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica  Grafica       @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  produtos ItemGrafica[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("maquinas_tempo")
}

// Categorias reais de equipamento de gráfica levantadas por pesquisa
// (2026-08-22) — cobre o que sobra fora de Offset/Flexografia (que já têm
// motor de custo próprio, ver Prensa/MaquinaFlexografia). Lista fechada com
// OUTRO de escape (mesmo padrão de UnidadeMedida/MaterialSubstrato/etc. no
// resto do schema) — nunca trava um equipamento real fora da lista.
enum CategoriaEquipamento {
  GUILHOTINA // corte de papel/papelão — ex: Polar, Guarani, Wohlenberg
  LAMINADORA // plastificação/laminação — ex: Ricall, Foliant, GMP
  DOBRADEIRA
  ENCADERNADORA // wire-o, espiral, capa dura — ex: Duplo, Marpax
  GRAMPEADEIRA // alceadeira/grampeadeira de miolo — ex: Müller Martini, CP Bourg
  PLOTTER_RECORTE // corte de vinil/adesivo
  IMPRESSORA_GRANDE_FORMATO // banner, lona, adesivo — ex: Roland, Mimaki, HP Latex, Epson
  // Segunda leva de categorias (pesquisa 2026-08-23) — cobre o fluxo de
  // pré-impressão Offset (CTP) e o que uma gráfica rápida/comunicação visual
  // tem além de papel: impressão digital de curto tiro, personalização
  // (serigrafia/sublimação), acabamento a quente e corte de material rígido.
  CTP // chapeadora — grava a chapa de offset — ex: Agfa, Kodak, Fujifilm, Heidelberg Suprasetter
  IMPRESSORA_DIGITAL // pequeno formato, tiragem curta — ex: HP Indigo, Xerox, Konica Minolta, Canon, Ricoh
  SERIGRAFIA // mesa/carrossel serigráfico, manual ou automático
  SUBLIMACAO // prensa térmica + impressora — ex: Metalnox, MAQmei (prensa); Epson SureColor F (impressora)
  ESTAMPAGEM_QUENTE // hot stamping — aplica filme metalizado/pigmentado com calor e pressão
  CORTE_LASER_ROUTER // corte/gravação de acrílico, ACM, MDF — ex: Visutec, MultiCam
  // Terceira leva (achados A1/A2/A5 da Parte 7 da auditoria de abrangência,
  // pesquisa-abrangencia-modulos.md, versão CORRIGIDA pela revisão Opus
  // 2026-08-31). BORDADO substitui a proposta original de
  // ProcessoSetupPorPeca.BORDADO (descartada por conflitar com o achado
  // A4/Parte 1 — bordado cobra por PONTO da arte, não por peça fixa como
  // calcularSetupPorPeca assume): entra só como cadastro informativo, sem
  // motor de custo próprio, o mesmo papel que Equipamento já cumpre pro
  // resto desta lista.
  BORDADO // bordadeira mono ou multicabeça — ex: Juki, Brother, Tajima
  CORTE_VINCO // corta e vinca papel/papelão simultaneamente (cartonagem) — ex: Makpel, DellMarck, Slottec
  VINCADORA // só vinca (não corta) — etapa anterior à dobra em cartonagem/gofragem
  OUTRO
}

// Equipamento físico da gráfica que NÃO tem motor de custo próprio na
// precificação — diferente de Prensa/MaquinaFlexografia (usados só por
// ItemGrafica com modeloCalculo=OFFSET/FLEXOGRAFIA), nenhum produto do
// catálogo referencia um Equipamento. É cadastro + rastreio de manutenção
// puramente informativo (ver RegistroManutencao.equipamentoId abaixo) —
// nunca influencia preço de nenhum orçamento. marca/modelo são texto livre
// opcional (não é catálogo de modelos exatos, só contexto pra quem
// registra a parada depois).
model Equipamento {
  id             String               @id @default(cuid())
  graficaId      String
  nome           String
  categoria      CategoriaEquipamento
  categoriaOutro String? // só usado quando categoria = OUTRO
  marca          String?
  modelo         String?
  ativo          Boolean              @default(true)

  // Achado A3 da Parte 7 (impressora de grande formato sem largura/
  // tecnologia cadastrável) — textos livres/nullable de propósito: sem
  // enum fechado pra tecnologiaImpressao (solvente/eco-solvente/UV/
  // sublimática) por decisão deliberada da revisão Opus 2026-08-31, mesmo
  // raciocínio de marca/modelo acima (contexto informativo, não catálogo
  // fechado). Faz sentido pra qualquer categoria de Equipamento, não só
  // IMPRESSORA_GRANDE_FORMATO — nenhuma validação de categoria aqui.
  larguraMaximaMm     Int?
  tecnologiaImpressao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica             Grafica              @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  registrosManutencao RegistroManutencao[]
  apontamentosEtapa   ApontamentoEtapa[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("equipamentos")
}

enum TipoRegistroManutencao {
  PREVENTIVA // manutenção agendada, planejada com antecedência
  QUEBRA // parada não planejada — máquina quebrou ou precisou parar de repente
}

// Um período em que uma Prensa, MaquinaFlexografia OU Equipamento ficou
// indisponível pra produção — cobre tanto manutenção PREVENTIVA agendada
// quanto QUEBRA/parada reativa (o `tipo` só existe pra segmentar isso em
// relatórios; o comportamento de "está parada agora" é sempre baseado em
// dataFim, nunca em tipo). dataFim null = parada ainda em andamento; é o
// que buscarManutencoesAtivas (src/lib/manutencao-maquina.ts) usa pra
// decidir exibir o aviso "essa máquina está parada" na tela de Máquinas e
// no cadastro de produto Offset/Flexografia. Três FKs opcionais, nunca mais
// de uma preenchida na mesma linha (validado na Server Action, não há
// CHECK no banco — mesmo padrão de validação em app do resto do schema) —
// mesmo princípio de ItemGrafica.prensaId/maquinaFlexografiaId: Prensa,
// MaquinaFlexografia e Equipamento são tabelas paralelas não-unificadas de
// propósito (ver comentário em MaquinaFlexografia), então o registro de
// parada segue a mesma filosofia em vez de virar o ponto que força uma
// hierarquia comum entre as três. onDelete=Cascade (diferente do Restrict
// em ItemGrafica.prensaId): um histórico de manutenção sem a máquina que
// ele descreve não tem valor — não faz sentido travar a exclusão da
// máquina por causa disso.
model RegistroManutencao {
  id        String @id @default(cuid())
  graficaId String

  prensaId              String?
  maquinaFlexografiaId  String?
  equipamentoId         String?
  // Generalização do mesmo padrão pras 2 máquinas novas de Feature A —
  // exatamente 1 dentre as 5 FKs preenchida por registro (validado em
  // validarSelecaoMaquina, src/lib/manutencao-maquina.ts).
  impressoraDigitalId   String?
  maquinaSetupPorPecaId String?

  tipo   TipoRegistroManutencao @default(QUEBRA)
  motivo String // texto livre — "trocou o rolo de tinta", "manutenção preventiva trimestral" etc.

  dataInicio DateTime  @default(now())
  dataFim    DateTime? // null = parada ainda em andamento

  // Quem registrou — sem FK direta pra Usuario (mesmo padrão de
  // MovimentacaoEstoque.criadoPorId): resolvido em batch na tela quando
  // precisa exibir o nome, pra não travar o registro se o usuário for removido.
  registradoPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica             Grafica              @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  prensa              Prensa?              @relation(fields: [prensaId], references: [id], onDelete: Cascade)
  maquinaFlexografia  MaquinaFlexografia?  @relation(fields: [maquinaFlexografiaId], references: [id], onDelete: Cascade)
  equipamento         Equipamento?         @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  impressoraDigital   ImpressoraDigital?   @relation(fields: [impressoraDigitalId], references: [id], onDelete: Cascade)
  maquinaSetupPorPeca MaquinaSetupPorPeca? @relation(fields: [maquinaSetupPorPecaId], references: [id], onDelete: Cascade)

  @@index([graficaId])
  @@index([prensaId])
  @@index([maquinaFlexografiaId])
  @@index([equipamentoId])
  @@index([impressoraDigitalId])
  @@index([maquinaSetupPorPecaId])
  @@map("registros_manutencao")
}

// Achado F1 da Parte 7 da auditoria de abrangência
// (pesquisa-abrangencia-modulos.md, "F. Documento e transação") — lista
// fechada com OUTRO de escape (mesmo padrão de CategoriaEquipamento/
// MaterialSubstrato/etc.), cobrindo o ferramental reutilizável que hoje só
// existe como CUSTO (ConfiguracaoClicheEtiqueta/Flexografia.
// custoClichePorCm2, ConfiguracaoAcabamento.custoFerramental,
// OrcamentoItemPrecificacaoEtiqueta.custoFaca), nunca como a ferramenta
// física em si.
enum TipoFerramental {
  FACA_CORTE_VINCO // corte e vinco de caixa/embalagem/cartão
  CLICHE_FLEXO // clichê de flexografia — lavado e reaproveitado em repetição
  CLICHE_HOT_STAMPING // clichê/matriz de estampagem a quente
  TELA_SERIGRAFIA // tela de serigrafia, por arte/cor
  MATRIZ_BORDADO // matriz/programa de bordado digitalizado
  CILINDRO_ROTOGRAVURA
  FERRAMENTA_ACABAMENTO // molde/dispositivo de acabamento que não se encaixa nos tipos acima
  OUTRO
}

// De quem é a ferramenta física — GRAFICA (patrimônio da própria gráfica,
// reutilizável em qualquer cliente que peça o mesmo produto) ou CLIENTE
// (encomendada e paga pelo cliente, guardada pela gráfica pra repetição —
// não pode ser usada pra outro cliente, e pode precisar ser devolvida, ver
// StatusFerramental.DEVOLVIDO_AO_CLIENTE).
enum ProprietarioFerramental {
  GRAFICA
  CLIENTE
}

enum StatusFerramental {
  ATIVO
  EM_MANUTENCAO
  DESCARTADO
  DEVOLVIDO_AO_CLIENTE
}

// Cadastro da ferramenta física (faca, clichê, tela, matriz...) — distinto
// de tudo que já existe no schema, que só guarda o CUSTO dela. Puramente
// informativo/cadastral: NUNCA entra automaticamente na precificação (ver
// OrcamentoItem.ferramentalId abaixo) — o vendedor pode vincular um item de
// orçamento a um Ferramental já existente só como referência/aviso, o preço
// continua 100% manual (custoFaca/custoClichePorCm2 etc. não mudam de
// comportamento). Nunca hard delete (mesmo princípio de Cliente/Usuario):
// desativadoEm marca remoção reversível sem apagar o vínculo histórico em
// OrcamentoItem.ferramentalId.
model Ferramental {
  id        String          @id @default(cuid())
  graficaId String
  tipo      TipoFerramental
  // Só usado quando tipo=OUTRO — mesmo padrão de categoriaOutro/segmentoOutro.
  tipoOutro String?
  // Identificação interna curta (ex: "FC-0042") — não é obrigatoriamente
  // único no mundo real (duas gráficas podem ter o mesmo código de
  // etiqueta interna), mas é único DENTRO da gráfica pra evitar confusão.
  codigo    String
  descricao String? @db.Text

  // Dono da ferramenta física — ver comentário de ProprietarioFerramental.
  // SetNull: desativar/remover o cliente não pode apagar o cadastro da
  // ferramenta, só perde a referência de dono (mesmo padrão de
  // ItemGrafica.categoriaCusto).
  clienteId    String?
  proprietario ProprietarioFerramental @default(GRAFICA)

  // Qual produto do catálogo usa esta ferramenta — opcional (algumas
  // ferramentas, ex: tela de serigrafia por arte avulsa, não têm um produto
  // fixo associado). SetNull, mesmo raciocínio de clienteId acima.
  itemGraficaId String?

  localizacao String?

  // Contador manual de repetições/tiragens já produzidas com esta
  // ferramenta — puramente informativo (ex: acompanhar vida útil de clichê
  // flexográfico, ver pesquisa no achado F1), nunca incrementado
  // automaticamente por nenhum motor ainda. @default(0) preserva
  // comportamento pra toda ferramenta cadastrada sem esse dado.
  tiragensAcumuladas Int @default(0)

  status StatusFerramental @default(ATIVO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // null = ativo/visível nas listas de seleção. Preenchido = removido
  // (soft delete, reversível) — mesmo precedente de Cliente.desativadoEm.
  // Distinto de `status`: status descreve o ESTADO FÍSICO da ferramenta
  // (em manutenção, descartada, devolvida...), desativadoEm é sobre
  // aparecer ou não nas listas/seleções da gráfica.
  desativadoEm DateTime?

  grafica     Grafica      @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  cliente     Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  itemGrafica ItemGrafica? @relation(fields: [itemGraficaId], references: [id], onDelete: SetNull)

  itensOrcamento OrcamentoItem[]

  @@unique([graficaId, codigo])
  @@index([graficaId])
  @@index([graficaId, status])
  @@index([clienteId])
  @@index([itemGraficaId])
  @@map("ferramentais")
}

// Como o Pedido soube da transição de etapa — achado B1/B2 da Parte 2
// (Produção) da auditoria de abrangência. APP é o painel autenticado
// (/producao, lista ou Kanban); LINK_PUBLICO é o e-mail sem login pro
// responsável da etapa (/p/[token]); QR_ETIQUETA é a etiqueta física
// escaneada no chão de fábrica (/q/[token]) — os mesmos 3 canais que já
// chamavam avancarStatusPedido antes desta feature.
enum OrigemConfirmacaoEtapa {
  APP
  LINK_PUBLICO
  QR_ETIQUETA
}

// Um registro por ENTRADA numa etapa de um Pedido (StatusPedido) — o rastro
// que faltava antes desta feature: só existia Pedido.status (o estado
// ATUAL), sem nenhum histórico de quando cada etapa começou/terminou, quem
// confirmou ou em qual máquina rodou. Aberto por avancarStatusPedido dentro
// da MESMA transação do CAS que muda Pedido.status (nunca fora dela — uma
// corrida que confirmasse o status sem abrir/fechar o apontamento junto
// deixaria o histórico inconsistente com o status real) e fechado
// (finalizadoEm) no mesmo instante em que o PRÓXIMO apontamento é aberto.
// Backfill: pedidos que já existiam antes desta migração não ganham
// histórico retroativo (aceitável, ver achado B1) — a linha do tempo
// começa a partir de agora. Sem quantidadeBoa/quantidadeRefugo (achado B3,
// rastreio de refugo) — deliberadamente fora de escopo desta rodada.
model ApontamentoEtapa {
  id        String @id @default(cuid())
  graficaId String
  pedidoId  String

  status StatusPedido

  iniciadoEm   DateTime  @default(now())
  finalizadoEm DateTime?

  // Quem apontou — sem FK direta pra Usuario (mesmo padrão de
  // MovimentacaoEstoque.criadoPorId): não trava o apontamento se o usuário
  // for removido depois. Só preenchido quando origemConfirmacao=APP.
  operadorId String?
  // Nome DECLARADO por quem confirmou pelo link público/QR sem login (mesmo
  // padrão de Pedido.arteRespondidaPor) — não verificado, vale como
  // registro. Hoje sempre null na prática: nem /p/[token] nem /q/[token]
  // coletam nome ainda (ver relatório da tarefa B1/B2 — deliberadamente
  // fora de escopo desta rodada, o campo só já nasce pronto pra quando
  // alguém construir essa UI).
  operadorNomeDeclarado String?

  origemConfirmacao OrigemConfirmacaoEtapa

  observacao String?

  // 5 FKs opcionais, mesmo padrão de RegistroManutencao — mas AQUI 0
  // preenchidas também é válido, diferente de lá (validado em app via
  // validarSelecaoMaquinaOpcional, src/lib/manutencao-maquina.ts): nem toda
  // etapa tem máquina associada (ARTE, CONFERENCIA, EMBALAGEM, EXPEDICAO,
  // ENTREGUE não têm "motor" nenhum) e os canais público/QR não coletam
  // essa informação ainda. "Mais de uma preenchida" continua sendo sempre
  // erro. onDelete=SetNull (diferente do Cascade de RegistroManutencao):
  // apagar uma máquina do cadastro não pode apagar o HISTÓRICO de produção
  // que passou por ela.
  prensaId              String?
  maquinaFlexografiaId  String?
  equipamentoId         String?
  impressoraDigitalId   String?
  maquinaSetupPorPecaId String?

  createdAt DateTime @default(now())

  grafica             Grafica              @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  pedido              Pedido               @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  prensa              Prensa?              @relation(fields: [prensaId], references: [id], onDelete: SetNull)
  maquinaFlexografia  MaquinaFlexografia?  @relation(fields: [maquinaFlexografiaId], references: [id], onDelete: SetNull)
  equipamento         Equipamento?         @relation(fields: [equipamentoId], references: [id], onDelete: SetNull)
  impressoraDigital   ImpressoraDigital?   @relation(fields: [impressoraDigitalId], references: [id], onDelete: SetNull)
  maquinaSetupPorPeca MaquinaSetupPorPeca? @relation(fields: [maquinaSetupPorPecaId], references: [id], onDelete: SetNull)

  @@index([graficaId])
  @@index([pedidoId])
  @@index([prensaId])
  @@index([maquinaFlexografiaId])
  @@index([equipamentoId])
  @@index([impressoraDigitalId])
  @@index([maquinaSetupPorPecaId])
  @@map("apontamentos_etapa")
}

// Uma filial/unidade física da gráfica. COMPARTILHA catálogo, estoque e
// financeiro com a gráfica inteira (não é um tenant separado) — serve só
// pra marcar em qual orçamento foi feito, pra fins de relatório (ver
// Orcamento.filialId). endereco é texto livre de propósito, sem CEP
// estruturado — é só referência, não alimenta nenhum cálculo.
model Filial {
  id        String  @id @default(cuid())
  graficaId String
  nome      String
  endereco  String?
  ativa     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica      Grafica             @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamentos   Orcamento[]
  dadosFiscais DadosFiscaisFilial?

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("filiais")
}

// Dados fiscais da gráfica pra emitir nota fiscal via Focus NFe — 100% opt-in,
// nunca pedido em /comecar ou /login, só configurado quando a gráfica realmente
// for usar a função (ver NotaFiscalCard em /orcamento/[id]). Cada gráfica traz
// sua PRÓPRIA conta na Focus NFe (não uma conta compartilhada do grafica-saas):
// o token abaixo é o dela, e o site nunca armazena/manuseia certificado digital
// — isso fica inteiramente do lado da Focus NFe.
//
// A API da Focus NFe exige os dados do emitente (CNPJ, razão social, endereço)
// em TODA chamada de emissão — não fica pré-configurado na conta deles, por
// isso precisamos guardar aqui também (confirmado no exemplo oficial da API).
model DadosFiscaisGrafica {
  id        String @id @default(cuid())
  graficaId String @unique

  focusNfeToken String? // token da CONTA DELES na Focus NFe — nunca uma conta nossa
  ambiente      String  @default("homologacao") // homologacao | producao — nasce em homologação por segurança

  cnpj              String?
  razaoSocial       String?
  nomeFantasia      String?
  inscricaoEstadual String?
  regimeTributario  RegimeTributario @default(SIMPLES_NACIONAL) // decide CSOSN (Simples) vs CST+ICMS (Normal) na emissão — ver src/lib/nota-fiscal.ts

  enderecoCep        String?
  enderecoLogradouro String?
  enderecoNumero     String?
  enderecoBairro     String?
  enderecoMunicipio  String?
  enderecoUf         String?

  naturezaOperacaoPadrao  String @default("Venda de mercadoria")
  cfopPadrao              String @default("5102") // venda dentro do estado, mercadoria de terceiros
  cfopPadraoInterestadual String @default("6102") // venda interestadual (UF do cliente != UF da gráfica) pra cliente CONTRIBUINTE de ICMS, mercadoria de terceiros — ver resolverCfop em src/lib/nota-fiscal.ts. Cliente não-contribuinte/isento (Cliente.indicadorInscricaoEstadual) usa 6108 fixo, não este campo — achado N7 em pesquisa-abrangencia-modulos.md
  csosnPadrao             String @default("102") // Simples Nacional, tributada sem permissão de crédito — só lido/enviado quando regimeTributario=SIMPLES_NACIONAL

  // Só relevantes/obrigatórios (validado na Server Action, não CHECK no
  // banco — mesmo padrão do resto do arquivo) quando regimeTributario !=
  // SIMPLES_NACIONAL. Tabelas de código: ver src/lib/nota-fiscal-tabelas.ts.
  cstIcmsPadrao                     String? // tabela CST-ICMS (00,10,20...), diferente de CSOSN
  icmsAliquotaPadrao                Decimal? @db.Decimal(5, 2) // % — ex: 18.00
  icmsModalidadeBaseCalculoPadrao   String? // tabela 0-3
  pisCofinsSituacaoTributariaPadrao String? // PIS e COFINS compartilham a mesma tabela de código

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@map("dados_fiscais_grafica")
}

// Cadastro fiscal completo e independente de uma FILIAL com CNPJ próprio —
// espelha DadosFiscaisGrafica campo a campo de propósito (cada CNPJ é um
// contribuinte separado perante a Focus NFe/SEFAZ, precisa do próprio
// token/cadastro lá, não dá pra "herdar" o da matriz). Opcional: uma filial
// sem linha aqui continua emitindo com os dados da gráfica (comportamento de
// sempre, sem mudança) — ver resolverDadosFiscais em src/lib/nota-fiscal.ts,
// único ponto que decide qual dos dois usar. Modelo separado (não um
// filialId nullable dentro de DadosFiscaisGrafica) de propósito: evita
// problema de unicidade parcial (Postgres trata NULL como sempre distinto em
// @@unique, então não daria pra garantir "no máximo 1 linha-padrão da
// gráfica" só com filialId opcional na mesma tabela) e mantém o caminho
// gráfica-level 100% intocado — decisão de 2026-08-16, pedido de negócio
// ainda sem caso real (nenhuma gráfica cliente tem filial com CNPJ próprio
// hoje), construído preventivamente.
model DadosFiscaisFilial {
  id       String @id @default(cuid())
  filialId String @unique

  focusNfeToken String?
  ambiente      String  @default("homologacao")

  cnpj              String?
  razaoSocial       String?
  nomeFantasia      String?
  inscricaoEstadual String?
  regimeTributario  RegimeTributario @default(SIMPLES_NACIONAL)

  enderecoCep        String?
  enderecoLogradouro String?
  enderecoNumero     String?
  enderecoBairro     String?
  enderecoMunicipio  String?
  enderecoUf         String?

  naturezaOperacaoPadrao  String @default("Venda de mercadoria")
  cfopPadrao              String @default("5102")
  cfopPadraoInterestadual String @default("6102") // ver comentário do campo espelho em DadosFiscaisGrafica
  csosnPadrao             String @default("102")

  // Espelha DadosFiscaisGrafica campo a campo — ver comentário lá.
  cstIcmsPadrao                     String?
  icmsAliquotaPadrao                Decimal? @db.Decimal(5, 2)
  icmsModalidadeBaseCalculoPadrao   String?
  pisCofinsSituacaoTributariaPadrao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  filial Filial @relation(fields: [filialId], references: [id], onDelete: Cascade)

  @@map("dados_fiscais_filial")
}

// Fechado, sem OUTRO: não existe um 4º regime real pra CNPJ emitir NF-e.
enum RegimeTributario {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum StatusNotaFiscal {
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
  ERRO
}

// Uma nota fiscal emitida (ou em processamento) pra um orçamento aprovado.
// 1:1 com Orcamento — mesmo padrão de Pedido. `referencia` é a chave que
// mandamos pra Focus NFe pra identificar essa emissão (idempotência do lado
// deles); `chaveAcesso` só existe depois de AUTORIZADA.
model NotaFiscal {
  id           String           @id @default(cuid())
  graficaId    String
  orcamentoId  String           @unique
  referencia   String           @unique
  status       StatusNotaFiscal @default(PROCESSANDO)
  numero       String?
  serie        String?
  chaveAcesso  String?
  xmlUrl       String?
  danfeUrl     String?
  mensagemErro String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  grafica   Grafica   @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id])

  @@index([graficaId])
  @@map("notas_fiscais")
}

// Webhook n8n (ou qualquer outro) que a PRÓPRIA gráfica configura pra
// receber eventos do hub de automação (pedido_status_mudou, estoque_critico,
// pedido_atrasado — ver src/lib/webhook-automacao.ts), mesmo padrão "bring
// your own account" de DadosFiscaisGrafica. Diferente do assistente de IA
// (ASSISTENTE_WEBHOOK_URL, env var única da plataforma) — automação é
// legitimamente por tenant, cada gráfica quer notificação só dos próprios
// pedidos.
model AutomacaoGrafica {
  id        String @id @default(cuid())
  graficaId String @unique

  // URL do workflow n8n do PRÓPRIO tenant — o path costuma carregar um UUID
  // que funciona como token de capability (padrão de webhook do n8n), por
  // isso é tratada como segredo (nunca reexibida por completo, ver
  // /configuracoes/automacao).
  webhookUrl String?

  // Liga/desliga cada tipo de evento individualmente — antes dos três
  // disparavam sempre juntos assim que webhookUrl estava configurado. Uma
  // gráfica que não controla estoque no sistema não quer estoque_critico
  // poluindo o workflow; outra quer só pedido_atrasado. Default true em
  // todos preserva o comportamento de hoje pra quem já tem webhook configurado.
  notificarStatusMudou    Boolean @default(true)
  notificarEstoqueCritico Boolean @default(true)
  notificarPedidoAtrasado Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@map("automacao_grafica")
}

enum StatusAssinatura {
  TRIALING
  ATIVA
  INADIMPLENTE // past_due no Stripe: pagamento falhou mas a assinatura ainda não cancelou
  CANCELADA
}

// Cobrança da PLATAFORMA sobre a gráfica (assinatura do SaaS) — diferente do
// padrão "bring your own account" usado por DadosFiscaisGrafica (onde a
// credencial é da própria gráfica): aqui a conta Stripe é NOSSA, do
// dono do grafica-saas. Guarda só o status derivado + IDs de referência — o
// Stripe é a fonte de verdade do dinheiro, isto aqui é um cache local pro
// gate de acesso (src/lib/auth/assinatura.ts) não precisar chamar a API do
// Stripe em toda página. A única escrita em `status` depois da criação vem
// do webhook (src/app/api/webhooks/stripe/route.ts), nunca de uma Server
// Action comum.
model AssinaturaGrafica {
  id        String @id @default(cuid())
  graficaId String @unique

  status StatusAssinatura @default(TRIALING)

  // true = acesso concedido via /admin/graficas (super admin), não uma
  // assinatura Stripe real. status continua "ATIVA" (mesmo campo que já
  // libera acesso, ver assinaturaEstaLiberada) — este campo só diferencia
  // "grátis de propósito" de "pagante de verdade" em relatórios/UI, nunca
  // influencia o gate de acesso em si.
  cortesia Boolean @default(false)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  trialExpiraEm        DateTime?
  periodoAtualExpiraEm DateTime? // current_period_end do Stripe, pra exibir "próxima cobrança em"
  canceladaEm          DateTime?

  // Início da janela de 15 dias de tolerância depois de ultrapassar o teto
  // de uso do plano (orçamentos/mês ou usuários) — null = dentro do limite
  // hoje. Ver src/lib/billing/limite-uso.ts.
  limiteExcedidoDesde DateTime?

  // Início da janela de carência de INADIMPLENTE (2 meses, ver
  // DIAS_CARENCIA_INADIMPLENCIA em src/lib/billing/status.ts) — decisão de
  // produto de 2026-08-15: bloquear acesso na primeira falha de cobrança do
  // Stripe é agressivo demais (cartão vencido por um dia, banco recusando
  // por engano). Setado por sincronizarSubscription quando o status
  // TRANSICIONA pra INADIMPLENTE (nunca resetado por resyncs subsequentes
  // enquanto continuar INADIMPLENTE); voltado a null assim que sai desse
  // status (ATIVA ou CANCELADA). null = nunca entrou em INADIMPLENTE, ou já
  // saiu.
  inadimplenteDesde DateTime?

  // Quando o e-mail de "seu trial está quase acabando" foi disparado (ver
  // src/app/api/cron/lifecycle/route.ts, cron diário) — idempotência pra
  // não mandar o aviso duas vezes. null = ainda não enviado. Fica null pra
  // sempre em gráficas que nunca chegam a 2 dias do fim do trial (ex:
  // assinam antes) ou que não estão em TRIALING.
  avisoTrialEnviadoEm DateTime?

  // Reserva atômica contra checkout duplicado: iniciarCheckout só cria uma
  // Stripe Checkout Session se conseguir gravar este timestamp via updateMany
  // condicionado (nenhuma reserva viva no momento) — duas requisições
  // concorrentes (duas abas, duplo clique) nunca passam as duas, porque a
  // segunda vê o timestamp que a primeira acabou de gravar e falha a
  // condição. null = sem checkout em andamento. Ver src/app/configuracoes/assinatura/actions.ts.
  checkoutIniciadoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@map("assinatura_grafica")
}

// Registro de cada pergunta enviada ao assistente — existe só pra rate limiting
// (mesmo padrão de TentativaLogin: conta linhas numa janela de tempo). NÃO
// guarda o texto da pergunta: não precisa pra esse propósito, e menos dado
// guardado é menos dado pra vazar. Protege contra spam/gasto de token do n8n
// da própria gráfica, tanto de um usuário sozinho quanto da gráfica toda.
model PerguntaAssistenteLog {
  id        String   @id @default(cuid())
  graficaId String
  usuarioId String
  createdAt DateTime @default(now())

  @@index([usuarioId, createdAt])
  @@index([graficaId, createdAt])
  @@map("pergunta_assistente_log")
}

enum PapelUsuario {
  DONO
  ADMIN
  OPERADOR
}

model Usuario {
  id        String       @id @default(cuid())
  graficaId String
  nome      String
  email     String       @unique
  senhaHash String
  papel     PapelUsuario @default(OPERADOR)
  createdAt DateTime     @default(now())

  // Concedido individualmente pelo DONO em /usuarios. Só tem efeito se
  // Grafica.compartilharMeuNegocio também estiver ligado — ver podeVerMeuNegocio.
  // Irrelevante pra DONO, que sempre tem acesso.
  acessoMeuNegocio Boolean @default(false)

  // null = ainda não confirmou o código de 6 dígitos enviado no cadastro
  // (ver exigirEmailVerificado). Só se aplica a quem se cadastra sozinho
  // via /registro — usuário convidado em /usuarios já nasce com isso
  // preenchido (confiança transitiva: quem convida já provou a própria
  // identidade). Contas anteriores a esta feature foram "perdoadas" na
  // migração (emailVerificadoEm = createdAt).
  emailVerificadoEm DateTime?

  // Acesso cross-tenant a /admin/graficas (conceder/revogar cortesia) — não
  // tem relação com `papel` (DONO/ADMIN/OPERADOR), que é sempre escopado à
  // própria gráfica. Só true pro dono da plataforma. Nunca exposto/editável
  // por nenhuma tela — só setado direto no banco (bootstrap único).
  superAdmin Boolean @default(false)

  // null = este usuário não recebe comissão (não é vendedor). Taxa pessoal,
  // independente do papel — DONO/ADMIN/OPERADOR podem todos vender. Ver
  // model Comissao e ParametrosGrafica.comissaoVendedorBase.
  comissaoPercent Decimal? @db.Decimal(5, 4)

  // null = ativo. Preenchido = funcionário removido da gráfica: perde acesso
  // NA HORA (exigirUsuarioAutenticado recusa, e as sessões são apagadas junto
  // no momento da remoção), some das listas e para de receber e-mail de etapa.
  //
  // Desativa em vez de apagar de propósito: Orcamento.usuarioId,
  // Comissao.usuarioId e LogAuditoria.usuarioId apontam pra cá. Apagar o
  // cadastro ou faria a exclusão falhar, ou deixaria o histórico órfão — e o
  // log de auditoria ficaria cego justamente sobre quem saiu da empresa, que
  // é quando mais se precisa dele. Comissão pendente continua devida e
  // pagável depois da remoção.
  //
  // É data (não boolean) porque "quando saiu" é a pergunta que aparece junto
  // com "quem fez isso" numa investigação. Reversível: voltar pra null
  // reativa.
  desativadoEm DateTime?

  // Achado A5 da auditoria de abrangência (Parte 6/Configurações,
  // pesquisa-abrangencia-modulos.md, 2026-08-27) — perfil reutilizável de
  // permissão por módulo, pra não configurar OPERADOR por OPERADOR quando
  // vários fazem a mesma função (ex: 3 de acabamento no mesmo turno). Só tem
  // efeito pra papel OPERADOR (mesma restrição de PermissaoUsuario) e só é
  // CONSULTADO quando não existe override individual em PermissaoUsuario pro
  // módulo em questão — ver resolverPermissaoOperador em
  // src/lib/auth/permissoes.ts pra ordem exata de resolução. null = sem
  // perfil atribuído, comportamento 100% igual ao de hoje (só PermissaoUsuario
  // individual, ausência = sem acesso). onDelete: SetNull (não Restrict nem
  // Cascade): apagar um PerfilAcesso nunca pode apagar usuário nem travar a
  // exclusão do perfil — o usuário só volta a depender exclusivamente de
  // PermissaoUsuario individual, o fallback mais seguro.
  perfilAcessoId String?

  grafica                       Grafica                     @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  perfilAcesso                  PerfilAcesso?               @relation(fields: [perfilAcessoId], references: [id], onDelete: SetNull)
  orcamentos                    Orcamento[]
  sessoes                       Sessao[]
  permissoes                    PermissaoUsuario[]
  tokensResetSenha              TokenResetSenha[]
  tokensVerificacaoEmail        TokenVerificacaoEmail[]
  comissoes                     Comissao[]
  responsaveisEstagio           ResponsavelEstagio[]
  responsaveisAdministrativo    ResponsavelAdministrativo[]
  solicitacoesCompraFeitas      SolicitacaoCompra[]         @relation("SolicitacoesCompraSolicitadas")
  solicitacoesCompraAprovadas   SolicitacaoCompra[]         @relation("SolicitacoesCompraAprovadas")
  // Achado A8 da auditoria de abrangência — ver Cliente.vendedorId.
  clientesVendedor              Cliente[]
  // Achado A4 da auditoria de abrangência (Parte 3/Compras) — ver model
  // CotacaoFornecedor.
  cotacoesFornecedorRegistradas CotacaoFornecedor[]

  @@index([graficaId])
  @@index([perfilAcessoId])
  @@map("usuarios")
}

// Só existe controle granular por módulo pra papel OPERADOR — DONO e ADMIN
// sempre têm acesso total, não passam por aqui (ver podeVerModulo/
// podeEditarModulo em src/lib/auth/permissoes.ts). Ausência de linha pra um
// módulo = sem acesso nenhum (nem ver), é o padrão mais seguro por omissão.
enum ModuloPermissao {
  ORCAMENTO
  CLIENTES
  CATALOGO
  PRODUCAO
  FINANCEIRO
  CONFIGURACOES
  // Lançar custo real de pedido (podeEditar) e ver lucro/margem (podeVer) —
  // separado de PRODUCAO de propósito: um operador de chão de fábrica pode
  // precisar lançar retrabalho sem enxergar o P&L do pedido (ver fase
  // "custo real", fase-custo-real.md §2.6).
  CUSTOS
  // Módulo de COMPRAS (SolicitacaoCompra) — separado de PRODUCAO/CATALOGO de
  // propósito: quem compra matéria-prima nem sempre é quem opera a produção
  // ou mexe no catálogo.
  COMPRAS
}

model PermissaoUsuario {
  id         String          @id @default(cuid())
  usuarioId  String
  modulo     ModuloPermissao
  podeVer    Boolean         @default(false)
  podeEditar Boolean         @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, modulo])
  @@map("permissoes_usuario")
}

// Achado A5 da auditoria de abrangência (Parte 6/Configurações,
// pesquisa-abrangencia-modulos.md, 2026-08-27) — perfil de acesso reutilizável
// ("Impressor", "Acabamento", "Vendedor externo"): em vez de configurar
// PermissaoUsuario módulo por módulo pra cada OPERADOR novo, o DONO monta o
// perfil uma vez e atribui a quantos usuários quiser (Usuario.perfilAcessoId).
// Aditivo de propósito — PermissaoUsuario continua existindo do jeito que
// está e continua vencendo o perfil quando as duas coexistem pro mesmo
// usuário+módulo (override individual, ver resolverPermissaoOperador em
// src/lib/auth/permissoes.ts). Só se aplica a OPERADOR, igual PermissaoUsuario
// — DONO/ADMIN nunca consultam nem esta tabela nem a de override individual.
model PerfilAcesso {
  id        String @id @default(cuid())
  graficaId String
  nome      String // "Impressor", "Acabamento", "Vendedor externo"

  grafica     Grafica            @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  permissoes  PermissaoPerfil[]
  // Usuários que têm este perfil atribuído (Usuario.perfilAcessoId) — usado
  // pra avisar/bloquear a exclusão do perfil quando ainda está em uso, e pra
  // listar "quem usa este perfil" na tela de detalhe.
  usuarios    Usuario[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("perfis_acesso")
}

model PermissaoPerfil {
  id         String          @id @default(cuid())
  perfilId   String
  modulo     ModuloPermissao
  podeVer    Boolean         @default(false)
  podeEditar Boolean         @default(false)

  perfil PerfilAcesso @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@unique([perfilId, modulo])
  @@map("permissoes_perfil")
}

// Achado A4 da Parte 6 da auditoria de abrangência (Configurações,
// pesquisa-abrangencia-modulos.md, 2026-09-02) — hoje duas travas de
// autorização por VALOR eram fixas em código: desconto de orçamento acima de
// ParametrosGrafica.descontoMaxSemAprovacao só DONO/ADMIN aprova (limite
// único pra gráfica inteira), e aprovação de SolicitacaoCompra não tinha
// teto de valor nenhum — quem tem permissão de COMPRAS aprova R$ 50 ou
// R$ 50.000 igual. Este model dá um teto CONFIGURÁVEL por papel ou por
// usuário específico pras duas travas, sem exigir aprovação em múltiplos
// níveis encadeados (fora de escopo de propósito — 1 nível + 1 teto resolve
// o porte do cliente-alvo, gráfica de 5 a 30 pessoas).
enum TipoAlcada {
  DESCONTO_ORCAMENTO // limite em % de desconto (ver resolverLimiteDesconto)
  APROVACAO_COMPRA // limite em R$ da solicitação de compra (ver resolverLimiteAprovacaoCompra)
}

model AlcadaAprovacao {
  id        String     @id @default(cuid())
  graficaId String
  tipo      TipoAlcada

  // Alvo: por PAPEL (cobre a gráfica inteira em poucas linhas) ou por
  // USUÁRIO específico (exceção pontual, ex: um vendedor sênior com alçada
  // maior que o resto do papel OPERADOR). Exatamente um dos dois preenchido
  // — validado na action, mesmo padrão de "exatamente um preenchido" que
  // RegistroManutencao já usa pras 5 FKs de máquina (ver
  // validarSelecaoMaquina em src/lib/manutencao-maquina.ts), aqui sem FK de
  // banco pro papel (é um enum, não uma tabela). usuarioId sem FK formal de
  // propósito, mesmo espírito de RegistroManutencao.registradoPorId —
  // resolvido em código, nunca precisa sobreviver à remoção de um usuário
  // (uma alçada de usuário removido simplesmente para de bater com ninguém).
  papel     PapelUsuario?
  usuarioId String?

  // % em DESCONTO_ORCAMENTO (0-100), R$ em APROVACAO_COMPRA — resolução em
  // src/lib/alcada-aprovacao.ts (resolverLimiteDesconto/
  // resolverLimiteAprovacaoCompra): alçada do usuário > alçada do papel >
  // comportamento de hoje (fallback sem esta tabela configurada).
  limite Decimal @db.Decimal(12, 2)

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@index([graficaId, tipo])
  @@map("alcadas_aprovacao")
}

// Sessão opaca: o cookie do usuário guarda só o token bruto, nunca persistido em texto puro aqui.
// Guardar apenas o hash do token faz um vazamento do banco não virar sessões utilizáveis,
// e apagar a linha revoga a sessão imediatamente (logout, troca de senha, etc).
model Sessao {
  id        String   @id @default(cuid())
  usuarioId String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  criadaEm  DateTime @default(now())
  expiraEm  DateTime

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sessoes")
}

// Mesma filosofia de Sessao: guarda só o HASH do token de reset, nunca o
// valor bruto — vazamento do banco não vira link de redefinição de senha
// utilizável. usadoEm torna o token de uso único mesmo dentro da janela
// de validade (1h, ver src/lib/auth/token-reset.ts).
model TokenResetSenha {
  id        String    @id @default(cuid())
  usuarioId String
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_reset_senha")
}

// Mesma filosofia de TokenResetSenha: guarda só o HASH do código (nunca o
// valor bruto de 6 dígitos), usadoEm torna de uso único. tentativas conta
// palpites errados NESTE código especificamente — ao chegar no limite
// (ver LIMITE_TENTATIVAS em src/lib/auth/verificacao-email.ts), o código
// vira inválido mesmo dentro da janela de expiração, forçando reenvio.
// Proteção extra necessária porque 6 dígitos é um espaço bem menor (1 em
// 1.000.000) que o token de 256 bits do reset de senha.
model TokenVerificacaoEmail {
  id         String    @id @default(cuid())
  usuarioId  String
  codigoHash String
  expiraEm   DateTime
  usadoEm    DateTime?
  tentativas Int       @default(0)
  createdAt  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_verificacao_email")
}

// Registro de tentativas de login (sucesso e falha) para permitir bloqueio temporário
// por e-mail e por IP contra ataques de força bruta, sobrevivendo a reinícios do servidor.
model TentativaLogin {
  id        String   @id @default(cuid())
  email     String
  ip        String
  sucesso   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("tentativas_login")
}

// Conta tentativas de cadastro (/registro) por IP — sem isso, um bot pode criar
// gráficas/usuários sem limite (spam de dados + custo de CPU do hash argon2id
// a cada tentativa, já que ele só é evitado quando o e-mail já existe).
model TentativaRegistro {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@map("tentativas_registro")
}

// Conta tentativas de pedido de reset de senha, por e-mail E por IP —
// evita spam de e-mail pro mesmo destinatário e limita um atacante
// disparando pedidos pra vários e-mails (mesmo padrão de TentativaLogin).
model TentativaResetSenha {
  id        String   @id @default(cuid())
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("tentativas_reset_senha")
}

// Mesmo padrão de TentativaResetSenha, por pedidoId em vez de e-mail —
// responderArtePublica (src/app/a/[token]/actions.ts) é uma Server Action
// sem autenticação (o token É a credencial), e o branch de "pedir alteração"
// não é idempotente por natureza (diferente de "aprovar", que trava sozinho
// em arteAprovadaEm): cada chamada dispara um e-mail novo pro(s) DONO(s) da
// gráfica. Sem este limite, quem tiver o link (ele circula por WhatsApp,
// fica no histórico do cliente) podia martelar a action e encher a caixa de
// entrada do dono — ou, na escala errada, estourar a cota diária de envio do
// Gmail/Workspace do EMAIL_WEBHOOK_URL, que é compartilhado com reset de
// senha e verificação de e-mail de TODOS os tenants (achado da auditoria de
// 2026-07-26). Limita por pedidoId (o alvo real do abuso, não muda trocando
// de IP) e por IP (limita quem tenta abusar de vários pedidos).
model TentativaRespostaArte {
  id        String   @id @default(cuid())
  pedidoId  String
  ip        String
  createdAt DateTime @default(now())

  @@index([pedidoId, createdAt])
  @@index([ip, createdAt])
  @@map("tentativas_resposta_arte")
}

// Mesmo padrão de TentativaResetSenha, só que por usuarioId em vez de
// email (usuário já está autenticado nesse ponto do fluxo, não precisa
// aceitar e-mail cru) — limita quantos códigos NOVOS podem ser pedidos,
// não quantos palpites (isso é TokenVerificacaoEmail.tentativas). As duas
// defesas juntas: no máximo LIMITE_VERIFICACAO_EMAIL_POR_USUARIO códigos
// por janela, cada um valendo só 5 palpites.
model TentativaVerificacaoEmail {
  id        String   @id @default(cuid())
  usuarioId String
  ip        String
  createdAt DateTime @default(now())

  @@index([usuarioId, createdAt])
  @@index([ip, createdAt])
  @@map("tentativas_verificacao_email")
}

model Cliente {
  id        String   @id @default(cuid())
  graficaId String
  nome      String
  email     String?
  telefone  String?
  documento String? // CPF ou CNPJ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // null = ativo. Preenchido = cliente desativado: some das listas e dos
  // dropdowns de seleção (orçamento, produção, relatórios), mas o histórico
  // (Orcamento, NotaFiscal) continua intacto — não é hard delete.
  //
  // Mesmo precedente de Usuario.desativadoEm: é data (não boolean) porque
  // "quando saiu" é a pergunta que aparece junto com "quem fez isso" numa
  // investigação. Reversível: voltar pra null reativa.
  //
  // Para o pedido de exclusão de dado pessoal (LGPD), ver anonimizarCliente
  // em src/app/clientes/actions.ts — que também preenche este campo, mas
  // além disso sobrescreve nome/documento/contatos, porque desativar sozinho
  // não atende ao direito de eliminação do titular.
  desativadoEm DateTime?

  // Conceito distinto de desativado: o cliente existe e continua sendo
  // atendido, só que só à vista (ou outra restrição comercial) — normalmente
  // por inadimplência. Não confundir com AssinaturaGrafica.inadimplenteDesde,
  // que é sobre a GRÁFICA dever ao GrafPro, não sobre o cliente dela.
  //
  // Hoje é só um aviso não-bloqueante na aprovação do orçamento
  // (atualizarStatusOrcamento) — não impede a venda, só avisa quem aprova.
  bloqueadoParaVenda Boolean @default(false)
  motivoBloqueio     String?

  // Achado A6 da Parte 4 da auditoria de abrangência (2026-08-27) — controle
  // de crédito, DIFERENTE de bloqueadoParaVenda acima: aquele é uma decisão
  // MANUAL do dono ("só à vista"); isto aqui é estouro de limite detectado
  // AUTOMATICAMENTE pelo sistema (soma de ContaReceber pendente/vencida do
  // cliente + o orçamento sendo aprovado, ver calcularExposicaoCreditoCliente
  // em src/lib/credito-cliente.ts) comparado contra um teto configurável.
  // Deliberadamente NÃO reaproveita bloqueadoParaVenda: são causas
  // independentes (um cliente pode estourar o limite sem nunca ter sido
  // bloqueado manualmente, e vice-versa) — mas os DOIS avisos são
  // compostos num único `aviso` na resposta de atualizarStatusOrcamento, sem
  // precisar de um segundo campo no resultado.
  //
  // null = sem limite configurado (comportamento de hoje, sem regressão).
  limiteCredito Decimal? @db.Decimal(12, 2)

  // Puramente informativo por enquanto — nenhum motor lê isto ainda (não
  // existe ainda o conceito de vencimento previsto de um orçamento não
  // aprovado). Existe pra a gráfica já cadastrar a condição comercial
  // combinada com o cliente, pronta pra quando um fluxo futuro precisar dela
  // (ex: sugerir parcelas de ContaReceber na aprovação).
  prazoPagamentoPadraoDias Int?

  // Espelha bloqueadoParaVenda/motivoBloqueio acima em FORMATO (boolean +
  // motivo em texto livre, mesmo aviso não-bloqueante na aprovação), mas é
  // outra causa: "faturamento" aqui é a decisão de travar NOVAS vendas a
  // prazo por decisão comercial explícita ligada a crédito/cobrança
  // (ex: fatura em atraso há muito tempo), enquanto bloqueadoParaVenda cobre
  // qualquer motivo comercial mais amplo ("só à vista" por request do
  // cliente, briga comercial, etc.) — a gráfica pode usar só um dos dois,
  // ou os dois ao mesmo tempo, sem conflito.
  bloqueadoParaFaturamento  Boolean @default(false)
  motivoBloqueioFaturamento String?

  // Achado A6 da Parte 5 da auditoria de abrangência (2026-08-28) — completa
  // o achado A6 da Parte 4 acima (limiteCredito/prazoPagamentoPadraoDias, já
  // existentes): faltava como o cliente PAGA, não só quanto/quando. Mesmo
  // padrão null=comportamento de hoje dos campos acima.
  //
  // Reusa o enum FormaPagamento que já existe em Pagamento.forma — zero
  // conceito novo. Sem *Outro de escape (diferente de origem/segmento): é só
  // um valor sugerido pra pré-preencher (ver condicoesPagamento no
  // orçamento), nunca gravado como valor final em nenhum lugar, então não
  // precisa do mesmo rigor de um dado fiscal/enum estruturado.
  formaPagamentoPreferida FormaPagamento?

  // Fração 0-1 (mesma representação de margemPadraoOverride abaixo, nunca
  // 0-100) — desconto negociado que costuma valer pra este cliente. Só uma
  // SUGESTÃO de preenchimento (ver defaultValue em DescontoItemForm.tsx):
  // quem aplica ainda passa pela mesma trava de
  // ParametrosGrafica.descontoMaxSemAprovacao no momento de aplicar (ver
  // aplicarDescontoItemOrcamento), então guardar aqui um valor acima do
  // limite não é uma brecha de aprovação — só adianta o preenchimento.
  descontoPadraoPercent Decimal? @db.Decimal(5, 4)

  // Nota financeira livre (ex: "só paga com nota + boleto, portal da
  // prefeitura"). Deliberadamente separado de `observacoes` abaixo (nota
  // comercial genérica de atendimento): este campo é especificamente sobre
  // COMO cobrar este cliente — mesmo precedente de preferenciasProducao ser
  // separado de observacoes por AUDIÊNCIA (produção vs. comercial), aqui é
  // financeiro vs. comercial.
  observacaoFinanceira String? @db.Text

  // Endereço — opcional pra cadastro comum, mas exigido pra emitir nota fiscal
  // (ver DadosFiscaisGrafica / NotaFiscal). enderecoCodigoIbge é nullable e não
  // bloqueia emissão: o exemplo oficial da Focus NFe envia só município+UF.
  enderecoCep         String?
  enderecoLogradouro  String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoMunicipio   String?
  enderecoCodigoIbge  String?
  enderecoUf          String?

  // Achado A11 da auditoria de abrangência (pesquisa-abrangencia-modulos.md)
  // — até aqui Cliente era o único model do domínio comercial sem nenhum
  // campo de texto livre (Orcamento/Pedido/Entrega/Despesa já têm). Nota
  // interna — nunca exposta em PDF nem no link público de orçamento (mesma
  // regra já documentada em Orcamento.observacoes acima), só na tela
  // autenticada da gráfica.
  observacoes String? @db.Text

  // Deliberadamente separado de `observacoes`: isto é o que precisa chegar
  // até o chão de fábrica junto da Ordem de Produção (ver
  // src/app/producao/[pedidoId]/ordem-producao/route.tsx) — ex: "sempre
  // mandar arte em RGB", "não aceita variação de tom entre lotes", "só
  // recebe às terças". `observacoes` é nota comercial interna e nunca sai
  // da tela da gráfica; este campo é operacional e aparece no documento
  // impresso que o produtor lê.
  preferenciasProducao String? @db.Text

  // De onde o cliente veio — mede qual canal traz cliente que fecha (achado
  // A11). Lista fechada com OUTRO de escape (mesmo padrão de
  // UnidadeMedida/CategoriaEquipamento/etc. no resto do schema).
  // origemOutro só é preenchido quando origem=OUTRO.
  origem      OrigemCliente?
  origemOutro String?

  // Achado A7 da auditoria de abrangência (pesquisa-abrangencia-modulos.md)
  // — "Nível 1": não existe segmento de cliente nem forma de dar margem
  // diferenciada pra revenda/agência. O motor de precificação já tinha o
  // gancho pronto e dormente (ContextoPrecificacao.margemLucroOverride, ver
  // src/lib/pricing/precificar.ts) — estes 2 campos são só o cadastro que
  // alimenta esse gancho via src/lib/orcamento-precificacao.ts. Mesmo padrão
  // enum-fechado+OUTRO de origem/origemOutro acima. segmentoOutro só é
  // preenchido quando segmento=OUTRO.
  segmento      SegmentoCliente?
  segmentoOutro String?

  // Sobrescreve ParametrosGrafica.margemPadrao só pra ESTE cliente — mesma
  // representação (fração 0-1, ex: 0.15 = 15%, nunca 0-100) e mesma precisão
  // de ParametrosGrafica.margemPadrao (schema ~L115). null = motor usa o
  // padrão da gráfica (comportamento de hoje, sem regressão). Independente
  // de `segmento`: dá pra ter margem diferenciada sem categorizar o cliente,
  // e vice-versa.
  margemPadraoOverride Decimal? @db.Decimal(5, 4)

  // Achado A8 da auditoria de abrangência — vendedor/responsável comercial
  // do cliente, distinto de Orcamento.usuarioId (quem DIGITOU o orçamento no
  // sistema). Nullable: maioria das gráficas pequenas não faz essa
  // distinção (comportamento de hoje, sem regressão). SetNull: vendedor
  // desligado não pode travar a exclusão do cadastro do usuário nem do
  // cliente, só perde a atribuição — mesmo padrão de Orcamento.duplicadoDeId.
  // Só afeta Comissao.usuarioId quando
  // ParametrosGrafica.comissaoSegueVendedorDoCliente está ligada (default
  // false).
  vendedorId String?

  // Achado A1 da auditoria de abrangência (pesquisa-abrangencia-modulos.md,
  // Parte 5) — distinção Pessoa Física × Pessoa Jurídica, base pra razão
  // social/IE na emissão de NF-e (ver src/lib/focus-nfe.ts e
  // verificarProntidaoFiscal em src/lib/nota-fiscal.ts). null = cadastro
  // anterior a este campo, sem mudança de comportamento na emissão.
  tipoPessoa TipoPessoa?

  // `nome` continua sendo o rótulo de uso interno (nunca migrado/apagado) —
  // a emissão fiscal passa a preferir `razaoSocial ?? nome`, porque nome
  // fantasia não tem validade jurídica pra nota fiscal. razaoSocial/
  // nomeFantasia só fazem sentido pra JURIDICA, mas não são bloqueados no
  // banco pra FISICA (validado na tela/action, não aqui).
  razaoSocial  String?
  nomeFantasia String?

  // IE só é exigida quando indicadorInscricaoEstadual=CONTRIBUINTE (rejeição
  // SEFAZ 728 se faltar) e NUNCA pode vir preenchida quando ISENTO (rejeição
  // 791) — ver verificarProntidaoFiscal e a montagem do payload em
  // src/lib/focus-nfe.ts. null = cadastro antigo, emissão cai no
  // comportamento de sempre (não manda nenhum dos dois campos).
  inscricaoEstadual          String?
  indicadorInscricaoEstadual IndicadorInscricaoEstadual?

  // Campo do TOMADOR que qualquer NFS-e municipal pede — barato guardar
  // agora mesmo sem uso imediato (o GrafPro só emite NF-e hoje, ver achado
  // A3 da mesma Parte da auditoria).
  inscricaoMunicipal String?

  grafica        Grafica          @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  vendedor       Usuario?         @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  orcamentos     Orcamento[]
  creditoCliente CreditoCliente?
  // Achado A4 da Parte 5 da auditoria de abrangência — ver ContatoCliente
  // mais abaixo no schema.
  contatos       ContatoCliente[]
  // Achado A5 da Parte 5 da auditoria de abrangência — ver EnderecoCliente
  // mais abaixo no schema.
  enderecos      EnderecoCliente[]
  // Achado A10 da Parte 5 da auditoria de abrangência — ver ContaReceber.clienteId.
  contasReceber  ContaReceber[]
  // Achado F1 da Parte 7 da auditoria de abrangência — ferramental (faca,
  // clichê...) de propriedade deste cliente, ver model Ferramental.
  ferramentais   Ferramental[]

  // NULL não colide com NULL em unique index do Postgres — várias gráficas
  // podem ter clientes sem documento cadastrado sem problema. Escopado por
  // graficaId (não global) porque CPF/CNPJ é único no mundo real, mas nada
  // impede duas gráficas diferentes atenderem o mesmo cliente.
  @@unique([graficaId, documento])
  @@index([graficaId])
  @@index([vendedorId])
  @@map("clientes")
}

// Canal de aquisição do cliente (achado A11 da auditoria de abrangência) —
// mesmo padrão enum-fechado+OUTRO do resto do schema. CLIENTE_ANTIGO é
// distinto de INDICACAO: cliente que já comprou antes e voltou por conta
// própria, sem ninguém ter indicado.
enum OrigemCliente {
  INDICACAO
  REDES_SOCIAIS
  BUSCA_GOOGLE
  ANUNCIO
  FEIRA_EVENTO
  PROSPECCAO_ATIVA
  CLIENTE_ANTIGO
  OUTRO
}

// Segmento comercial do cliente (achado A7 da auditoria de abrangência,
// "Nível 1") — mesmo padrão enum-fechado+OUTRO do resto do schema.
// REVENDA_AGENCIA é o caso que motivou o achado: existem gráficas que só
// atendem revenda/agência, com margem bem menor que venda direta ao
// consumidor final (VAREJO). INDUSTRIA e ORGAO_PUBLICO são segmentos com
// dinâmica de compra própria (grandes volumes recorrentes / licitação),
// distintos de EMPRESA genérica.
enum SegmentoCliente {
  VAREJO
  EMPRESA
  REVENDA_AGENCIA
  INDUSTRIA
  ORGAO_PUBLICO
  OUTRO
}

// Achado A1 da auditoria de abrangência (pesquisa-abrangencia-modulos.md,
// Parte 5) — distinção Pessoa Física × Pessoa Jurídica do cliente, base pra
// razão social/Inscrição Estadual na emissão de NF-e. Sem OUTRO de
// propósito: não existe um terceiro tipo de pessoa no direito brasileiro,
// diferente dos enums enum-fechado+OUTRO do resto do schema.
enum TipoPessoa {
  FISICA
  JURIDICA
}

// Tag indIEDest da NF-e 4.0 — decide se a Inscrição Estadual do destinatário
// é obrigatória (CONTRIBUINTE, rejeição SEFAZ 728 se faltar) ou proibida
// (ISENTO, rejeição 791 se vier preenchida). NAO_CONTRIBUINTE é o terceiro
// valor da mesma tag (consumidor final sem IE). Ver mapeamento pros códigos
// 1/2/9 da Focus NFe em src/lib/focus-nfe.ts.
enum IndicadorInscricaoEstadual {
  CONTRIBUINTE
  ISENTO
  NAO_CONTRIBUINTE
}

// Papel da pessoa de contato dentro da empresa cliente (achado A4 da Parte 5
// da auditoria de abrangência, pesquisa-abrangencia-modulos.md) — quem
// COMPRA não é necessariamente quem aprova arte, nem quem está no
// financeiro, nem quem recebe a entrega. Mandar automaticamente o link de
// aprovação pro contato APROVACAO_ARTE (ou o boleto/NF pro FINANCEIRO) é o
// que esta lista DESTRAVA pro futuro — nenhum dos dois é implementado nesta
// rodada, só o cadastro do papel. Mesmo padrão enum-fechado+OUTRO do resto
// do schema (ver ContatoCliente.funcaoOutro).
enum FuncaoContatoCliente {
  COMPRADOR
  FINANCEIRO
  APROVACAO_ARTE
  RECEBIMENTO
  OUTRO
}

// Contato individual de um Cliente Pessoa Jurídica (achado A4 da Parte 5 da
// auditoria de abrangência) — até aqui Cliente.email/telefone tratava a
// empresa cliente como se fosse uma pessoa só. Não substitui
// Cliente.email/telefone (que continuam existindo e funcionando exatamente
// como hoje pra quem nunca cadastrar um contato); é um cadastro adicional,
// só usado por quem escolher usá-lo — ver Orcamento.contatoClienteId abaixo,
// que convive com o snapshot em texto Orcamento.contatoNome/contatoEmail
// (mesmo precedente de Comissao/Orcamento.opcaoEscolhidaNome: FK opcional +
// snapshot em texto que sobrevive mesmo se o contato mudar ou for
// desativado depois).
model ContatoCliente {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  nome         String
  cargo        String?
  departamento String?
  email        String?
  telefone     String?
  whatsapp     String?

  funcao      FuncaoContatoCliente @default(COMPRADOR)
  // Só preenchido (e obrigatório, validado na action) quando funcao=OUTRO —
  // mesmo padrão de Cliente.origemOutro/segmentoOutro.
  funcaoOutro String?

  // Só um contato principal por cliente — imposto na action
  // (ver src/app/clientes/actions.ts), não como constraint de banco: um
  // índice único parcial (WHERE principal) resolveria, mas é mais
  // complexidade de migração manual do que vale a pena pra esta regra.
  principal Boolean @default(false)

  // Soft-delete — nunca hard delete, porque o contato pode já estar
  // referenciado por Orcamento.contatoClienteId (histórico de quem foi
  // escolhido num orçamento passado não pode quebrar). Contato inativo some
  // do <select> de novos orçamentos, mas continua existindo pra quem já
  // aponta pra ele.
  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orcamentos Orcamento[]

  @@index([clienteId])
  @@map("contatos_cliente")
}

// Tipo do endereço cadastrado (achado A5 da Parte 5 da auditoria de
// abrangência, pesquisa-abrangencia-modulos.md) — mesmo padrão de ERP
// brasileiro: endereço comercial/de cadastro, de cobrança (pra onde vai a
// fatura/boleto) e de entrega (pra onde vai a mercadoria) podem ser 3
// lugares diferentes. Sem OUTRO de escape: são só 3 papéis fixos, não uma
// lista aberta como origem/segmento do cliente.
enum TipoEnderecoCliente {
  PRINCIPAL
  COBRANCA
  ENTREGA
}

// Endereço adicional de um Cliente (achado A5 da Parte 5 da auditoria de
// abrangência) — até aqui os 8 campos `endereco*` inline em Cliente eram
// SIMULTANEAMENTE endereço de cadastro, de cobrança e de entrega, então não
// dava pra registrar que o faturamento vai pra matriz em São Paulo e a caixa
// de rótulos vai pra fábrica em Extrema. Não substitui os campos `endereco*`
// de Cliente (que continuam sendo o endereço FISCAL do destinatário, nada
// muda na emissão de nota, nada migra pra cá); é um cadastro aditivo e
// opcional, só usado por quem escolher usá-lo — mesmo precedente de
// ContatoCliente logo acima não substituir Cliente.email/telefone. Ver
// Orcamento.enderecoEntregaId abaixo, que convive com o snapshot em texto
// Orcamento.localEntrega (mesmo padrão de contatoClienteId/contatoNome).
//
// Grupos econômicos / matriz-filial do cliente (um Cliente "pai" com vários
// Cliente "filho") ficam FORA de escopo aqui — o achado que motivou este
// model é só "várias entregas/cobranças pro MESMO cadastro de cliente", não
// inferir hierarquia entre cadastros diferentes.
model EnderecoCliente {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Rótulo livre de uso interno — "Fábrica Extrema", "Loja Shopping
  // Iguatemi" — pra reconhecer o endereço numa lista sem precisar ler o
  // logradouro inteiro.
  apelido String

  tipo TipoEnderecoCliente @default(ENTREGA)

  // Mesmos nomes/formato dos campos `endereco*` de Cliente (sem o prefixo
  // `endereco`, redundante aqui dentro do próprio model EnderecoCliente).
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  municipio   String?
  codigoIbge  String?
  uf          String?

  // Quem recebe NESTE endereço — pode ser diferente do ContatoCliente
  // comercial da empresa (ex: o vigia da doca, não o comprador). Texto
  // livre, não FK pra ContatoCliente: são conceitos independentes, um
  // endereço não precisa ter um contato cadastrado pra ter um recebedor.
  contatoNome     String?
  contatoTelefone String?

  // Horário de recebimento, doca, agendamento, "tocar interfone" — o tipo de
  // detalhe que só existe pra ENTREGA, mas o campo fica disponível pra
  // qualquer tipo (não é validado por tipo, só normalmente vazio pra
  // PRINCIPAL/COBRANCA).
  instrucoesEntrega String? @db.Text

  // Só um endereço `padrao: true` por TIPO, por cliente (ex: pode ter um
  // ENTREGA padrão E um COBRANCA padrão ao mesmo tempo, mas nunca 2 ENTREGA
  // padrão) — imposto na action via $transaction, mesmo mecanismo de
  // ContatoCliente.principal acima (não é constraint de banco, mesmo motivo:
  // um índice único parcial resolveria, mas é mais complexidade de migração
  // manual do que vale a pena pra esta regra).
  padrao Boolean @default(false)

  // Soft-delete — nunca hard delete, o endereço pode já estar referenciado
  // por Orcamento.enderecoEntregaId (histórico de orçamento passado não pode
  // quebrar). Endereço inativo some do <select> de novos orçamentos, mas
  // continua existindo pra quem já aponta pra ele.
  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orcamentos Orcamento[]

  @@index([clienteId])
  @@map("enderecos_cliente")
}

// Perfil de negócio da GRÁFICA (tenant), não confundir com SegmentoCliente
// acima (perfil comercial de um cliente da gráfica) — achado A6 da Parte 6
// da auditoria de abrangência (2026-08-27): nada no schema dizia que TIPO
// de gráfica o tenant é, então defaults (categorias de custo sugeridas,
// pacote de dados de exemplo) ficavam implicitamente calibrados só no
// perfil da gráfica-piloto (rótulos/etiquetas). Mesmo padrão
// enum-fechado+OUTRO do resto do schema — ver Grafica.segmento/segmentoOutro.
enum SegmentoGrafica {
  ROTULOS_ETIQUETAS
  OFFSET_COMERCIAL
  COMUNICACAO_VISUAL
  ESTAMPARIA_VESTUARIO
  BRINDES_PERSONALIZADOS
  EMBALAGEM_CARTONAGEM
  EDITORIAL_LIVRO
  CORTE_LASER_ACRILICO
  GRAFICA_RAPIDA
  // Leva 2 (achado F9 da Parte 7 da auditoria de abrangência,
  // pesquisa-abrangencia-modulos.md, 2026-08-31) — SERIGRAFIA e FLEXOGRAFIA
  // já tinham ModeloCalculo próprio no motor de preço sem ter valor
  // correspondente aqui; BORDADO/PAPELARIA_CONVITES/SINALIZACAO_ADESIVAGEM
  // cobrem segmentos reais de mercado que não caíam em nenhum valor
  // existente. Mesmo padrão enum-fechado+OUTRO acima — nunca restritivo, só
  // amplia a lista de opção.
  SERIGRAFIA
  FLEXOGRAFIA
  BORDADO
  PAPELARIA_CONVITES
  SINALIZACAO_ADESIVAGEM
  OUTRO
}

// Tipo da chave PIX cadastrada em Grafica.chavePix (achado F6 da Parte 7 da
// auditoria de abrangência, pesquisa-abrangencia-modulos.md, 2026-08-31) —
// só rotula o campo pra exibição ("Chave PIX (CPF): ..."), nunca valida o
// FORMATO do valor digitado (não confere dígito verificador de CPF/CNPJ nem
// formato de e-mail/telefone — texto livre em Grafica.chavePix). Os 5
// valores reais de chave PIX no arranjo BACEN, +OUTRO de escape (mesmo
// padrão enum-fechado+OUTRO do resto do schema, aqui sem campo-irmão
// `xxxOutro` — os tipos reais já esgotam o universo do BACEN; OUTRO só cobre
// "não quis especificar", sem detalhe adicional a coletar).
enum TipoChavePix {
  CPF
  CNPJ
  EMAIL
  TELEFONE
  ALEATORIA
  OUTRO
}

enum UnidadeMedida {
  FOLHA
  METRO_QUADRADO
  METRO_LINEAR
  UNIDADE
  LITRO
  KG
  ROLO
  PACOTE
  CENTO
  MILHEIRO
  HORA
  // Sem fator de conversão nenhum (diferente de UnidadeDimensao) — é só
  // rótulo. Lista fechada sem esta opção forçava gráfica que mede insumo em
  // resma/galão/fardo/tonelada a "forçar" pra unidade ou pacote, perdendo
  // precisão no relatório de estoque. ItemCatalogo.unidadeOutro guarda o
  // texto quando esta opção é escolhida.
  OUTRO
}

// Unidade COMERCIAL de compra — achado A6 da auditoria de abrangência (Parte
// 3/Compras, 2026-08-29): separada da unidade de ESTOQUE (UnidadeMedida
// acima). NF-e brasileira distingue uCom (unidade comercial, o que consta na
// nota/negociação) de uTrib (unidade tributável — aqui, a de estoque), com
// tabela oficial incluindo FARDO/RESMA/BOBINA/ROLO/PALETE: o comprador
// negocia e recebe proposta em R$/tonelada ou R$/fardo, não na unidade que o
// estoque já usa. OUTRO + campo de texto livre, mesmo padrão de
// UnidadeMedida.OUTRO/ItemCatalogo.unidadeOutro.
enum UnidadeCompra {
  FARDO
  RESMA
  BOBINA
  ROLO
  PALETE
  CAIXA
  UNIDADE
  KG
  TONELADA
  OUTRO
}

enum TipoItemCatalogo {
  PRODUTO
  MATERIA_PRIMA
  SERVICO
}

// Modelo de cálculo de um PRODUTO: SIMPLES é o preço direto (precoVenda × área/quantidade,
// como sempre funcionou); M2, OFFSET e FLEXOGRAFIA acionam o motor avançado (src/lib/pricing)
// e exigem configuração extra (bobinas, formatos de folha, ou máquina flexo + clichê).
// Sempre opt-in por item, nunca default.
// DIGITAL usa src/lib/pricing/digital.ts (custo por clique + substrato, sem
// nesting). SERIGRAFIA/SUBLIMACAO/ESTAMPAGEM_QUENTE/PERSONALIZACAO são 4
// valores distintos (rótulo específico no dropdown de produto, pra não
// confundir o usuário) mas os 4 chamam a MESMA função calcularSetupPorPeca —
// a tag de qual processo é (pra filtrar a lista de MaquinaSetupPorPeca
// compatível) vive em ProcessoSetupPorPeca, não aqui. PERSONALIZACAO é o
// rótulo genérico (achado A3 da auditoria de abrangência,
// pesquisa-abrangencia-modulos.md) pra processos que têm a mesma forma de
// custo (setup fixo por matriz/clichê/arte + variável por peça) mas não são
// nenhum dos 3 nomeados: tampografia, gravação a laser, DTG, transfer etc.
enum ModeloCalculo {
  SIMPLES
  M2
  OFFSET
  FLEXOGRAFIA
  DIGITAL
  SERIGRAFIA
  SUBLIMACAO
  ESTAMPAGEM_QUENTE
  PERSONALIZACAO
  // Revenda/terceirização (achado A12 da auditoria de abrangência,
  // 2026-08-24): produto comprado pronto de um fornecedor (brinde) ou
  // terceirizado — sem máquina, sem setup. custoBase = Q × custoAquisicaoUnitario
  // (ver OrcamentoItem.custoAquisicaoUnitario abaixo), mas passa pelo MESMO
  // comporPreco de todo mundo — ganha overhead/imposto/margem/piso e
  // breakdown auditável, ao contrário de SIMPLES (preço digitado, custo zero).
  REVENDA
  // Achados A4/A6 da Parte 1 da auditoria de abrangência
  // (pesquisa-abrangencia-modulos.md, 2026-09-02). BORDADO: custoBase =
  // custoMatrizDigitalizacao (1×, não escala com tiragem — mesmo princípio
  // já usado no clichê de etiqueta) + Q × (numeroPontos/1000 ×
  // custoPorMilPontos) + Q × custoSubstrato (ver MaquinaBordado,
  // OrcamentoItem.numeroPontos). TEMPO_MAQUINA: custoBase = tempo
  // (tempoEstimadoMin/60 × custoHoraMaq) + corte (metrosCorte ×
  // custoPorMetroCorte, se preenchido) + custoSetupPorJob (1× por item) com
  // custoMinimo como piso — cobre corte/gravação a laser, router CNC,
  // plotter de recorte, montagem de letra caixa/totem (ver MaquinaTempo,
  // OrcamentoItem.tempoEstimadoMin/metrosCorte). Sem nesting, mesma família
  // de DIGITAL/setup-por-peça/REVENDA acima.
  BORDADO
  TEMPO_MAQUINA
}

// Como um acabamento (SERVICO) é cobrado — spec §3. FOLHA_IMPRESSA é o caso mais sutil:
// cobra pela folha de máquina ANTES do refile (ex: BOPP), não pela peça final.
enum BaseCobranca {
  UNIDADE
  M2
  FOLHA_IMPRESSA
  METRO_LINEAR
  FIXO
  HORA
  MILHEIRO
  CENTO
}

// Achado N14 da auditoria de abrangência (Parte 7, 2026-09-03): campo
// DESCRITIVO, não usado pelo motor de precificação. Decisão tomada após
// investigar calcularQtdBase/calcularCustoAcabamento (src/lib/pricing/
// acabamento.ts) — o motor só tem UMA noção de quantidade de folha
// (ContextoAcabamento.folhasBoas/folhasPerda, calculadas em offset.ts), e ela
// já É a folha de máquina ANTES do refile (é literalmente como
// BaseCobranca.FOLHA_IMPRESSA é definida e documentada). Não existe, em
// nenhum lugar do motor, uma segunda contagem de "folhas depois do refile"
// pra esse campo escolher entre uma e outra — depois do refile o que existe
// é contagem de PEÇA (ctx.quantidade), já coberta por BaseCobranca.UNIDADE.
// Fazer o campo governar o cálculo exigiria inventar essa segunda contagem,
// que não corresponde a nada físico além do que UNIDADE já cobre — trocado
// por deixar o campo puramente organizacional (indica ao fluxo de produção
// SE este acabamento acontece antes ou depois do corte de refile, sem afetar
// o preço). Ver rótulo/hint em ConfiguracaoAcabamentoForm.tsx.
enum EstagioAcabamento {
  PRE_REFILE
  POS_REFILE
}

// Código de origem da mercadoria (Tabela B do CST/ICMS, Convênio S/N 70/2012)
// exigido em TODO item de NF-e — achado N6 da auditoria de abrangência
// (Parte 7, 2026-09-03): mapearItemNfePayload em src/lib/focus-nfe.ts mandava
// icms_origem: "0" (nacional) fixo pra todo item, de toda gráfica, sem
// nenhum campo pra configurar diferente. Gráfica de brindes que revende
// produto importado (ModeloCalculo.REVENDA), comunicação visual com
// ACM/acrílico importado, DTF com filme importado — todas emitiam NF-e
// declarando origem nacional errada (afeta ICMS interestadual da Resolução
// SF 13/2012 e a FCI). Sufixo numérico no nome de cada valor evita ambiguidade
// entre os 5 códigos "Nacional" (0/3/4/5/8) e os 4 "Estrangeira" (1/2/6/7) —
// ver mapearOrigemMercadoria em src/lib/focus-nfe.ts pro código exato
// enviado à Focus NFe. @default(NACIONAL_0) preserva o comportamento atual
// pra todo item já cadastrado e todo item novo, até a gráfica configurar
// diferente.
enum OrigemMercadoria {
  NACIONAL_0 // Nacional, exceto os códigos 3, 4, 5 e 8
  ESTRANGEIRA_IMPORTACAO_DIRETA_1
  ESTRANGEIRA_MERCADO_INTERNO_2 // adquirida no mercado interno
  NACIONAL_CONTEUDO_IMPORTACAO_40_A_70_3 // conteúdo de importação > 40% e ≤ 70%
  NACIONAL_PROCESSO_PRODUTIVO_BASICO_4
  NACIONAL_CONTEUDO_IMPORTACAO_ATE_40_5 // conteúdo de importação ≤ 40%
  ESTRANGEIRA_IMPORTACAO_DIRETA_SEM_SIMILAR_6 // sem produto nacional similar
  ESTRANGEIRA_MERCADO_INTERNO_SEM_SIMILAR_7 // adquirida no mercado interno, sem produto nacional similar
  NACIONAL_CONTEUDO_IMPORTACAO_ACIMA_70_8 // conteúdo de importação > 70%
}

// Catálogo: base é mestre e compartilhada entre todas as gráficas (graficaId=null,
// só criada via seed). Cada gráfica pode complementar com itens próprios que faltem
// (graficaId preenchido, criados pelo botão "Adicionar" em /catalogo) — esses ficam
// privados: só a gráfica dona vê e pode selecionar (ver salvarCatalogo/página do
// catálogo, que sempre filtram por graficaId=null OU graficaId=tenant atual).
// Cada gráfica escolhe, em ItemGrafica, o que ela realmente oferece/usa e define
// seus próprios preços — o item de catálogo em si nunca muda por tenant.
model ItemCatalogo {
  id           String           @id @default(cuid())
  graficaId    String? // null = catálogo mestre; preenchido = item privado dessa gráfica
  tipo         TipoItemCatalogo
  categoria    String
  nome         String
  descricao    String?
  unidade      UnidadeMedida?
  unidadeOutro String? // só usado quando unidade = OUTRO
  ncm          String? // classificação fiscal (NF-e) — nullable, só exigido no momento de emitir nota
  // Código de origem da mercadoria (Tabela B do CST/ICMS) — achado N6 da
  // auditoria de abrangência. @default(NACIONAL_0) preserva o comportamento
  // de sempre (icms_origem "0" fixo) pra todo item existente e todo item
  // novo até a gráfica configurar diferente. Ver enum OrigemMercadoria acima.
  origemMercadoria OrigemMercadoria @default(NACIONAL_0)
  createdAt    DateTime         @default(now())

  grafica      Grafica?      @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  itensGrafica ItemGrafica[]

  // Nota: como o Postgres trata NULL como distinto em índices únicos, esta
  // constraint não impede globais (graficaId=null) duplicados entre si — por
  // isso o seed faz a própria checagem de duplicidade em vez de contar só com
  // isto (ver prisma/seed.ts). Para itens privados (graficaId preenchido) a
  // constraint funciona normalmente.
  @@unique([graficaId, tipo, nome])
  @@index([tipo, categoria])
  @@index([graficaId])
  @@map("itens_catalogo")
}

// Seleção da gráfica dentro do catálogo mestre: liga a gráfica a um ItemCatalogo
// e guarda os preços que ELA define (compra = custo de aquisição/produção,
// venda = quanto cobra do cliente). ativo=false "desliga" o item sem apagar
// histórico (orçamentos e movimentações de estoque continuam íntegros).
model ItemGrafica {
  id                      String    @id @default(cuid())
  graficaId               String
  itemCatalogoId          String
  ativo                   Boolean   @default(true)
  precoCompra             Decimal?  @db.Decimal(12, 4)
  // Quando precoCompra mudou pela última vez — carimbado só quando o VALOR
  // muda de verdade (não em toda edição da linha, ao contrário de
  // updatedAt). null = nunca rastreado (todo item já existente antes deste
  // campo) — não entra no aviso de "preço desatualizado"
  // (ParametrosGrafica.diasPrecoInsumoDesatualizado): sem dado é "não sei",
  // nunca "está velho".
  precoCompraAtualizadoEm DateTime?
  precoVenda              Decimal?  @db.Decimal(12, 2)
  estoqueAtual            Decimal?  @db.Decimal(12, 4)
  estoqueMinimo           Decimal?  @db.Decimal(12, 4)
  // Quantas unidades individuais tem em cada "unidade cadastrada" deste item
  // (ex: unidade=PACOTE, quantidadePorEmbalagem=500 → 1 pacote = 500
  // etiquetas). Puramente informativo: mostra a conversão ao lado do estoque
  // nas telas de catálogo, mas NÃO muda a unidade em que
  // entrada/saída/ajuste são lançados nem como ficha técnica/custo calculam
  // (estoqueAtual continua sendo "quantas unidades cadastradas", igual hoje).
  // null = sem conversão configurada (comportamento atual, sem mudança).
  quantidadePorEmbalagem  Decimal?  @db.Decimal(12, 4)
  // Achado A6 da auditoria de abrangência (Parte 3/Compras): unidade
  // COMERCIAL padrão em que este item costuma ser comprado (ex: FARDO),
  // separada da unidade de ESTOQUE (ItemCatalogo.unidade) — ver enum
  // UnidadeCompra. unidadeCompraPadraoOutro é texto livre só usado quando
  // unidadeCompraPadrao=OUTRO (mesmo padrão de unidadeOutro). Só pré-
  // preenche e avisa na tela de nova solicitação de compra (ver
  // src/app/compras/nova/NovaSolicitacaoForm.tsx) — nunca obrigatório,
  // nunca muda como estoque é lançado. null = sem padrão configurado
  // (comprador digita direto na unidade de estoque, comportamento de hoje).
  unidadeCompraPadrao        UnidadeCompra?
  unidadeCompraPadraoOutro   String?
  // Quantas unidades de ESTOQUE cada unidade de COMPRA representa (ex:
  // unidadeCompraPadrao=FARDO, fatorConversaoCompraPadrao=50 → 1 fardo = 50
  // kg de estoque). Pré-preenche o fator da solicitação; o comprador pode
  // sempre digitar um fator diferente pra uma compra específica. null = sem
  // fator padrão (precisa digitar na hora que unidadeCompra é usada).
  fatorConversaoCompraPadrao Decimal?       @db.Decimal(12, 4)
  // Lote mínimo e múltiplo de embalagem padrão de compra deste item, na
  // unidade de COMPRA (não de estoque) — só CONFIGURAÇÃO pra pré-preencher
  // e avisar arredondamento na tela de nova solicitação (mesma disciplina
  // de aviso não-bloqueante já usada nesta auditoria, ex.: divergência de
  // máquina): pedir uma quantidade que não é múltiplo é sempre permitido,
  // nunca barrado. null = sem lote/múltiplo configurado, sem aviso.
  loteMinimoCompra           Decimal?       @db.Decimal(12, 4)
  multiploCompra             Decimal?       @db.Decimal(12, 4)
  // Quanto desse material é perdido por CALIBRAGEM toda vez que uma produção
  // entra em impressão (FILA→IMPRESSAO) — fixo, não escala com a quantidade
  // do pedido (1 unidade ou 1000 = mesma perda). Diferente de
  // Prensa.perdaPercentPadrao, que é percentual e só entra na ESTIMATIVA DE
  // PREÇO do motor Offset (src/lib/pricing/offset.ts) — nunca mexe em
  // estoque real. null = sem perda de calibragem configurada (comportamento
  // de hoje: baixa só pela ficha técnica). Só relevante quando este
  // ItemGrafica é matéria-prima (itemCatalogo.tipo=MATERIA_PRIMA); é o
  // padrão sugerido na tela de confirmação de avancarPedido — editável por
  // pedido lá, sem alterar este valor.
  perdaFixaPadrao         Decimal?  @db.Decimal(12, 4)
  // Dedup do alerta de estoque baixo por e-mail (ver src/lib/alerta-estoque.ts)
  // — preenchido quando o e-mail/aviso é disparado, limpo de volta pra null
  // assim que o estoque volta a ficar acima do mínimo (self-healing: cai nunca
  // avisado → avisa; sobe → limpa; cai de novo → avisa de novo).
  alertaEstoqueEnviadoEm  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Motor avançado — só relevante quando tipo=PRODUTO no ItemCatalogo relacionado.
  modeloCalculo ModeloCalculo @default(SIMPLES)
  viraFolha     Boolean       @default(false) // work-and-turn; só usado quando modeloCalculo=OFFSET

  // Achado N1 da auditoria de abrangência (Parte 7) — só relevante quando
  // modeloCalculo=SIMPLES. Antes desta flag, o motor decidia "cobra por m²"
  // ou "cobra por peça" olhando se o VENDEDOR preencheu largura/altura
  // naquela linha do orçamento (largura/altura são sempre opcionais e
  // renderizadas em qualquer linha, ver SeletorItemOrcamento.tsx) — uma
  // camiseta SIMPLES com "30×40" digitado como medida descritiva da estampa
  // virava R$ preço/m² por acidente. Agora é propriedade do PRODUTO: só
  // multiplica pela área (ver calcularPreco em src/lib/orcamento.ts) quando
  // esta flag está ligada. @default(false) preserva o comportamento atual
  // (peça) pra todo produto — a migration que introduziu este campo faz um
  // backfill pontual (liga a flag em todo ItemGrafica que JÁ TEM algum
  // OrcamentoItem SIMPLES com largura+altura preenchidas, preservando o
  // comportamento observado hoje pra quem já dependia disso, ex: rótulos por
  // tamanho) — nunca liga sozinha pra produto novo.
  simplesCobraPorArea Boolean @default(false)

  // Qual prensa física produz este item — só relevante/obrigatório (na aplicação)
  // quando modeloCalculo=OFFSET. onDelete=Restrict: não deixa excluir uma prensa
  // ainda em uso por algum produto.
  prensaId String?

  // Qual máquina flexo produz este item — só relevante/obrigatório (na aplicação)
  // quando modeloCalculo=FLEXOGRAFIA. Mesma regra de prensaId (onDelete=Restrict).
  maquinaFlexografiaId String?

  // Qual impressora digital produz este item — só relevante/obrigatório (na
  // aplicação) quando modeloCalculo=DIGITAL. Mesma regra de prensaId
  // (onDelete=Restrict).
  impressoraDigitalId String?

  // Qual máquina de setup-por-peça produz este item — só relevante/
  // obrigatório (na aplicação) quando modeloCalculo é SERIGRAFIA/SUBLIMACAO/
  // ESTAMPAGEM_QUENTE. A máquina escolhida deve ter tipoProcesso compatível
  // com o modeloCalculo do produto (validado na Server Action, sem CHECK no
  // banco — mesmo padrão do resto do schema). Mesma regra de prensaId
  // (onDelete=Restrict).
  maquinaSetupPorPecaId String?

  // Qual máquina de bordado produz este item — só relevante/obrigatório (na
  // aplicação) quando modeloCalculo=BORDADO (achado A4). Mesma regra de
  // prensaId (onDelete=Restrict).
  maquinaBordadoId String?

  // Qual máquina de tempo (corte/gravação a laser, router CNC, plotter de
  // recorte...) produz este item — só relevante/obrigatório (na aplicação)
  // quando modeloCalculo=TEMPO_MAQUINA (achado A6). Mesma regra de prensaId
  // (onDelete=Restrict).
  maquinaTempoId String?

  // Gramatura escolhida — só relevante quando modeloCalculo=OFFSET (produto) ou
  // quando este item é usado como papel de outro produto (matéria-prima). No
  // produto, alimenta tanto o peso físico real da folha quanto a busca (com
  // fallback) na TabelaPrecoPapel do papel selecionado — ver `papelId` abaixo
  // e src/lib/pricing/papel.ts.
  gramaturaGm2 Decimal? @db.Decimal(6, 1)

  // Qual matéria-prima (papel) este produto Offset usa — só relevante/obrigatório
  // (na aplicação) quando modeloCalculo=OFFSET. O preço por kg não fica mais
  // digitado no produto: é resolvido em runtime pela TabelaPrecoPapel do papel
  // referenciado aqui, usando gramaturaGm2 como chave (com fallback pra mais
  // próxima). onDelete=Restrict: não deixa excluir um papel ainda em uso.
  papelId String?

  // Só relevante quando tipo=PRODUTO e modeloCalculo=M2.
  custoImpressaoM2    Decimal? @db.Decimal(12, 4)
  areaMinimaFaturavel Decimal? @db.Decimal(8, 4)

  // Em qual CategoriaCusto a baixa automática desta matéria-prima cai (ver
  // fase-custo-real.md §1.5, §3.2) — só relevante quando tipo=MATERIA_PRIMA.
  // Nulo cai na categoria padrão configurada em
  // ParametrosGrafica.categoriaCustoConsumoPadraoId.
  categoriaCustoId String?

  // Unidade em que a gráfica RACIOCINA e VENDE este produto (ex: rótulo por
  // milheiro), separada da UnidadeMedida de ItemCatalogo (que descreve o
  // item em si) — só relevante quando tipo=PRODUTO. fatorConversao converte
  // pra a unidade base do motor de preço (ex: 1 milheiro = 1000). Nula = usa
  // UNIDADE/1, comportamento de hoje. Camada de exibição/métrica derivada —
  // nunca mexe no motor de preço em si.
  unidadeContagem UnidadeMedida?
  fatorConversao  Decimal?       @db.Decimal(12, 4)

  grafica             Grafica              @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  itemCatalogo        ItemCatalogo         @relation(fields: [itemCatalogoId], references: [id])
  prensa              Prensa?              @relation(fields: [prensaId], references: [id], onDelete: Restrict)
  maquinaFlexografia  MaquinaFlexografia?  @relation(fields: [maquinaFlexografiaId], references: [id], onDelete: Restrict)
  impressoraDigital   ImpressoraDigital?   @relation(fields: [impressoraDigitalId], references: [id], onDelete: Restrict)
  maquinaSetupPorPeca MaquinaSetupPorPeca? @relation(fields: [maquinaSetupPorPecaId], references: [id], onDelete: Restrict)
  maquinaBordado      MaquinaBordado?      @relation(fields: [maquinaBordadoId], references: [id], onDelete: Restrict)
  maquinaTempo        MaquinaTempo?        @relation(fields: [maquinaTempoId], references: [id], onDelete: Restrict)
  papel               ItemGrafica?         @relation("PapelDoProdutoOffset", fields: [papelId], references: [id], onDelete: Restrict)
  // SetNull: desativar/remover a categoria de custo não pode travar a
  // matéria-prima — ela só volta a cair na categoria padrão da gráfica.
  categoriaCusto      CategoriaCusto?      @relation(fields: [categoriaCustoId], references: [id], onDelete: SetNull)

  itensOrcamento OrcamentoItem[]
  movimentacoes  MovimentacaoEstoque[]

  bobinas                       BobinaMaterial[]
  formatosFolha                 FormatoFolha[]
  configuracaoAcabamento        ConfiguracaoAcabamento?
  usadoComoAcabamento           OrcamentoItemAcabamento[]
  configuracaoClicheEtiqueta    ConfiguracaoClicheEtiqueta?
  configuracaoClicheFlexografia ConfiguracaoClicheFlexografia?
  configuracaoEmenda            ConfiguracaoEmenda?
  usadoComoPapelEtiqueta        OrcamentoItemPrecificacaoEtiqueta[] @relation("PapelDoItemOrcamentoEtiqueta")

  // Ficha técnica (spec de baixa automática de estoque): só relevante quando
  // tipo=PRODUTO. fichaTecnica = quais matérias-primas este produto consome;
  // usadoComoMateriaPrima = em quais fichas técnicas esta matéria-prima aparece.
  fichaTecnica          FichaTecnicaItem[] @relation("FichaTecnicaDoProduto")
  usadoComoMateriaPrima FichaTecnicaItem[] @relation("MateriaPrimaConsumida")

  // Papel: produtos Offset que usam este item como papel, e a tabela de
  // preço por gramatura deste item quando ELE é o papel (tipo=MATERIA_PRIMA).
  produtosQueUsam  ItemGrafica[]      @relation("PapelDoProdutoOffset")
  tabelaPrecoPapel TabelaPrecoPapel[] @relation("TabelaDoPapel")

  // Variantes deste item quando ELE é uma matéria-prima com sub-variação
  // (ex: espessura de chapa) — ver comentário do model VarianteMateriaPrima.
  variantes VarianteMateriaPrima[] @relation("VariantesDaMateriaPrima")

  // Pedidos de compra (workflow SOLICITADO→...→CONFERIDO) que têm esta
  // matéria-prima como alvo — ver model SolicitacaoCompra.
  solicitacoesCompra SolicitacaoCompra[]
  // Contratos de fornecimento com preço fixo por período que travam
  // especificamente esta matéria-prima — achado A9 da auditoria de
  // abrangência (Parte 3/Compras, 2026-08-30). Ver model ContratoFornecimento.
  contratosFornecimento ContratoFornecimento[]
  // Achado F1 da Parte 7 da auditoria de abrangência — ferramentais (faca,
  // clichê...) que produzem este item do catálogo, ver model Ferramental.
  ferramentais          Ferramental[]

  @@unique([graficaId, itemCatalogoId])
  @@index([graficaId])
  @@index([categoriaCustoId])
  @@index([impressoraDigitalId])
  @@index([maquinaSetupPorPecaId])
  @@index([maquinaBordadoId])
  @@index([maquinaTempoId])
  @@map("itens_grafica")
}

// Tabela de preço por gramatura de um papel (ItemGrafica tipo=MATERIA_PRIMA).
// Um papel = 1 cadastro no catálogo; a gramatura vira um subtópico aqui em vez
// de virar um cadastro inteiro novo (ver comentário do model ItemGrafica).
// resolverPrecoPapel (src/lib/pricing/papel.ts) busca aqui pela gramatura
// exata e, se não achar, cai no fallback pela mais próxima.
model TabelaPrecoPapel {
  id            String   @id @default(cuid())
  itemGraficaId String
  gramatura     Int
  precoKg       Decimal  @db.Decimal(12, 4)
  createdAt     DateTime @default(now())

  itemGrafica ItemGrafica @relation("TabelaDoPapel", fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@unique([itemGraficaId, gramatura])
  @@index([itemGraficaId])
  @@map("tabela_preco_papel")
}

// Quanto de uma matéria-prima um produto consome por unidade vendida (ex: 1 Cartão de
// Visita consome 0,002 folha de Papel Couché 300g). Alimenta a baixa automática de
// estoque quando um Pedido entra em produção (ver avancarPedido) — v1 só cobre
// PRODUTO×quantidade do OrcamentoItem; acabamentos/serviços consumindo material próprio
// (ex: BOPP na laminação) ficam de fora por ora.
model FichaTecnicaItem {
  id                   String   @id @default(cuid())
  itemGraficaId        String // o produto (ItemGrafica tipo PRODUTO)
  materiaPrimaId       String // a matéria-prima consumida (outro ItemGrafica, tipo MATERIA_PRIMA)
  quantidadePorUnidade Decimal  @db.Decimal(12, 6)
  createdAt            DateTime @default(now())

  // Qual variante da matéria-prima (ex: espessura de uma chapa) é consumida —
  // só relevante/obrigatório (na aplicação) quando a matéria-prima tem
  // VarianteMateriaPrima cadastrada. Sem variantes, fica null e o consumo é
  // do ItemGrafica direto, como sempre foi.
  varianteId String?

  itemGrafica  ItemGrafica           @relation("FichaTecnicaDoProduto", fields: [itemGraficaId], references: [id], onDelete: Cascade)
  materiaPrima ItemGrafica           @relation("MateriaPrimaConsumida", fields: [materiaPrimaId], references: [id], onDelete: Cascade)
  variante     VarianteMateriaPrima? @relation(fields: [varianteId], references: [id], onDelete: Restrict)

  @@unique([itemGraficaId, materiaPrimaId, varianteId])
  @@index([itemGraficaId])
  @@index([materiaPrimaId])
  @@index([varianteId])
  @@map("ficha_tecnica_itens")
}

// Variante de uma matéria-prima (ex: espessura de uma chapa: 2mm/3mm/5mm) —
// mesma filosofia de TabelaPrecoPapel (1 cadastro de matéria-prima, N
// subtópicos), mas aqui cada variante tem preço E estoque próprios, porque
// (diferente da gramatura do papel) variantes físicas diferentes têm saldos
// de estoque diferentes de verdade. `ativo=false` é soft-delete: nunca se
// apaga uma variante que já foi referenciada por ficha técnica ou
// movimentação de estoque, só se desativa (some da tela, histórico intacto).
model VarianteMateriaPrima {
  id                     String    @id @default(cuid())
  itemGraficaId          String // a matéria-prima "pai" (ItemGrafica tipo=MATERIA_PRIMA)
  rotulo                 String // ex: "2mm", "3mm", "5mm"
  ativo                  Boolean   @default(true)
  precoCompra            Decimal   @db.Decimal(12, 4)
  estoqueAtual           Decimal?  @db.Decimal(12, 4)
  estoqueMinimo          Decimal?  @db.Decimal(12, 4)
  // Mesma ideia de ItemGrafica.perdaFixaPadrao, só que por variante (ex: uma
  // espessura de chapa pode ter perda de calibragem diferente de outra).
  perdaFixaPadrao        Decimal?  @db.Decimal(12, 4)
  // Mesmo dedup self-healing de ItemGrafica.alertaEstoqueEnviadoEm, só que por
  // variante (cada uma tem saldo próprio).
  alertaEstoqueEnviadoEm DateTime?
  createdAt              DateTime  @default(now())

  itemGrafica ItemGrafica @relation("VariantesDaMateriaPrima", fields: [itemGraficaId], references: [id], onDelete: Cascade)

  fichaTecnica       FichaTecnicaItem[]
  movimentacoes      MovimentacaoEstoque[]
  solicitacoesCompra SolicitacaoCompra[]
  // Achado A9 da auditoria de abrangência (Parte 3/Compras, 2026-08-30) —
  // ver model ContratoFornecimento.
  contratosFornecimento ContratoFornecimento[]

  @@unique([itemGraficaId, rotulo])
  @@index([itemGraficaId])
  @@map("variantes_materia_prima")
}

// Opções de bobina de um material (ex: Lona 440g vem em rolos de 1,00/1,20/1,50m).
// custoM2 não é duplicado aqui — vem de ItemGrafica.precoCompra (fonte única).
model BobinaMaterial {
  id             String   @id @default(cuid())
  itemGraficaId  String
  larguraNominal Decimal  @db.Decimal(6, 3) // W_nominal, metros
  refile         Decimal  @db.Decimal(6, 3) // m_refile por lado, metros
  createdAt      DateTime @default(now())

  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@index([itemGraficaId])
  @@map("bobinas_material")
}

// Formatos de folha de máquina de um papel (ex: Couché 300g em 66x96 e 33x48).
model FormatoFolha {
  id            String   @id @default(cuid())
  itemGraficaId String
  nome          String // ex: "Fechada 66x96"
  larguraFolha  Decimal  @db.Decimal(6, 3) // L_f, metros
  alturaFolha   Decimal  @db.Decimal(6, 3) // A_f, metros
  createdAt     DateTime @default(now())

  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@index([itemGraficaId])
  @@map("formatos_folha")
}

// Configura um SERVICO como acabamento do motor avançado (spec §3).
// custoUnitario da fórmula não é campo novo — é o ItemGrafica.precoCompra do próprio serviço.
model ConfiguracaoAcabamento {
  id               String            @id @default(cuid())
  itemGraficaId    String            @unique
  baseCobranca     BaseCobranca
  estagio          EstagioAcabamento
  custoSetup       Decimal           @default(0) @db.Decimal(12, 4)
  custoMinimo      Decimal           @default(0) @db.Decimal(12, 4)
  custoFerramental Decimal?          @db.Decimal(12, 4)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@map("configuracoes_acabamento")
}

// Liga/configura o motor de clichê de etiqueta pra um produto M2 — presença
// da linha = "este produto usa o motor de clichê", mesmo padrão de
// ConfiguracaoAcabamento pra SERVICO/acabamento (presença = ligado, sem
// checkbox extra). Só relevante quando ItemGrafica.modeloCalculo=M2.
model ConfiguracaoClicheEtiqueta {
  id                String   @id @default(cuid())
  itemGraficaId     String   @unique
  // R$ por cm² de área de clichê — achado analisando 132 pedidos reais da
  // Assus (histórico "Custos_Adestek"): o custo do clichê escala com a área
  // da etiqueta, não é um valor fixo igual pra qualquer tamanho (confirmado
  // comparando pedidos de tamanhos diferentes com o mesmo nº de cores).
  // Nunca escala com a tiragem — só com área × nº de cores.
  custoClichePorCm2 Decimal  @db.Decimal(12, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@map("configuracoes_cliche_etiqueta")
}

// Custo de clichê pro modelo FLEXOGRAFIA — mesma fórmula/unidade de
// ConfiguracaoClicheEtiqueta (R$/cm² × nº de cores × área da peça, achada na mesma
// análise de dados reais), mas tabela PARALELA, não reaproveitada: ao contrário do
// M2 (onde a presença da linha liga/desliga um motor opcional, configurado num card
// próprio), aqui é OBRIGATÓRIO pra todo produto FLEXOGRAFIA e configurado inline
// junto com máquina/bobina em ConfiguracaoProdutoForm.tsx, não como card
// independente.
model ConfiguracaoClicheFlexografia {
  id                String   @id @default(cuid())
  itemGraficaId     String   @unique
  custoClichePorCm2 Decimal  @db.Decimal(12, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@map("configuracoes_cliche_flexografia")
}

// Achado A9 da auditoria de abrangência — config OPCIONAL por produto M2:
// presença da linha = "emenda liberada pra este item", mesmo padrão de
// presença-liga/ausência-desliga de ConfiguracaoClicheEtiqueta. Sem esta
// linha, calcularM2 continua lançando PECA_EXCEDE_BOBINA quando a peça não
// cabe em nenhuma bobina — comunicação visual (backdrop/fachada/outdoor/
// painel de evento) é onde emendar painéis é rotina, não exceção; ver
// src/lib/pricing/m2.ts. sobreposicaoM é só informativo por ora (não entra
// na fórmula de custo, que segue exatamente a proposta do achado) — fica
// disponível pra produção/instalação saberem quanto de sobra deixar em cada
// emenda.
model ConfiguracaoEmenda {
  id                  String   @id @default(cuid())
  itemGraficaId       String   @unique
  custoPorMetroLinear Decimal  @db.Decimal(12, 4)
  sobreposicaoM       Decimal  @db.Decimal(6, 3)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@map("configuracoes_emenda")
}

// SAIDA_PRODUCAO e ESTORNO_CANCELAMENTO substituem os antigos valores
// genéricos SAIDA/ENTRADA (renomeados na migration desta fase — eram os
// únicos dois tipos que existiam: SAIDA = baixa automática Fila→Impressão,
// ENTRADA = estorno de cancelamento de pedido). Os três novos cobrem o que
// a fase "custo real" precisa: compra registrada, baixa manual (perda/
// quebra/uso avulso) e ajuste de contagem física.
enum TipoMovimentacao {
  SAIDA_PRODUCAO
  ESTORNO_CANCELAMENTO
  ENTRADA_COMPRA
  SAIDA_MANUAL
  AJUSTE_INVENTARIO
}

// Como o custo unitário snapshotado numa MovimentacaoEstoque foi obtido —
// hoje só PRECO_CADASTRO existe (lê ItemGrafica.precoCompra no momento da
// baixa); os outros dois entram quando houver disciplina de compra
// lançada o suficiente pra sustentar um cálculo melhor (ver fase-custo-real.md §1.1).
enum MetodoCusteio {
  PRECO_CADASTRO
  ULTIMA_COMPRA
  MEDIO_PONDERADO
}

model MovimentacaoEstoque {
  id            String           @id @default(cuid())
  itemGraficaId String
  // Qual pedido de produção gerou essa saída (quando aplicável) — permite
  // comparar consumo real vs. previsto pela ficha técnica por pedido, em vez
  // de depender de parsear o texto livre de `motivo`.
  pedidoId      String?
  tipo          TipoMovimentacao
  quantidade    Decimal          @db.Decimal(12, 4)
  motivo        String?
  createdAt     DateTime         @default(now())

  // Qual variante da matéria-prima moveu (quando ela tem variantes) —
  // itemGraficaId continua apontando pro "pai", pra joins/relatórios; isso
  // aqui só desambigua QUAL saldo (2mm ou 5mm) foi decrementado. SetNull,
  // igual pedidoId: preserva o histórico do movimento mesmo se a variante
  // um dia for desativada/apagada.
  varianteId String?

  // Snapshot de custo no momento da baixa — nunca recalculado retroativamente
  // (mesmo princípio do preço travado do orçamento). Nulo em movimentações
  // anteriores a esta fase: a UI mostra "—", nunca zero (zero mentiria que o
  // custo foi apurado como R$ 0). 4 casas em custoUnitario porque insumo
  // cotado por m²/milheiro tem preço fracionário — arredondar em 2 casas na
  // origem gera desvio acumulado visível em tiragem grande.
  custoUnitario     Decimal?      @db.Decimal(12, 4)
  custoTotal        Decimal?      @db.Decimal(12, 2)
  metodoCusteio     MetodoCusteio @default(PRECO_CADASTRO)
  // Quando o preço usado no snapshot foi atualizado pela última vez — base
  // do alerta "preço de custo não atualizado há N dias".
  precoReferenciaEm DateTime?

  documento    String? // nº da nota fiscal, só usado em ENTRADA_COMPRA
  criadoPorId  String? // null quando a movimentação foi gerada pelo sistema (baixa automática)
  // De qual fornecedor veio a compra — só relevante/preenchido em
  // ENTRADA_COMPRA. Opcional: nem toda gráfica cadastra fornecedor pra
  // toda compra, e histórico de compras sem fornecedor continua válido.
  fornecedorId String?

  // Qual SolicitacaoCompra gerou esta entrada (quando aplicável) — mesmo
  // papel de `pedidoId` só que do lado de compras: liga a ENTRADA_COMPRA ao
  // pedido de compra que a originou (ver avancarStatusCompra em
  // src/app/compras/status-transicao.ts). @unique porque uma solicitação só
  // gera no máximo uma entrada de estoque, ao confirmar RECEBIDO — CONFERIDO
  // (a etapa seguinte) é só a auditoria do que já entrou, não gera outra.
  // null pra toda movimentação que não veio de uma solicitação de compra
  // (compra avulsa lançada direto, ajuste manual, etc.).
  solicitacaoCompraId String? @unique

  // Restrict (não Cascade) porque isso é o histórico de movimentação de
  // estoque em si — apagar o ItemGrafica junto apagaria o próprio registro
  // que a movimentação existe pra preservar. Não é SetNull (como pedido/
  // variante abaixo) porque itemGraficaId não é opcional: uma movimentação
  // sem "o que moveu" não faz sentido. Hoje não existe nenhum fluxo no app
  // que apague um ItemGrafica, então isso é defensivo — mas se um dia
  // existir, Restrict força uma decisão explícita em vez de apagar
  // histórico financeiro/estoque silenciosamente.
  itemGrafica       ItemGrafica           @relation(fields: [itemGraficaId], references: [id], onDelete: Restrict)
  pedido            Pedido?               @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  variante          VarianteMateriaPrima? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  custoPedido       CustoPedido?
  // SetNull: desativar/apagar um fornecedor não pode apagar o histórico de
  // compra em si, só perde a referência de quem vendeu.
  fornecedor        Fornecedor?           @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  // SetNull: mesma razão de `pedido` acima — apagar a solicitação (hoje não
  // existe fluxo que apague) não pode invalidar o histórico de estoque.
  solicitacaoCompra SolicitacaoCompra?    @relation(fields: [solicitacaoCompraId], references: [id], onDelete: SetNull)

  @@index([itemGraficaId])
  @@index([pedidoId])
  @@index([varianteId])
  @@index([fornecedorId])
  @@map("movimentacoes_estoque")
}

// Fornecedor de matéria-prima/serviço — cadastro simples pra permitir
// vincular uma entrada de compra (MovimentacaoEstoque tipo ENTRADA_COMPRA)
// a quem vendeu, e comparar preço entre fornecedores do mesmo item ao
// longo do tempo (via o histórico de movimentações já existente). Sem
// workflow de cotação/aprovação de propósito — isso é feature maior,
// separada; aqui é só "quem vendeu isto", espelhando o que a gráfica já
// controla manualmente numa planilha de lista de compras.
model Fornecedor {
  id        String   @id @default(cuid())
  graficaId String
  nome      String
  contato   String? // telefone/e-mail/observação livre
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  // Achado R3 da auditoria de abrangência (Parte 2/Produção, rodada 20,
  // 2026-09-03) — CNPJ/CPF + endereço, necessários pra usar este fornecedor
  // como DESTINATÁRIO de uma NF-e de remessa pra industrialização emitida
  // direto do sistema (ver emitirNfeRemessaTerceirizacao em
  // src/app/producao/terceirizacao-nfe-actions.ts e
  // fornecedorProntoParaNfe em src/lib/nota-fiscal.ts). Todos opcionais: um
  // Fornecedor cadastrado sem esses dados continua funcionando normalmente
  // em SolicitacaoCompra/EtapaTerceirizada (comportamento de sempre) — só
  // fica de fora do botão de emissão automática até alguém completar o
  // cadastro (a terceirização em si nunca é bloqueada, só a emissão).
  documento          String? // CNPJ (14) ou CPF (11), decidido pelo comprimento na emissão — mesmo critério de normalizarDocumentoDestinatario
  enderecoLogradouro String?
  enderecoNumero     String?
  enderecoBairro     String?
  enderecoMunicipio  String?
  enderecoUf         String?
  enderecoCep        String?

  grafica            Grafica               @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  movimentacoes      MovimentacaoEstoque[]
  solicitacoesCompra SolicitacaoCompra[]
  cotacoes           CotacaoFornecedor[]
  // Achado A9 da auditoria de abrangência (Parte 3/Compras, 2026-08-30) —
  // ver model ContratoFornecimento.
  contratosFornecimento ContratoFornecimento[]
  // Achado E1 da auditoria de abrangência (Parte 2/Produção) — ver model
  // EtapaTerceirizada.
  etapasTerceirizadas EtapaTerceirizada[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("fornecedores")
}

// Fluxo estruturado de compra de matéria-prima: SOLICITADO→COTANDO→APROVADO→
// COMPRADO→RECEBIDO→CONFERIDO, com CANCELADO alcançável a partir de qualquer
// estado antes de RECEBIDO (ver TRANSICOES_VALIDAS em
// src/lib/compras-status.ts, mesmo padrão de StatusOrcamento/orcamento-status.ts).
// Diferente de MovimentacaoEstoque tipo ENTRADA_COMPRA (que já existia, um
// registro simples de "isso entrou no estoque"): este model é o PEDIDO DE
// COMPRA em si, existe desde ANTES de qualquer coisa física acontecer, e só
// gera a MovimentacaoEstoque de entrada quando o material de fato chega
// (RECEBIDO) — CONFERIDO é só a conferência/auditoria do que já entrou,
// nunca gera uma segunda entrada.
enum StatusSolicitacaoCompra {
  SOLICITADO
  COTANDO
  APROVADO
  COMPRADO
  RECEBIDO
  CONFERIDO
  CANCELADO
}

// De onde nasce a necessidade da compra — achado A3 da auditoria de
// abrangência (Parte 3/Compras, 2026-08-29): sem isso, reposição de estoque
// (make-to-stock, nasce do ponto de encomenda) e compra pra um pedido
// específico (make-to-order, nasce da venda) eram indistinguíveis, e o
// custo de uma compra sob encomenda só chegava ao pedido indiretamente via
// baixa de ficha técnica — nunca quando o item comprado não está na ficha
// técnica (clichê, faca, terceirização). PEDIDO_ESPECIFICO exige
// SolicitacaoCompra.pedidoId (obrigatório na aplicação, não no schema — ver
// criarSolicitacaoCompra em src/app/compras/actions.ts); as demais nunca
// preenchem pedidoId.
enum OrigemSolicitacaoCompra {
  REPOSICAO_ESTOQUE // ponto de encomenda / estoque baixo — o caso de sempre, default
  PEDIDO_ESPECIFICO // comprado especificamente pra um Pedido — vira CustoPedido origem COMPRA em RECEBIDO
  MANUTENCAO
  CONSUMO_INTERNO
  CONTRATO_PROGRAMADO
  OUTRO
}

model SolicitacaoCompra {
  id        String                  @id @default(cuid())
  graficaId String
  status    StatusSolicitacaoCompra @default(SOLICITADO)

  itemGraficaId String // a matéria-prima (ItemGrafica tipo=MATERIA_PRIMA)
  // Qual variante (ex: espessura de chapa) quando a matéria-prima tem
  // VarianteMateriaPrima cadastrada — mesmo padrão opcional de
  // FichaTecnicaItem.varianteId. null = matéria-prima sem variantes.
  varianteId    String?
  // Pode nascer sem fornecedor definido (ainda em SOLICITADO/COTANDO) — só
  // costuma ser preenchido a partir de APROVADO.
  fornecedorId  String?

  quantidade    Decimal  @db.Decimal(12, 4)
  // Achado A6 da auditoria de abrangência (Parte 3/Compras): unidade
  // COMERCIAL desta compra específica (ex: FARDO — "R$/fardo"), separada da
  // unidade de ESTOQUE que `quantidade` acima sempre representa (ver enum
  // UnidadeCompra). unidadeCompraOutro é texto livre só usado quando
  // unidadeCompra=OUTRO. quantidadeCompra × fatorConversaoCompra = quantidade
  // (calculado e gravado na criação/edição da solicitação, em
  // criarSolicitacaoCompra — não é campo computed do Prisma). `quantidade`
  // continua sendo a ÚNICA fonte de verdade lida pelo resto do sistema
  // (baixa de estoque, custo automático etc.); estes campos só existem pra
  // reconstruir/exibir a conta original em unidade de compra pro comprador.
  // precoUnitarioCompra é o preço por unidade de COMPRA (R$/fardo), DIFERENTE
  // de ItemGrafica.precoCompra (preço por unidade de ESTOQUE) — puramente
  // informativo, nunca usado em cálculo de custo. Todos null quando a
  // solicitação não usa unidade de compra própria (comportamento de hoje
  // 100% preservado: quantidade digitada direto na unidade de estoque).
  unidadeCompra        UnidadeCompra?
  unidadeCompraOutro   String?
  quantidadeCompra     Decimal?       @db.Decimal(12, 4)
  fatorConversaoCompra Decimal?       @db.Decimal(12, 4)
  precoUnitarioCompra  Decimal?       @db.Decimal(12, 4)
  // Estimativa no momento da solicitação/cotação — informativa, nunca usada
  // pra decrementar caixa nem pra gravar o custo da entrada de estoque.
  // valorFinal é o que de fato foi pago, preenchido ao confirmar COMPRADO —
  // é ele (não o estimado) que vira o custo snapshotado na MovimentacaoEstoque
  // gerada em RECEBIDO.
  valorEstimado Decimal? @db.Decimal(12, 2)
  valorFinal    Decimal? @db.Decimal(12, 2)

  observacao String? // texto livre — ex: motivo da solicitação, condição de pagamento

  // Achado A3 da auditoria de abrangência (Parte 3/Compras) — ver comentário
  // de OrigemSolicitacaoCompra acima. origemOutro é texto livre só usado
  // quando origem=OUTRO (mesmo padrão de TipoPessoa/segmento "outro" já
  // usados no resto do schema). pedidoId aponta pro Pedido de PRODUÇÃO (não
  // pro Orcamento) — é o Pedido que tem CustoPedido; nullable porque só
  // PEDIDO_ESPECIFICO preenche (obrigatoriedade condicional validada na
  // action, não constraint de banco).
  origem      OrigemSolicitacaoCompra @default(REPOSICAO_ESTOQUE)
  origemOutro String?
  pedidoId    String?

  // Achado A9 da auditoria de abrangência (Parte 3/Compras, 2026-08-30) —
  // preenchido só quando origem=CONTRATO_PROGRAMADO: o contrato de
  // fornecimento que autorizou esta solicitação a nascer direto em APROVADO
  // (fornecedor/preço copiados dele, ver criarSolicitacaoCompra em
  // src/app/compras/actions.ts). SetNull: apagar o contrato (hoje sem fluxo
  // de exclusão, só alternarAtivoContratoFornecimento) não pode apagar o
  // histórico da compra, só perde a referência de qual contrato a originou.
  contratoFornecimentoId String?

  usuarioSolicitanteId String
  usuarioAprovadorId   String?

  // Datas de cada transição relevante. LogAuditoria (registrarAuditoria) já
  // cobre "quem fez o quê e quando" de forma genérica pra toda a aplicação,
  // mas a tela de detalhe desta solicitação precisa montar sua própria linha
  // do tempo sem depender de outra tabela — por isso datas dedicadas aqui,
  // igual o resto do schema faz (ex: Pedido.arteAprovadaEm). SOLICITADO
  // nasce preenchido (solicitadoEm = createdAt); as demais começam null e são
  // preenchidas por avancarStatusCompra na hora de cada transição.
  solicitadoEm DateTime  @default(now())
  cotandoEm    DateTime?
  aprovadoEm   DateTime?
  compradoEm   DateTime?
  recebidoEm   DateTime?
  conferidoEm  DateTime?
  canceladoEm  DateTime?

  // Nº da nota fiscal da compra — mesmo papel de MovimentacaoEstoque.documento;
  // copiado pra lá quando a entrada é gerada em RECEBIDO.
  documento String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica             Grafica               @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  // Restrict, mesmo raciocínio de MovimentacaoEstoque.itemGrafica: hoje não
  // existe fluxo que apague um ItemGrafica, isto é só defensivo.
  itemGrafica         ItemGrafica           @relation(fields: [itemGraficaId], references: [id], onDelete: Restrict)
  // SetNull: desativar/apagar uma variante não pode apagar a solicitação —
  // ela só perde a referência de qual variante era o alvo.
  variante            VarianteMateriaPrima? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  fornecedor          Fornecedor?           @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  usuarioSolicitante  Usuario               @relation("SolicitacoesCompraSolicitadas", fields: [usuarioSolicitanteId], references: [id])
  usuarioAprovador    Usuario?              @relation("SolicitacoesCompraAprovadas", fields: [usuarioAprovadorId], references: [id])
  // SetNull, mesmo raciocínio de MovimentacaoEstoque.pedido: apagar um
  // Pedido (hoje não existe fluxo que apague) não pode apagar a solicitação
  // de compra, só perde a referência de qual pedido a originou.
  pedido              Pedido?               @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  // Achado A9 da auditoria de abrangência (Parte 3/Compras) — ver comentário
  // do campo contratoFornecimentoId acima.
  contratoFornecimento ContratoFornecimento? @relation(fields: [contratoFornecimentoId], references: [id], onDelete: SetNull)
  // Lado inverso de MovimentacaoEstoque.solicitacaoCompraId (FK mora lá, não
  // aqui) — a entrada de estoque gerada ao confirmar RECEBIDO.
  movimentacaoEstoque MovimentacaoEstoque?
  // Cotações registradas de cada fornecedor consultado (ver model
  // CotacaoFornecedor abaixo) — achado A4 da auditoria de abrangência.
  cotacoes            CotacaoFornecedor[]
  // Lado inverso de CustoPedido.solicitacaoCompraId — o CustoPedido origem
  // COMPRA gerado ao confirmar RECEBIDO quando pedidoId está preenchido
  // (achado A3 da auditoria de abrangência).
  custoPedidoGerado   CustoPedido?

  @@index([graficaId, status])
  @@index([itemGraficaId])
  @@index([varianteId])
  @@index([fornecedorId])
  @@index([usuarioSolicitanteId])
  @@index([pedidoId])
  @@index([contratoFornecimentoId])
  @@map("solicitacoes_compra")
}

// Achado A9 da auditoria de abrangência (Parte 3/Compras, 2026-08-30) —
// contrato de fornecimento com preço fixo por período, prática corrente pra
// gráfica de volume alto que dispensa cotação a cada reposição. Antes disto,
// nada representava um acordo contínuo: ItemGrafica.precoCompra e
// TabelaPrecoPapel.precoKg são preços de REFERÊNCIA, sem vigência nem
// fornecedor associado. Dá função de verdade a
// OrigemSolicitacaoCompra.CONTRATO_PROGRAMADO (enum existia desde a rodada 14
// da auditoria sem nenhum comportamento associado) — ver
// criarSolicitacaoCompra em src/app/compras/actions.ts: uma solicitação
// criada com essa origem, vinculada a um contrato ativo e dentro da
// vigência, nasce direto em APROVADO (fornecedor e preço copiados do
// contrato), sem passar por COTANDO.
//
// itemGraficaId/varianteId são OPCIONAIS (validado em app, não em constraint
// de banco — mesmo padrão do resto do schema): null em itemGraficaId é
// contrato "coringa" que cobre qualquer matéria-prima deste fornecedor; null
// em varianteId com itemGraficaId preenchido cobre qualquer variante deste
// item — ver contratosAplicaveis em src/lib/contrato-fornecimento.ts.
//
// precoUnitario é sempre por UNIDADE DE ESTOQUE (a mesma unidade de
// SolicitacaoCompra.quantidade) — unidadeCompra aqui é só INFORMATIVO (rótulo
// de como o preço foi negociado, ex: "R$/fardo" na tela), sem fator de
// conversão próprio: se o preço foi negociado numa unidade comercial
// diferente da unidade de estoque, quem cadastra o contrato já digita
// precoUnitario convertido pra unidade de estoque (fora de escopo desta
// rodada acoplar isso ao fator de conversão do achado A6, trabalho em
// paralelo). Reusa o enum UnidadeCompra (achado A6) em vez de duplicar;
// unidadeCompraOutro é texto livre só usado quando unidadeCompra=OUTRO,
// mesmo padrão do resto do schema.
//
// quantidadeConsumida só CRESCE, incrementada via increment() do Prisma
// dentro da MESMA transação que já confirma RECEBIDO (ver
// avancarStatusCompra em src/app/compras/status-transicao.ts) — nunca
// lê-modifica-grava em passos separados, pra não perder incremento sob
// concorrência. quantidadeContratada é o teto opcional (contrato "preço
// travado, sem teto de volume" também é comum) — ver
// listarContratosProximosDoLimite em src/lib/contrato-fornecimento.ts pro
// alerta de esgotamento de quantidade/vigência.
model ContratoFornecimento {
  id        String @id @default(cuid())
  graficaId String

  fornecedorId  String
  itemGraficaId String?
  varianteId    String?

  precoUnitario      Decimal       @db.Decimal(12, 4)
  unidadeCompra      UnidadeCompra
  unidadeCompraOutro String?

  vigenciaInicio DateTime @db.Date
  vigenciaFim    DateTime @db.Date

  quantidadeContratada Decimal? @db.Decimal(12, 4)
  quantidadeConsumida  Decimal  @default(0) @db.Decimal(12, 4)

  condicaoPagamento String? // texto livre, mesmo padrão de CotacaoFornecedor.condicaoPagamento
  observacao        String?

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica    Grafica    @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  // Restrict: um fornecedor com contrato cadastrado nunca deveria ser
  // excluído de verdade (hoje nem existe fluxo de exclusão física de
  // Fornecedor, só alternarAtivoFornecedor) — puramente defensivo.
  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  // SetNull: desativar/remover o item ou a variante não apaga o contrato, só
  // perde o escopo específico e passa a valer como "coringa" pro fornecedor
  // (mesmo raciocínio de SolicitacaoCompra.varianteId).
  itemGrafica ItemGrafica?          @relation(fields: [itemGraficaId], references: [id], onDelete: SetNull)
  variante    VarianteMateriaPrima? @relation(fields: [varianteId], references: [id], onDelete: SetNull)

  // Lado inverso de SolicitacaoCompra.contratoFornecimentoId — todas as
  // solicitações nascidas via este contrato (origem=CONTRATO_PROGRAMADO).
  solicitacoesCompra SolicitacaoCompra[]

  @@index([graficaId, ativo])
  @@index([fornecedorId])
  @@index([itemGraficaId])
  @@index([varianteId])
  @@map("contratos_fornecimento")
}

// Uma cotação de um fornecedor específico pra uma SolicitacaoCompra — "mapa
// de cotação" padrão dos ERPs brasileiros (achado A4 da auditoria de
// abrangência, Parte 3/Compras): antes disso, a transição SOLICITADO/
// COTANDO→APROVADO só guardava um único fornecedorId+valorEstimado, sem
// forma de registrar "Suzano cotou R$5,20/kg em 10 dias, boleto 30; Ibema
// R$5,45 em 3 dias, à vista" e depois escolher entre eles. Diferente de
// ComparativoFornecedoresCard (src/lib/comparativo-fornecedores.ts), que é
// histórico RETROSPECTIVO derivado de compras já recebidas — este model é
// cotação ATIVA, criada durante o fluxo de uma solicitação específica, antes
// de qualquer compra de fato acontecer.
//
// condicaoPagamento é texto livre de propósito: não existe no schema um
// enum que sirva pra condição de COMPRA ("à vista", "boleto 30/60/90",
// "antecipado") — FormaPagamento (usado em Pagamento/Despesa) é sobre o
// MEIO de pagamento de uma venda (PIX/cartão/boleto como forma), conceito
// diferente. Fechar um enum agora sem uso real validado seria hardcode
// prematuro (ver princípio "configurabilidade em vez de hardcode").
//
// @@unique([solicitacaoCompraId, fornecedorId]): um fornecedor tem NO MÁXIMO
// uma cotação vigente por solicitação — recotar o mesmo fornecedor
// atualiza a linha existente (upsert), nunca duplica.
model CotacaoFornecedor {
  id                  String @id @default(cuid())
  solicitacaoCompraId String
  fornecedorId        String

  precoUnitario     Decimal   @db.Decimal(12, 4)
  valorTotal        Decimal   @db.Decimal(12, 2)
  prazoEntregaDias  Int?
  condicaoPagamento String?
  validaAte         DateTime?
  frete             Decimal?  @db.Decimal(12, 2)
  observacao        String?

  // Só uma cotação por solicitação pode ser vencedora — garantido em
  // código (definirCotacaoVencedora zera as demais na mesma transação),
  // não em constraint de banco (um índice único parcial "por
  // solicitacaoCompraId onde vencedora=true" exigiria SQL específico do
  // Postgres fora do que o Prisma schema expressa direto; a rota de
  // escrita é única — sempre via essa mesma action — então o risco de
  // divergência é baixo).
  vencedora Boolean @default(false)

  registradaPorId String
  createdAt       DateTime @default(now())

  solicitacaoCompra SolicitacaoCompra @relation(fields: [solicitacaoCompraId], references: [id], onDelete: Cascade)
  fornecedor        Fornecedor        @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  registradaPor     Usuario           @relation(fields: [registradaPorId], references: [id])

  @@unique([solicitacaoCompraId, fornecedorId])
  @@index([solicitacaoCompraId])
  @@index([fornecedorId])
  @@map("cotacoes_fornecedor")
}

enum StatusOrcamento {
  RASCUNHO
  ENVIADO
  APROVADO
  REJEITADO
}

enum TipoPedidoOrcamento {
  MODELO_NOVO
  REPETICAO_SEM_ALTERACAO
  REPETICAO_COM_ALTERACAO
}

// Os 6 valores oficiais de modFrete do layout NF-e 4.0 — achado B1 da
// auditoria de abrangência (2026-08-24): o enum só cobria CIF/FOB (modFrete
// 0/1), faltando os outros 4, o mais importante sendo SEM_FRETE (modFrete 9
// = "Sem Ocorrência de Transporte"), que é o caso mais comum de gráfica
// rápida (retirada no balcão). Ver resolverModalidadeFrete em
// src/lib/nota-fiscal.ts pro mapeamento pro código que a Focus NFe espera.
enum TipoFrete {
  CIF_REMETENTE // modFrete 0 — por conta do emitente
  FOB_DESTINATARIO // modFrete 1 — por conta do destinatário
  TERCEIROS // modFrete 2
  PROPRIO_REMETENTE // modFrete 3 — transporte próprio, por conta do remetente
  PROPRIO_DESTINATARIO // modFrete 4 — transporte próprio, por conta do destinatário
  SEM_FRETE // modFrete 9 — sem ocorrência de transporte (ex: retirada no balcão)
}

model Orcamento {
  id               String          @id @default(cuid())
  graficaId        String
  clienteId        String
  usuarioId        String
  status           StatusOrcamento @default(RASCUNHO)
  total            Decimal         @default(0) @db.Decimal(12, 2)
  linkPublicoToken String?         @unique

  // Quem respondeu pelo link público, e quando. Nome DECLARADO, não
  // verificado — quem tem o link digita o que quiser. Vale como registro
  // (mesma força de uma assinatura em formulário de papel), não como prova
  // de identidade: a tela deve dizer "aceito por", nunca "confirmado por".
  // Fica separado de LogAuditoria de propósito — aquele responde "qual
  // FUNCIONÁRIO mexeu", este responde "qual pessoa do CLIENTE respondeu",
  // e misturar os dois exigiria usuarioId nulo lá, enfraquecendo o log
  // interno justamente onde ele precisa ser firme.
  respostaPublicaNome   String?
  respostaPublicaEm     DateTime?
  // Quando o orçamento virou ENVIADO pela última vez (gerarLinkPublico ou
  // atualizarStatusOrcamento) — âncora da lista de "orçamentos parados"
  // (ver orcamentoEstaParado em src/lib/orcamento-status.ts). Zerado quando
  // o cliente pede ajuste (volta pra RASCUNHO) e recalculado do zero ao
  // reenviar, mesmo ciclo de vida de validoAteEm logo abaixo — mas
  // deliberadamente um campo PRÓPRIO, não derivado de validoAteEm menos
  // diasValidadeOrcamentoPadrao: esse cálculo quebraria se a gráfica mudasse
  // diasValidadeOrcamentoPadrao depois do envio, ou quando renovarValidadeOrcamento
  // empurra validoAteEm pra frente sem reenviar de fato. null = nunca foi
  // enviado (RASCUNHO) ou orçamento criado antes desta feature.
  enviadoEm             DateTime?
  // Motivo escrito PELO CLIENTE ao recusar, no próprio link público.
  // Diferente de `observacoes` (nota interna da gráfica, logo abaixo): este
  // texto veio de fora e é o que o vendedor precisa ler pra saber se perdeu
  // por preço, por prazo ou por arte. Vai junto no e-mail de recusa.
  respostaPublicaMotivo String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Opcional de propósito — gráfica sem filial cadastrada nunca vê esse
  // campo no formulário. Filiais COMPARTILHAM catálogo/estoque/financeiro
  // da gráfica (ver model Filial): isto é só um rótulo de "onde esse
  // orçamento foi feito", pra relatório, não um tenant separado.
  filialId String?

  // Dados gerais do pedido — todos opcionais, editáveis a qualquer status
  // (não só RASCUNHO: frete/transportadora normalmente só são definidos
  // depois que o cliente já aprovou, e nenhum desses campos entra na conta
  // de preço). contatoNome/contatoEmail são um snapshot específico DESTE
  // pedido, diferente de Cliente.nome/Cliente.email (que são o cadastro).
  vendedor                 String?
  tipoPedido               TipoPedidoOrcamento?
  contatoNome              String?
  contatoEmail             String?
  // Achado A4 da Parte 5 — quando o vendedor escolhe um ContatoCliente
  // cadastrado (em vez de digitar contatoNome/contatoEmail à mão), este id
  // fica salvo aqui. FK opcional que CONVIVE com o snapshot em texto acima
  // (mesmo precedente de Comissao/opcaoEscolhidaNome): escolher um contato
  // pré-preenche o snapshot, mas o snapshot continua sendo o que aparece no
  // PDF/link público — nunca lido daqui, pra não quebrar se o contato for
  // editado ou desativado depois de o orçamento já ter sido enviado.
  // SetNull: contato excluído (nunca acontece de verdade, é soft-delete via
  // ContatoCliente.ativo) não pode travar nada, só perde o vínculo.
  contatoClienteId         String?
  condicoesPagamento       String?
  // Achado A7 da Parte 4 da auditoria de abrangência (2026-08-28) — FK
  // opcional pra CondicaoPagamento (parcelas ESTRUTURADAS, com âncora e
  // percentuais), convivendo lado a lado com `condicoesPagamento` acima
  // (texto livre, exibido no PDF, continua existindo pra quem prefere
  // digitar). Só usado hoje pra gerar ContaReceber automaticamente na
  // aprovação (âncora APROVACAO — ver atualizarStatusOrcamento em
  // src/app/orcamento/[id]/actions.ts e responderOrcamentoPublico em
  // src/app/o/[token]/actions.ts); âncoras EMISSAO_NOTA/ENTREGA ainda não
  // têm gatilho automático plumbado (ver comentário em AncoraVencimento).
  // SetNull: apagar a condição de pagamento (nunca acontece de verdade, é
  // soft-delete via CondicaoPagamento.ativa) não pode travar o orçamento,
  // só perde o vínculo — o texto livre continua valendo.
  condicaoPagamentoId      String?
  frete                    TipoFrete?
  transportadora           String?
  localEntrega             String?
  // Achado A5 da Parte 5 da auditoria de abrangência (2026-08-28) — quando o
  // vendedor escolhe um EnderecoCliente cadastrado (normalmente tipo
  // ENTREGA) em vez de digitar `localEntrega` à mão, este id fica salvo
  // aqui. FK opcional que CONVIVE com o texto livre acima (mesmo precedente
  // de contatoClienteId/contatoNome, achado A4): escolher um endereço
  // pré-preenche `localEntrega`, mas o texto livre continua sendo o que
  // aparece no PDF/Ordem de Produção — nunca lido daqui, pra não quebrar se
  // o endereço for editado ou desativado depois de o orçamento já enviado.
  // SetNull: endereço excluído (nunca acontece de verdade, é soft-delete via
  // EnderecoCliente.ativo) não pode travar nada, só perde o vínculo.
  enderecoEntregaId        String?
  // Estimativa em DIAS, preenchida pelo vendedor ANTES do cliente decidir —
  // distinto de Pedido.prazoEntrega (data CONFIRMADA, só existe depois da
  // aprovação). Um é promessa pré-venda em dias, o outro é compromisso
  // pós-venda com data fixa — nunca unificar os dois.
  prazoEntregaEstimadoDias Int?
  // Data-limite computada até quando a proposta vale — não é um novo valor
  // de StatusOrcamento (evita cron job): orcamentoEstaExpirado() em
  // src/lib/orcamento-status.ts considera o orçamento vencido mesmo com
  // status=ENVIADO no banco. Calculado uma vez, quando o orçamento vira
  // ENVIADO (gerarLinkPublico/atualizarStatusOrcamento), a partir de
  // ParametrosGrafica.diasValidadeOrcamentoPadrao. Zerado quando o cliente
  // pede ajuste (volta pra RASCUNHO) e recalculado do zero ao reenviar.
  // null = nunca expira (todo orçamento criado antes desta feature).
  validoAteEm              DateTime?
  // Variação admissível entre a quantidade contratada e a entregue, em %,
  // snapshotada de ParametrosGrafica.toleranciaTiragemPadraoPercent no
  // momento do ENVIO — mesmo ciclo de vida de validoAteEm acima: zerada
  // quando o cliente pede ajuste (volta pra RASCUNHO) e recalculada do
  // zero ao reenviar. Aparece no PDF (src/lib/pdf/OrcamentoDocumento.tsx)
  // como respaldo contratual pra faturar a quantidade real. null = ainda
  // em RASCUNHO/nunca enviado, ou orçamento criado antes desta feature.
  toleranciaTiragemPercent Decimal?             @db.Decimal(5, 2)
  // Achado A12 da Parte 5 da auditoria de abrangência (2026-08-30) — campos
  // opcionais pra cliente órgão público. Aparecem no PDF quando preenchidos.
  // Não é uma modelagem de licitação, é só o mínimo pra o faturamento não
  // travar (empenho autoriza a entrega, processo/pregão fica pra referência).
  notaEmpenho              String?
  processoLicitatorio      String?
  // Nota interna — nunca aparece no PDF nem no link público (ver
  // src/lib/pdf/mapear-dados.ts), só na tela autenticada da gráfica.
  observacoes              String?

  // Arte anexada já na criação do orçamento, pro cliente ver junto da
  // proposta (ver /o/[token]). Só visualização — a APROVAÇÃO de arte de
  // verdade continua em Pedido.arteUrl/arteAprovadaEm, sem mudança nenhuma
  // nesse fluxo. Editável só enquanto o orçamento está em RASCUNHO (mesma
  // regra dos outros campos editáveis desta tela). Quando o orçamento vira
  // Pedido, este valor é copiado pra Pedido.arteUrl automaticamente (ver
  // orcamento/[id]/actions.ts e o/[token]/actions.ts).
  arteUrl String?

  // Achados do preflight automático rodado no momento do upload (ver
  // src/lib/preflight.ts) — array de { checagem, severidade, mensagem }.
  // null = arquivo ainda não passou pelo preflight (nunca teve arte
  // enviada, ou foi enviada antes desta feature existir). Recalculado do
  // zero a cada novo upload (nunca acumula achado de um arquivo antigo).
  // v1 cobre: DPI efetivo (raster) e sangria via MediaBox×TrimBox (PDF) —
  // NÃO tenta detectar CMYK/RGB dentro do conteúdo de um PDF já pronto
  // (só é confiável pra imagem raster), nem checar fonte embutida ainda.
  preflightAvisos Json?

  // Rastreamento de etapas de produção (data+hora combinados, mesmo padrão
  // de arteAprovadaEm) + nome de quem é responsável — não precisa ser o
  // usuário logado, por isso é texto livre e não uma FK pra Usuario. Editável
  // direto (não é um log de eventos), a qualquer status. etapaConfirmacaoPedido*
  // corresponde à etapa "Pedido" do formulário físico original — nome do
  // campo é diferente pra não colidir com o model Pedido (produção) já
  // existente neste schema.
  etapaOrcamentoDesenvolvimentoEm          DateTime?
  etapaOrcamentoDesenvolvimentoResponsavel String?
  etapaLayoutEm                            DateTime?
  etapaLayoutResponsavel                   String?
  etapaAprovacaoEm                         DateTime?
  etapaAprovacaoResponsavel                String?
  etapaConfirmacaoPedidoEm                 DateTime?
  etapaConfirmacaoPedidoResponsavel        String?
  etapaEntregaEm                           DateTime?
  etapaEntregaResponsavel                  String?

  // Preenchido quando este orçamento nasceu do botão "Pedir de novo" (ver
  // duplicarOrcamento em src/app/orcamento/[id]/actions.ts) — rastreio pra um
  // futuro relatório de "quantos pedidos são reposição". Nunca influencia
  // preço/itens do novo orçamento (esses são sempre recalculados do zero a
  // partir do catálogo atual, nunca copiados) — é só um vínculo informativo.
  // SetNull: hoje só é possível apagar um Orcamento em RASCUNHO
  // (cancelarOrcamento), e "Pedir de novo" só é oferecido a partir de
  // APROVADO/REJEITADO, então isto não deveria disparar na prática — mas se
  // um dia mudar, o duplicado não pode ficar travado por causa disso, só
  // perde a referência.
  duplicadoDeId String?

  // Nome da OrcamentoOpcao (ou "Opção A" pra opção-base) que o cliente
  // escolheu, congelado no momento da aprovação — só preenchido quando o
  // orçamento chegou a ter opções alternativas (ver model OrcamentoOpcao).
  // null pra todo orçamento que nunca teve opção nenhuma (o caso de sempre),
  // inclusive todo orçamento aprovado ANTES desta feature — snapshot, nunca
  // uma FK (a OrcamentoOpcao escolhida é apagada na promoção, ver
  // src/lib/orcamento-opcoes.ts), mesmo princípio de Comissao.baseCalculo.
  opcaoEscolhidaNome String?

  grafica           Grafica            @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  cliente           Cliente            @relation(fields: [clienteId], references: [id])
  usuario           Usuario            @relation(fields: [usuarioId], references: [id])
  filial            Filial?            @relation(fields: [filialId], references: [id], onDelete: SetNull)
  contatoCliente    ContatoCliente?    @relation(fields: [contatoClienteId], references: [id], onDelete: SetNull)
  condicaoPagamento CondicaoPagamento? @relation(fields: [condicaoPagamentoId], references: [id], onDelete: SetNull)
  enderecoEntrega   EnderecoCliente?   @relation(fields: [enderecoEntregaId], references: [id], onDelete: SetNull)
  itens             OrcamentoItem[]
  opcoes            OrcamentoOpcao[]
  pedido            Pedido?
  notaFiscal        NotaFiscal?
  comissao          Comissao?
  duplicadoDe       Orcamento?         @relation("DuplicacaoOrcamento", fields: [duplicadoDeId], references: [id], onDelete: SetNull)
  duplicados        Orcamento[]        @relation("DuplicacaoOrcamento")

  pagamentos                  Pagamento[]
  contasReceber               ContaReceber[]
  movimentacoesCreditoCliente MovimentacaoCreditoCliente[]

  @@index([graficaId])
  @@index([filialId])
  @@index([duplicadoDeId])
  @@index([contatoClienteId])
  @@index([condicaoPagamentoId])
  @@index([enderecoEntregaId])
  // Query da lista de "orçamentos parados" (ver /orcamento/parados) —
  // filtra por graficaId+status=ENVIADO e ordena por enviadoEm.
  @@index([graficaId, status, enviadoEm])
  // Achado A10 da Parte 5 da auditoria de abrangência (2026-08-30) — toda
  // consulta "orçamentos/faturamento deste cliente" (ficha do cliente,
  // relatorios-negocio.ts) filtrava por clienteId sem nenhum índice
  // dedicado, varrendo por graficaId inteiro. graficaId primeiro (mesmo
  // padrão de [graficaId, status, enviadoEm] acima) porque toda query já
  // filtra por tenant de qualquer forma.
  @@index([graficaId, clienteId])
  @@map("orcamentos")
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO
  BOLETO
  TRANSFERENCIA
  OUTRO
}

// Registro de pagamento (entrada, parcela, quitação) de um orçamento aprovado. Saldo
// devedor é sempre calculado (total - soma dos pagamentos), nunca armazenado — evita
// dessincronia. Só criado com o orçamento em APROVADO (ver registrarPagamento).
model Pagamento {
  id           String         @id @default(cuid())
  orcamentoId  String
  valor        Decimal        @db.Decimal(12, 2)
  forma        FormaPagamento
  // Só usado quando forma = OUTRO (cheque, vale-troca, permuta...) — sem
  // isso "Outro" virava caixa preta sem detalhe nenhum nos relatórios.
  formaDetalhe String?
  observacao   String?
  createdAt    DateTime       @default(now())

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  // Presente quando este pagamento foi gerado a partir de "marcar conta a
  // receber como recebida" (ver marcarComoRecebido em
  // src/app/financeiro/contas-receber/actions.ts) — decisão revista em
  // 2026-08-15: o comentário original de ContaReceber (acima) dizia que os
  // dois conviviam sem se referenciar, mas isso deixava a exportação
  // financeira subestimando receita sempre que alguém usava o botão
  // "Marcar como recebido" em vez de lançar Pagamento manual na tela do
  // orçamento. Mesmo padrão de Despesa.comissao. Risco aceito: se alguém
  // fizer as duas coisas pro mesmo dinheiro, ele conta 2x — não há
  // deduplicação automática entre os dois caminhos.
  contaReceber ContaReceber?

  // Presente quando este pagamento é a origem de um DEPOSITO de
  // CreditoCliente (ver MovimentacaoCreditoCliente.pagamentoId) — cliente
  // pagou a mais num orçamento aprovado e a diferença virou saldo. null no
  // caminho comum de depósito adiantado (sem Pagamento nenhum envolvido).
  movimentacaoCreditoCliente MovimentacaoCreditoCliente?

  // Baixas (recebimento total ou parcial) de ContaReceber financiadas por
  // este pagamento — achado A8 da Parte 4. Só populado pelo caminho NOVO
  // (registrarBaixaContaReceber / fechamento automático de saldo parcial em
  // registrarPagamento); o caminho antigo de valor EXATO continua usando só
  // ContaReceber.pagamentoId acima, sem nenhuma linha aqui. Ver comentário em
  // BaixaContaReceber abaixo.
  baixasContaReceber BaixaContaReceber[]

  @@index([orcamentoId])
  @@map("pagamentos")
}

// PARCIAL — achado A8 da Parte 4 da auditoria de abrangência (2026-08-29):
// até então PENDENTE/PAGA era tudo-ou-nada, sem jeito de registrar um
// pagamento que cobre só parte do valor (ex: acordo de pagar metade agora).
// Ver model PagamentoDespesa abaixo.
enum StatusDespesa {
  PENDENTE
  PARCIAL
  PAGA
}

// Unidade de avanço de uma série recorrente de Despesa — ver
// src/lib/despesa-recorrente.ts pra como cada valor avança a data de
// vencimento. MENSAL é @default porque era o único comportamento que
// existia antes deste campo (achado A14 da auditoria de abrangência).
enum PeriodicidadeDespesa {
  SEMANAL
  QUINZENAL
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

// Contraparte de Pagamento: dinheiro SAINDO da gráfica (fornecedor, aluguel,
// conta fixa), não entrando. descricao continua texto livre; categoria
// também continua existindo como texto livre (histórico), mas agora tem um
// par estruturado opcional (categoriaCustoId) reaproveitando o MESMO
// CategoriaCusto já usado em CustoPedido — evita "Aluguel" vs "aluguel" vs
// "ALUGUEL " quebrando agrupamento em relatório. Fornecedor JÁ é modelo
// relacional configurável hoje (ver model Fornecedor), só não tem vínculo
// com Despesa ainda.
//
// status/pagoEm nunca são editados por um form genérico de edição — só pelas
// actions marcarComoPaga/marcarComoPendente (ver src/app/financeiro/actions.ts),
// pra nunca existir uma combinação inconsistente tipo "paga sem data de pagamento".
//
// vencimento é a PRIMEIRA data-pura (sem hora) do schema inteiro — guardada
// sempre como meia-noite UTC (`${valor}T00:00:00Z`) e SEMPRE exibida com
// `timeZone: "UTC"` no formatador (src/lib/data.ts), pra não variar um dia
// conforme o fuso de quem tá vendo. Todo campo de data-pura futuro deve
// seguir o mesmo padrão.
model Despesa {
  id                    String          @id @default(cuid())
  graficaId             String
  descricao             String
  categoria             String?
  categoriaCustoId      String? // par estruturado opcional de `categoria` (ver comentário acima)
  valor                 Decimal         @db.Decimal(12, 2)
  vencimento            DateTime
  status                StatusDespesa   @default(PENDENTE)
  formaPagamento        FormaPagamento?
  // Só usado quando formaPagamento = OUTRO — mesmo par de Pagamento.formaDetalhe.
  formaPagamentoDetalhe String?
  pagoEm                DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Recorrência: recorrente=true marca que essa ocorrência faz parte de uma
  // série. serieRecorrenciaId agrupa as ocorrências da mesma série
  // (a primeira ocorrência recebe o próprio id como serieRecorrenciaId — ver
  // criarDespesa). Só a ocorrência de VENCIMENTO MAIS RECENTE de uma série é
  // consultada pra decidir se gera a próxima (ver src/lib/despesa-recorrente.ts)
  // — então desmarcar "recorrente" só nessa ocorrência mais recente já
  // encerra a série, sem precisar tocar nas anteriores.
  recorrente         Boolean              @default(false)
  serieRecorrenciaId String?
  // Unidade de avanço da série — ver enum PeriodicidadeDespesa acima.
  // @default(MENSAL) preserva o comportamento de toda série criada antes
  // deste campo existir, sem precisar de backfill.
  periodicidade      PeriodicidadeDespesa @default(MENSAL)
  // Série para de gerar novas ocorrências quando a PRÓXIMA ocorrência
  // ultrapassaria essa data — as ocorrências já geradas antes disso
  // continuam existindo normalmente. null = sem fim (comportamento de hoje).
  recorrenciaAteEm   DateTime?            @db.Date
  // true: cada ocorrência nova nasce com valor 0 ("a confirmar") em vez de
  // copiar o valor da anterior — pra série cujo valor muda a cada vencimento
  // (ex: conta de luz/água). false (default): copia o valor da ocorrência
  // anterior, como sempre foi.
  valorVariavel      Boolean              @default(false)

  grafica        Grafica         @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  // SetNull, não Restrict: uma categoria de custo nunca é apagada de
  // verdade (só desativada, ativa=false), mas se algum dia for, a despesa
  // não pode ficar travada por causa disso — só perde o vínculo estruturado,
  // o texto livre em `categoria` continua intacto.
  categoriaCusto CategoriaCusto? @relation(fields: [categoriaCustoId], references: [id], onDelete: SetNull)

  // Presente quando esta despesa foi gerada a partir de "marcar comissão
  // como paga" (ver marcarComissaoPaga em src/app/financeiro/comissoes/actions.ts)
  // — deixa o pagamento aparecer no relatório/exportação financeira normal
  // sem duplicar os campos de Comissao aqui.
  comissao Comissao?

  // Presente quando esta despesa foi gerada a partir de uma RECARGA de conta
  // prepaga (ver lancarMovimentacaoContaPrepaga em
  // src/app/financeiro/contas-prepagas/actions.ts) — mesmo padrão de
  // Despesa.comissao acima, pra recarga de carteira (ex: Lalamove) não ficar
  // de fora do relatório/exportação financeira.
  movimentacaoContaPrepaga MovimentacaoContaPrepaga?

  // Cada baixa (total ou parcial) registrada contra esta despesa — achado A8
  // da Parte 4. Ver model PagamentoDespesa abaixo e saldoDespesa em
  // src/lib/baixa-financeira.ts pra como o saldo em aberto é sempre
  // recalculado a partir daqui, nunca armazenado.
  pagamentosDespesa PagamentoDespesa[]

  // Trava contra duplicata em `gerarDespesasRecorrentesPendentes`: duas
  // requisições concorrentes (duas abas, dois usuários abrindo /financeiro
  // ao mesmo tempo) podem ambas decidir gerar a ocorrência do mesmo mês
  // pra mesma série — essa constraint faz a segunda tentativa falhar no
  // banco em vez de criar uma despesa duplicada (ver catch de P2002 lá).
  @@unique([serieRecorrenciaId, vencimento])
  @@index([graficaId])
  @@index([graficaId, status, vencimento])
  @@index([graficaId, serieRecorrenciaId])
  @@map("despesas")
}

// Uma baixa (pagamento total ou parcial) contra uma Despesa — achado A8 da
// Parte 4 da auditoria de abrangência (2026-08-29). Despesa nunca teve um
// model de "pagamento" próprio como Orcamento tem (Pagamento): status/pagoEm/
// formaPagamento viviam direto nela, tudo-ou-nada. Esta tabela passa a ser a
// fonte de verdade de CADA pagamento registrado (1:N simples — diferente de
// BaixaContaReceber, que é N:N porque ali Pagamento já existe como entidade
// própria e uma linha pode em tese quitar mais de uma ContaReceber). Os
// campos status/pagoEm/formaPagamento/formaPagamentoDetalhe em Despesa
// continuam existindo e refletem o estado mais recente (pra não quebrar
// nenhuma tela que já lê direto de lá), mas o saldo em aberto é sempre
// recalculado a partir da soma destas linhas — ver saldoDespesa em
// src/lib/baixa-financeira.ts. Criada só por marcarComoPaga (mesmo cuidado
// de status/pagoEm de Despesa: nunca editada por form genérico).
model PagamentoDespesa {
  id           String         @id @default(cuid())
  despesaId    String
  valor        Decimal        @db.Decimal(12, 2)
  forma        FormaPagamento
  // Só usado quando forma = OUTRO — mesmo par de Pagamento.formaDetalhe.
  formaDetalhe String?
  observacao   String?
  createdAt    DateTime       @default(now())

  despesa Despesa @relation(fields: [despesaId], references: [id], onDelete: Cascade)

  @@index([despesaId])
  @@map("pagamentos_despesa")
}

// Saldo prepago tipo "vale" (ex: carteira de um serviço de entrega como
// Lalamove) — diferente de Despesa, que é conta a pagar; aqui o dinheiro já
// saiu antes, numa recarga, e cada uso (corrida, envio) só debita de um
// saldo que a gráfica precisa monitorar pra não ficar negativo/zerado.
// saldoAtual é cache redundante da soma de MovimentacaoContaPrepaga — existe
// só pra não recalcular a soma inteira em toda leitura da tela; sempre
// atualizado na MESMA transação que cria a movimentação.
//
// Não confundir com CreditoCliente (achado A13 da auditoria de abrangência,
// 2026-08-27): isto aqui é a carteira da PRÓPRIA gráfica junto a um
// FORNECEDOR (ela deve/tem saldo lá). CreditoCliente é o sentido oposto —
// um CLIENTE da gráfica com saldo adiantado (ela deve pra ele). Modelos
// irmãos na mecânica (saldo sempre derivado das movimentações), opostos no
// sentido do dinheiro.
model ContaPrepaga {
  id         String   @id @default(cuid())
  graficaId  String
  nome       String // ex: "Lalamove"
  saldoAtual Decimal  @default(0) @db.Decimal(12, 2)
  ativa      Boolean  @default(true)
  createdAt  DateTime @default(now())

  grafica       Grafica                    @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  movimentacoes MovimentacaoContaPrepaga[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("contas_prepagas")
}

enum TipoMovimentacaoContaPrepaga {
  RECARGA
  DEBITO
}

model MovimentacaoContaPrepaga {
  id          String                       @id @default(cuid())
  contaId     String
  tipo        TipoMovimentacaoContaPrepaga
  valor       Decimal                      @db.Decimal(12, 2)
  motivo      String?
  criadoPorId String?
  createdAt   DateTime                     @default(now())

  // Despesa gerada quando tipo=RECARGA (só recarga é dinheiro saindo da
  // gráfica de verdade; débito só consome saldo já lançado antes) — ver
  // comentário em Despesa.movimentacaoContaPrepaga acima. Null pra DEBITO.
  despesaId String? @unique

  conta   ContaPrepaga @relation(fields: [contaId], references: [id], onDelete: Cascade)
  despesa Despesa?     @relation(fields: [despesaId], references: [id], onDelete: SetNull)

  @@index([contaId, createdAt])
  @@map("movimentacoes_conta_prepaga")
}

// Saldo adiantado que um CLIENTE tem com a gráfica (ex: conta corporativa
// B2B que deposita R$5.000 e vai consumindo em pedidos ao longo dos meses)
// — achado A13 da auditoria de abrangência (2026-08-27). Até aqui não havia
// onde registrar isso: Pagamento sempre exige um Orcamento APROVADO, que
// ainda nem existe no momento do depósito adiantado.
//
// Não confundir com ContaPrepaga (ver comentário lá): isto aqui é o sentido
// oposto — o CLIENTE tem saldo com a gráfica (ela deve pra ele), não a
// gráfica com um fornecedor. Mesma mecânica (saldo sempre derivado da soma
// das movimentações), sentido do dinheiro invertido.
//
// Saldo é SEMPRE calculado a partir da soma de MovimentacaoCreditoCliente
// (ver saldoCreditoCliente em src/lib/credito-cliente.ts) — deliberadamente
// SEM campo `saldo` armazenado aqui. Diferente de ContaPrepaga.saldoAtual
// (que é cache com precedente de corrida documentado ali): CONSUMO precisa
// reler o saldo real dentro da própria transação pra nunca deixar consumir
// mais do que existe (ver lançarConsumoCreditoCliente), e um cache
// incrementado fora dessa checagem reabriria exatamente a corrida que a
// validação existe pra fechar.
model CreditoCliente {
  id        String @id @default(cuid())
  clienteId String @unique

  cliente       Cliente                      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  movimentacoes MovimentacaoCreditoCliente[]

  @@map("creditos_cliente")
}

// AJUSTE cobre correção de lançamento errado (depósito duplicado, valor
// digitado errado) — pode ir em qualquer direção, por isso valorSinalizado
// (ver MovimentacaoCreditoCliente abaixo) permite negativo só pra este tipo.
// ESTORNO é sempre positivo (devolve saldo que tinha sido consumido, ex:
// pedido cancelado depois de abater do crédito).
enum TipoMovimentacaoCreditoCliente {
  DEPOSITO
  CONSUMO
  ESTORNO
  AJUSTE
}

model MovimentacaoCreditoCliente {
  id               String                         @id @default(cuid())
  creditoClienteId String
  tipo             TipoMovimentacaoCreditoCliente
  // Sempre positivo pra DEPOSITO/CONSUMO/ESTORNO (o `tipo` já diz a direção
  // — ver saldoCreditoCliente). Só AJUSTE aceita negativo, pra corrigir
  // lançamento indevido pra qualquer lado sem precisar de um tipo a mais.
  valor            Decimal                        @db.Decimal(12, 2)
  // Presente quando o consumo (ou um estorno de consumo) está ligado a um
  // orçamento específico — null pra DEPOSITO/AJUSTE, que não têm orçamento
  // nenhum envolvido. Não é @unique: um mesmo orçamento pode em tese ter um
  // CONSUMO e depois um ESTORNO (pedido cancelado).
  orcamentoId      String?
  // Presente quando um DEPOSITO já nasceu vinculado a um Pagamento existente
  // (ex: cliente pagou a mais num orçamento aprovado e a diferença virou
  // crédito) — evita esse valor contar 2x na exportação financeira, mesmo
  // padrão de ContaReceber.pagamentoId. @unique: um Pagamento nunca gera
  // mais de um depósito de crédito. null no caminho comum (depósito
  // adiantado lançado manualmente, sem Pagamento nenhum ainda — é
  // exatamente o caso que motivou este model, ver comentário em
  // CreditoCliente acima).
  pagamentoId      String?                        @unique
  descricao        String?
  criadoPorId      String?
  createdAt        DateTime                       @default(now())

  creditoCliente CreditoCliente @relation(fields: [creditoClienteId], references: [id], onDelete: Cascade)
  orcamento      Orcamento?     @relation(fields: [orcamentoId], references: [id], onDelete: SetNull)
  pagamento      Pagamento?     @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)

  @@index([creditoClienteId, createdAt])
  @@index([orcamentoId])
  @@map("movimentacoes_credito_cliente")
}

// PARCIAL — achado A8 da Parte 4 da auditoria de abrangência (2026-08-29):
// até então PENDENTE/RECEBIDO era tudo-ou-nada, e a reconciliação com
// Pagamento só casava em valor EXATO (ver comentário em registrarPagamento
// em src/app/orcamento/[id]/actions.ts) — um pagamento parcial ou com sobra
// não mexia em nada, deixando o sistema contar como recebido dinheiro que
// nunca entrou. Ver model BaixaContaReceber abaixo.
enum StatusContaReceber {
  PENDENTE
  PARCIAL
  RECEBIDO
  CANCELADO
}

// Uma parcela/pagamento esperado de um Orcamento aprovado — o par simétrico
// de Despesa (que é dinheiro SAINDO), mas pro dinheiro que o CLIENTE ainda
// deve. Pode haver várias linhas por orçamento (parcelamento). Até
// 2026-08-28 nunca era gerado automaticamente — o vendedor/financeiro
// cadastrava as parcelas manualmente na tela do orçamento aprovado (ver
// criarContaReceber em src/app/financeiro/contas-receber/actions.ts, que
// continua sendo o único caminho MANUAL). Achado A7 da Parte 4 da auditoria
// de abrangência: quando Orcamento.condicaoPagamentoId aponta pra uma
// CondicaoPagamento (parcelas estruturadas — ver model abaixo), as linhas
// daqui nascem automaticamente na aprovação, uma vez, como SNAPSHOT — nunca
// recalculadas/regeneradas se a condição mudar depois (mesma disciplina de
// Comissao).
//
// Diferente de Pagamento (que registra dinheiro JÁ recebido, sem noção de
// "esperado"/"vencimento"): ContaReceber é o lado da EXPECTATIVA — o que
// ainda falta cobrar e quando. Até 2026-08-15 os dois conviviam sem se
// referenciar; revisto porque isso deixava a exportação financeira (ver
// src/app/financeiro/exportar/route.ts, que só lê Pagamento) subestimando
// receita sempre que o recebimento era registrado por aqui (marcarComoRecebido)
// em vez de um Pagamento lançado manualmente na tela do orçamento. Agora
// marcarComoRecebido cria o Pagamento espelhado — ver pagamentoId abaixo.
//
// status/recebidoEm nunca são editados por um form genérico — só pelas
// actions registrarBaixaContaReceber/cancelarContaReceber (ver
// src/app/financeiro/contas-receber/actions.ts), mesmo cuidado de Despesa
// pra nunca existir "recebido sem data de recebimento".
model ContaReceber {
  id          String             @id @default(cuid())
  graficaId   String
  orcamentoId String
  descricao   String // ex: "Parcela 1/3", "Entrada", "Pagamento único"
  valor       Decimal            @db.Decimal(12, 2)
  vencimento  DateTime // data-pura (meia-noite UTC), mesmo padrão de Despesa.vencimento
  status      StatusContaReceber @default(PENDENTE)
  recebidoEm  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Pagamento gerado quando a conta é quitada NUM SÓ pagamento de valor
  // EXATO (caminho antigo, preservado 100% — ver registrarPagamento em
  // src/app/orcamento/[id]/actions.ts e registrarBaixaContaReceber). Quando a
  // conta é fechada por uma ou mais baixas parciais (ver BaixaContaReceber
  // abaixo), este campo continua null mesmo com status RECEBIDO — o(s)
  // pagamento(s) responsável(is) fica(m) só nas linhas de `baixas`. Os dois
  // caminhos nunca coexistem na mesma conta (ver saldoContaReceber em
  // src/lib/baixa-financeira.ts).
  pagamentoId String? @unique

  // Achado A10 da Parte 5 da auditoria de abrangência (2026-08-30) — antes só
  // dava pra chegar no cliente via ContaReceber → Orcamento → clienteId, o
  // que impedia um índice direto pra "quanto o cliente X me deve". Preenchida
  // na CRIAÇÃO a partir de Orcamento.clienteId (tanto no caminho automático,
  // gerarContasReceberDaAprovacao em src/lib/condicao-pagamento.ts, quanto no
  // manual, criarContaReceber em src/app/financeiro/contas-receber/actions.ts)
  // — nunca escrita depois disso. Sincronização garantida por construção:
  // alterarClienteOrcamento (src/app/orcamento/[id]/actions.ts) só permite
  // trocar o cliente enquanto o orçamento está em RASCUNHO, e ContaReceber só
  // nasce depois de APROVADO — o vínculo nunca pode dessincronizar. Nullable
  // + SetNull (mesmo padrão de Orcamento.duplicadoDeId): contas criadas antes
  // desta coluna existir (ou cujo cliente foi apagado — nunca acontece de
  // verdade, é soft-delete via Cliente.desativadoEm) não travam por causa
  // disso, só perdem o vínculo direto (ainda alcançável via orcamento.clienteId).
  clienteId String?

  grafica   Grafica    @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamento Orcamento  @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  cliente   Cliente?   @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  pagamento Pagamento? @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)

  // Baixas parciais (ou o fechamento final de uma conta que já teve baixas
  // parciais) — achado A8 da Parte 4. Vazio pra toda conta fechada pelo
  // caminho antigo (pagamentoId acima) ou ainda PENDENTE.
  baixas BaixaContaReceber[]

  @@index([graficaId, status, vencimento])
  @@index([orcamentoId])
  // Achado A10 da Parte 5 — ver comentário em clienteId acima. Sustenta a
  // consulta "contas em aberto/vencidas deste cliente" na ficha do cliente.
  @@index([clienteId])
  @@map("contas_a_receber")
}

// Uma baixa (recebimento total ou parcial) de uma ContaReceber financiada
// por um Pagamento — achado A8 da Parte 4 da auditoria de abrangência
// (2026-08-29). N:N com valor (não um FK direto em nenhum dos dois lados)
// porque uma parcela pode levar mais de um pagamento pra fechar (recebimento
// parcial, o motivo desta tabela existir) e, em tese, um mesmo Pagamento
// poderia financiar baixas em mais de uma ContaReceber — não construído hoje
// (nenhuma tela oferece isso), mas o modelo não impede.
//
// Só existe pro caminho NOVO: pagamento em valor EXATO continua fechando a
// conta direto via ContaReceber.pagamentoId, sem nenhuma linha aqui (ver
// comentário lá). Criada por registrarBaixaContaReceber (escolha explícita
// de qual conta) e pelo fechamento automático em registrarPagamento quando o
// valor bate exato com o SALDO REMANESCENTE de uma conta já PARCIAL — nunca
// em silêncio numa situação ambígua (ver comentários nas duas actions).
// Saldo em aberto sempre recalculado somando estas linhas — nunca
// armazenado, mesma disciplina de CreditoCliente — ver saldoContaReceber em
// src/lib/baixa-financeira.ts.
model BaixaContaReceber {
  id             String   @id @default(cuid())
  contaReceberId String
  pagamentoId    String
  valor          Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  contaReceber ContaReceber @relation(fields: [contaReceberId], references: [id], onDelete: Cascade)
  pagamento    Pagamento    @relation(fields: [pagamentoId], references: [id], onDelete: Cascade)

  @@index([contaReceberId])
  @@index([pagamentoId])
  @@map("baixas_conta_receber")
}

// Quando o relógio da parcela começa a contar — pesquisa de mercado (achado
// A7 da Parte 4) mostrou 4 âncoras cobrindo a esmagadora maioria das
// condições praticadas por gráfica brasileira: da aprovação do orçamento,
// da emissão da nota fiscal, da entrega do pedido, ou "outro" (prazo digitado
// manualmente, sem gatilho automático — cai no mesmo cadastro manual de
// sempre). As 3 primeiras disparam geração automática de ContaReceber
// (achado R1 da auditoria, Parte 7, 2026-09-03 — ver
// gerarContasReceberDaAprovacao/gerarContasReceberDaEmissaoNota/
// gerarContasReceberDaEntrega em src/lib/condicao-pagamento.ts, chamadas
// respectivamente em atualizarStatusOrcamento/responderOrcamentoPublico,
// emitirNotaFiscal/atualizarStatusNotaFiscal, e avancarStatusPedido na
// transição pra ENTREGUE). OUTRO nunca dispara nada automático — é
// deliberadamente "sem gatilho", a gráfica sempre cadastra a parcela à mão.
enum AncoraVencimento {
  APROVACAO
  EMISSAO_NOTA
  ENTREGA
  OUTRO
}

// Um "jeito de cobrar" que a gráfica pratica com frequência — bootstrap lazy
// com as condições mais comuns do mercado (1x faturado 30 dias; 50%+50% na
// entrega; 30/60/90 com 2% de acréscimo; 28/42/56 dias da emissão da nota),
// mesma disciplina de CATEGORIAS_CUSTO_SUGERIDAS/garantirCategoriasCustoPadrao
// em src/lib/custo-pedido.ts — ver garantirCondicoesPagamentoPadrao em
// src/lib/condicao-pagamento.ts. Vinculada a um Orcamento via
// Orcamento.condicaoPagamentoId (FK opcional, convive com o texto livre
// condicoesPagamento) e usada, no evento que bate com a âncora escolhida
// (aprovação/emissão de nota/entrega), pra gerar ContaReceber (ver
// comentário em AncoraVencimento acima e no model ContaReceber). Soft-delete
// via `ativa` (nunca hard-delete — orçamentos já aprovados continuam
// referenciando a condição usada, mesmo desativada).
model CondicaoPagamento {
  id               String           @id @default(cuid())
  graficaId        String
  nome             String
  ancora           AncoraVencimento @default(APROVACAO)
  // % somado ao total antes de dividir nas parcelas (ex: 30/60/90 com 2% —
  // condição praticada como "acréscimo pra prazo maior"). null/0 = sem
  // acréscimo, a maioria das condições (1x faturado, 50%+50%).
  acrescimoPercent Decimal?         @db.Decimal(5, 2)
  ativa            Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  grafica    Grafica                    @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  parcelas   CondicaoPagamentoParcela[]
  orcamentos Orcamento[]

  @@unique([graficaId, nome])
  @@index([graficaId, ativa])
  @@map("condicoes_pagamento")
}

// Uma linha do parcelamento de uma CondicaoPagamento — ex: "30/60/90" tem 3
// linhas (ordem 1/2/3), cada uma com 1/3 (~33.33%) do total e
// diasAposAncora 30/60/90. `percentual` de todas as linhas de uma mesma
// condição deveria somar 100 (validado no server ao salvar, não no banco —
// mesmo princípio de outras validações de composição deste projeto).
model CondicaoPagamentoParcela {
  id                  String  @id @default(cuid())
  condicaoPagamentoId String
  ordem               Int
  percentual          Decimal @db.Decimal(5, 2)
  diasAposAncora      Int

  condicaoPagamento CondicaoPagamento @relation(fields: [condicaoPagamentoId], references: [id], onDelete: Cascade)

  @@index([condicaoPagamentoId])
  @@map("condicao_pagamento_parcelas")
}

enum StatusComissao {
  PENDENTE
  PAGA
}

// Comissão de um vendedor sobre um orçamento aprovado — registro histórico
// (nunca recalculado): guarda SNAPSHOT da taxa do usuário e da política de
// cálculo da gráfica no momento da aprovação, pra não mudar retroativamente
// se o dono trocar a config depois. Ver src/lib/comissao.ts (cálculo puro) e
// o gatilho em src/app/orcamento/[id]/actions.ts (atualizarStatusOrcamento).
model Comissao {
  id                 String         @id @default(cuid())
  graficaId          String
  orcamentoId        String         @unique // no máximo 1 comissão por orçamento
  usuarioId          String // vendedor — snapshot de Orcamento.usuarioId
  baseCalculo        BaseComissao // snapshot de ParametrosGrafica.comissaoVendedorBase
  percentualAplicado Decimal        @db.Decimal(5, 4) // snapshot de Usuario.comissaoPercent
  valorBase          Decimal        @db.Decimal(12, 2) // total ou lucro, conforme baseCalculo
  valorComissao      Decimal        @db.Decimal(12, 2)
  status             StatusComissao @default(PENDENTE)
  pagoEm             DateTime?
  createdAt          DateTime       @default(now())

  // Despesa gerada quando marcada como paga (opcional — só existe depois do
  // pagamento) — ver comentário em Despesa.comissao acima.
  despesaId String? @unique

  grafica   Grafica   @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id])
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])
  despesa   Despesa?  @relation(fields: [despesaId], references: [id], onDelete: SetNull)

  @@index([graficaId, status])
  @@index([usuarioId])
  @@map("comissoes")
}

// Trilha de auditoria financeira: quem alterou o quê. usuarioNome é um
// snapshot (não FK em Usuario) de propósito — o log tem que continuar legível
// mesmo que o usuário seja removido da gráfica no futuro. entidadeId também
// não é FK (mesmo motivo: excluirDespesa é hard delete, o log tem que
// sobreviver ao registro que ele descreve).
model LogAuditoria {
  id          String   @id @default(cuid())
  graficaId   String
  usuarioId   String
  usuarioNome String
  acao        String
  entidade    String
  entidadeId  String
  descricao   String
  createdAt   DateTime @default(now())

  // O QUE mudou, não só que mudou. Sem estes dois, "Fulano editou a despesa
  // X" não resolve nenhuma investigação — o que resolve é "mudou de R$ 300
  // pra R$ 100". Guardados como texto legível por humano (não JSON cru),
  // porque quem lê isto é o dono da gráfica na tela de auditoria, não um
  // programa. Nulos em ação que não é edição (criar, excluir, aprovar).
  valorAnterior String?
  valorNovo     String?

  // IP de quem fez a ação. Existe pra responder "foi mesmo esse funcionário
  // ou alguém usando a conta dele" — a pergunta que o dono faz quando algo
  // dá errado. Nulo quando não foi possível resolver o IP.
  ip String?

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@index([graficaId, createdAt])
  @@map("logs_auditoria")
}

enum TipoDesconto {
  PERCENTUAL
  VALOR_ABSOLUTO
  PRECO_FINAL // usuário digita o preço fechado, sistema deriva o desconto
}

// Opção alternativa de proposta dentro do MESMO orçamento/link público — ex:
// "Pacote Econômico" vs. "Pacote Premium", cada uma com seu próprio conjunto
// de itens e total. A opção-base (o que hoje já é Orcamento.itens/total) NÃO
// tem uma linha aqui — continua vivendo direto em OrcamentoItem com
// opcaoId=null, exatamente como todo orçamento desde sempre. Por isso não há
// migração de dado nenhuma: um orçamento existente simplesmente nunca tem
// nenhuma OrcamentoOpcao, e o resto do sistema (edição, PDF, link público,
// aprovação) continua enxergando só a opção-base até o dia em que a gráfica
// adicionar a primeira opção alternativa (ver adicionarOpcaoOrcamento em
// src/app/orcamento/[id]/opcoes.actions.ts). MVP: no máximo
// MAX_OPCOES_ALTERNATIVAS (2) linhas por orçamento — 3 opções no total
// contando a base (ver src/lib/orcamento-opcoes.ts).
//
// Ao aprovar, a opção escolhida pelo cliente (ou pelo vendedor, no painel) é
// PROMOVIDA: seus itens têm opcaoId zerado (viram a opção-base) e todas as
// outras opções (e a base perdedora, se uma alternativa foi escolhida) são
// descartadas — ver resolverOpcoesNaAprovacao em src/lib/orcamento-opcoes.ts.
// Depois da promoção, o orçamento aprovado é indistinguível de um orçamento
// de opção única de sempre: Pedido, Comissao, PDF, relatórios e ficha técnica
// nunca precisam saber que opções existiram. Ao rejeitar, todas as opções
// alternativas são descartadas do mesmo jeito (só a base permanece) — um
// orçamento em status terminal (APROVADO/REJEITADO) nunca tem linha aqui.
model OrcamentoOpcao {
  id          String   @id @default(cuid())
  orcamentoId String
  nome        String // "Opção B", "Pacote Premium" etc — texto livre, editável
  // Cache = soma de itens.precoTotal, mesmo padrão de Orcamento.total —
  // mantido em sincronia pela action que cria a opção (criada de uma vez só,
  // como um carrinho — ver adicionarOpcaoOrcamento; MVP não tem edição
  // incremental de item dentro de uma opção já criada, só remover a opção
  // inteira e recriar).
  total       Decimal  @default(0) @db.Decimal(12, 2)
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orcamento Orcamento       @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  itens     OrcamentoItem[]

  @@index([orcamentoId])
  @@map("orcamento_opcoes")
}

model OrcamentoItem {
  id              String          @id @default(cuid())
  orcamentoId     String
  // null = pertence à opção-base do orçamento (Orcamento.itens/total de
  // sempre, "Opção A" na UI) — comportamento de todo item já existente,
  // sem migração nenhuma. Preenchido = pertence a uma OrcamentoOpcao
  // alternativa (ver comentário do model acima); orcamentoId continua
  // apontando pro orçamento-pai nos dois casos, nunca só opcaoId.
  opcaoId         String?
  itemGraficaId   String
  quantidade      Int
  larguraCm       Decimal?        @db.Decimal(8, 2)
  alturaCm        Decimal?        @db.Decimal(8, 2)
  // Terceira dimensão (caixa/embalagem, acrílico, livro) e espessura de chapa
  // (corte a laser/router) do ITEM VENDIDO — distinto da espessura do lado da
  // matéria-prima. Ambos opcionais e ignorados por 100% dos motores de preço
  // em src/lib/pricing/ hoje (risco zero de mudar preço de ninguém).
  // profundidadeCm segue a MESMA unidade canônica de largura/altura (cm).
  // espessuraMm é em MILÍMETRO (chapa é vendida em mm no Brasil) — não
  // confundir com a unidade de largura/altura/profundidade, que é cm.
  profundidadeCm  Decimal?        @db.Decimal(8, 2)
  espessuraMm     Decimal?        @db.Decimal(8, 2)
  // Unidade em que o usuário efetivamente DIGITOU largura/altura deste item
  // (mm/cm/m — ver src/lib/unidade-dimensao.ts) — congelada no momento da
  // criação do item, nunca lida dinamicamente de Grafica.unidadePadraoDimensao
  // depois: trocar o padrão da gráfica não deve reinterpretar itens já salvos.
  // larguraCm/alturaCm acima continuam SEMPRE em centímetros; isto é só a
  // unidade de ENTRADA/EXIBIÇÃO. Default CM preserva o comportamento de toda
  // linha existente (nunca teve outra unidade).
  unidadeDimensao UnidadeDimensao @default(CM)
  cores           String? // ex: "4x0", "4x4" — snapshot legível, sempre preenchido
  acabamento      String? // texto livre, modo SIMPLES apenas

  // precoUnitario/precoTotal continuam sendo o VALOR VENDIDO (deliberado —
  // PDF, link público, pagamentos e relatórios já leem estes campos). O
  // preço sugerido pelo motor vira campo paralelo, nunca substitui estes.
  precoUnitario Decimal @db.Decimal(12, 2)
  precoTotal    Decimal @db.Decimal(12, 2)

  // Preço sugerido vs. negociado (ver fase-custo-real.md §2.4, §4.2) — nulo em
  // item sem desconto registrado, o que inclui todo item criado antes desta
  // fase (renderiza normalmente, sem "erosão por desconto" pra mostrar).
  precoSugeridoUnitario Decimal?      @db.Decimal(12, 4)
  descontoTipo          TipoDesconto?
  descontoValor         Decimal?      @db.Decimal(12, 4)
  motivoDesconto        String?       @db.VarChar(300)
  // Preenchido quando o desconto passa de ParametrosGrafica.descontoMaxSemAprovacao
  // e um DONO/ADMIN aprova — texto livre de "quem", não FK (mesmo padrão de
  // LogAuditoria.usuarioNome: sobrevive à remoção do usuário).
  aprovadoPorId         String?

  // Motor avançado (M2/OFFSET/FLEXOGRAFIA): snapshot do modelo usado + árvore de
  // custo auditável (spec §0d). Fica null pra itens SIMPLES — nada muda no caminho
  // existente.
  modeloCalculo                ModeloCalculo @default(SIMPLES)
  corFrente                    Int?
  corVerso                     Int?
  // Nº de cores da arte — modeloCalculo=FLEXOGRAFIA only. Deliberadamente separado
  // de corFrente/corVerso (que têm semântica de "frente/verso de folha", lida em
  // ~20 lugares — PDF, webhook-tinta.ts, pedido-aprovacao.ts) pra não arriscar bug
  // silencioso de significado errado nesses consumidores.
  numeroCoresFlexo             Int?
  // Nº de cliques da impressora digital — modeloCalculo=DIGITAL only.
  numeroCliques                Int?
  // Nº de setups (telas/matrizes/artes) — modeloCalculo SERIGRAFIA/
  // SUBLIMACAO/ESTAMPAGEM_QUENTE only, os 3 compartilham este mesmo campo
  // (mesma razão de compartilharem calcularSetupPorPeca).
  numeroSetups                 Int?
  // Nº de pontos da arte de bordado — modeloCalculo=BORDADO only (achado A4).
  // Driver de custo POR PEDIDO (diferente de numeroSetups acima, que é fixo
  // na máquina): a mesma máquina, na mesma camiseta, custa 5× diferente
  // entre um logo de 3.000 pontos e uma arte de costas de 15.000 pontos.
  numeroPontos                 Int?
  // Tempo estimado de máquina (minutos) e metros de corte — modeloCalculo=
  // TEMPO_MAQUINA only (achado A6). A gráfica escolhe a base na máquina
  // (tempo, metro de corte, ou os dois somados) — ambos opcionais e
  // independentes; o motor só cobra o que estiver preenchido (ver
  // calcularTempoMaquina em src/lib/pricing/tempo-maquina.ts). Decimal (não
  // Int) porque o vendedor pode estimar em fração de minuto/metro.
  tempoEstimadoMin             Decimal?      @db.Decimal(10, 2)
  metrosCorte                  Decimal?      @db.Decimal(10, 2)
  // Estimativa de horas — só usada quando o item tem um acabamento anexado
  // com ConfiguracaoAcabamento.baseCobranca=HORA (ex: instalação, criação de
  // arte). Independente de modeloCalculo, ao contrário de numeroSetups
  // acima: acabamento por hora pode ser anexado a qualquer motor.
  horasEstimadas               Decimal?      @db.Decimal(8, 2)
  // Achado N10 da auditoria de abrangência (2026-09-03) — custo de
  // ferramental (faca de corte-e-vinco, matriz...) R$ livre, POR ITEM,
  // pro motor avançado FORA do M2 com clichê de etiqueta: aquele caso já
  // tem seu próprio snapshot em OrcamentoItemPrecificacaoEtiqueta.custoFaca
  // (não duplicado aqui — quando o item tem essa linha, ela é a fonte de
  // verdade, este campo fica null). ContextoPrecificacao.custoFaca (motor
  // de preço, ver src/lib/pricing/precificar.ts) já era lido por TODOS os
  // branches menos OFFSET antes desta correção — hoje só OFFSET grava
  // aqui (embalagem/cartonagem que paga faca de corte-e-vinco); nenhum
  // gate de banco impede outro modelo avançado gravar aqui no futuro sem
  // migration nova.
  custoFaca                    Decimal?      @db.Decimal(12, 4)
  // Override opcional, POR ORÇAMENTO, do custo de aquisição do fornecedor —
  // modeloCalculo=REVENDA only (achado A12). O preço de um brinde muda por
  // cotação/faixa de quantidade a cada orçamento; quando null, o motor cai no
  // ItemGrafica.precoCompra do catálogo (mesmo fallback que
  // ContextoDigital/ContextoSetupPorPeca já usam a partir de precoCompra —
  // ver src/lib/pricing/carregar.ts).
  custoAquisicaoUnitario       Decimal?      @db.Decimal(12, 4)
  // Achado B7 (correção de regressão introduzida pelo A2, 2026-08-24): quando
  // true, a gráfica só aplica a estampa/gravação — o cliente já trouxe a
  // peça em branco (camiseta/caneca/boné) — então o motor zera
  // ContextoDigital/ContextoSetupPorPeca.custoSubstratoPorPeca pra este item
  // (ver src/lib/orcamento-precificacao.ts). Só faz sentido pra
  // modeloCalculo=DIGITAL ou um dos 4 de setup-por-peça (SERIGRAFIA/
  // SUBLIMACAO/ESTAMPAGEM_QUENTE/PERSONALIZACAO) — nunca REVENDA, onde o
  // "custo de aquisição" É o produto inteiro, não um substrato aplicado.
  // @default(false) preserva 100% o comportamento de todo item já existente
  // (continua cobrando o substrato normalmente).
  materialFornecidoPeloCliente Boolean       @default(false)
  // Achado B6 — sobrepõe o nome do catálogo (ItemGrafica.itemCatalogo.nome)
  // no PDF e no link público quando preenchido (ver src/lib/pdf/mapear-dados.ts
  // e src/app/o/[token]/page.tsx). Puramente descritivo: nunca entra no motor
  // de preço (DadosItemOrcamento/calcularItemOrcamento em
  // orcamento-precificacao.ts), mesmo caráter de `acabamento` acima. Nullable
  // = todo item já existente continua mostrando o nome genérico do catálogo,
  // comportamento de sempre. Não remove a exigência de itemGraficaId — só
  // resolve a falta de descrição específica, não a falta de item de catálogo
  // (parte maior do achado B6, deixada de fora de propósito).
  descricaoLivre               String?       @db.Text
  breakdown                    Json?

  // Achado F1 da Parte 7 da auditoria de abrangência — vínculo INFORMATIVO,
  // opcional, nunca automático na precificação: quando o vendedor escolhe
  // um Ferramental já cadastrado (do mesmo cliente/produto), a UI pode
  // sugerir um aviso ("esta faca/clichê já existe, considere não cobrar de
  // novo") — mas custoFaca/custoClichePorCm2 e o preço final continuam
  // 100% manuais, ninguém zera isso sozinho. SetNull: desativar/remover o
  // Ferramental não pode apagar o item de orçamento que só referenciava ele.
  ferramentalId String?

  orcamento   Orcamento       @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  opcao       OrcamentoOpcao? @relation(fields: [opcaoId], references: [id], onDelete: Cascade)
  itemGrafica ItemGrafica     @relation(fields: [itemGraficaId], references: [id])
  ferramental Ferramental?    @relation(fields: [ferramentalId], references: [id], onDelete: SetNull)

  acabamentos          OrcamentoItemAcabamento[]
  etiqueta             OrcamentoItemEtiqueta?
  tinta                OrcamentoItemTinta?
  precificacaoEtiqueta OrcamentoItemPrecificacaoEtiqueta?
  filaGangRun          FilaGangRun?

  @@index([orcamentoId])
  @@index([opcaoId])
  @@index([ferramentalId])
  @@map("orcamento_itens")
}

enum MaterialSubstrato {
  PAPEL_TERMICO
  COUCHE_C_ROT
  BOPP_METALIZADO_ROT
  BOPP_BCO_PEROLIZADO
  BOPP_BCO_FOSCO
  BOPP_TRANSPARENTE
  L2_SEM_ADESIVO
  POLIETILENO_BRANCO
  POLIETILENO_TRANSPARENTE
  POLIESTER_BRANCO
  POLIESTER_TRANSPARENTE
  POLIESTER_CROMO_FOSCO
  ELETROSTATICO_SEM_COLA
  OUTRO
}

// OUTRO em cada enum abaixo (exceto TipoRotulagem, que descreve um PROCESSO
// binário — manual ou automático — não um catálogo de material/técnica de
// fornecedor) + campo de texto livre pareado em OrcamentoItemEtiqueta/
// OrcamentoItemHotStamping — sem isso, uma gráfica cujo adesivo/laminação/
// verniz real não está nesta lista fixa (montada a partir do catálogo de UM
// fornecedor específico) simplesmente não conseguia cadastrar o item.
enum TipoAdesivo {
  ACRILICO_20G
  ACRILICO_30G
  BORRACHA_20G
  BORRACHA_25G
  BORRACHA_30G
  BORRACHA_50G
  OUTRO
}

enum SuperficieAplicacao {
  VIDRO
  PLASTICO
  METAL
  PAPEL
  PAPELAO
  OUTROS
}

enum TipoRotulagem {
  MANUAL
  AUTOMATICA
}

enum TipoSerrilha {
  SERRILHA
  MICRO_SERRILHA
  GAP
  OUTRO
}

enum TipoLaminacao {
  BRILHO
  FOSCO
  SOFT_TOUCH
  METALIZADA
  OUTRO
}

enum TipoAcabamentoVerniz {
  BRILHO
  FOSCO
  RIBBON
  SOFT_TOUCH
  OUTRO
}

enum TipoHotStamping {
  HOT
  COLD
  OUTRO
}

enum LadoEtiqueta {
  ROTULO
  CONTRA_ROTULO
}

// Detalhe descritivo/de produção de etiqueta (rótulo adesivo) — só relevante
// pra item com modeloCalculo=M2 (flexografia). Não entra na conta de preço
// (o motor M2 em src/lib/pricing/m2.ts só usa geometria + custo por m²) —
// isso aqui é 100% dado de especificação técnica pra imprimir/produzir, uma
// tabela separada (não colunas em OrcamentoItem) pra não deixar ~18 colunas
// sempre nulas em todo item SIMPLES/OFFSET, mesmo raciocínio que já levou
// OrcamentoItemAcabamento a ser tabela própria.
model OrcamentoItemEtiqueta {
  id              String @id @default(cuid())
  orcamentoItemId String @unique

  materialSubstrato        MaterialSubstrato?
  materialSubstratoOutro   String? // só usado quando materialSubstrato = OUTRO
  tipoAdesivo              TipoAdesivo?
  tipoAdesivoOutro         String? // só usado quando tipoAdesivo = OUTRO
  durabilidadeAdesivo      String? // PERMANENTE/REMOVIVEL ou outro tipo de durabilidade do adesivo
  superficieAplicacao      SuperficieAplicacao?
  superficieAplicacaoOutro String? // só usado quando superficieAplicacao = OUTROS
  formatoEtiqueta          String?

  coresRotulo       Int?
  coresContraRotulo Int?

  embalagemQtdPorRolo Int?
  tubeteMedida        String?

  rotulagem     TipoRotulagem?
  serrilha      TipoSerrilha?
  serrilhaOutro String? // só usado quando serrilha = OUTRO

  vernizRotuloTotal           Boolean               @default(false)
  vernizRotuloReserva         Boolean               @default(false)
  vernizRotuloTipo            TipoAcabamentoVerniz?
  vernizRotuloTipoOutro       String? // só usado quando vernizRotuloTipo = OUTRO
  vernizContraRotuloTotal     Boolean               @default(false)
  vernizContraRotuloReserva   Boolean               @default(false)
  vernizContraRotuloTipo      TipoAcabamentoVerniz?
  vernizContraRotuloTipoOutro String? // só usado quando vernizContraRotuloTipo = OUTRO

  laminacaoRotulo            TipoLaminacao?
  laminacaoRotuloOutro       String? // só usado quando laminacaoRotulo = OUTRO
  laminacaoContraRotulo      TipoLaminacao?
  laminacaoContraRotuloOutro String? // só usado quando laminacaoContraRotulo = OUTRO

  rebobinamento Int? // 1-8, validado em app (src/lib/orcamento-etiqueta.ts) — sem nome pras opções ainda

  orcamentoItem OrcamentoItem              @relation(fields: [orcamentoItemId], references: [id], onDelete: Cascade)
  hotStampings  OrcamentoItemHotStamping[]

  @@map("orcamento_item_etiquetas")
}

// Hot/cold stamping pode ter mais de uma variação no mesmo item (ex: dois
// hots diferentes, cada um com sua própria medida/cor) — por isso é tabela
// 1:N, diferente de verniz/laminação (que são "um valor por lado", únicos).
model OrcamentoItemHotStamping {
  id                      String @id @default(cuid())
  orcamentoItemEtiquetaId String

  lado      LadoEtiqueta
  tipo      TipoHotStamping
  tipoOutro String? // só usado quando tipo = OUTRO
  tipoEfeitoHotStamping String? // holográfico/espelhado/metalizado/colorido/outro — efeito visual do hot stamping
  medida    String?
  cor       String?

  orcamentoItemEtiqueta OrcamentoItemEtiqueta @relation(fields: [orcamentoItemEtiquetaId], references: [id], onDelete: Cascade)

  @@index([orcamentoItemEtiquetaId])
  @@map("orcamento_item_hot_stampings")
}

// Snapshot dos dados que ENTRAM na conta de preço de um item M2 com motor de
// clichê (ConfiguracaoClicheEtiqueta) — separado de OrcamentoItemEtiqueta de
// propósito (aquela é 100% descritiva/produção, nunca mexe no motor de preço,
// ver comentário dela acima; misturar quebraria esse invariante). Criada só
// quando o produto tem a config de clichê presente; nunca recalculada depois
// — mesmo espírito de OrcamentoItemAcabamento.
model OrcamentoItemPrecificacaoEtiqueta {
  id                   String   @id @default(cuid())
  orcamentoItemId      String   @unique
  papelId              String // matéria-prima (ItemGrafica tipo=MATERIA_PRIMA) escolhida NESTE orçamento
  quantidadeCores      Int // nº de cores da arte → nº de clichês
  custoClicheCalculado Decimal  @db.Decimal(12, 4) // snapshot = quantidadeCores × custoClicheUnitario no momento do cálculo
  custoFaca            Decimal? @db.Decimal(12, 4) // opcional, R$ livre (ferramental de corte)
  custoFrete           Decimal? @db.Decimal(12, 4) // opcional, R$ livre
  createdAt            DateTime @default(now())

  orcamentoItem OrcamentoItem @relation(fields: [orcamentoItemId], references: [id], onDelete: Cascade)
  papel         ItemGrafica   @relation("PapelDoItemOrcamentoEtiqueta", fields: [papelId], references: [id], onDelete: Restrict)

  @@map("orcamento_item_precificacao_etiquetas")
}

// Acabamentos estruturados aplicados a um item de orçamento no motor avançado
// (substitui o texto livre "acabamento" quando modeloCalculo != SIMPLES).
model OrcamentoItemAcabamento {
  id              String  @id @default(cuid())
  orcamentoItemId String
  itemGraficaId   String // o SERVICO usado como acabamento
  qtdBase         Decimal @db.Decimal(12, 4) // snapshot da base de cobrança usada
  custoCalculado  Decimal @db.Decimal(12, 4)

  orcamentoItem OrcamentoItem @relation(fields: [orcamentoItemId], references: [id], onDelete: Cascade)
  itemGrafica   ItemGrafica   @relation(fields: [itemGraficaId], references: [id])

  @@index([orcamentoItemId])
  @@map("orcamento_item_acabamentos")
}

// FSM linear completa do Pedido (visão de produto 2026-08-21): Arte →
// Clichê/Faca → Produção → Acabamento → Conferência → Embalagem → Expedição
// → Entregue — os dois estágios anteriores (Orçamento/Aprovado) são
// StatusOrcamento, não entram aqui, porque um Pedido só nasce quando o
// Orçamento já está Aprovado. Expandido de 5 pros 8 estágios abaixo (mais
// CANCELADO) na migration 20260821230000_expande_status_pedido_10_etapas via
// ALTER TYPE RENAME VALUE (não recriação do enum): FILA→ARTE,
// IMPRESSAO→PRODUCAO, PRONTO→EXPEDICAO preservam o dado de pedidos
// existentes automaticamente; CLICHE_FACA/CONFERENCIA/EMBALAGEM são
// estágios novos, sem pedido nenhum neles até que algum avance até lá pela
// primeira vez. Ver SEQUENCIA_STATUS_PEDIDO em src/lib/producao-estagios.ts
// pra ordem canônica (a ordem de declaração aqui só espelha ela, não é a
// fonte de verdade — a aplicação nunca depende de ordem de enum do Postgres).
enum StatusPedido {
  ARTE
  CLICHE_FACA
  PRODUCAO
  ACABAMENTO
  CONFERENCIA
  EMBALAGEM
  EXPEDICAO
  ENTREGUE
  // Terminal, assim como ENTREGUE — mas ao contrário dela, cancelar um
  // pedido que já passou por Clichê/Faca→Produção estorna automaticamente a
  // matéria-prima baixada (ver cancelarPedido em src/app/producao/actions.ts).
  // Alcançável a partir de qualquer estágio ANTES de ENTREGUE — nunca de
  // ENTREGUE (produto já saiu, cancelar não desfaz uma entrega física).
  CANCELADO
}

// Pedido nasce quando um Orcamento é aprovado: acompanha a produção física.
model Pedido {
  id          String       @id @default(cuid())
  graficaId   String
  orcamentoId String       @unique
  status      StatusPedido @default(ARTE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Data pura (meia-noite UTC, mesmo padrão de Despesa.vencimento — ver
  // src/lib/data.ts), definida na aprovação do orçamento. Opcional: nem todo
  // pedido tem prazo prometido, e sem prazo nunca gera alerta de atraso.
  prazoEntrega          DateTime?
  // Dedup do evento pedido_atrasado (webhook-automacao.ts): uma vez enviado
  // o alerta pra este pedido, nunca reenviar — evita spam a cada
  // carregamento de /producao enquanto o pedido continua atrasado. Canal
  // separado do campo abaixo: este dispara pro webhook de AUTOMAÇÃO da
  // própria gráfica (n8n), só depois do prazo já vencido.
  alertaAtrasoEnviadoEm DateTime?

  // Limiar mais urgente (5, 3 ou 0 dias até o prazo) já avisado por E-MAIL
  // ao vendedor do orçamento + DONO da gráfica (ver
  // src/lib/alerta-prazo-email.ts, rodando no cron diário). Cascata que só
  // anda pra frente — 5 → 3 → 0 — nunca reenvia um limiar já ultrapassado,
  // mas pula direto pro mais urgente ainda não avisado se o cron perder um
  // dia (ex: de "não avisado" direto pra 0 se o pedido já venceu no
  // primeiro run). Null = nenhum alerta de prazo ainda enviado por e-mail.
  alertaPrazoUltimoLimiarDias Int?

  // Aprovação de arte: opt-in por pedido — se a gráfica nunca envia uma
  // arte (arteUrl null), o pedido avança normalmente sem nenhum gate. Uma
  // vez enviada, avancarPedido bloqueia a saída de FILA até arteAprovadaEm
  // ser preenchido (ver src/app/producao/actions.ts). arteLinkToken é
  // gerado sob demanda (mesmo padrão de Orcamento.linkPublicoToken) e
  // reaproveitado entre reenvios do mesmo pedido — só o token muda de
  // "significado" (aprovado/pendente), nunca de valor, então o link que a
  // gráfica já mandou pro cliente continua válido após um reenvio.
  arteUrl               String?
  arteAprovadaEm        DateTime?
  arteComentarioCliente String?
  arteLinkToken         String?   @unique
  // Mesmo campo/formato de Orcamento.preflightAvisos (ver comentário lá) —
  // quando a arte do orçamento é copiada pro Pedido na aprovação, os
  // achados de preflight são copiados junto (não recalculados, é o mesmo
  // arquivo); um reenvio de arte na Produção recalcula do zero.
  preflightAvisos       Json?
  // Nome DECLARADO por quem respondeu pelo link público — não é verificado
  // (quem tem o link digita o que quiser), vale como registro, igual a uma
  // assinatura em formulário de papel. Nunca escrever "confirmado por" na
  // tela a partir disto, só "aprovado por". Mesmo par existe em Orcamento
  // (respostaPublicaNome/Em) pro aceite do orçamento.
  arteRespondidaPor     String?

  // Link público evergreen: "confirmar a etapa atual deste pedido", sem
  // login (ver ResponsavelEstagio e src/app/p/[token]). Gerado na criação
  // do Pedido e NUNCA rotacionado — como o status é um FSM estritamente
  // linear e só existe uma etapa viva por vez, o token não precisa saber
  // "qual" etapa confirma, só lê o status atual. Deixa de fazer sentido
  // quando o pedido chega em ENTREGUE/CANCELADO (terminal) — a página trata
  // isso como "nada pra confirmar agora", não como link inválido.
  producaoLinkToken String? @unique

  // QR físico colado no produto, pra atualizar status direto do chão de
  // fábrica sem voltar ao desktop (ver src/app/q/[token]). Mesmo princípio
  // de producaoLinkToken (token evergreen, "credencial" = posse do token),
  // mas token PRÓPRIO e deliberadamente mais permissivo: só existe depois
  // que um usuário autenticado da gráfica baixa a etiqueta pela primeira vez
  // (gerado inline em src/app/producao/[pedidoId]/etiqueta/route.tsx — nunca
  // em massa na criação do Pedido, só sob demanda), e a tela /q/[token]
  // (src/app/q/[token]/actions.ts) não aplica rate limit nem a checagem de
  // "etapaEsperada" que producaoLinkToken tem (ver confirmarEstagioPublico)
  // — a etiqueta impressa circula só
  // fisicamente dentro da própria gráfica, ao contrário do link por e-mail
  // que pode ficar aberto numa aba esquecida por dias. Mesma restrição de
  // ESTAGIOS_ATRIBUIVEIS continua valendo (nunca avança a partir de FILA por
  // aqui — essa transição baixa estoque e exige a tela de confirmação de
  // perda de material, que não existe nesta versão mobile).
  qrToken String? @unique

  // Data da aprovação do orçamento (autenticada ou pelo link público) — até
  // esta fase, o dashboard somava faturamento por createdAt do orçamento
  // porque este campo não existia. Também é o gatilho que congela
  // PedidoCustoPrevisto e os três snapshots abaixo (ver fase-custo-real.md §1.2, §3.1).
  aprovadoEm DateTime?

  // Snapshots tirados no momento de aprovadoEm — nunca recalculados depois,
  // mesmo que o motor de precificação ou o preço de matéria-prima mudem.
  precoSugeridoTotal  Decimal? @db.Decimal(12, 2)
  valorNegociadoTotal Decimal? @db.Decimal(12, 2)
  custoPrevistoTotal  Decimal? @db.Decimal(12, 2)

  // Fechamento é ato explícito (tela /pedidos/{id}/fechamento), não
  // automático ao entrar em Entregue — custo atrasado (frete que chega na
  // semana seguinte) é regra, não exceção. Reabrir exige permissão
  // custosVerLucro e gera auditoria.
  fechadoEm    DateTime?
  fechadoPorId String?

  grafica   Grafica   @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id])

  movimentacoes      MovimentacaoEstoque[]
  custos             CustoPedido[]
  custosPrevisto     PedidoCustoPrevisto[]
  // Achado B1/B2 da Parte 2 (Produção) — histórico de transição de etapa,
  // ver ApontamentoEtapa.
  apontamentos       ApontamentoEtapa[]
  entrega            Entrega?
  filaGangRun        FilaGangRun[]
  // Lado inverso de SolicitacaoCompra.pedidoId — compras feitas
  // especificamente pra este pedido (origem=PEDIDO_ESPECIFICO, achado A3 da
  // auditoria de abrangência, Parte 3/Compras).
  solicitacoesCompra SolicitacaoCompra[]
  // Achado E1 da auditoria de abrangência (Parte 2/Produção) — etapas deste
  // pedido enviadas pra terceirização (laminação, UV, acabamento de livro
  // etc.), ver model EtapaTerceirizada.
  etapasTerceirizadas EtapaTerceirizada[]

  @@index([graficaId])
  @@map("pedidos")
}

// Achado A1 da auditoria de abrangência (Parte 2/Produção, pesquisa-
// abrangencia-modulos.md, 2026-09-01), Fase 1 (barata): liga/desliga e
// renomeia, por tenant, cada um dos 8 estágios de StatusPedido que fazem
// parte de SEQUENCIA_STATUS_PEDIDO (CANCELADO fica de fora — é terminal,
// alcançável de qualquer estágio, nunca parte do caminho linear). Bootstrap
// lazy na primeira leitura (ver garantirEtapasGraficaPadrao em
// src/lib/etapa-grafica.ts), mesmo padrão de garantirCategoriasCustoPadrao
// em src/lib/custo-pedido.ts: as 8 linhas só são criadas quando uma gráfica
// realmente precisa, todas ativa=true/rotulo=null/ordem=posição atual — uma
// gráfica que nunca abriu esta tela se comporta EXATAMENTE como antes desta
// feature (resolverSequencia cai no array literal quando não há linha
// nenhuma, ver mesmo arquivo).
//
// ativa=false remove o status da sequência que avancarStatusPedido usa pra
// decidir "qual é o próximo válido" — pula direto pro próximo ativo.
// ARTE/PRODUCAO/ENTREGUE NUNCA podem ficar ativa=false (ver
// ETAPAS_SEMPRE_ATIVAS em src/lib/etapa-grafica.ts, validado nas actions
// desta tela, não só na UI): ARTE é o status @default(ARTE) de todo Pedido
// novo (desligá-lo quebraria a criação de pedido); PRODUCAO é a etapa de
// destino cuja ENTRADA dispara a baixa de estoque automática (ver
// status-transicao.ts) — sem ela sempre presente e sempre alcançável, a
// baixa de estoque poderia nunca disparar; ENTREGUE é o status terminal que
// vários outros pontos do código conferem literalmente (alertas de atraso,
// filtro de "pedidos finalizados") — desligá-lo faria um pedido desta
// gráfica nunca alcançar esse status de verdade.
//
// rotulo=null usa o rótulo padrão do sistema (ROTULOS_STATUS_PEDIDO); um
// valor customizado aparece no Kanban, na lista de produção, no e-mail ao
// responsável de etapa e nas telas públicas (/p/[token], /q/[token]) no
// lugar do padrão — ex: serigrafia renomeia CLICHE_FACA pra "Queima de
// tela", comunicação visual renomeia EXPEDICAO pra "Instalação".
model EtapaGrafica {
  id        String       @id @default(cuid())
  graficaId String
  status    StatusPedido
  ativa     Boolean      @default(true)
  rotulo    String?
  ordem     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@unique([graficaId, status])
  @@index([graficaId])
  @@map("etapas_grafica")
}

enum StatusEntrega {
  AGUARDANDO
  EM_TRANSITO
  ENTREGUE
  // Estado lateral, alcançável a partir de qualquer status ATIVO
  // (AGUARDANDO ou EM_TRANSITO) — nunca terminal: a tela permite resolver o
  // problema e voltar pro fluxo normal (ver TRANSICOES_VALIDAS em
  // src/lib/entrega-status.ts).
  PROBLEMA
}

// Status ESTRUTURADO da entrega física de um pedido — substitui o texto
// livre que hoje só existe em Orcamento.frete/transportadora/localEntrega
// (preenchido uma vez na aprovação do orçamento, nunca mais atualizado).
// 1:1 com Pedido (não com Orcamento): entrega só faz sentido depois que a
// produção física começou — ver ESTAGIOS_PRE_PRODUCAO em
// src/lib/producao-estagios.ts (Arte/Clichê-Faca ainda não têm nada físico
// pra rastrear). Não confundir com StatusPedido.ENTREGUE (que marca a
// PRODUÇÃO como concluída e fora da fila) — este model é o rastreamento
// OPERACIONAL da entrega em si (motorista, quando saiu, quando chegou),
// independente e mais granular.
model Entrega {
  id        String        @id @default(cuid())
  graficaId String
  pedidoId  String        @unique
  status    StatusEntrega @default(AGUARDANDO)

  // Texto livre, não cadastro relacional — mesmo princípio de
  // Despesa.categoria: motorista de entrega (motoboy da Lalamove, alguém da
  // equipe) não repete o bastante numa gráfica rápida pra justificar uma
  // tabela própria.
  motorista String?

  dataSaida   DateTime?
  dataEntrega DateTime?

  // Detalhe do problema (quando status === PROBLEMA) ou qualquer observação
  // livre sobre a entrega — nunca obrigatório no schema, mas a tela exige
  // preenchido antes de mandar pra PROBLEMA (ver EntregaPedidoSecao.tsx).
  observacoes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([graficaId])
  @@map("entregas")
}

// Categoria de custo configurável por gráfica, usada pra lançar custos reais
// de produção num pedido específico (papel, ferramental/faca, laminação,
// clichê, impressão, frete, mão de obra, retrabalho etc — inspirado na
// planilha real de controle de uma gráfica cliente). NUNCA fixo no código —
// mesmo princípio já aplicado a UnidadeDimensao: cada gráfica tem seu
// próprio jeito de separar custo, então isto é só um rótulo configurável,
// com um conjunto padrão sugerido na primeira vez que a gráfica abre a tela
// (ver bootstrapCategoriasCustoPadrao), nunca um enum travado.
model CategoriaCusto {
  id        String   @id @default(cuid())
  graficaId String
  nome      String
  ordem     Int      @default(0)
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())

  grafica         Grafica               @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  custos          CustoPedido[]
  custosPrevistos PedidoCustoPrevisto[]
  itensGrafica    ItemGrafica[]
  despesas        Despesa[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("categorias_custo")
}

enum OrigemCusto {
  MANUAL
  CONSUMO_ESTOQUE
  COMISSAO
  SERVICO_INSUMO
  // Rateio do custo de chapa + acerto de máquina entre os pedidos que
  // dividiram uma mesma chapa no gang run (ver GrupoGangRun/FilaGangRun
  // abaixo e combinarGrupoGangRun em src/lib/gang-run-servico.ts).
  GANG_RUN
  // Compra feita especificamente pra este pedido (SolicitacaoCompra
  // origem=PEDIDO_ESPECIFICO), gerado ao confirmar RECEBIDO — achado A3 da
  // auditoria de abrangência (Parte 3/Compras). Ver criarCustoAutomaticoCompra
  // em src/lib/custo-pedido.ts.
  COMPRA
  // Terceirização de etapa (EtapaTerceirizada.valorFinal preenchido) —
  // achado E1 da auditoria de abrangência (Parte 2/Produção, 2026-09-01). Ver
  // criarCustoAutomaticoTerceirizacao em src/lib/custo-pedido.ts.
  TERCEIRIZACAO
}

// Um lançamento de custo REAL incorrido num pedido específico — diferente do
// custo ESTIMADO pelo motor de precificação (OrcamentoItem.breakdown), que é
// uma previsão feita na hora do orçamento. Isto aqui é o gasto de verdade,
// lançado manualmente durante/depois da produção (ex: "paguei R$ 60 de faca
// nova pra este pedido"). Alimenta lucro por pedido (receita do orçamento
// aprovado − soma destes custos) e o gráfico de custos por categoria do Meu
// Negócio. graficaId duplicado de pedido.graficaId de propósito — mesmo
// padrão usado em Comissao/MovimentacaoEstoque, evita join extra pra
// escopar por tenant em toda query de relatório.
model CustoPedido {
  id               String   @id @default(cuid())
  graficaId        String
  pedidoId         String
  categoriaCustoId String
  valor            Decimal  @db.Decimal(12, 2)
  observacao       String?
  createdAt        DateTime @default(now())

  // De onde veio este lançamento (ver fase-custo-real.md §1.4). CONSUMO_ESTOQUE
  // é gerado automaticamente na baixa Fila→Impressão e nunca duplicado
  // (movimentacaoEstoqueId é único). Se já existir custo MANUAL na mesma
  // categoria/pedido quando o automático nasce, ele vem com
  // possivelDuplicidade=true em vez de somar calado.
  origem                OrigemCusto @default(MANUAL)
  movimentacaoEstoqueId String?     @unique
  // Mesmo padrão de movimentacaoEstoqueId acima, agora pro achado A3 (Parte
  // 3/Compras): qual SolicitacaoCompra origem=PEDIDO_ESPECIFICO gerou este
  // lançamento origem=COMPRA ao confirmar RECEBIDO — único porque uma
  // solicitação nunca gera dois CustoPedido (dedup, mesmo raciocínio de uma
  // solicitação gerar no máximo uma MovimentacaoEstoque).
  solicitacaoCompraId   String?     @unique
  // Mesmo padrão de solicitacaoCompraId acima, agora pro achado E1 (Parte 2/
  // Produção): qual EtapaTerceirizada gerou este lançamento origem=
  // TERCEIRIZACAO ao ter valorFinal preenchido — único porque uma
  // terceirização nunca gera dois CustoPedido (mesmo dedup).
  etapaTerceirizadaId   String?     @unique
  valorCalculado        Decimal?    @db.Decimal(12, 2) // o que o sistema apurou, antes de qualquer edição manual
  editadoManualmente    Boolean     @default(false)
  possivelDuplicidade   Boolean     @default(false)

  criadoPorId String?
  // Cancelamento de pedido: nunca deleta custo de origem automática, só
  // marca estornadoEm e exclui da soma (mesmo princípio do estorno de
  // estoque, que já usa histórico real em vez de recalcular). Custo manual
  // não é estornado automaticamente (frete pago é frete pago).
  estornadoEm DateTime?

  grafica             Grafica              @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  pedido              Pedido               @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  // Restrict: não deixa apagar uma categoria ainda referenciada por um
  // lançamento de custo — a gráfica precisa desativar (ativa=false) em vez
  // de excluir, preservando o histórico de custos já lançados.
  categoriaCusto      CategoriaCusto       @relation(fields: [categoriaCustoId], references: [id], onDelete: Restrict)
  movimentacaoEstoque MovimentacaoEstoque? @relation(fields: [movimentacaoEstoqueId], references: [id], onDelete: SetNull)
  // SetNull, mesmo raciocínio de movimentacaoEstoque acima: apagar a
  // solicitação (hoje não existe fluxo que apague) não pode apagar o custo
  // já lançado, só perde a referência de qual solicitação o gerou.
  solicitacaoCompra   SolicitacaoCompra?   @relation(fields: [solicitacaoCompraId], references: [id], onDelete: SetNull)
  // SetNull, mesmo raciocínio de solicitacaoCompra acima: apagar a
  // terceirização (hoje não existe fluxo que apague) não pode apagar o custo
  // já lançado, só perde a referência de qual terceirização o gerou.
  etapaTerceirizada   EtapaTerceirizada?   @relation(fields: [etapaTerceirizadaId], references: [id], onDelete: SetNull)

  @@index([graficaId])
  @@index([pedidoId])
  @@index([categoriaCustoId])
  @@map("custos_pedido")
}

// Achado E1 da auditoria de abrangência (Parte 2/Produção,
// pesquisa-abrangencia-modulos.md, 2026-09-01): nada no schema modelava um
// pedido que sai FISICAMENTE da gráfica pra uma operação terceirizada
// (laminação, UV, acabamento de livro etc.) e volta depois — o card ficava
// parado numa etapa (geralmente ACABAMENTO) por dias sem ninguém saber se é
// lentidão interna ou se está no terceiro, e o custo do terceiro só entrava
// como CustoPedido origem=MANUAL, sem prazo, sem fornecedor vinculado, sem
// alerta. Forma fiscal correspondente no Brasil: remessa para
// industrialização por encomenda (CFOP 5901/6901), retorno (5902/6902) —
// notaRemessa/notaRetorno abaixo guardam só o Nº da nota, mesmo papel de
// SolicitacaoCompra.documento (não emitem nota, só registram).
enum SituacaoTerceirizacao {
  AGUARDANDO_ENVIO
  ENVIADO
  RETORNADO
  PROBLEMA
}

model EtapaTerceirizada {
  id        String @id @default(cuid())
  graficaId String
  pedidoId  String

  // Etapa do PEDIDO em que a terceirização aconteceu (ex: ACABAMENTO) —
  // congelado no momento da criação deste registro, nunca acompanha se o
  // Pedido avançar de status depois (mesmo princípio de
  // ApontamentoEtapa.status).
  status StatusPedido

  // Fornecedor formal (Fornecedor já existe no schema, usado por
  // SolicitacaoCompra) OU nome livre pra terceiro não cadastrado — mesmo par
  // estruturado/escape já usado em vários textos livres do schema (ex:
  // Despesa.categoria). Validado na action pra nunca nascer com os dois
  // vazios ao mesmo tempo (não é constraint de banco).
  fornecedorId   String?
  fornecedorNome String?

  situacao SituacaoTerceirizacao @default(AGUARDANDO_ENVIO)

  enviadoEm DateTime?
  // Data pura (meia-noite UTC), mesmo padrão de Pedido.prazoEntrega — ver
  // src/lib/data.ts.
  previsaoRetorno DateTime?
  retornadoEm     DateTime?

  valorAcordado Decimal? @db.Decimal(10, 2)
  valorFinal    Decimal? @db.Decimal(10, 2)

  // CFOP 5901/6901 (remessa) e 5902/6902 (retorno) — só o Nº da nota, mesmo
  // papel informativo de SolicitacaoCompra.documento. Continuam existindo
  // INTACTOS depois do achado R3 abaixo — quem prefere digitar o número de
  // uma nota emitida fora do sistema (ou não tem Focus NFe configurado)
  // nunca perde esse caminho.
  notaRemessa String?
  notaRetorno String?

  // Achado R3 da auditoria de abrangência (Parte 2/Produção, rodada 20,
  // 2026-09-03) — resultado ESTRUTURADO da emissão da NF-e de REMESSA (CFOP
  // 5901/6901, ver resolverCfopTerceirizacao em src/lib/nota-fiscal.ts)
  // quando emitida direto do sistema via Focus NFe, em vez de só o número
  // digitado em notaRemessa acima. Campos FLAT aqui (não um relacionamento
  // pra NotaFiscal) porque NotaFiscal é 1:1 com Orcamento
  // (orcamentoId String @unique NOT NULL, ver model abaixo) e não existe
  // Orcamento nenhum pra uma remessa de terceirização — reaproveitar aquele
  // model exigiria tornar orcamentoId opcional/reestruturar, fora do escopo
  // deste achado (ver resumo da rodada 20/R3).
  //
  // Só a REMESSA tem emissão real pelo sistema. O RETORNO (CFOP 5902/6902)
  // é, pela tabela CFOP oficial, uma SAÍDA do ESTABELECIMENTO TERCEIRIZADO
  // (quem devolve a mercadoria já industrializada) — nunca da gráfica, que
  // só o RECEBE de volta (entrada 1902/2902 do lado dela). Como este
  // sistema só tem acesso à conta Focus NFe da PRÓPRIA gráfica (nunca a do
  // terceiro), não há como emitir essa nota por aqui — notaRetorno continua
  // sendo só o número digitado da nota que veio do terceiro junto com a
  // mercadoria, comportamento inalterado.
  remessaNfeStatus       StatusNotaFiscal?
  remessaNfeNumero       String?
  remessaNfeSerie        String?
  remessaNfeChaveAcesso  String?
  remessaNfeXmlUrl       String?
  remessaNfeDanfeUrl     String?
  remessaNfeMensagemErro String?           @db.Text

  // Preenchido quando situacao=PROBLEMA — mesmo princípio de
  // Entrega.observacoes (a tela exige preenchido antes de mandar pra
  // PROBLEMA, ver avancarStatusEntrega em producao/entrega-transicao.ts).
  observacao String? @db.Text

  // Dedup do alerta de retorno atrasado (verificarEDispararAlertasAtraso,
  // src/lib/alerta-atraso.ts) — mesmo papel de Pedido.alertaAtrasoEnviadoEm,
  // campo PRÓPRIO porque o vencimento aqui é previsaoRetorno (não
  // Pedido.prazoEntrega): os dois podem estar atrasados em momentos
  // diferentes, e uma terceirização atrasada não implica pedido atrasado.
  alertaAtrasoEnviadoEm DateTime?

  criadoPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  // Cascade: pedidoId é obrigatório (mesmo raciocínio de CustoPedido.pedido
  // acima) — hoje não existe fluxo que apague um Pedido, mas um FK NOT NULL
  // não pode usar SetNull de qualquer forma.
  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  // SetNull, mesmo raciocínio de SolicitacaoCompra.fornecedor: apagar/
  // desativar um Fornecedor não pode apagar o histórico da terceirização, só
  // perde a referência de qual fornecedor formal a atendeu (fornecedorNome
  // preserva o registro textual independente disso).
  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  // Lado inverso de CustoPedido.etapaTerceirizadaId — o CustoPedido origem
  // TERCEIRIZACAO gerado quando valorFinal é preenchido.
  custoPedidoGerado CustoPedido?

  @@index([graficaId])
  @@index([pedidoId])
  @@index([fornecedorId])
  @@map("etapas_terceirizadas")
}

enum OrigemPrevisao {
  MOTOR_PRECIFICACAO
  FICHA_TECNICA
  MANUAL
}

// Previsão de custo por categoria, congelada no momento em que o orçamento
// é aprovado (ver fase-custo-real.md §2.3, §3.1). Existe pra responder
// "orçado vs. realizado" por categoria — não um total só, porque um total
// diz "estourei R$ 780" e por categoria diz "o papel veio 34% acima do
// previsto e apareceu um frete não orçado". Nunca recalculada depois: se o
// preço da matéria-prima mudar após a aprovação, esta linha não se altera.
model PedidoCustoPrevisto {
  id               String         @id @default(cuid())
  graficaId        String
  pedidoId         String
  categoriaCustoId String
  valor            Decimal        @db.Decimal(12, 2)
  origem           OrigemPrevisao
  detalhe          String? // ex: "Papel Couché 150g — 420 folhas"
  createdAt        DateTime       @default(now())

  grafica        Grafica        @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  pedido         Pedido         @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  categoriaCusto CategoriaCusto @relation(fields: [categoriaCustoId], references: [id], onDelete: Restrict)

  @@index([graficaId, pedidoId])
  @@index([categoriaCustoId])
  @@map("pedido_custo_previsto")
}

enum StatusFilaGangRun {
  // Esperando outros itens compatíveis aparecerem — aparece na tela
  // /producao/gang-run agrupado com outros candidatos do mesmo
  // papel+gramatura+prensa+folha+cores.
  AGUARDANDO
  // Um operador decidiu rodar o grupo junto (ver GrupoGangRun) — o rateio
  // de chapa/acerto já foi lançado como CustoPedido (origem=GANG_RUN).
  COMBINADO
  // Saiu da fila sem ser combinado: o pedido foi cancelado, ou avançou pra
  // IMPRESSAO sozinho (o operador decidiu não esperar, ver
  // cancelarCandidatosDoPedido em src/lib/gang-run-servico.ts).
  CANCELADO
}

// Um evento de "rodar junto" — quando um operador decide, na tela
// /producao/gang-run, combinar um grupo de candidatos que compartilham
// papel+gramatura+prensa+folha+cores numa mesma chapa física. Existe como
// registro próprio (não só um campo em FilaGangRun) pra guardar o custo
// TOTAL de chapa+acerto rateado entre os itens combinados — auditável depois
// (ver combinarGrupoGangRun em src/lib/gang-run-servico.ts).
//
// MVP: não otimiza automaticamente QUAIS candidatos combinar nem em quantas
// chapas físicas eles cabem juntos (bin-packing 2D é NP-difícil) — o
// operador escolhe manualmente quando o grupo já tem candidatos suficientes
// pra valer a pena rodar, e o sistema assume que 1 chapa é compartilhada
// entre todos os itens do grupo (ver custoChapas/custoSetup abaixo, que já
// são fixos por combo cor+prensa no motor Offset, independentes da
// quantidade — ver src/lib/pricing/offset.ts).
model GrupoGangRun {
  id        String @id @default(cuid())
  graficaId String

  // Chave de compatibilidade física — mesma folha/prensa/papel/cores, ver
  // comentário de FilaGangRun abaixo.
  papelId      String
  gramaturaGm2 Decimal @db.Decimal(6, 1)
  prensaId     String
  folhaId      String
  corFrente    Int
  corVerso     Int

  // Custo TOTAL de chapa(s) + acerto de máquina da rodada compartilhada —
  // pago UMA vez pelo grupo inteiro (não por item), rateado
  // proporcionalmente ao espaço de cada item na folha (ver
  // FilaGangRun.custoRateado). Snapshot de um dos itens do grupo no momento
  // da combinação (todos têm o mesmo valor, por construção da chave acima).
  custoChapasTotal Decimal @db.Decimal(12, 2)
  custoSetupTotal  Decimal @db.Decimal(12, 2)

  combinadoEm    DateTime @default(now())
  combinadoPorId String?

  grafica Grafica       @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  itens   FilaGangRun[]

  @@index([graficaId])
  @@map("grupos_gang_run")
}

// Candidato a gang run: um OrcamentoItem com modeloCalculo=OFFSET cuja
// quantidade sozinha não preenche uma chapa/folha inteira (fracaoFolha < 1,
// ver ehCandidatoGangRun em src/lib/gang-run.ts) — em vez de rodar uma
// chapa exclusiva só pra ele, fica esperando outros pedidos da MESMA
// gráfica com o MESMO papel+gramatura+prensa+folha+cores (ver
// chaveGrupoGangRun) pra dividir o custo fixo de chapa+acerto. Criado uma
// vez, na aprovação do orçamento (junto com o Pedido, ver
// registrarCandidatosGangRun) — nunca recalculado depois, mesmo que o
// motor de precificação mude.
//
// 1:1 com OrcamentoItem (um item Offset entra na fila no máximo uma vez).
// pedidoId é denormalizado do Orcamento (Pedido.orcamentoId é @unique) só
// pra não precisar de join toda vez que a fila lê/atualiza por pedido (ex:
// cancelarPedido cancelando os candidatos deste pedido).
model FilaGangRun {
  id              String            @id @default(cuid())
  graficaId       String
  orcamentoItemId String            @unique
  pedidoId        String
  status          StatusFilaGangRun @default(AGUARDANDO)

  // Chave de compatibilidade física: só itens com os MESMOS seis valores
  // abaixo podem compartilhar uma chapa/folha (ver chaveGrupoGangRun em
  // src/lib/gang-run.ts). papelId/prensaId vêm de ItemGrafica (matéria-prima
  // e prensa do produto, ver schema de ItemGrafica); folhaId é o
  // FormatoFolha que o motor de nesting ESCOLHEU pra este item específico
  // (metricas.folhaEscolhida.id do breakdown salvo em OrcamentoItem —
  // produtos com mais de um formato cadastrado podem escolher formatos
  // diferentes conforme o tamanho da peça). Sem FK formal pra
  // papel/prensa/folha de propósito: isto é um snapshot de agrupamento, não
  // um vínculo que precise ser mantido consistente se o cadastro mudar
  // depois (mesmo princípio de CategoriaCusto.nome livre em Despesa).
  papelId      String
  gramaturaGm2 Decimal @db.Decimal(6, 1)
  prensaId     String
  folhaId      String
  corFrente    Int
  corVerso     Int

  // nUp = quantas peças deste item cabem numa folha (motor de nesting já
  // existente, calcularImposicao em src/lib/pricing/offset.ts).
  // fracaoFolha = quantidade/nUp — quanto da capacidade de UMA folha este
  // item sozinho ocupa (< 1 é o que faz dele um candidato, ver
  // ehCandidatoGangRun). Soma de fracaoFolha do grupo >= 1 é o sinal
  // (informativo, não automático) de "já dá pra encher uma chapa juntando
  // estes pedidos".
  nUpPeca        Int
  quantidadePeca Int
  fracaoFolha    Decimal @db.Decimal(8, 4)

  // Snapshot do que chapa+acerto custariam se este item rodasse SOZINHO
  // (igual ao que já foi orçado em OrcamentoItem.breakdown.detalhes.chapas/
  // setup) — usado só pra mostrar "quanto está economizando" na tela depois
  // de combinado; nunca é o valor efetivamente cobrado (esse é
  // custoRateado, abaixo).
  custoChapasIndividual Decimal @db.Decimal(12, 2)
  custoSetupIndividual  Decimal @db.Decimal(12, 2)

  grupoGangRunId String?
  // Fatia do GrupoGangRun.custoChapasTotal+custoSetupTotal atribuída a este
  // item (proporcional a fracaoFolha, ver ratearCustoSetup) — preenchido só
  // quando status=COMBINADO. O mesmo valor é lançado como CustoPedido
  // (origem=GANG_RUN) no Pedido deste item.
  custoRateado   Decimal? @db.Decimal(12, 2)

  criadoEm           DateTime  @default(now())
  canceladoEm        DateTime?
  motivoCancelamento String?

  grafica       Grafica       @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamentoItem OrcamentoItem @relation(fields: [orcamentoItemId], references: [id], onDelete: Cascade)
  pedido        Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  grupo         GrupoGangRun? @relation(fields: [grupoGangRunId], references: [id], onDelete: SetNull)

  @@index([graficaId, status])
  @@index([graficaId, papelId, gramaturaGm2, prensaId, folhaId, corFrente, corVerso, status])
  @@index([pedidoId])
  @@map("fila_gang_run")
}

// Atribuição gráfica-wide (não por Pedido individual) de quem é responsável
// por cada etapa de produção — configurada em /usuarios. Usada em dois
// pontos: (1) e-mail automático quando um Pedido ENTRA nesse status (ver
// avancarStatusPedido em src/app/producao/status-transicao.ts), (2) bypass
// de permissão pra confirmar em app sem precisar de PRODUCAO.podeEditar
// completo (ver podeConfirmarEstagio em src/lib/auth/permissoes.ts). Só
// cobre as 5 etapas "vivas" atribuíveis (PRODUCAO/ACABAMENTO/CONFERENCIA/
// EMBALAGEM/EXPEDICAO, ver ESTAGIOS_ATRIBUIVEIS) — ARTE (estágio inicial) e
// CLICHE_FACA (etapa que baixa matéria-prima do estoque ao ser deixada)
// ficam de fora (decisão do produto: evita expor a tela de perda de
// material do estoque a um link sem login) e ENTREGUE/CANCELADO são
// terminais, sem transição de "confirmar" alguma.
model ResponsavelEstagio {
  id        String       @id @default(cuid())
  usuarioId String
  status    StatusPedido

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, status])
  @@index([status])
  @@map("responsaveis_estagio")
}

// Área ADMINISTRATIVA (não é etapa de produção — por isso não reaproveita
// ResponsavelEstagio/StatusPedido, que é o motor de estado do Pedido) que
// pode ter um ou mais responsáveis atribuídos. NOTA_FISCAL (pedido do usuário
// em 2026-08-15/16: notificar quem emite a NF-e quando um orçamento é
// aprovado e já está pronto pra emitir) e PRAZO_PRODUCAO (achado A9 da
// auditoria de abrangência em 2026-08-24: sem isto, o alerta de
// prazo/atraso de pedido em src/lib/alerta-prazo-email.ts só sabia mandar
// pro vendedor + todo DONO da gráfica, sem jeito de rotear pra um PCP
// dedicado sem promovê-lo a DONO) — enum deixado aberto pra outras áreas
// administrativas futuras (cobrança, etc.) sem precisar de migration nova,
// só adicionar valor ao enum + linha na UI.
// PRAZO_PRODUCAO adicionado 2026-08-24 (achado A9 da auditoria de
// abrangência) pra rotear o alerta de prazo/atraso de pedido
// (src/lib/alerta-prazo-email.ts) pra um responsável dedicado em vez de
// sempre cair em todos os DONOs. COMPRAS adicionado 2026-08-31 (achado A9,
// restante pendente) pro mesmo tratamento no alerta de estoque crítico
// (src/lib/alerta-estoque.ts). COBRANCA adicionado junto (mesmo achado,
// mesma rodada) só como valor cadastrável — hoje não existe nenhum disparo
// de e-mail de "conta a receber vencida" no código pra rotear (só a tela
// /financeiro/contas-receber destacando visualmente as vencidas), então
// marcar um funcionário aqui não liga nada ainda; fica pronto pro dia que
// esse alerta for construído.
enum AreaAdministrativa {
  NOTA_FISCAL
  PRAZO_PRODUCAO
  COBRANCA
  COMPRAS
}

model ResponsavelAdministrativo {
  id        String             @id @default(cuid())
  usuarioId String
  area      AreaAdministrativa

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, area])
  @@index([area])
  @@map("responsaveis_administrativo")
}

// Rate limit da confirmação pública de etapa (src/app/p/[token]) — tabela
// separada de TentativaRespostaArte pra não misturar os dois orçamentos de
// tentativa (abuso num fluxo não deve travar o outro).
model TentativaConfirmacaoEstagio {
  id        String   @id @default(cuid())
  pedidoId  String
  ip        String
  createdAt DateTime @default(now())

  @@index([pedidoId, createdAt])
  @@index([ip, createdAt])
  @@map("tentativas_confirmacao_estagio")
}

// Rate limit da resposta pública ao orçamento (src/app/o/[token]) — mesmo
// padrão de TentativaRespostaArte/TentativaConfirmacaoEstagio, tabela
// própria pra não misturar o orçamento de tentativas dos três fluxos
// públicos por token.
model TentativaRespostaOrcamento {
  id          String   @id @default(cuid())
  orcamentoId String
  ip          String
  createdAt   DateTime @default(now())

  @@index([orcamentoId, createdAt])
  @@index([ip, createdAt])
  @@map("tentativas_resposta_orcamento")
}

enum TipoArquivoArmazenado {
  ARTE_PEDIDO
  ARTE_ORCAMENTO
  LOGO_GRAFICA
  ANALISE_TINTA // reservado pra Cálculo de gasto de tinta com IA
  PLANILHA_IMPORTACAO // reservado pro Importador de planilha com IA (ver ImportacaoPlanilha)
}

enum TipoImportacaoPlanilha {
  CLIENTES
  CATALOGO
  PEDIDOS
}

enum StatusImportacaoPlanilha {
  MAPEANDO // arquivo recebido, aguardando/mostrando sugestão da IA
  CONFIRMADO // usuário confirmou o mapeamento, escrita ainda não começou
  PROCESSANDO // escrita em andamento
  CONCLUIDO // terminou (mesmo com linhas com erro — ver linhasComErro)
  ERRO // falhou antes de terminar (webhook, arquivo expirado etc.)
}

// Um upload de planilha do Importador com IA — serve tanto de registro de
// auditoria/resultado quanto de CONTADOR DE COTA MENSAL (ver
// src/lib/billing/limite-importacao.ts): a linha é criada ao pedir a
// sugestão de mapeamento, ANTES da chamada ao webhook de IA (mesmo
// raciocínio de AnaliseTintaLog — falha de rede depois ainda consome cota,
// porque a plataforma já pagou a chamada). Cota é compartilhada entre os 3
// tipos (contada por graficaId+createdAt do mês corrente, não por tipo).
model ImportacaoPlanilha {
  id        String @id @default(cuid())
  graficaId String
  usuarioId String

  tipo   TipoImportacaoPlanilha
  status StatusImportacaoPlanilha @default(MAPEANDO)

  nomeArquivo     String
  // Pathname no store PRIVADO do Blob — null depois que o arquivo é apagado
  // ao concluir a importação ou expirar sem confirmação (ver
  // expirarImportacoesAbandonadas em src/lib/lifecycle-cron.ts).
  arquivoPathname String?

  linhasTotal      Int
  linhasImportadas Int @default(0)
  linhasComErro    Int @default(0)

  // Sugestão da IA (passo 1) e o que o usuário de fato CONFIRMOU (passo 2) —
  // { "Coluna A": "nome", "Coluna B": "ignorar", ... }, uma entrada por
  // COLUNA da planilha, nunca por linha — cabe folgado num Json.
  mapeamentoSugerido   Json?
  mapeamentoConfirmado Json?

  // Até 50 mensagens de erro por linha ("Linha 12: e-mail inválido") —
  // capado na aplicação, nunca guarda as linhas originais aqui.
  erros Json?

  // Preenchido só quando status=ERRO (falha de webhook, arquivo expirado
  // sem confirmação etc.).
  mensagemErro String?

  createdAt   DateTime  @default(now())
  concluidoEm DateTime?

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  // [graficaId, createdAt]: cota mensal (conta linhas do mês corrente, mesmo
  // padrão de inicioDoMesUTC em billing/uso.ts). [status, createdAt]: cron
  // de expiração de mapeamento abandonado.
  @@index([graficaId, createdAt])
  @@index([status, createdAt])
  @@map("importacoes_planilha")
}

// Razão de TODO arquivo que a gráfica sobe pro Vercel Blob (arte de pedido,
// logo, imagem de análise de tinta) — existe pra sustentar a cota de
// armazenamento por plano (ver src/lib/billing/limite-armazenamento.ts),
// não pra guardar o arquivo em si (isso continua no Blob; aqui só o
// tamanho e a referência). Uma linha por arquivo VIVO: ao substituir uma
// arte/logo, a linha antiga é apagada na mesma operação que confirma a
// nova (ver src/lib/billing/armazenamento.ts), nunca acumula histórico.
//
// url null = reserva pendente (a soma da cota já conta esta linha antes do
// put() no Blob terminar, pra duas escritas concorrentes não furarem o
// limite — ver reservarEspaco). Uma reserva que nunca vira upload de
// verdade (crash entre reservar e subir) é varrida pelo cron de
// reconciliação (src/lib/lifecycle-cron.ts) depois de 1h.
//
// onDelete: Cascade em graficaId apaga as LINHAS quando a Grafica é
// apagada, mas não os blobs — eles viram órfão e são recolhidos pela mesma
// reconciliação (varre o Blob inteiro, não só o razão).
model ArquivoArmazenado {
  id           String                @id @default(cuid())
  graficaId    String
  tipo         TipoArquivoArmazenado
  referenciaId String // pedidoId | graficaId | orcamentoItemId, conforme o tipo
  bytes        Int
  url          String?               @unique
  pathname     String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@index([graficaId])
  @@index([tipo, referenciaId])
  @@map("arquivos_armazenados")
}

// Estimativa de gasto de tinta gerada por IA a partir de uma imagem da arte
// (recurso de plano pago — ver src/lib/billing/recursos-pagos.ts,
// "calculo_tinta_ia" — disparado manualmente pelo usuário). Tabela separada
// da OrcamentoItem pelo mesmo motivo de OrcamentoItemEtiqueta: colunas que
// ficariam nulas na esmagadora maioria dos itens. 1:1 com substituição —
// refazer a análise sobrescreve esta linha e apaga a imagem antiga do Blob,
// mesma semântica de Pedido.arteUrl. Histórico de USO (pra rate limit) vive
// em AnaliseTintaLog, não aqui.
model OrcamentoItemTinta {
  id              String @id @default(cuid())
  orcamentoItemId String @unique

  // Blob PRIVADO (diferente de Pedido.arteUrl, que é público de propósito —
  // esta imagem nunca é vista fora do tenant). pathname guardado à parte
  // pra assinar/apagar sem precisar reparsear a URL.
  imagemUrl      String
  imagemPathname String
  imagemTipo     String

  coberturaPercentual Decimal  @db.Decimal(5, 2)
  coberturaCiano      Decimal? @db.Decimal(5, 2)
  coberturaMagenta    Decimal? @db.Decimal(5, 2)
  coberturaAmarelo    Decimal? @db.Decimal(5, 2)
  coberturaPreto      Decimal? @db.Decimal(5, 2)

  consumoMlPorPeca Decimal @db.Decimal(12, 6)
  consumoMlTotal   Decimal @db.Decimal(12, 3)

  // String, não enum: valor vem de um LLM externo, normalizado na aplicação
  // (ALTA/MEDIA/BAIXA, com MEDIA como fallback) — um enum quebraria se a IA
  // devolvesse um valor inesperado.
  confianca String

  observacao String? @db.Text
  modeloIa   String?

  // Snapshot do que foi analisado — o item é editável em RASCUNHO, e sem
  // isso mudar a quantidade/medida depois transforma consumoMlTotal numa
  // mentira silenciosa (ver aviso de desatualização na UI).
  quantidadeSnapshot Int
  larguraCmSnapshot  Decimal? @db.Decimal(8, 2)
  alturaCmSnapshot   Decimal? @db.Decimal(8, 2)

  criadoPorUsuarioId String
  createdAt          DateTime @default(now())

  orcamentoItem OrcamentoItem @relation(fields: [orcamentoItemId], references: [id], onDelete: Cascade)

  @@map("orcamento_item_tinta")
}

// Log de USO (não de conteúdo) do cálculo de tinta com IA — mesmo padrão de
// PerguntaAssistenteLog, existe só pra sustentar o rate limit (ver
// src/lib/rate-limit-tinta.ts): protege o custo de token/imagem da
// PLATAFORMA contra abuso, já que a IA roda numa conta única, não por tenant.
model AnaliseTintaLog {
  id        String   @id @default(cuid())
  graficaId String
  usuarioId String
  createdAt DateTime @default(now())

  @@index([usuarioId, createdAt])
  @@index([graficaId, createdAt])
  @@map("analise_tinta_log")
}
