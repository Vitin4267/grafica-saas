// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Cada gráfica é um tenant: todo dado abaixo pertence a uma Grafica
// e nunca deve vazar entre tenants nas queries da aplicação.
model Grafica {
  id        String   @id @default(cuid())
  nome      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Liga/desliga o compartilhamento da aba "Meu Negócio" com a equipe (não-DONO).
  // Controle fino de quem exatamente vê fica em Usuario.acessoMeuNegocio — os dois
  // precisam ser verdadeiros pra um funcionário enxergar a aba (ver podeVerMeuNegocio).
  compartilharMeuNegocio Boolean @default(false)

  usuarios              Usuario[]
  clientes              Cliente[]
  itensGrafica          ItemGrafica[]
  itensCatalogoPrivados ItemCatalogo[]
  orcamentos            Orcamento[]
  pedidos               Pedido[]
  parametros            ParametrosGrafica?
  prensas               Prensa[]
  dadosFiscais          DadosFiscaisGrafica?
  notasFiscais          NotaFiscal[]
  assistente            AssistenteGrafica?
  despesas              Despesa[]
  logsAuditoria         LogAuditoria[]
  assinatura            AssinaturaGrafica?

  @@map("graficas")
}

// Parâmetros globais do motor de precificação avançado (M2/OFFSET), um por tenant.
// Os campos de custo de máquina (torres, custoHoraMaq etc.) viraram o modelo Prensa
// — um tenant pode ter várias prensas offset com custos/rendimentos diferentes.
model ParametrosGrafica {
  id        String @id @default(cuid())
  graficaId String @unique

  // Composição final do preço (spec §0 e §4)
  overheadPercent          Decimal @default(0.15) @db.Decimal(5, 4)
  margemPadrao             Decimal @default(0.20) @db.Decimal(5, 4)
  impostoPercent           Decimal @default(0.06) @db.Decimal(5, 4)
  comissaoPercent          Decimal @default(0) @db.Decimal(5, 4)
  taxaFinanceiraPercent    Decimal @default(0) @db.Decimal(5, 4)
  pedidoMinimo             Decimal @default(0) @db.Decimal(12, 2)
  incrementoArredondamento Decimal @default(0.10) @db.Decimal(6, 2)

  // Defaults de nesting em bobina (spec §1: s, g)
  margemSegurancaPadrao Decimal @default(0.02) @db.Decimal(5, 4)
  gapPecasPadrao        Decimal @default(0.008) @db.Decimal(5, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@map("parametros_grafica")
}

// Uma prensa offset física do tenant. Produtos com modeloCalculo=OFFSET escolhem
// uma prensa específica em ItemGrafica.prensaId — cada prensa tem seu próprio
// custo de hora-máquina, chapas, torres etc. (ver spec §2, antes vivia em
// ParametrosGrafica como uma "prensa virtual" única por gráfica).
model Prensa {
  id        String  @id @default(cuid())
  graficaId String
  nome      String
  ativa     Boolean @default(true)

  custoHoraMaq       Decimal @default(0) @db.Decimal(12, 4)
  torres             Int     @default(4)
  custoChapa         Decimal @default(0) @db.Decimal(12, 4)
  folhasAcerto       Int     @default(150)
  tempoAcertoH       Decimal @default(0.5) @db.Decimal(6, 4)
  custoMilheiroRod   Decimal @default(0) @db.Decimal(12, 4)
  rodagemMinima      Decimal @default(0) @db.Decimal(12, 4)
  perdaPercentPadrao Decimal @default(0.03) @db.Decimal(5, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica  Grafica       @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  produtos ItemGrafica[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("prensas")
}

// Dados fiscais da gráfica pra emitir nota fiscal via Focus NFe — 100% opt-in,
// nunca pedido em /comecar ou /login, só configurado quando a gráfica realmente
// for usar a função (ver NotaFiscalCard em /orcamento/[id]). Cada gráfica traz
// sua PRÓPRIA conta na Focus NFe (não uma conta compartilhada do grafica-saas):
// o token abaixo é o dela, e o site nunca armazena/manuseia certificado digital
// — isso fica inteiramente do lado da Focus NFe.
//
// A API da Focus NFe exige os dados do emitente (CNPJ, razão social, endereço)
// em TODA chamada de emissão — não fica pré-configurado na conta deles, por
// isso precisamos guardar aqui também (confirmado no exemplo oficial da API).
model DadosFiscaisGrafica {
  id        String @id @default(cuid())
  graficaId String @unique

  focusNfeToken String? // token da CONTA DELES na Focus NFe — nunca uma conta nossa
  ambiente      String  @default("homologacao") // homologacao | producao — nasce em homologação por segurança

  cnpj              String?
  razaoSocial       String?
  nomeFantasia      String?
  inscricaoEstadual String?
  regimeTributario  String? // informativo (ex: "Simples Nacional") — orienta o CSOSN padrão

  enderecoCep        String?
  enderecoLogradouro String?
  enderecoNumero     String?
  enderecoBairro     String?
  enderecoMunicipio  String?
  enderecoUf         String?

  naturezaOperacaoPadrao String @default("Venda de mercadoria")
  cfopPadrao             String @default("5102") // venda dentro do estado, mercadoria de terceiros
  csosnPadrao            String @default("102")  // Simples Nacional, tributada sem permissão de crédito

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@map("dados_fiscais_grafica")
}

enum StatusNotaFiscal {
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
  ERRO
}

// Uma nota fiscal emitida (ou em processamento) pra um orçamento aprovado.
// 1:1 com Orcamento — mesmo padrão de Pedido. `referencia` é a chave que
// mandamos pra Focus NFe pra identificar essa emissão (idempotência do lado
// deles); `chaveAcesso` só existe depois de AUTORIZADA.
model NotaFiscal {
  id           String           @id @default(cuid())
  graficaId    String
  orcamentoId  String           @unique
  referencia   String           @unique
  status       StatusNotaFiscal @default(PROCESSANDO)
  numero       String?
  serie        String?
  chaveAcesso  String?
  xmlUrl       String?
  danfeUrl     String?
  mensagemErro String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  grafica   Grafica   @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id])

  @@index([graficaId])
  @@map("notas_fiscais")
}

// Configuração do assistente de IA de uso do site — 100% opt-in, nunca pedido
// em /comecar ou /login. A IA de verdade não roda aqui: o grafica-saas só
// encaminha a pergunta do usuário + em qual página ele está pro workflow n8n
// que a PRÓPRIA gráfica configurou (nunca uma conta nossa, mesmo modelo de
// DadosFiscaisGrafica). É estritamente um guia de uso do site — a aplicação
// NUNCA inclui orçamento, cliente, valor, pagamento ou nota fiscal no payload
// enviado (ver src/lib/webhook-assistente.ts).
model AssistenteGrafica {
  id        String @id @default(cuid())
  graficaId String @unique

  // URL do workflow n8n do PRÓPRIO tenant — o path costuma carregar um UUID
  // que funciona como token de capability (padrão de webhook do n8n), por
  // isso é tratada como segredo (nunca reexibida por completo, ver
  // /configuracoes/assistente).
  webhookUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@map("assistente_grafica")
}

enum StatusAssinatura {
  TRIALING
  ATIVA
  INADIMPLENTE // past_due no Stripe: pagamento falhou mas a assinatura ainda não cancelou
  CANCELADA
}

// Cobrança da PLATAFORMA sobre a gráfica (assinatura do SaaS) — diferente do
// padrão "bring your own account" usado por DadosFiscaisGrafica/AssistenteGrafica
// (onde a credencial é da própria gráfica): aqui a conta Stripe é NOSSA, do
// dono do grafica-saas. Guarda só o status derivado + IDs de referência — o
// Stripe é a fonte de verdade do dinheiro, isto aqui é um cache local pro
// gate de acesso (src/lib/auth/assinatura.ts) não precisar chamar a API do
// Stripe em toda página. A única escrita em `status` depois da criação vem
// do webhook (src/app/api/webhooks/stripe/route.ts), nunca de uma Server
// Action comum.
model AssinaturaGrafica {
  id        String @id @default(cuid())
  graficaId String @unique

  status StatusAssinatura @default(TRIALING)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  trialExpiraEm        DateTime?
  periodoAtualExpiraEm DateTime? // current_period_end do Stripe, pra exibir "próxima cobrança em"
  canceladaEm          DateTime?

  // Início da janela de 15 dias de tolerância depois de ultrapassar o teto
  // de uso do plano (orçamentos/mês ou usuários) — null = dentro do limite
  // hoje. Ver src/lib/billing/limite-uso.ts.
  limiteExcedidoDesde DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@map("assinatura_grafica")
}

// Registro de cada pergunta enviada ao assistente — existe só pra rate limiting
// (mesmo padrão de TentativaLogin: conta linhas numa janela de tempo). NÃO
// guarda o texto da pergunta: não precisa pra esse propósito, e menos dado
// guardado é menos dado pra vazar. Protege contra spam/gasto de token do n8n
// da própria gráfica, tanto de um usuário sozinho quanto da gráfica toda.
model PerguntaAssistenteLog {
  id        String   @id @default(cuid())
  graficaId String
  usuarioId String
  createdAt DateTime @default(now())

  @@index([usuarioId, createdAt])
  @@index([graficaId, createdAt])
  @@map("pergunta_assistente_log")
}

enum PapelUsuario {
  DONO
  ADMIN
  OPERADOR
}

model Usuario {
  id           String       @id @default(cuid())
  graficaId    String
  nome         String
  email        String       @unique
  senhaHash    String
  papel        PapelUsuario @default(OPERADOR)
  createdAt    DateTime     @default(now())

  // Concedido individualmente pelo DONO em /usuarios. Só tem efeito se
  // Grafica.compartilharMeuNegocio também estiver ligado — ver podeVerMeuNegocio.
  // Irrelevante pra DONO, que sempre tem acesso.
  acessoMeuNegocio Boolean @default(false)

  grafica     Grafica            @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamentos  Orcamento[]
  sessoes     Sessao[]
  permissoes  PermissaoUsuario[]

  @@index([graficaId])
  @@map("usuarios")
}

// Só existe controle granular por módulo pra papel OPERADOR — DONO e ADMIN
// sempre têm acesso total, não passam por aqui (ver podeVerModulo/
// podeEditarModulo em src/lib/auth/permissoes.ts). Ausência de linha pra um
// módulo = sem acesso nenhum (nem ver), é o padrão mais seguro por omissão.
enum ModuloPermissao {
  ORCAMENTO
  CLIENTES
  CATALOGO
  PRODUCAO
  FINANCEIRO
  CONFIGURACOES
}

model PermissaoUsuario {
  id         String          @id @default(cuid())
  usuarioId  String
  modulo     ModuloPermissao
  podeVer    Boolean         @default(false)
  podeEditar Boolean         @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, modulo])
  @@map("permissoes_usuario")
}

// Sessão opaca: o cookie do usuário guarda só o token bruto, nunca persistido em texto puro aqui.
// Guardar apenas o hash do token faz um vazamento do banco não virar sessões utilizáveis,
// e apagar a linha revoga a sessão imediatamente (logout, troca de senha, etc).
model Sessao {
  id        String   @id @default(cuid())
  usuarioId String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  criadaEm  DateTime @default(now())
  expiraEm  DateTime

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sessoes")
}

// Registro de tentativas de login (sucesso e falha) para permitir bloqueio temporário
// por e-mail e por IP contra ataques de força bruta, sobrevivendo a reinícios do servidor.
model TentativaLogin {
  id        String   @id @default(cuid())
  email     String
  ip        String
  sucesso   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("tentativas_login")
}

// Conta tentativas de cadastro (/registro) por IP — sem isso, um bot pode criar
// gráficas/usuários sem limite (spam de dados + custo de CPU do hash argon2id
// a cada tentativa, já que ele só é evitado quando o e-mail já existe).
model TentativaRegistro {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@map("tentativas_registro")
}

model Cliente {
  id        String   @id @default(cuid())
  graficaId String
  nome      String
  email     String?
  telefone  String?
  documento String? // CPF ou CNPJ
  createdAt DateTime @default(now())

  // Endereço — opcional pra cadastro comum, mas exigido pra emitir nota fiscal
  // (ver DadosFiscaisGrafica / NotaFiscal). enderecoCodigoIbge é nullable e não
  // bloqueia emissão: o exemplo oficial da Focus NFe envia só município+UF.
  enderecoCep         String?
  enderecoLogradouro  String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoMunicipio   String?
  enderecoCodigoIbge  String?
  enderecoUf          String?

  grafica    Grafica     @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamentos Orcamento[]

  @@index([graficaId])
  @@map("clientes")
}

enum UnidadeMedida {
  FOLHA
  METRO_QUADRADO
  METRO_LINEAR
  UNIDADE
  LITRO
  KG
  ROLO
  PACOTE
  CENTO
  HORA
}

enum TipoItemCatalogo {
  PRODUTO
  MATERIA_PRIMA
  SERVICO
}

// Modelo de cálculo de um PRODUTO: SIMPLES é o preço direto (precoVenda × área/quantidade,
// como sempre funcionou); M2 e OFFSET acionam o motor avançado (src/lib/pricing) e exigem
// configuração extra (bobinas ou formatos de folha). Sempre opt-in por item, nunca default.
enum ModeloCalculo {
  SIMPLES
  M2
  OFFSET
}

// Como um acabamento (SERVICO) é cobrado — spec §3. FOLHA_IMPRESSA é o caso mais sutil:
// cobra pela folha de máquina ANTES do refile (ex: BOPP), não pela peça final.
enum BaseCobranca {
  UNIDADE
  M2
  FOLHA_IMPRESSA
  METRO_LINEAR
  FIXO
  HORA
}

enum EstagioAcabamento {
  PRE_REFILE
  POS_REFILE
}

// Catálogo: base é mestre e compartilhada entre todas as gráficas (graficaId=null,
// só criada via seed). Cada gráfica pode complementar com itens próprios que faltem
// (graficaId preenchido, criados pelo botão "Adicionar" em /catalogo) — esses ficam
// privados: só a gráfica dona vê e pode selecionar (ver salvarCatalogo/página do
// catálogo, que sempre filtram por graficaId=null OU graficaId=tenant atual).
// Cada gráfica escolhe, em ItemGrafica, o que ela realmente oferece/usa e define
// seus próprios preços — o item de catálogo em si nunca muda por tenant.
model ItemCatalogo {
  id        String           @id @default(cuid())
  graficaId String? // null = catálogo mestre; preenchido = item privado dessa gráfica
  tipo      TipoItemCatalogo
  categoria String
  nome      String
  descricao String?
  unidade   UnidadeMedida?
  ncm       String? // classificação fiscal (NF-e) — nullable, só exigido no momento de emitir nota
  createdAt DateTime         @default(now())

  grafica      Grafica?      @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  itensGrafica ItemGrafica[]

  // Nota: como o Postgres trata NULL como distinto em índices únicos, esta
  // constraint não impede globais (graficaId=null) duplicados entre si — por
  // isso o seed faz a própria checagem de duplicidade em vez de contar só com
  // isto (ver prisma/seed.ts). Para itens privados (graficaId preenchido) a
  // constraint funciona normalmente.
  @@unique([graficaId, tipo, nome])
  @@index([tipo, categoria])
  @@index([graficaId])
  @@map("itens_catalogo")
}

// Seleção da gráfica dentro do catálogo mestre: liga a gráfica a um ItemCatalogo
// e guarda os preços que ELA define (compra = custo de aquisição/produção,
// venda = quanto cobra do cliente). ativo=false "desliga" o item sem apagar
// histórico (orçamentos e movimentações de estoque continuam íntegros).
model ItemGrafica {
  id             String   @id @default(cuid())
  graficaId      String
  itemCatalogoId String
  ativo          Boolean  @default(true)
  precoCompra    Decimal? @db.Decimal(12, 4)
  precoVenda     Decimal? @db.Decimal(12, 2)
  estoqueAtual   Decimal? @db.Decimal(12, 4)
  estoqueMinimo  Decimal? @db.Decimal(12, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Motor avançado — só relevante quando tipo=PRODUTO no ItemCatalogo relacionado.
  modeloCalculo ModeloCalculo @default(SIMPLES)
  viraFolha     Boolean       @default(false) // work-and-turn; só usado quando modeloCalculo=OFFSET

  // Qual prensa física produz este item — só relevante/obrigatório (na aplicação)
  // quando modeloCalculo=OFFSET. onDelete=Restrict: não deixa excluir uma prensa
  // ainda em uso por algum produto.
  prensaId String?

  // Gramatura escolhida — só relevante quando modeloCalculo=OFFSET (produto) ou
  // quando este item é usado como papel de outro produto (matéria-prima). No
  // produto, alimenta tanto o peso físico real da folha quanto a busca (com
  // fallback) na TabelaPrecoPapel do papel selecionado — ver `papelId` abaixo
  // e src/lib/pricing/papel.ts.
  gramaturaGm2 Decimal? @db.Decimal(6, 1)

  // Qual matéria-prima (papel) este produto Offset usa — só relevante/obrigatório
  // (na aplicação) quando modeloCalculo=OFFSET. O preço por kg não fica mais
  // digitado no produto: é resolvido em runtime pela TabelaPrecoPapel do papel
  // referenciado aqui, usando gramaturaGm2 como chave (com fallback pra mais
  // próxima). onDelete=Restrict: não deixa excluir um papel ainda em uso.
  papelId String?

  // Só relevante quando tipo=PRODUTO e modeloCalculo=M2.
  custoImpressaoM2    Decimal? @db.Decimal(12, 4)
  areaMinimaFaturavel Decimal? @db.Decimal(8, 4)

  grafica      Grafica      @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  itemCatalogo ItemCatalogo @relation(fields: [itemCatalogoId], references: [id])
  prensa       Prensa?      @relation(fields: [prensaId], references: [id], onDelete: Restrict)
  papel        ItemGrafica? @relation("PapelDoProdutoOffset", fields: [papelId], references: [id], onDelete: Restrict)

  itensOrcamento OrcamentoItem[]
  movimentacoes  MovimentacaoEstoque[]

  bobinas                BobinaMaterial[]
  formatosFolha          FormatoFolha[]
  configuracaoAcabamento ConfiguracaoAcabamento?
  usadoComoAcabamento    OrcamentoItemAcabamento[]

  // Ficha técnica (spec de baixa automática de estoque): só relevante quando
  // tipo=PRODUTO. fichaTecnica = quais matérias-primas este produto consome;
  // usadoComoMateriaPrima = em quais fichas técnicas esta matéria-prima aparece.
  fichaTecnica           FichaTecnicaItem[] @relation("FichaTecnicaDoProduto")
  usadoComoMateriaPrima  FichaTecnicaItem[] @relation("MateriaPrimaConsumida")

  // Papel: produtos Offset que usam este item como papel, e a tabela de
  // preço por gramatura deste item quando ELE é o papel (tipo=MATERIA_PRIMA).
  produtosQueUsam  ItemGrafica[]      @relation("PapelDoProdutoOffset")
  tabelaPrecoPapel TabelaPrecoPapel[] @relation("TabelaDoPapel")

  // Variantes deste item quando ELE é uma matéria-prima com sub-variação
  // (ex: espessura de chapa) — ver comentário do model VarianteMateriaPrima.
  variantes VarianteMateriaPrima[] @relation("VariantesDaMateriaPrima")

  @@unique([graficaId, itemCatalogoId])
  @@index([graficaId])
  @@map("itens_grafica")
}

// Tabela de preço por gramatura de um papel (ItemGrafica tipo=MATERIA_PRIMA).
// Um papel = 1 cadastro no catálogo; a gramatura vira um subtópico aqui em vez
// de virar um cadastro inteiro novo (ver comentário do model ItemGrafica).
// resolverPrecoPapel (src/lib/pricing/papel.ts) busca aqui pela gramatura
// exata e, se não achar, cai no fallback pela mais próxima.
model TabelaPrecoPapel {
  id            String   @id @default(cuid())
  itemGraficaId String
  gramatura     Int
  precoKg       Decimal  @db.Decimal(12, 4)
  createdAt     DateTime @default(now())

  itemGrafica ItemGrafica @relation("TabelaDoPapel", fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@unique([itemGraficaId, gramatura])
  @@index([itemGraficaId])
  @@map("tabela_preco_papel")
}

// Quanto de uma matéria-prima um produto consome por unidade vendida (ex: 1 Cartão de
// Visita consome 0,002 folha de Papel Couché 300g). Alimenta a baixa automática de
// estoque quando um Pedido entra em produção (ver avancarPedido) — v1 só cobre
// PRODUTO×quantidade do OrcamentoItem; acabamentos/serviços consumindo material próprio
// (ex: BOPP na laminação) ficam de fora por ora.
model FichaTecnicaItem {
  id                   String   @id @default(cuid())
  itemGraficaId        String // o produto (ItemGrafica tipo PRODUTO)
  materiaPrimaId       String // a matéria-prima consumida (outro ItemGrafica, tipo MATERIA_PRIMA)
  quantidadePorUnidade Decimal  @db.Decimal(12, 6)
  createdAt            DateTime @default(now())

  // Qual variante da matéria-prima (ex: espessura de uma chapa) é consumida —
  // só relevante/obrigatório (na aplicação) quando a matéria-prima tem
  // VarianteMateriaPrima cadastrada. Sem variantes, fica null e o consumo é
  // do ItemGrafica direto, como sempre foi.
  varianteId String?

  itemGrafica  ItemGrafica           @relation("FichaTecnicaDoProduto", fields: [itemGraficaId], references: [id], onDelete: Cascade)
  materiaPrima ItemGrafica           @relation("MateriaPrimaConsumida", fields: [materiaPrimaId], references: [id], onDelete: Cascade)
  variante     VarianteMateriaPrima? @relation(fields: [varianteId], references: [id], onDelete: Restrict)

  @@unique([itemGraficaId, materiaPrimaId, varianteId])
  @@index([itemGraficaId])
  @@index([materiaPrimaId])
  @@index([varianteId])
  @@map("ficha_tecnica_itens")
}

// Variante de uma matéria-prima (ex: espessura de uma chapa: 2mm/3mm/5mm) —
// mesma filosofia de TabelaPrecoPapel (1 cadastro de matéria-prima, N
// subtópicos), mas aqui cada variante tem preço E estoque próprios, porque
// (diferente da gramatura do papel) variantes físicas diferentes têm saldos
// de estoque diferentes de verdade. `ativo=false` é soft-delete: nunca se
// apaga uma variante que já foi referenciada por ficha técnica ou
// movimentação de estoque, só se desativa (some da tela, histórico intacto).
model VarianteMateriaPrima {
  id            String   @id @default(cuid())
  itemGraficaId String // a matéria-prima "pai" (ItemGrafica tipo=MATERIA_PRIMA)
  rotulo        String // ex: "2mm", "3mm", "5mm"
  ativo         Boolean  @default(true)
  precoCompra   Decimal  @db.Decimal(12, 4)
  estoqueAtual  Decimal? @db.Decimal(12, 4)
  estoqueMinimo Decimal? @db.Decimal(12, 4)
  createdAt     DateTime @default(now())

  itemGrafica ItemGrafica @relation("VariantesDaMateriaPrima", fields: [itemGraficaId], references: [id], onDelete: Cascade)

  fichaTecnica  FichaTecnicaItem[]
  movimentacoes MovimentacaoEstoque[]

  @@unique([itemGraficaId, rotulo])
  @@index([itemGraficaId])
  @@map("variantes_materia_prima")
}

// Opções de bobina de um material (ex: Lona 440g vem em rolos de 1,00/1,20/1,50m).
// custoM2 não é duplicado aqui — vem de ItemGrafica.precoCompra (fonte única).
model BobinaMaterial {
  id             String   @id @default(cuid())
  itemGraficaId  String
  larguraNominal Decimal  @db.Decimal(6, 3) // W_nominal, metros
  refile         Decimal  @db.Decimal(6, 3) // m_refile por lado, metros
  createdAt      DateTime @default(now())

  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@index([itemGraficaId])
  @@map("bobinas_material")
}

// Formatos de folha de máquina de um papel (ex: Couché 300g em 66x96 e 33x48).
model FormatoFolha {
  id            String   @id @default(cuid())
  itemGraficaId String
  nome          String // ex: "Fechada 66x96"
  larguraFolha  Decimal  @db.Decimal(6, 3) // L_f, metros
  alturaFolha   Decimal  @db.Decimal(6, 3) // A_f, metros
  createdAt     DateTime @default(now())

  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@index([itemGraficaId])
  @@map("formatos_folha")
}

// Configura um SERVICO como acabamento do motor avançado (spec §3).
// custoUnitario da fórmula não é campo novo — é o ItemGrafica.precoCompra do próprio serviço.
model ConfiguracaoAcabamento {
  id               String            @id @default(cuid())
  itemGraficaId    String            @unique
  baseCobranca     BaseCobranca
  estagio          EstagioAcabamento
  custoSetup       Decimal           @default(0) @db.Decimal(12, 4)
  custoMinimo      Decimal           @default(0) @db.Decimal(12, 4)
  custoFerramental Decimal?          @db.Decimal(12, 4)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@map("configuracoes_acabamento")
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

model MovimentacaoEstoque {
  id            String           @id @default(cuid())
  itemGraficaId String
  // Qual pedido de produção gerou essa saída (quando aplicável) — permite
  // comparar consumo real vs. previsto pela ficha técnica por pedido, em vez
  // de depender de parsear o texto livre de `motivo`.
  pedidoId      String?
  tipo          TipoMovimentacao
  quantidade    Decimal          @db.Decimal(12, 4)
  motivo        String?
  createdAt     DateTime         @default(now())

  // Qual variante da matéria-prima moveu (quando ela tem variantes) —
  // itemGraficaId continua apontando pro "pai", pra joins/relatórios; isso
  // aqui só desambigua QUAL saldo (2mm ou 5mm) foi decrementado. SetNull,
  // igual pedidoId: preserva o histórico do movimento mesmo se a variante
  // um dia for desativada/apagada.
  varianteId String?

  itemGrafica ItemGrafica           @relation(fields: [itemGraficaId], references: [id], onDelete: Cascade)
  pedido      Pedido?               @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  variante    VarianteMateriaPrima? @relation(fields: [varianteId], references: [id], onDelete: SetNull)

  @@index([itemGraficaId])
  @@index([pedidoId])
  @@index([varianteId])
  @@map("movimentacoes_estoque")
}

enum StatusOrcamento {
  RASCUNHO
  ENVIADO
  APROVADO
  REJEITADO
}

model Orcamento {
  id               String          @id @default(cuid())
  graficaId        String
  clienteId        String
  usuarioId        String
  status           StatusOrcamento @default(RASCUNHO)
  total            Decimal         @default(0) @db.Decimal(12, 2)
  linkPublicoToken String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  itens   OrcamentoItem[]
  pedido  Pedido?
  notaFiscal NotaFiscal?

  pagamentos Pagamento[]

  @@index([graficaId])
  @@map("orcamentos")
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO
  BOLETO
  TRANSFERENCIA
  OUTRO
}

// Registro de pagamento (entrada, parcela, quitação) de um orçamento aprovado. Saldo
// devedor é sempre calculado (total - soma dos pagamentos), nunca armazenado — evita
// dessincronia. Só criado com o orçamento em APROVADO (ver registrarPagamento).
model Pagamento {
  id          String         @id @default(cuid())
  orcamentoId String
  valor       Decimal        @db.Decimal(12, 2)
  forma       FormaPagamento
  observacao  String?
  createdAt   DateTime       @default(now())

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@index([orcamentoId])
  @@map("pagamentos")
}

enum StatusDespesa {
  PENDENTE
  PAGA
}

// Contraparte de Pagamento: dinheiro SAINDO da gráfica (fornecedor, aluguel,
// conta fixa), não entrando. Sem modelo de Fornecedor relacional de propósito
// (decisão já tomada antes) — descricao/categoria são texto livre.
//
// status/pagoEm nunca são editados por um form genérico de edição — só pelas
// actions marcarComoPaga/marcarComoPendente (ver src/app/financeiro/actions.ts),
// pra nunca existir uma combinação inconsistente tipo "paga sem data de pagamento".
//
// vencimento é a PRIMEIRA data-pura (sem hora) do schema inteiro — guardada
// sempre como meia-noite UTC (`${valor}T00:00:00Z`) e SEMPRE exibida com
// `timeZone: "UTC"` no formatador (src/lib/data.ts), pra não variar um dia
// conforme o fuso de quem tá vendo. Todo campo de data-pura futuro deve
// seguir o mesmo padrão.
model Despesa {
  id             String          @id @default(cuid())
  graficaId      String
  descricao      String
  categoria      String?
  valor          Decimal         @db.Decimal(12, 2)
  vencimento     DateTime
  status         StatusDespesa   @default(PENDENTE)
  formaPagamento FormaPagamento?
  pagoEm         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Recorrência: recorrente=true marca que essa ocorrência faz parte de uma
  // série mensal. serieRecorrenciaId agrupa as ocorrências da mesma série
  // (a primeira ocorrência recebe o próprio id como serieRecorrenciaId — ver
  // criarDespesa). Só a ocorrência de VENCIMENTO MAIS RECENTE de uma série é
  // consultada pra decidir se gera a próxima (ver src/lib/despesa-recorrente.ts)
  // — então desmarcar "recorrente" só nessa ocorrência mais recente já
  // encerra a série, sem precisar tocar nas anteriores.
  recorrente         Boolean @default(false)
  serieRecorrenciaId String?

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@index([graficaId])
  @@index([graficaId, status, vencimento])
  @@index([graficaId, serieRecorrenciaId])
  @@map("despesas")
}

// Trilha de auditoria financeira: quem alterou o quê. usuarioNome é um
// snapshot (não FK em Usuario) de propósito — o log tem que continuar legível
// mesmo que o usuário seja removido da gráfica no futuro. entidadeId também
// não é FK (mesmo motivo: excluirDespesa é hard delete, o log tem que
// sobreviver ao registro que ele descreve).
model LogAuditoria {
  id          String   @id @default(cuid())
  graficaId   String
  usuarioId   String
  usuarioNome String
  acao        String
  entidade    String
  entidadeId  String
  descricao   String
  createdAt   DateTime @default(now())

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@index([graficaId, createdAt])
  @@map("logs_auditoria")
}

model OrcamentoItem {
  id            String   @id @default(cuid())
  orcamentoId   String
  itemGraficaId String
  quantidade    Int
  larguraCm     Decimal? @db.Decimal(8, 2)
  alturaCm      Decimal? @db.Decimal(8, 2)
  cores         String? // ex: "4x0", "4x4" — snapshot legível, sempre preenchido
  acabamento    String? // texto livre, modo SIMPLES apenas

  precoUnitario Decimal @db.Decimal(12, 2)
  precoTotal    Decimal @db.Decimal(12, 2)

  // Motor avançado (M2/OFFSET): snapshot do modelo usado + árvore de custo auditável
  // (spec §0d). Fica null pra itens SIMPLES — nada muda no caminho existente.
  modeloCalculo ModeloCalculo @default(SIMPLES)
  corFrente     Int?
  corVerso      Int?
  breakdown     Json?

  orcamento   Orcamento   @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id])

  acabamentos OrcamentoItemAcabamento[]

  @@index([orcamentoId])
  @@map("orcamento_itens")
}

// Acabamentos estruturados aplicados a um item de orçamento no motor avançado
// (substitui o texto livre "acabamento" quando modeloCalculo != SIMPLES).
model OrcamentoItemAcabamento {
  id              String  @id @default(cuid())
  orcamentoItemId String
  itemGraficaId   String // o SERVICO usado como acabamento
  qtdBase         Decimal @db.Decimal(12, 4) // snapshot da base de cobrança usada
  custoCalculado  Decimal @db.Decimal(12, 4)

  orcamentoItem OrcamentoItem @relation(fields: [orcamentoItemId], references: [id], onDelete: Cascade)
  itemGrafica   ItemGrafica   @relation(fields: [itemGraficaId], references: [id])

  @@index([orcamentoItemId])
  @@map("orcamento_item_acabamentos")
}

enum StatusPedido {
  FILA
  IMPRESSAO
  ACABAMENTO
  PRONTO
  ENTREGUE
}

// Pedido nasce quando um Orcamento é aprovado: acompanha a produção física.
model Pedido {
  id          String       @id @default(cuid())
  graficaId   String
  orcamentoId String       @unique
  status      StatusPedido @default(FILA)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Data pura (meia-noite UTC, mesmo padrão de Despesa.vencimento — ver
  // src/lib/data.ts), definida na aprovação do orçamento. Opcional: nem todo
  // pedido tem prazo prometido, e sem prazo nunca gera alerta de atraso.
  prazoEntrega DateTime?
  // Dedup do evento pedido_atrasado (webhook-automacao.ts): uma vez enviado
  // o alerta pra este pedido, nunca reenviar — evita spam a cada
  // carregamento de /producao enquanto o pedido continua atrasado.
  alertaAtrasoEnviadoEm DateTime?

  grafica   Grafica   @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id])

  movimentacoes MovimentacaoEstoque[]

  @@index([graficaId])
  @@map("pedidos")
}
