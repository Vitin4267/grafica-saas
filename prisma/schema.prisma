// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Unidade de ENTRADA/EXIBIÇÃO de medida de item de orçamento — ver
// Grafica.unidadePadraoDimensao e src/lib/unidade-dimensao.ts. O banco
// sempre grava em centímetros (OrcamentoItem.larguraCm/alturaCm), então
// isto nunca é a unidade armazenada, só a unidade que a gráfica prefere
// digitar/ver.
enum UnidadeDimensao {
  MM
  CM
  M
}

// Cada gráfica é um tenant: todo dado abaixo pertence a uma Grafica
// e nunca deve vazar entre tenants nas queries da aplicação.
model Grafica {
  id        String   @id @default(cuid())
  nome      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Liga/desliga o compartilhamento da aba "Meu Negócio" com a equipe (não-DONO).
  // Controle fino de quem exatamente vê fica em Usuario.acessoMeuNegocio — os dois
  // precisam ser verdadeiros pra um funcionário enxergar a aba (ver podeVerMeuNegocio).
  compartilharMeuNegocio Boolean @default(false)

  // Logo da PRÓPRIA gráfica (não confundir com a marca do grafica-saas) —
  // usada no cabeçalho do PDF de orçamento (src/lib/pdf/OrcamentoDocumento.tsx)
  // no lugar da marca da plataforma. Opcional: sem logo, o PDF mostra só o
  // nome da gráfica em texto, nunca a marca "GrafPro".
  logoUrl String?

  // Cor de destaque usada no PDF de orçamento e nos e-mails transacionais
  // que vão pro CLIENTE FINAL da gráfica (aprovação de orçamento, arte,
  // etc.) — documentos com a cara da gráfica, não do GrafPro. Formato hex
  // ("#RRGGBB"), validado na action. null = mantém o teal padrão da
  // plataforma (comportamento de hoje, sem mudança pra quem nunca configurar).
  corPrimaria String?

  // Unidade padrão pra ENTRADA e EXIBIÇÃO de medidas de item de orçamento
  // (largura/altura) — não afeta como o dado é gravado: OrcamentoItem.
  // larguraCm/alturaCm continuam SEMPRE em centímetros, a unidade canônica
  // do motor de cálculo (ver src/lib/unidade-dimensao.ts). Default CM
  // preserva o comportamento de toda gráfica existente. Mais tarde um item
  // específico de orçamento poderá sobrescrever isso pontualmente — trocar
  // este padrão aqui nunca reconverte/altera orçamentos já salvos.
  unidadePadraoDimensao UnidadeDimensao @default(CM)

  usuarios              Usuario[]
  clientes              Cliente[]
  itensGrafica          ItemGrafica[]
  itensCatalogoPrivados ItemCatalogo[]
  orcamentos            Orcamento[]
  pedidos               Pedido[]
  parametros            ParametrosGrafica?
  prensas               Prensa[]
  maquinasFlexografia   MaquinaFlexografia[]
  dadosFiscais          DadosFiscaisGrafica?
  notasFiscais          NotaFiscal[]
  automacao             AutomacaoGrafica?
  despesas              Despesa[]
  logsAuditoria         LogAuditoria[]
  assinatura            AssinaturaGrafica?
  comissoes             Comissao[]
  filiais               Filial[]
  arquivos              ArquivoArmazenado[]
  categoriasCusto       CategoriaCusto[]
  custosPedido          CustoPedido[]
  custosPrevisto        PedidoCustoPrevisto[]
  fornecedores          Fornecedor[]
  contasPrepagas        ContaPrepaga[]
  contasReceber         ContaReceber[]
  importacoesPlanilha   ImportacaoPlanilha[]
  solicitacoesCompra    SolicitacaoCompra[]

  @@map("graficas")
}

// Parâmetros globais do motor de precificação avançado (M2/OFFSET), um por tenant.
// Os campos de custo de máquina (torres, custoHoraMaq etc.) viraram o modelo Prensa
// — um tenant pode ter várias prensas offset com custos/rendimentos diferentes.
model ParametrosGrafica {
  id        String @id @default(cuid())
  graficaId String @unique

  // Composição final do preço (spec §0 e §4)
  overheadPercent          Decimal @default(0.15) @db.Decimal(5, 4)
  margemPadrao             Decimal @default(0.20) @db.Decimal(5, 4)
  impostoPercent           Decimal @default(0.06) @db.Decimal(5, 4)
  comissaoPercent          Decimal @default(0) @db.Decimal(5, 4)
  taxaFinanceiraPercent    Decimal @default(0) @db.Decimal(5, 4)
  pedidoMinimo             Decimal @default(0) @db.Decimal(12, 2)
  incrementoArredondamento Decimal @default(0.10) @db.Decimal(6, 2)

  // Defaults de nesting em bobina (spec §1: s, g)
  margemSegurancaPadrao Decimal @default(0.02) @db.Decimal(5, 4)
  gapPecasPadrao        Decimal @default(0.008) @db.Decimal(5, 4)

  // Referência pro Cálculo de tinta com IA (ver OrcamentoItemTinta) — NUNCA
  // entra na composição de preço acima, é só multiplicado pelo ml estimado
  // na hora de EXIBIR o card, puramente informativo. Nulo = ainda não
  // configurado, o card não mostra linha de custo nenhuma nesse caso.
  custoTintaPorMl Decimal? @db.Decimal(10, 4)

  // Política de cálculo da comissão PAGA a vendedores (ver model Comissao)
  // — NÃO CONFUNDIR com `comissaoPercent` acima, que é markup de
  // precificação embutido no preço de venda (src/lib/pricing/compor.ts),
  // nunca pago a ninguém. Esta aqui decide se o valor-base da comissão de
  // cada vendedor é o total do orçamento ou o lucro (total - custo).
  comissaoVendedorBase BaseComissao @default(VALOR)

  // Flags da fase "custo real" (fase-custo-real.md §1.5) — tudo que varia
  // entre gráficas nasce aqui, nunca hardcoded.
  custoAutomaticoConsumo        Boolean @default(true) // gerar CustoPedido automático na baixa Fila→Impressão
  categoriaCustoConsumoPadraoId String? // categoria pra matéria-prima sem categoriaCustoId própria
  comissaoEntraNoCustoPedido    Boolean @default(false)
  perdaEhCustoDoPedido          Boolean @default(true)
  margemFaixaBaixa              Decimal @default(10) @db.Decimal(5, 2) // % — abaixo disso o medidor mostra vermelho
  margemFaixaBoa                Decimal @default(25) @db.Decimal(5, 2) // % — acima disso o medidor mostra verde
  descontoMaxSemAprovacao       Decimal @default(100) @db.Decimal(5, 2) // % — 100 = sem trava (comportamento de hoje)
  diasPrecoInsumoDesatualizado  Int     @default(90)
  // Quantos dias um orçamento fica válido depois de virar ENVIADO (ver
  // Orcamento.validoAteEm e orcamentoEstaExpirado em
  // src/lib/orcamento-status.ts). Nullable + default(15) de propósito: o
  // form sempre manda um inteiro, mas o nullable deixa espaço pra uma
  // futura opção de "sem expiração" sem precisar de sentinela mágico.
  diasValidadeOrcamentoPadrao   Int?    @default(15)

  // Limiares do alerta de prazo por e-mail (ver src/lib/alerta-prazo-email.ts)
  // — antes fixos em 5/3/0 dias no código. Uma gráfica com ciclo de produção
  // de 1 dia acha 5 dias antes ruído inútil; uma com produção longa
  // (offset+laminação+hot stamping) quer aviso mais cedo. Ordem decrescente
  // sempre (limiar1 > limiar2 > limiar3) — validado na action, não aqui.
  alertaPrazoAtivo       Boolean @default(true)
  alertaPrazoLimiar1Dias Int     @default(5)
  alertaPrazoLimiar2Dias Int     @default(3)
  alertaPrazoLimiar3Dias Int     @default(0)

  // Bloco de termos e condições impresso no rodapé do PDF de orçamento
  // (src/lib/pdf/OrcamentoDocumento.tsx), usado tanto em /orcamento/[id]/pdf
  // quanto no link público /o/[token]/pdf. Null = gráfica nunca configurou
  // — o PDF cai no texto padrão do sistema (ver TERMOS_CONDICOES_PDF_PADRAO
  // em src/lib/pdf/termos-padrao.ts), nunca fica em branco por padrão
  // (exposição jurídica se um pedido for contestado). "" também vira null na
  // action (ver salvarParametros), pra "limpar o campo" sempre significar
  // "voltar pro padrão do sistema", nunca "sem cláusula nenhuma".
  termosCondicoesPdf String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@map("parametros_grafica")
}

enum BaseComissao {
  VALOR // % sobre o total do orçamento aprovado
  LUCRO // % sobre valor - custo estimado dos itens
}

// Uma prensa offset física do tenant. Produtos com modeloCalculo=OFFSET escolhem
// uma prensa específica em ItemGrafica.prensaId — cada prensa tem seu próprio
// custo de hora-máquina, chapas, torres etc. (ver spec §2, antes vivia em
// ParametrosGrafica como uma "prensa virtual" única por gráfica).
model Prensa {
  id        String  @id @default(cuid())
  graficaId String
  nome      String
  ativa     Boolean @default(true)

  custoHoraMaq       Decimal @default(0) @db.Decimal(12, 4)
  torres             Int     @default(4)
  custoChapa         Decimal @default(0) @db.Decimal(12, 4)
  folhasAcerto       Int     @default(150)
  tempoAcertoH       Decimal @default(0.5) @db.Decimal(6, 4)
  custoMilheiroRod   Decimal @default(0) @db.Decimal(12, 4)
  rodagemMinima      Decimal @default(0) @db.Decimal(12, 4)
  perdaPercentPadrao Decimal @default(0.03) @db.Decimal(5, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica  Grafica       @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  produtos ItemGrafica[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("prensas")
}

// Uma máquina flexográfica física do tenant. Produtos com modeloCalculo=FLEXOGRAFIA
// escolhem uma máquina específica em ItemGrafica.maquinaFlexografiaId — mesma
// filosofia da Prensa (custo de hora-máquina, setup e rodagem por máquina, não por
// gráfica). Tabela separada de Prensa (não polimórfica) de propósito: o projeto já
// trata SIMPLES/M2/OFFSET como caminhos paralelos não-unificados, e unificar Prensa
// numa estrutura polimórfica arriscaria migrar dado real de produção do Offset à
// toa. Nesting de material é 1D (largura da bobina, reaproveitando BobinaMaterial
// tal como já existe pro M2), não 2D como o Offset — a bobina define a largura útil,
// o cilindro define o comprimento fixo consumido por volta (passoCilindroM).
model MaquinaFlexografia {
  id        String  @id @default(cuid())
  graficaId String
  nome      String
  ativa     Boolean @default(true)

  // Teto físico de largura útil de impressão da máquina — usado como limite superior
  // no nesting (min contra a largura útil da bobina escolhida no produto), não como
  // a largura em si (essa vem da BobinaMaterial, igual M2).
  larguraMaquinaM     Decimal @default(0) @db.Decimal(6, 3)
  // Repeat do cilindro instalado — comprimento fixo consumido a cada volta,
  // independente do tamanho da peça (v1 assume 1 repeat por volta, ver
  // calcularFlexografia).
  passoCilindroM      Decimal @default(0) @db.Decimal(6, 3)
  // Nº de estações/cores da máquina — teto de cores por passagem, mesmo papel de
  // Prensa.torres.
  numeroEstacoesCores Int     @default(6)
  custoHoraMaq        Decimal @default(0) @db.Decimal(12, 4)
  tempoAcertoH        Decimal @default(1) @db.Decimal(6, 4)
  // Metros lineares de bobina perdidos no acerto/registro por entrada — equivalente
  // contínuo de Prensa.folhasAcerto (que é um nº de folhas, não de metros).
  metrosAcerto        Decimal @default(0) @db.Decimal(6, 3)
  custoMetroLinearRod Decimal @default(0) @db.Decimal(12, 4)
  rodagemMinima       Decimal @default(0) @db.Decimal(12, 4)
  perdaPercentPadrao  Decimal @default(0.03) @db.Decimal(5, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica  Grafica       @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  produtos ItemGrafica[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("maquinas_flexografia")
}

// Uma filial/unidade física da gráfica. COMPARTILHA catálogo, estoque e
// financeiro com a gráfica inteira (não é um tenant separado) — serve só
// pra marcar em qual orçamento foi feito, pra fins de relatório (ver
// Orcamento.filialId). endereco é texto livre de propósito, sem CEP
// estruturado — é só referência, não alimenta nenhum cálculo.
model Filial {
  id        String  @id @default(cuid())
  graficaId String
  nome      String
  endereco  String?
  ativa     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica      Grafica             @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamentos   Orcamento[]
  dadosFiscais DadosFiscaisFilial?

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("filiais")
}

// Dados fiscais da gráfica pra emitir nota fiscal via Focus NFe — 100% opt-in,
// nunca pedido em /comecar ou /login, só configurado quando a gráfica realmente
// for usar a função (ver NotaFiscalCard em /orcamento/[id]). Cada gráfica traz
// sua PRÓPRIA conta na Focus NFe (não uma conta compartilhada do grafica-saas):
// o token abaixo é o dela, e o site nunca armazena/manuseia certificado digital
// — isso fica inteiramente do lado da Focus NFe.
//
// A API da Focus NFe exige os dados do emitente (CNPJ, razão social, endereço)
// em TODA chamada de emissão — não fica pré-configurado na conta deles, por
// isso precisamos guardar aqui também (confirmado no exemplo oficial da API).
model DadosFiscaisGrafica {
  id        String @id @default(cuid())
  graficaId String @unique

  focusNfeToken String? // token da CONTA DELES na Focus NFe — nunca uma conta nossa
  ambiente      String  @default("homologacao") // homologacao | producao — nasce em homologação por segurança

  cnpj              String?
  razaoSocial       String?
  nomeFantasia      String?
  inscricaoEstadual String?
  regimeTributario  String? // informativo (ex: "Simples Nacional") — orienta o CSOSN padrão

  enderecoCep        String?
  enderecoLogradouro String?
  enderecoNumero     String?
  enderecoBairro     String?
  enderecoMunicipio  String?
  enderecoUf         String?

  naturezaOperacaoPadrao String @default("Venda de mercadoria")
  cfopPadrao             String @default("5102") // venda dentro do estado, mercadoria de terceiros
  csosnPadrao            String @default("102") // Simples Nacional, tributada sem permissão de crédito

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@map("dados_fiscais_grafica")
}

// Cadastro fiscal completo e independente de uma FILIAL com CNPJ próprio —
// espelha DadosFiscaisGrafica campo a campo de propósito (cada CNPJ é um
// contribuinte separado perante a Focus NFe/SEFAZ, precisa do próprio
// token/cadastro lá, não dá pra "herdar" o da matriz). Opcional: uma filial
// sem linha aqui continua emitindo com os dados da gráfica (comportamento de
// sempre, sem mudança) — ver resolverDadosFiscais em src/lib/nota-fiscal.ts,
// único ponto que decide qual dos dois usar. Modelo separado (não um
// filialId nullable dentro de DadosFiscaisGrafica) de propósito: evita
// problema de unicidade parcial (Postgres trata NULL como sempre distinto em
// @@unique, então não daria pra garantir "no máximo 1 linha-padrão da
// gráfica" só com filialId opcional na mesma tabela) e mantém o caminho
// gráfica-level 100% intocado — decisão de 2026-08-16, pedido de negócio
// ainda sem caso real (nenhuma gráfica cliente tem filial com CNPJ próprio
// hoje), construído preventivamente.
model DadosFiscaisFilial {
  id       String @id @default(cuid())
  filialId String @unique

  focusNfeToken String?
  ambiente      String  @default("homologacao")

  cnpj              String?
  razaoSocial       String?
  nomeFantasia      String?
  inscricaoEstadual String?
  regimeTributario  String?

  enderecoCep        String?
  enderecoLogradouro String?
  enderecoNumero     String?
  enderecoBairro     String?
  enderecoMunicipio  String?
  enderecoUf         String?

  naturezaOperacaoPadrao String @default("Venda de mercadoria")
  cfopPadrao             String @default("5102")
  csosnPadrao            String @default("102")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  filial Filial @relation(fields: [filialId], references: [id], onDelete: Cascade)

  @@map("dados_fiscais_filial")
}

enum StatusNotaFiscal {
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
  ERRO
}

// Uma nota fiscal emitida (ou em processamento) pra um orçamento aprovado.
// 1:1 com Orcamento — mesmo padrão de Pedido. `referencia` é a chave que
// mandamos pra Focus NFe pra identificar essa emissão (idempotência do lado
// deles); `chaveAcesso` só existe depois de AUTORIZADA.
model NotaFiscal {
  id           String           @id @default(cuid())
  graficaId    String
  orcamentoId  String           @unique
  referencia   String           @unique
  status       StatusNotaFiscal @default(PROCESSANDO)
  numero       String?
  serie        String?
  chaveAcesso  String?
  xmlUrl       String?
  danfeUrl     String?
  mensagemErro String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  grafica   Grafica   @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id])

  @@index([graficaId])
  @@map("notas_fiscais")
}

// Webhook n8n (ou qualquer outro) que a PRÓPRIA gráfica configura pra
// receber eventos do hub de automação (pedido_status_mudou, estoque_critico,
// pedido_atrasado — ver src/lib/webhook-automacao.ts), mesmo padrão "bring
// your own account" de DadosFiscaisGrafica. Diferente do assistente de IA
// (ASSISTENTE_WEBHOOK_URL, env var única da plataforma) — automação é
// legitimamente por tenant, cada gráfica quer notificação só dos próprios
// pedidos.
model AutomacaoGrafica {
  id        String @id @default(cuid())
  graficaId String @unique

  // URL do workflow n8n do PRÓPRIO tenant — o path costuma carregar um UUID
  // que funciona como token de capability (padrão de webhook do n8n), por
  // isso é tratada como segredo (nunca reexibida por completo, ver
  // /configuracoes/automacao).
  webhookUrl String?

  // Liga/desliga cada tipo de evento individualmente — antes dos três
  // disparavam sempre juntos assim que webhookUrl estava configurado. Uma
  // gráfica que não controla estoque no sistema não quer estoque_critico
  // poluindo o workflow; outra quer só pedido_atrasado. Default true em
  // todos preserva o comportamento de hoje pra quem já tem webhook configurado.
  notificarStatusMudou    Boolean @default(true)
  notificarEstoqueCritico Boolean @default(true)
  notificarPedidoAtrasado Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@map("automacao_grafica")
}

enum StatusAssinatura {
  TRIALING
  ATIVA
  INADIMPLENTE // past_due no Stripe: pagamento falhou mas a assinatura ainda não cancelou
  CANCELADA
}

// Cobrança da PLATAFORMA sobre a gráfica (assinatura do SaaS) — diferente do
// padrão "bring your own account" usado por DadosFiscaisGrafica (onde a
// credencial é da própria gráfica): aqui a conta Stripe é NOSSA, do
// dono do grafica-saas. Guarda só o status derivado + IDs de referência — o
// Stripe é a fonte de verdade do dinheiro, isto aqui é um cache local pro
// gate de acesso (src/lib/auth/assinatura.ts) não precisar chamar a API do
// Stripe em toda página. A única escrita em `status` depois da criação vem
// do webhook (src/app/api/webhooks/stripe/route.ts), nunca de uma Server
// Action comum.
model AssinaturaGrafica {
  id        String @id @default(cuid())
  graficaId String @unique

  status StatusAssinatura @default(TRIALING)

  // true = acesso concedido via /admin/graficas (super admin), não uma
  // assinatura Stripe real. status continua "ATIVA" (mesmo campo que já
  // libera acesso, ver assinaturaEstaLiberada) — este campo só diferencia
  // "grátis de propósito" de "pagante de verdade" em relatórios/UI, nunca
  // influencia o gate de acesso em si.
  cortesia Boolean @default(false)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  trialExpiraEm        DateTime?
  periodoAtualExpiraEm DateTime? // current_period_end do Stripe, pra exibir "próxima cobrança em"
  canceladaEm          DateTime?

  // Início da janela de 15 dias de tolerância depois de ultrapassar o teto
  // de uso do plano (orçamentos/mês ou usuários) — null = dentro do limite
  // hoje. Ver src/lib/billing/limite-uso.ts.
  limiteExcedidoDesde DateTime?

  // Início da janela de carência de INADIMPLENTE (2 meses, ver
  // DIAS_CARENCIA_INADIMPLENCIA em src/lib/billing/status.ts) — decisão de
  // produto de 2026-08-15: bloquear acesso na primeira falha de cobrança do
  // Stripe é agressivo demais (cartão vencido por um dia, banco recusando
  // por engano). Setado por sincronizarSubscription quando o status
  // TRANSICIONA pra INADIMPLENTE (nunca resetado por resyncs subsequentes
  // enquanto continuar INADIMPLENTE); voltado a null assim que sai desse
  // status (ATIVA ou CANCELADA). null = nunca entrou em INADIMPLENTE, ou já
  // saiu.
  inadimplenteDesde DateTime?

  // Quando o e-mail de "seu trial está quase acabando" foi disparado (ver
  // src/app/api/cron/lifecycle/route.ts, cron diário) — idempotência pra
  // não mandar o aviso duas vezes. null = ainda não enviado. Fica null pra
  // sempre em gráficas que nunca chegam a 2 dias do fim do trial (ex:
  // assinam antes) ou que não estão em TRIALING.
  avisoTrialEnviadoEm DateTime?

  // Reserva atômica contra checkout duplicado: iniciarCheckout só cria uma
  // Stripe Checkout Session se conseguir gravar este timestamp via updateMany
  // condicionado (nenhuma reserva viva no momento) — duas requisições
  // concorrentes (duas abas, duplo clique) nunca passam as duas, porque a
  // segunda vê o timestamp que a primeira acabou de gravar e falha a
  // condição. null = sem checkout em andamento. Ver src/app/configuracoes/assinatura/actions.ts.
  checkoutIniciadoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@map("assinatura_grafica")
}

// Registro de cada pergunta enviada ao assistente — existe só pra rate limiting
// (mesmo padrão de TentativaLogin: conta linhas numa janela de tempo). NÃO
// guarda o texto da pergunta: não precisa pra esse propósito, e menos dado
// guardado é menos dado pra vazar. Protege contra spam/gasto de token do n8n
// da própria gráfica, tanto de um usuário sozinho quanto da gráfica toda.
model PerguntaAssistenteLog {
  id        String   @id @default(cuid())
  graficaId String
  usuarioId String
  createdAt DateTime @default(now())

  @@index([usuarioId, createdAt])
  @@index([graficaId, createdAt])
  @@map("pergunta_assistente_log")
}

enum PapelUsuario {
  DONO
  ADMIN
  OPERADOR
}

model Usuario {
  id        String       @id @default(cuid())
  graficaId String
  nome      String
  email     String       @unique
  senhaHash String
  papel     PapelUsuario @default(OPERADOR)
  createdAt DateTime     @default(now())

  // Concedido individualmente pelo DONO em /usuarios. Só tem efeito se
  // Grafica.compartilharMeuNegocio também estiver ligado — ver podeVerMeuNegocio.
  // Irrelevante pra DONO, que sempre tem acesso.
  acessoMeuNegocio Boolean @default(false)

  // null = ainda não confirmou o código de 6 dígitos enviado no cadastro
  // (ver exigirEmailVerificado). Só se aplica a quem se cadastra sozinho
  // via /registro — usuário convidado em /usuarios já nasce com isso
  // preenchido (confiança transitiva: quem convida já provou a própria
  // identidade). Contas anteriores a esta feature foram "perdoadas" na
  // migração (emailVerificadoEm = createdAt).
  emailVerificadoEm DateTime?

  // Acesso cross-tenant a /admin/graficas (conceder/revogar cortesia) — não
  // tem relação com `papel` (DONO/ADMIN/OPERADOR), que é sempre escopado à
  // própria gráfica. Só true pro dono da plataforma. Nunca exposto/editável
  // por nenhuma tela — só setado direto no banco (bootstrap único).
  superAdmin Boolean @default(false)

  // null = este usuário não recebe comissão (não é vendedor). Taxa pessoal,
  // independente do papel — DONO/ADMIN/OPERADOR podem todos vender. Ver
  // model Comissao e ParametrosGrafica.comissaoVendedorBase.
  comissaoPercent Decimal? @db.Decimal(5, 4)

  // null = ativo. Preenchido = funcionário removido da gráfica: perde acesso
  // NA HORA (exigirUsuarioAutenticado recusa, e as sessões são apagadas junto
  // no momento da remoção), some das listas e para de receber e-mail de etapa.
  //
  // Desativa em vez de apagar de propósito: Orcamento.usuarioId,
  // Comissao.usuarioId e LogAuditoria.usuarioId apontam pra cá. Apagar o
  // cadastro ou faria a exclusão falhar, ou deixaria o histórico órfão — e o
  // log de auditoria ficaria cego justamente sobre quem saiu da empresa, que
  // é quando mais se precisa dele. Comissão pendente continua devida e
  // pagável depois da remoção.
  //
  // É data (não boolean) porque "quando saiu" é a pergunta que aparece junto
  // com "quem fez isso" numa investigação. Reversível: voltar pra null
  // reativa.
  desativadoEm DateTime?

  grafica                    Grafica                     @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamentos                 Orcamento[]
  sessoes                    Sessao[]
  permissoes                 PermissaoUsuario[]
  tokensResetSenha           TokenResetSenha[]
  tokensVerificacaoEmail     TokenVerificacaoEmail[]
  comissoes                  Comissao[]
  responsaveisEstagio        ResponsavelEstagio[]
  responsaveisAdministrativo ResponsavelAdministrativo[]
  solicitacoesCompraFeitas   SolicitacaoCompra[]         @relation("SolicitacoesCompraSolicitadas")
  solicitacoesCompraAprovadas SolicitacaoCompra[]        @relation("SolicitacoesCompraAprovadas")

  @@index([graficaId])
  @@map("usuarios")
}

// Só existe controle granular por módulo pra papel OPERADOR — DONO e ADMIN
// sempre têm acesso total, não passam por aqui (ver podeVerModulo/
// podeEditarModulo em src/lib/auth/permissoes.ts). Ausência de linha pra um
// módulo = sem acesso nenhum (nem ver), é o padrão mais seguro por omissão.
enum ModuloPermissao {
  ORCAMENTO
  CLIENTES
  CATALOGO
  PRODUCAO
  FINANCEIRO
  CONFIGURACOES
  // Lançar custo real de pedido (podeEditar) e ver lucro/margem (podeVer) —
  // separado de PRODUCAO de propósito: um operador de chão de fábrica pode
  // precisar lançar retrabalho sem enxergar o P&L do pedido (ver fase
  // "custo real", fase-custo-real.md §2.6).
  CUSTOS
  // Módulo de COMPRAS (SolicitacaoCompra) — separado de PRODUCAO/CATALOGO de
  // propósito: quem compra matéria-prima nem sempre é quem opera a produção
  // ou mexe no catálogo.
  COMPRAS
}

model PermissaoUsuario {
  id         String          @id @default(cuid())
  usuarioId  String
  modulo     ModuloPermissao
  podeVer    Boolean         @default(false)
  podeEditar Boolean         @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, modulo])
  @@map("permissoes_usuario")
}

// Sessão opaca: o cookie do usuário guarda só o token bruto, nunca persistido em texto puro aqui.
// Guardar apenas o hash do token faz um vazamento do banco não virar sessões utilizáveis,
// e apagar a linha revoga a sessão imediatamente (logout, troca de senha, etc).
model Sessao {
  id        String   @id @default(cuid())
  usuarioId String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  criadaEm  DateTime @default(now())
  expiraEm  DateTime

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sessoes")
}

// Mesma filosofia de Sessao: guarda só o HASH do token de reset, nunca o
// valor bruto — vazamento do banco não vira link de redefinição de senha
// utilizável. usadoEm torna o token de uso único mesmo dentro da janela
// de validade (1h, ver src/lib/auth/token-reset.ts).
model TokenResetSenha {
  id        String    @id @default(cuid())
  usuarioId String
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_reset_senha")
}

// Mesma filosofia de TokenResetSenha: guarda só o HASH do código (nunca o
// valor bruto de 6 dígitos), usadoEm torna de uso único. tentativas conta
// palpites errados NESTE código especificamente — ao chegar no limite
// (ver LIMITE_TENTATIVAS em src/lib/auth/verificacao-email.ts), o código
// vira inválido mesmo dentro da janela de expiração, forçando reenvio.
// Proteção extra necessária porque 6 dígitos é um espaço bem menor (1 em
// 1.000.000) que o token de 256 bits do reset de senha.
model TokenVerificacaoEmail {
  id         String    @id @default(cuid())
  usuarioId  String
  codigoHash String
  expiraEm   DateTime
  usadoEm    DateTime?
  tentativas Int       @default(0)
  createdAt  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_verificacao_email")
}

// Registro de tentativas de login (sucesso e falha) para permitir bloqueio temporário
// por e-mail e por IP contra ataques de força bruta, sobrevivendo a reinícios do servidor.
model TentativaLogin {
  id        String   @id @default(cuid())
  email     String
  ip        String
  sucesso   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("tentativas_login")
}

// Conta tentativas de cadastro (/registro) por IP — sem isso, um bot pode criar
// gráficas/usuários sem limite (spam de dados + custo de CPU do hash argon2id
// a cada tentativa, já que ele só é evitado quando o e-mail já existe).
model TentativaRegistro {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@map("tentativas_registro")
}

// Conta tentativas de pedido de reset de senha, por e-mail E por IP —
// evita spam de e-mail pro mesmo destinatário e limita um atacante
// disparando pedidos pra vários e-mails (mesmo padrão de TentativaLogin).
model TentativaResetSenha {
  id        String   @id @default(cuid())
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("tentativas_reset_senha")
}

// Mesmo padrão de TentativaResetSenha, por pedidoId em vez de e-mail —
// responderArtePublica (src/app/a/[token]/actions.ts) é uma Server Action
// sem autenticação (o token É a credencial), e o branch de "pedir alteração"
// não é idempotente por natureza (diferente de "aprovar", que trava sozinho
// em arteAprovadaEm): cada chamada dispara um e-mail novo pro(s) DONO(s) da
// gráfica. Sem este limite, quem tiver o link (ele circula por WhatsApp,
// fica no histórico do cliente) podia martelar a action e encher a caixa de
// entrada do dono — ou, na escala errada, estourar a cota diária de envio do
// Gmail/Workspace do EMAIL_WEBHOOK_URL, que é compartilhado com reset de
// senha e verificação de e-mail de TODOS os tenants (achado da auditoria de
// 2026-07-26). Limita por pedidoId (o alvo real do abuso, não muda trocando
// de IP) e por IP (limita quem tenta abusar de vários pedidos).
model TentativaRespostaArte {
  id        String   @id @default(cuid())
  pedidoId  String
  ip        String
  createdAt DateTime @default(now())

  @@index([pedidoId, createdAt])
  @@index([ip, createdAt])
  @@map("tentativas_resposta_arte")
}

// Mesmo padrão de TentativaResetSenha, só que por usuarioId em vez de
// email (usuário já está autenticado nesse ponto do fluxo, não precisa
// aceitar e-mail cru) — limita quantos códigos NOVOS podem ser pedidos,
// não quantos palpites (isso é TokenVerificacaoEmail.tentativas). As duas
// defesas juntas: no máximo LIMITE_VERIFICACAO_EMAIL_POR_USUARIO códigos
// por janela, cada um valendo só 5 palpites.
model TentativaVerificacaoEmail {
  id        String   @id @default(cuid())
  usuarioId String
  ip        String
  createdAt DateTime @default(now())

  @@index([usuarioId, createdAt])
  @@index([ip, createdAt])
  @@map("tentativas_verificacao_email")
}

model Cliente {
  id        String   @id @default(cuid())
  graficaId String
  nome      String
  email     String?
  telefone  String?
  documento String? // CPF ou CNPJ
  createdAt DateTime @default(now())

  // Endereço — opcional pra cadastro comum, mas exigido pra emitir nota fiscal
  // (ver DadosFiscaisGrafica / NotaFiscal). enderecoCodigoIbge é nullable e não
  // bloqueia emissão: o exemplo oficial da Focus NFe envia só município+UF.
  enderecoCep         String?
  enderecoLogradouro  String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoMunicipio   String?
  enderecoCodigoIbge  String?
  enderecoUf          String?

  grafica    Grafica     @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamentos Orcamento[]

  // NULL não colide com NULL em unique index do Postgres — várias gráficas
  // podem ter clientes sem documento cadastrado sem problema. Escopado por
  // graficaId (não global) porque CPF/CNPJ é único no mundo real, mas nada
  // impede duas gráficas diferentes atenderem o mesmo cliente.
  @@unique([graficaId, documento])
  @@index([graficaId])
  @@map("clientes")
}

enum UnidadeMedida {
  FOLHA
  METRO_QUADRADO
  METRO_LINEAR
  UNIDADE
  LITRO
  KG
  ROLO
  PACOTE
  CENTO
  MILHEIRO
  HORA
  // Sem fator de conversão nenhum (diferente de UnidadeDimensao) — é só
  // rótulo. Lista fechada sem esta opção forçava gráfica que mede insumo em
  // resma/galão/fardo/tonelada a "forçar" pra unidade ou pacote, perdendo
  // precisão no relatório de estoque. ItemCatalogo.unidadeOutro guarda o
  // texto quando esta opção é escolhida.
  OUTRO
}

enum TipoItemCatalogo {
  PRODUTO
  MATERIA_PRIMA
  SERVICO
}

// Modelo de cálculo de um PRODUTO: SIMPLES é o preço direto (precoVenda × área/quantidade,
// como sempre funcionou); M2, OFFSET e FLEXOGRAFIA acionam o motor avançado (src/lib/pricing)
// e exigem configuração extra (bobinas, formatos de folha, ou máquina flexo + clichê).
// Sempre opt-in por item, nunca default.
enum ModeloCalculo {
  SIMPLES
  M2
  OFFSET
  FLEXOGRAFIA
}

// Como um acabamento (SERVICO) é cobrado — spec §3. FOLHA_IMPRESSA é o caso mais sutil:
// cobra pela folha de máquina ANTES do refile (ex: BOPP), não pela peça final.
enum BaseCobranca {
  UNIDADE
  M2
  FOLHA_IMPRESSA
  METRO_LINEAR
  FIXO
  HORA
}

enum EstagioAcabamento {
  PRE_REFILE
  POS_REFILE
}

// Catálogo: base é mestre e compartilhada entre todas as gráficas (graficaId=null,
// só criada via seed). Cada gráfica pode complementar com itens próprios que faltem
// (graficaId preenchido, criados pelo botão "Adicionar" em /catalogo) — esses ficam
// privados: só a gráfica dona vê e pode selecionar (ver salvarCatalogo/página do
// catálogo, que sempre filtram por graficaId=null OU graficaId=tenant atual).
// Cada gráfica escolhe, em ItemGrafica, o que ela realmente oferece/usa e define
// seus próprios preços — o item de catálogo em si nunca muda por tenant.
model ItemCatalogo {
  id           String           @id @default(cuid())
  graficaId    String? // null = catálogo mestre; preenchido = item privado dessa gráfica
  tipo         TipoItemCatalogo
  categoria    String
  nome         String
  descricao    String?
  unidade      UnidadeMedida?
  unidadeOutro String? // só usado quando unidade = OUTRO
  ncm          String? // classificação fiscal (NF-e) — nullable, só exigido no momento de emitir nota
  createdAt    DateTime         @default(now())

  grafica      Grafica?      @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  itensGrafica ItemGrafica[]

  // Nota: como o Postgres trata NULL como distinto em índices únicos, esta
  // constraint não impede globais (graficaId=null) duplicados entre si — por
  // isso o seed faz a própria checagem de duplicidade em vez de contar só com
  // isto (ver prisma/seed.ts). Para itens privados (graficaId preenchido) a
  // constraint funciona normalmente.
  @@unique([graficaId, tipo, nome])
  @@index([tipo, categoria])
  @@index([graficaId])
  @@map("itens_catalogo")
}

// Seleção da gráfica dentro do catálogo mestre: liga a gráfica a um ItemCatalogo
// e guarda os preços que ELA define (compra = custo de aquisição/produção,
// venda = quanto cobra do cliente). ativo=false "desliga" o item sem apagar
// histórico (orçamentos e movimentações de estoque continuam íntegros).
model ItemGrafica {
  id                     String    @id @default(cuid())
  graficaId              String
  itemCatalogoId         String
  ativo                  Boolean   @default(true)
  precoCompra            Decimal?  @db.Decimal(12, 4)
  precoVenda             Decimal?  @db.Decimal(12, 2)
  estoqueAtual           Decimal?  @db.Decimal(12, 4)
  estoqueMinimo          Decimal?  @db.Decimal(12, 4)
  // Quantas unidades individuais tem em cada "unidade cadastrada" deste item
  // (ex: unidade=PACOTE, quantidadePorEmbalagem=500 → 1 pacote = 500
  // etiquetas). Puramente informativo: mostra a conversão ao lado do estoque
  // nas telas de catálogo, mas NÃO muda a unidade em que
  // entrada/saída/ajuste são lançados nem como ficha técnica/custo calculam
  // (estoqueAtual continua sendo "quantas unidades cadastradas", igual hoje).
  // null = sem conversão configurada (comportamento atual, sem mudança).
  quantidadePorEmbalagem Decimal?  @db.Decimal(12, 4)
  // Quanto desse material é perdido por CALIBRAGEM toda vez que uma produção
  // entra em impressão (FILA→IMPRESSAO) — fixo, não escala com a quantidade
  // do pedido (1 unidade ou 1000 = mesma perda). Diferente de
  // Prensa.perdaPercentPadrao, que é percentual e só entra na ESTIMATIVA DE
  // PREÇO do motor Offset (src/lib/pricing/offset.ts) — nunca mexe em
  // estoque real. null = sem perda de calibragem configurada (comportamento
  // de hoje: baixa só pela ficha técnica). Só relevante quando este
  // ItemGrafica é matéria-prima (itemCatalogo.tipo=MATERIA_PRIMA); é o
  // padrão sugerido na tela de confirmação de avancarPedido — editável por
  // pedido lá, sem alterar este valor.
  perdaFixaPadrao        Decimal?  @db.Decimal(12, 4)
  // Dedup do alerta de estoque baixo por e-mail (ver src/lib/alerta-estoque.ts)
  // — preenchido quando o e-mail/aviso é disparado, limpo de volta pra null
  // assim que o estoque volta a ficar acima do mínimo (self-healing: cai nunca
  // avisado → avisa; sobe → limpa; cai de novo → avisa de novo).
  alertaEstoqueEnviadoEm DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Motor avançado — só relevante quando tipo=PRODUTO no ItemCatalogo relacionado.
  modeloCalculo ModeloCalculo @default(SIMPLES)
  viraFolha     Boolean       @default(false) // work-and-turn; só usado quando modeloCalculo=OFFSET

  // Qual prensa física produz este item — só relevante/obrigatório (na aplicação)
  // quando modeloCalculo=OFFSET. onDelete=Restrict: não deixa excluir uma prensa
  // ainda em uso por algum produto.
  prensaId String?

  // Qual máquina flexo produz este item — só relevante/obrigatório (na aplicação)
  // quando modeloCalculo=FLEXOGRAFIA. Mesma regra de prensaId (onDelete=Restrict).
  maquinaFlexografiaId String?

  // Gramatura escolhida — só relevante quando modeloCalculo=OFFSET (produto) ou
  // quando este item é usado como papel de outro produto (matéria-prima). No
  // produto, alimenta tanto o peso físico real da folha quanto a busca (com
  // fallback) na TabelaPrecoPapel do papel selecionado — ver `papelId` abaixo
  // e src/lib/pricing/papel.ts.
  gramaturaGm2 Decimal? @db.Decimal(6, 1)

  // Qual matéria-prima (papel) este produto Offset usa — só relevante/obrigatório
  // (na aplicação) quando modeloCalculo=OFFSET. O preço por kg não fica mais
  // digitado no produto: é resolvido em runtime pela TabelaPrecoPapel do papel
  // referenciado aqui, usando gramaturaGm2 como chave (com fallback pra mais
  // próxima). onDelete=Restrict: não deixa excluir um papel ainda em uso.
  papelId String?

  // Só relevante quando tipo=PRODUTO e modeloCalculo=M2.
  custoImpressaoM2    Decimal? @db.Decimal(12, 4)
  areaMinimaFaturavel Decimal? @db.Decimal(8, 4)

  // Em qual CategoriaCusto a baixa automática desta matéria-prima cai (ver
  // fase-custo-real.md §1.5, §3.2) — só relevante quando tipo=MATERIA_PRIMA.
  // Nulo cai na categoria padrão configurada em
  // ParametrosGrafica.categoriaCustoConsumoPadraoId.
  categoriaCustoId String?

  // Unidade em que a gráfica RACIOCINA e VENDE este produto (ex: rótulo por
  // milheiro), separada da UnidadeMedida de ItemCatalogo (que descreve o
  // item em si) — só relevante quando tipo=PRODUTO. fatorConversao converte
  // pra a unidade base do motor de preço (ex: 1 milheiro = 1000). Nula = usa
  // UNIDADE/1, comportamento de hoje. Camada de exibição/métrica derivada —
  // nunca mexe no motor de preço em si.
  unidadeContagem UnidadeMedida?
  fatorConversao  Decimal?       @db.Decimal(12, 4)

  grafica            Grafica             @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  itemCatalogo       ItemCatalogo        @relation(fields: [itemCatalogoId], references: [id])
  prensa             Prensa?             @relation(fields: [prensaId], references: [id], onDelete: Restrict)
  maquinaFlexografia MaquinaFlexografia? @relation(fields: [maquinaFlexografiaId], references: [id], onDelete: Restrict)
  papel              ItemGrafica?        @relation("PapelDoProdutoOffset", fields: [papelId], references: [id], onDelete: Restrict)
  // SetNull: desativar/remover a categoria de custo não pode travar a
  // matéria-prima — ela só volta a cair na categoria padrão da gráfica.
  categoriaCusto     CategoriaCusto?     @relation(fields: [categoriaCustoId], references: [id], onDelete: SetNull)

  itensOrcamento OrcamentoItem[]
  movimentacoes  MovimentacaoEstoque[]

  bobinas                       BobinaMaterial[]
  formatosFolha                 FormatoFolha[]
  configuracaoAcabamento        ConfiguracaoAcabamento?
  usadoComoAcabamento           OrcamentoItemAcabamento[]
  configuracaoClicheEtiqueta    ConfiguracaoClicheEtiqueta?
  configuracaoClicheFlexografia ConfiguracaoClicheFlexografia?
  usadoComoPapelEtiqueta        OrcamentoItemPrecificacaoEtiqueta[] @relation("PapelDoItemOrcamentoEtiqueta")

  // Ficha técnica (spec de baixa automática de estoque): só relevante quando
  // tipo=PRODUTO. fichaTecnica = quais matérias-primas este produto consome;
  // usadoComoMateriaPrima = em quais fichas técnicas esta matéria-prima aparece.
  fichaTecnica          FichaTecnicaItem[] @relation("FichaTecnicaDoProduto")
  usadoComoMateriaPrima FichaTecnicaItem[] @relation("MateriaPrimaConsumida")

  // Papel: produtos Offset que usam este item como papel, e a tabela de
  // preço por gramatura deste item quando ELE é o papel (tipo=MATERIA_PRIMA).
  produtosQueUsam  ItemGrafica[]      @relation("PapelDoProdutoOffset")
  tabelaPrecoPapel TabelaPrecoPapel[] @relation("TabelaDoPapel")

  // Variantes deste item quando ELE é uma matéria-prima com sub-variação
  // (ex: espessura de chapa) — ver comentário do model VarianteMateriaPrima.
  variantes VarianteMateriaPrima[] @relation("VariantesDaMateriaPrima")

  // Pedidos de compra (workflow SOLICITADO→...→CONFERIDO) que têm esta
  // matéria-prima como alvo — ver model SolicitacaoCompra.
  solicitacoesCompra SolicitacaoCompra[]

  @@unique([graficaId, itemCatalogoId])
  @@index([graficaId])
  @@index([categoriaCustoId])
  @@map("itens_grafica")
}

// Tabela de preço por gramatura de um papel (ItemGrafica tipo=MATERIA_PRIMA).
// Um papel = 1 cadastro no catálogo; a gramatura vira um subtópico aqui em vez
// de virar um cadastro inteiro novo (ver comentário do model ItemGrafica).
// resolverPrecoPapel (src/lib/pricing/papel.ts) busca aqui pela gramatura
// exata e, se não achar, cai no fallback pela mais próxima.
model TabelaPrecoPapel {
  id            String   @id @default(cuid())
  itemGraficaId String
  gramatura     Int
  precoKg       Decimal  @db.Decimal(12, 4)
  createdAt     DateTime @default(now())

  itemGrafica ItemGrafica @relation("TabelaDoPapel", fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@unique([itemGraficaId, gramatura])
  @@index([itemGraficaId])
  @@map("tabela_preco_papel")
}

// Quanto de uma matéria-prima um produto consome por unidade vendida (ex: 1 Cartão de
// Visita consome 0,002 folha de Papel Couché 300g). Alimenta a baixa automática de
// estoque quando um Pedido entra em produção (ver avancarPedido) — v1 só cobre
// PRODUTO×quantidade do OrcamentoItem; acabamentos/serviços consumindo material próprio
// (ex: BOPP na laminação) ficam de fora por ora.
model FichaTecnicaItem {
  id                   String   @id @default(cuid())
  itemGraficaId        String // o produto (ItemGrafica tipo PRODUTO)
  materiaPrimaId       String // a matéria-prima consumida (outro ItemGrafica, tipo MATERIA_PRIMA)
  quantidadePorUnidade Decimal  @db.Decimal(12, 6)
  createdAt            DateTime @default(now())

  // Qual variante da matéria-prima (ex: espessura de uma chapa) é consumida —
  // só relevante/obrigatório (na aplicação) quando a matéria-prima tem
  // VarianteMateriaPrima cadastrada. Sem variantes, fica null e o consumo é
  // do ItemGrafica direto, como sempre foi.
  varianteId String?

  itemGrafica  ItemGrafica           @relation("FichaTecnicaDoProduto", fields: [itemGraficaId], references: [id], onDelete: Cascade)
  materiaPrima ItemGrafica           @relation("MateriaPrimaConsumida", fields: [materiaPrimaId], references: [id], onDelete: Cascade)
  variante     VarianteMateriaPrima? @relation(fields: [varianteId], references: [id], onDelete: Restrict)

  @@unique([itemGraficaId, materiaPrimaId, varianteId])
  @@index([itemGraficaId])
  @@index([materiaPrimaId])
  @@index([varianteId])
  @@map("ficha_tecnica_itens")
}

// Variante de uma matéria-prima (ex: espessura de uma chapa: 2mm/3mm/5mm) —
// mesma filosofia de TabelaPrecoPapel (1 cadastro de matéria-prima, N
// subtópicos), mas aqui cada variante tem preço E estoque próprios, porque
// (diferente da gramatura do papel) variantes físicas diferentes têm saldos
// de estoque diferentes de verdade. `ativo=false` é soft-delete: nunca se
// apaga uma variante que já foi referenciada por ficha técnica ou
// movimentação de estoque, só se desativa (some da tela, histórico intacto).
model VarianteMateriaPrima {
  id                     String    @id @default(cuid())
  itemGraficaId          String // a matéria-prima "pai" (ItemGrafica tipo=MATERIA_PRIMA)
  rotulo                 String // ex: "2mm", "3mm", "5mm"
  ativo                  Boolean   @default(true)
  precoCompra            Decimal   @db.Decimal(12, 4)
  estoqueAtual           Decimal?  @db.Decimal(12, 4)
  estoqueMinimo          Decimal?  @db.Decimal(12, 4)
  // Mesma ideia de ItemGrafica.perdaFixaPadrao, só que por variante (ex: uma
  // espessura de chapa pode ter perda de calibragem diferente de outra).
  perdaFixaPadrao        Decimal?  @db.Decimal(12, 4)
  // Mesmo dedup self-healing de ItemGrafica.alertaEstoqueEnviadoEm, só que por
  // variante (cada uma tem saldo próprio).
  alertaEstoqueEnviadoEm DateTime?
  createdAt              DateTime  @default(now())

  itemGrafica ItemGrafica @relation("VariantesDaMateriaPrima", fields: [itemGraficaId], references: [id], onDelete: Cascade)

  fichaTecnica       FichaTecnicaItem[]
  movimentacoes      MovimentacaoEstoque[]
  solicitacoesCompra SolicitacaoCompra[]

  @@unique([itemGraficaId, rotulo])
  @@index([itemGraficaId])
  @@map("variantes_materia_prima")
}

// Opções de bobina de um material (ex: Lona 440g vem em rolos de 1,00/1,20/1,50m).
// custoM2 não é duplicado aqui — vem de ItemGrafica.precoCompra (fonte única).
model BobinaMaterial {
  id             String   @id @default(cuid())
  itemGraficaId  String
  larguraNominal Decimal  @db.Decimal(6, 3) // W_nominal, metros
  refile         Decimal  @db.Decimal(6, 3) // m_refile por lado, metros
  createdAt      DateTime @default(now())

  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@index([itemGraficaId])
  @@map("bobinas_material")
}

// Formatos de folha de máquina de um papel (ex: Couché 300g em 66x96 e 33x48).
model FormatoFolha {
  id            String   @id @default(cuid())
  itemGraficaId String
  nome          String // ex: "Fechada 66x96"
  larguraFolha  Decimal  @db.Decimal(6, 3) // L_f, metros
  alturaFolha   Decimal  @db.Decimal(6, 3) // A_f, metros
  createdAt     DateTime @default(now())

  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@index([itemGraficaId])
  @@map("formatos_folha")
}

// Configura um SERVICO como acabamento do motor avançado (spec §3).
// custoUnitario da fórmula não é campo novo — é o ItemGrafica.precoCompra do próprio serviço.
model ConfiguracaoAcabamento {
  id               String            @id @default(cuid())
  itemGraficaId    String            @unique
  baseCobranca     BaseCobranca
  estagio          EstagioAcabamento
  custoSetup       Decimal           @default(0) @db.Decimal(12, 4)
  custoMinimo      Decimal           @default(0) @db.Decimal(12, 4)
  custoFerramental Decimal?          @db.Decimal(12, 4)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@map("configuracoes_acabamento")
}

// Liga/configura o motor de clichê de etiqueta pra um produto M2 — presença
// da linha = "este produto usa o motor de clichê", mesmo padrão de
// ConfiguracaoAcabamento pra SERVICO/acabamento (presença = ligado, sem
// checkbox extra). Só relevante quando ItemGrafica.modeloCalculo=M2.
model ConfiguracaoClicheEtiqueta {
  id                String   @id @default(cuid())
  itemGraficaId     String   @unique
  // R$ por cm² de área de clichê — achado analisando 132 pedidos reais da
  // Assus (histórico "Custos_Adestek"): o custo do clichê escala com a área
  // da etiqueta, não é um valor fixo igual pra qualquer tamanho (confirmado
  // comparando pedidos de tamanhos diferentes com o mesmo nº de cores).
  // Nunca escala com a tiragem — só com área × nº de cores.
  custoClichePorCm2 Decimal  @db.Decimal(12, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@map("configuracoes_cliche_etiqueta")
}

// Custo de clichê pro modelo FLEXOGRAFIA — mesma fórmula/unidade de
// ConfiguracaoClicheEtiqueta (R$/cm² × nº de cores × área da peça, achada na mesma
// análise de dados reais), mas tabela PARALELA, não reaproveitada: ao contrário do
// M2 (onde a presença da linha liga/desliga um motor opcional, configurado num card
// próprio), aqui é OBRIGATÓRIO pra todo produto FLEXOGRAFIA e configurado inline
// junto com máquina/bobina em ConfiguracaoProdutoForm.tsx, não como card
// independente.
model ConfiguracaoClicheFlexografia {
  id                String   @id @default(cuid())
  itemGraficaId     String   @unique
  custoClichePorCm2 Decimal  @db.Decimal(12, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id], onDelete: Cascade)

  @@map("configuracoes_cliche_flexografia")
}

// SAIDA_PRODUCAO e ESTORNO_CANCELAMENTO substituem os antigos valores
// genéricos SAIDA/ENTRADA (renomeados na migration desta fase — eram os
// únicos dois tipos que existiam: SAIDA = baixa automática Fila→Impressão,
// ENTRADA = estorno de cancelamento de pedido). Os três novos cobrem o que
// a fase "custo real" precisa: compra registrada, baixa manual (perda/
// quebra/uso avulso) e ajuste de contagem física.
enum TipoMovimentacao {
  SAIDA_PRODUCAO
  ESTORNO_CANCELAMENTO
  ENTRADA_COMPRA
  SAIDA_MANUAL
  AJUSTE_INVENTARIO
}

// Como o custo unitário snapshotado numa MovimentacaoEstoque foi obtido —
// hoje só PRECO_CADASTRO existe (lê ItemGrafica.precoCompra no momento da
// baixa); os outros dois entram quando houver disciplina de compra
// lançada o suficiente pra sustentar um cálculo melhor (ver fase-custo-real.md §1.1).
enum MetodoCusteio {
  PRECO_CADASTRO
  ULTIMA_COMPRA
  MEDIO_PONDERADO
}

model MovimentacaoEstoque {
  id            String           @id @default(cuid())
  itemGraficaId String
  // Qual pedido de produção gerou essa saída (quando aplicável) — permite
  // comparar consumo real vs. previsto pela ficha técnica por pedido, em vez
  // de depender de parsear o texto livre de `motivo`.
  pedidoId      String?
  tipo          TipoMovimentacao
  quantidade    Decimal          @db.Decimal(12, 4)
  motivo        String?
  createdAt     DateTime         @default(now())

  // Qual variante da matéria-prima moveu (quando ela tem variantes) —
  // itemGraficaId continua apontando pro "pai", pra joins/relatórios; isso
  // aqui só desambigua QUAL saldo (2mm ou 5mm) foi decrementado. SetNull,
  // igual pedidoId: preserva o histórico do movimento mesmo se a variante
  // um dia for desativada/apagada.
  varianteId String?

  // Snapshot de custo no momento da baixa — nunca recalculado retroativamente
  // (mesmo princípio do preço travado do orçamento). Nulo em movimentações
  // anteriores a esta fase: a UI mostra "—", nunca zero (zero mentiria que o
  // custo foi apurado como R$ 0). 4 casas em custoUnitario porque insumo
  // cotado por m²/milheiro tem preço fracionário — arredondar em 2 casas na
  // origem gera desvio acumulado visível em tiragem grande.
  custoUnitario     Decimal?      @db.Decimal(12, 4)
  custoTotal        Decimal?      @db.Decimal(12, 2)
  metodoCusteio     MetodoCusteio @default(PRECO_CADASTRO)
  // Quando o preço usado no snapshot foi atualizado pela última vez — base
  // do alerta "preço de custo não atualizado há N dias".
  precoReferenciaEm DateTime?

  documento    String? // nº da nota fiscal, só usado em ENTRADA_COMPRA
  criadoPorId  String? // null quando a movimentação foi gerada pelo sistema (baixa automática)
  // De qual fornecedor veio a compra — só relevante/preenchido em
  // ENTRADA_COMPRA. Opcional: nem toda gráfica cadastra fornecedor pra
  // toda compra, e histórico de compras sem fornecedor continua válido.
  fornecedorId String?

  // Qual SolicitacaoCompra gerou esta entrada (quando aplicável) — mesmo
  // papel de `pedidoId` só que do lado de compras: liga a ENTRADA_COMPRA ao
  // pedido de compra que a originou (ver avancarStatusCompra em
  // src/app/compras/status-transicao.ts). @unique porque uma solicitação só
  // gera no máximo uma entrada de estoque, ao confirmar RECEBIDO — CONFERIDO
  // (a etapa seguinte) é só a auditoria do que já entrou, não gera outra.
  // null pra toda movimentação que não veio de uma solicitação de compra
  // (compra avulsa lançada direto, ajuste manual, etc.).
  solicitacaoCompraId String? @unique

  // Restrict (não Cascade) porque isso é o histórico de movimentação de
  // estoque em si — apagar o ItemGrafica junto apagaria o próprio registro
  // que a movimentação existe pra preservar. Não é SetNull (como pedido/
  // variante abaixo) porque itemGraficaId não é opcional: uma movimentação
  // sem "o que moveu" não faz sentido. Hoje não existe nenhum fluxo no app
  // que apague um ItemGrafica, então isso é defensivo — mas se um dia
  // existir, Restrict força uma decisão explícita em vez de apagar
  // histórico financeiro/estoque silenciosamente.
  itemGrafica ItemGrafica           @relation(fields: [itemGraficaId], references: [id], onDelete: Restrict)
  pedido      Pedido?               @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  variante    VarianteMateriaPrima? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  custoPedido CustoPedido?
  // SetNull: desativar/apagar um fornecedor não pode apagar o histórico de
  // compra em si, só perde a referência de quem vendeu.
  fornecedor  Fornecedor?           @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  // SetNull: mesma razão de `pedido` acima — apagar a solicitação (hoje não
  // existe fluxo que apague) não pode invalidar o histórico de estoque.
  solicitacaoCompra SolicitacaoCompra? @relation(fields: [solicitacaoCompraId], references: [id], onDelete: SetNull)

  @@index([itemGraficaId])
  @@index([pedidoId])
  @@index([varianteId])
  @@index([fornecedorId])
  @@map("movimentacoes_estoque")
}

// Fornecedor de matéria-prima/serviço — cadastro simples pra permitir
// vincular uma entrada de compra (MovimentacaoEstoque tipo ENTRADA_COMPRA)
// a quem vendeu, e comparar preço entre fornecedores do mesmo item ao
// longo do tempo (via o histórico de movimentações já existente). Sem
// workflow de cotação/aprovação de propósito — isso é feature maior,
// separada; aqui é só "quem vendeu isto", espelhando o que a gráfica já
// controla manualmente numa planilha de lista de compras.
model Fornecedor {
  id        String   @id @default(cuid())
  graficaId String
  nome      String
  contato   String? // telefone/e-mail/observação livre
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  grafica            Grafica               @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  movimentacoes      MovimentacaoEstoque[]
  solicitacoesCompra SolicitacaoCompra[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("fornecedores")
}

// Fluxo estruturado de compra de matéria-prima: SOLICITADO→COTANDO→APROVADO→
// COMPRADO→RECEBIDO→CONFERIDO, com CANCELADO alcançável a partir de qualquer
// estado antes de RECEBIDO (ver TRANSICOES_VALIDAS em
// src/lib/compras-status.ts, mesmo padrão de StatusOrcamento/orcamento-status.ts).
// Diferente de MovimentacaoEstoque tipo ENTRADA_COMPRA (que já existia, um
// registro simples de "isso entrou no estoque"): este model é o PEDIDO DE
// COMPRA em si, existe desde ANTES de qualquer coisa física acontecer, e só
// gera a MovimentacaoEstoque de entrada quando o material de fato chega
// (RECEBIDO) — CONFERIDO é só a conferência/auditoria do que já entrou,
// nunca gera uma segunda entrada.
enum StatusSolicitacaoCompra {
  SOLICITADO
  COTANDO
  APROVADO
  COMPRADO
  RECEBIDO
  CONFERIDO
  CANCELADO
}

model SolicitacaoCompra {
  id        String                  @id @default(cuid())
  graficaId String
  status    StatusSolicitacaoCompra @default(SOLICITADO)

  itemGraficaId String // a matéria-prima (ItemGrafica tipo=MATERIA_PRIMA)
  // Qual variante (ex: espessura de chapa) quando a matéria-prima tem
  // VarianteMateriaPrima cadastrada — mesmo padrão opcional de
  // FichaTecnicaItem.varianteId. null = matéria-prima sem variantes.
  varianteId String?
  // Pode nascer sem fornecedor definido (ainda em SOLICITADO/COTANDO) — só
  // costuma ser preenchido a partir de APROVADO.
  fornecedorId String?

  quantidade Decimal @db.Decimal(12, 4)
  // Estimativa no momento da solicitação/cotação — informativa, nunca usada
  // pra decrementar caixa nem pra gravar o custo da entrada de estoque.
  // valorFinal é o que de fato foi pago, preenchido ao confirmar COMPRADO —
  // é ele (não o estimado) que vira o custo snapshotado na MovimentacaoEstoque
  // gerada em RECEBIDO.
  valorEstimado Decimal? @db.Decimal(12, 2)
  valorFinal    Decimal? @db.Decimal(12, 2)

  observacao String? // texto livre — ex: motivo da solicitação, condição de pagamento

  usuarioSolicitanteId String
  usuarioAprovadorId   String?

  // Datas de cada transição relevante. LogAuditoria (registrarAuditoria) já
  // cobre "quem fez o quê e quando" de forma genérica pra toda a aplicação,
  // mas a tela de detalhe desta solicitação precisa montar sua própria linha
  // do tempo sem depender de outra tabela — por isso datas dedicadas aqui,
  // igual o resto do schema faz (ex: Pedido.arteAprovadaEm). SOLICITADO
  // nasce preenchido (solicitadoEm = createdAt); as demais começam null e são
  // preenchidas por avancarStatusCompra na hora de cada transição.
  solicitadoEm DateTime  @default(now())
  cotandoEm    DateTime?
  aprovadoEm   DateTime?
  compradoEm   DateTime?
  recebidoEm   DateTime?
  conferidoEm  DateTime?
  canceladoEm  DateTime?

  // Nº da nota fiscal da compra — mesmo papel de MovimentacaoEstoque.documento;
  // copiado pra lá quando a entrada é gerada em RECEBIDO.
  documento String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica            Grafica               @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  // Restrict, mesmo raciocínio de MovimentacaoEstoque.itemGrafica: hoje não
  // existe fluxo que apague um ItemGrafica, isto é só defensivo.
  itemGrafica        ItemGrafica           @relation(fields: [itemGraficaId], references: [id], onDelete: Restrict)
  // SetNull: desativar/apagar uma variante não pode apagar a solicitação —
  // ela só perde a referência de qual variante era o alvo.
  variante           VarianteMateriaPrima? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  fornecedor         Fornecedor?           @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  usuarioSolicitante Usuario               @relation("SolicitacoesCompraSolicitadas", fields: [usuarioSolicitanteId], references: [id])
  usuarioAprovador   Usuario?              @relation("SolicitacoesCompraAprovadas", fields: [usuarioAprovadorId], references: [id])
  // Lado inverso de MovimentacaoEstoque.solicitacaoCompraId (FK mora lá, não
  // aqui) — a entrada de estoque gerada ao confirmar RECEBIDO.
  movimentacaoEstoque MovimentacaoEstoque?

  @@index([graficaId, status])
  @@index([itemGraficaId])
  @@index([varianteId])
  @@index([fornecedorId])
  @@index([usuarioSolicitanteId])
  @@map("solicitacoes_compra")
}

enum StatusOrcamento {
  RASCUNHO
  ENVIADO
  APROVADO
  REJEITADO
}

enum TipoPedidoOrcamento {
  MODELO_NOVO
  REPETICAO_SEM_ALTERACAO
  REPETICAO_COM_ALTERACAO
}

enum TipoFrete {
  EMITENTE
  DESTINATARIO
}

model Orcamento {
  id               String          @id @default(cuid())
  graficaId        String
  clienteId        String
  usuarioId        String
  status           StatusOrcamento @default(RASCUNHO)
  total            Decimal         @default(0) @db.Decimal(12, 2)
  linkPublicoToken String?         @unique

  // Quem respondeu pelo link público, e quando. Nome DECLARADO, não
  // verificado — quem tem o link digita o que quiser. Vale como registro
  // (mesma força de uma assinatura em formulário de papel), não como prova
  // de identidade: a tela deve dizer "aceito por", nunca "confirmado por".
  // Fica separado de LogAuditoria de propósito — aquele responde "qual
  // FUNCIONÁRIO mexeu", este responde "qual pessoa do CLIENTE respondeu",
  // e misturar os dois exigiria usuarioId nulo lá, enfraquecendo o log
  // interno justamente onde ele precisa ser firme.
  respostaPublicaNome   String?
  respostaPublicaEm     DateTime?
  // Motivo escrito PELO CLIENTE ao recusar, no próprio link público.
  // Diferente de `observacoes` (nota interna da gráfica, logo abaixo): este
  // texto veio de fora e é o que o vendedor precisa ler pra saber se perdeu
  // por preço, por prazo ou por arte. Vai junto no e-mail de recusa.
  respostaPublicaMotivo String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Opcional de propósito — gráfica sem filial cadastrada nunca vê esse
  // campo no formulário. Filiais COMPARTILHAM catálogo/estoque/financeiro
  // da gráfica (ver model Filial): isto é só um rótulo de "onde esse
  // orçamento foi feito", pra relatório, não um tenant separado.
  filialId String?

  // Dados gerais do pedido — todos opcionais, editáveis a qualquer status
  // (não só RASCUNHO: frete/transportadora normalmente só são definidos
  // depois que o cliente já aprovou, e nenhum desses campos entra na conta
  // de preço). contatoNome/contatoEmail são um snapshot específico DESTE
  // pedido, diferente de Cliente.nome/Cliente.email (que são o cadastro).
  vendedor                 String?
  tipoPedido               TipoPedidoOrcamento?
  contatoNome              String?
  contatoEmail             String?
  condicoesPagamento       String?
  frete                    TipoFrete?
  transportadora           String?
  localEntrega             String?
  // Estimativa em DIAS, preenchida pelo vendedor ANTES do cliente decidir —
  // distinto de Pedido.prazoEntrega (data CONFIRMADA, só existe depois da
  // aprovação). Um é promessa pré-venda em dias, o outro é compromisso
  // pós-venda com data fixa — nunca unificar os dois.
  prazoEntregaEstimadoDias Int?
  // Data-limite computada até quando a proposta vale — não é um novo valor
  // de StatusOrcamento (evita cron job): orcamentoEstaExpirado() em
  // src/lib/orcamento-status.ts considera o orçamento vencido mesmo com
  // status=ENVIADO no banco. Calculado uma vez, quando o orçamento vira
  // ENVIADO (gerarLinkPublico/atualizarStatusOrcamento), a partir de
  // ParametrosGrafica.diasValidadeOrcamentoPadrao. Zerado quando o cliente
  // pede ajuste (volta pra RASCUNHO) e recalculado do zero ao reenviar.
  // null = nunca expira (todo orçamento criado antes desta feature).
  validoAteEm              DateTime?
  // Nota interna — nunca aparece no PDF nem no link público (ver
  // src/lib/pdf/mapear-dados.ts), só na tela autenticada da gráfica.
  observacoes              String?

  // Arte anexada já na criação do orçamento, pro cliente ver junto da
  // proposta (ver /o/[token]). Só visualização — a APROVAÇÃO de arte de
  // verdade continua em Pedido.arteUrl/arteAprovadaEm, sem mudança nenhuma
  // nesse fluxo. Editável só enquanto o orçamento está em RASCUNHO (mesma
  // regra dos outros campos editáveis desta tela). Quando o orçamento vira
  // Pedido, este valor é copiado pra Pedido.arteUrl automaticamente (ver
  // orcamento/[id]/actions.ts e o/[token]/actions.ts).
  arteUrl String?

  // Achados do preflight automático rodado no momento do upload (ver
  // src/lib/preflight.ts) — array de { checagem, severidade, mensagem }.
  // null = arquivo ainda não passou pelo preflight (nunca teve arte
  // enviada, ou foi enviada antes desta feature existir). Recalculado do
  // zero a cada novo upload (nunca acumula achado de um arquivo antigo).
  // v1 cobre: DPI efetivo (raster) e sangria via MediaBox×TrimBox (PDF) —
  // NÃO tenta detectar CMYK/RGB dentro do conteúdo de um PDF já pronto
  // (só é confiável pra imagem raster), nem checar fonte embutida ainda.
  preflightAvisos Json?

  // Rastreamento de etapas de produção (data+hora combinados, mesmo padrão
  // de arteAprovadaEm) + nome de quem é responsável — não precisa ser o
  // usuário logado, por isso é texto livre e não uma FK pra Usuario. Editável
  // direto (não é um log de eventos), a qualquer status. etapaConfirmacaoPedido*
  // corresponde à etapa "Pedido" do formulário físico original — nome do
  // campo é diferente pra não colidir com o model Pedido (produção) já
  // existente neste schema.
  etapaOrcamentoDesenvolvimentoEm          DateTime?
  etapaOrcamentoDesenvolvimentoResponsavel String?
  etapaLayoutEm                            DateTime?
  etapaLayoutResponsavel                   String?
  etapaAprovacaoEm                         DateTime?
  etapaAprovacaoResponsavel                String?
  etapaConfirmacaoPedidoEm                 DateTime?
  etapaConfirmacaoPedidoResponsavel        String?
  etapaEntregaEm                           DateTime?
  etapaEntregaResponsavel                  String?

  // Preenchido quando este orçamento nasceu do botão "Pedir de novo" (ver
  // duplicarOrcamento em src/app/orcamento/[id]/actions.ts) — rastreio pra um
  // futuro relatório de "quantos pedidos são reposição". Nunca influencia
  // preço/itens do novo orçamento (esses são sempre recalculados do zero a
  // partir do catálogo atual, nunca copiados) — é só um vínculo informativo.
  // SetNull: hoje só é possível apagar um Orcamento em RASCUNHO
  // (cancelarOrcamento), e "Pedir de novo" só é oferecido a partir de
  // APROVADO/REJEITADO, então isto não deveria disparar na prática — mas se
  // um dia mudar, o duplicado não pode ficar travado por causa disso, só
  // perde a referência.
  duplicadoDeId String?

  grafica      Grafica         @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  cliente      Cliente         @relation(fields: [clienteId], references: [id])
  usuario      Usuario         @relation(fields: [usuarioId], references: [id])
  filial       Filial?         @relation(fields: [filialId], references: [id], onDelete: SetNull)
  itens        OrcamentoItem[]
  pedido       Pedido?
  notaFiscal   NotaFiscal?
  comissao     Comissao?
  duplicadoDe  Orcamento?      @relation("DuplicacaoOrcamento", fields: [duplicadoDeId], references: [id], onDelete: SetNull)
  duplicados   Orcamento[]     @relation("DuplicacaoOrcamento")

  pagamentos    Pagamento[]
  contasReceber ContaReceber[]

  @@index([graficaId])
  @@index([filialId])
  @@index([duplicadoDeId])
  @@map("orcamentos")
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO
  BOLETO
  TRANSFERENCIA
  OUTRO
}

// Registro de pagamento (entrada, parcela, quitação) de um orçamento aprovado. Saldo
// devedor é sempre calculado (total - soma dos pagamentos), nunca armazenado — evita
// dessincronia. Só criado com o orçamento em APROVADO (ver registrarPagamento).
model Pagamento {
  id           String         @id @default(cuid())
  orcamentoId  String
  valor        Decimal        @db.Decimal(12, 2)
  forma        FormaPagamento
  // Só usado quando forma = OUTRO (cheque, vale-troca, permuta...) — sem
  // isso "Outro" virava caixa preta sem detalhe nenhum nos relatórios.
  formaDetalhe String?
  observacao   String?
  createdAt    DateTime       @default(now())

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  // Presente quando este pagamento foi gerado a partir de "marcar conta a
  // receber como recebida" (ver marcarComoRecebido em
  // src/app/financeiro/contas-receber/actions.ts) — decisão revista em
  // 2026-08-15: o comentário original de ContaReceber (acima) dizia que os
  // dois conviviam sem se referenciar, mas isso deixava a exportação
  // financeira subestimando receita sempre que alguém usava o botão
  // "Marcar como recebido" em vez de lançar Pagamento manual na tela do
  // orçamento. Mesmo padrão de Despesa.comissao. Risco aceito: se alguém
  // fizer as duas coisas pro mesmo dinheiro, ele conta 2x — não há
  // deduplicação automática entre os dois caminhos.
  contaReceber ContaReceber?

  @@index([orcamentoId])
  @@map("pagamentos")
}

enum StatusDespesa {
  PENDENTE
  PAGA
}

// Contraparte de Pagamento: dinheiro SAINDO da gráfica (fornecedor, aluguel,
// conta fixa), não entrando. descricao continua texto livre; categoria
// também continua existindo como texto livre (histórico), mas agora tem um
// par estruturado opcional (categoriaCustoId) reaproveitando o MESMO
// CategoriaCusto já usado em CustoPedido — evita "Aluguel" vs "aluguel" vs
// "ALUGUEL " quebrando agrupamento em relatório. Fornecedor JÁ é modelo
// relacional configurável hoje (ver model Fornecedor), só não tem vínculo
// com Despesa ainda.
//
// status/pagoEm nunca são editados por um form genérico de edição — só pelas
// actions marcarComoPaga/marcarComoPendente (ver src/app/financeiro/actions.ts),
// pra nunca existir uma combinação inconsistente tipo "paga sem data de pagamento".
//
// vencimento é a PRIMEIRA data-pura (sem hora) do schema inteiro — guardada
// sempre como meia-noite UTC (`${valor}T00:00:00Z`) e SEMPRE exibida com
// `timeZone: "UTC"` no formatador (src/lib/data.ts), pra não variar um dia
// conforme o fuso de quem tá vendo. Todo campo de data-pura futuro deve
// seguir o mesmo padrão.
model Despesa {
  id                    String          @id @default(cuid())
  graficaId             String
  descricao             String
  categoria             String?
  categoriaCustoId      String? // par estruturado opcional de `categoria` (ver comentário acima)
  valor                 Decimal         @db.Decimal(12, 2)
  vencimento            DateTime
  status                StatusDespesa   @default(PENDENTE)
  formaPagamento        FormaPagamento?
  // Só usado quando formaPagamento = OUTRO — mesmo par de Pagamento.formaDetalhe.
  formaPagamentoDetalhe String?
  pagoEm                DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Recorrência: recorrente=true marca que essa ocorrência faz parte de uma
  // série mensal. serieRecorrenciaId agrupa as ocorrências da mesma série
  // (a primeira ocorrência recebe o próprio id como serieRecorrenciaId — ver
  // criarDespesa). Só a ocorrência de VENCIMENTO MAIS RECENTE de uma série é
  // consultada pra decidir se gera a próxima (ver src/lib/despesa-recorrente.ts)
  // — então desmarcar "recorrente" só nessa ocorrência mais recente já
  // encerra a série, sem precisar tocar nas anteriores.
  recorrente         Boolean @default(false)
  serieRecorrenciaId String?

  grafica        Grafica         @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  // SetNull, não Restrict: uma categoria de custo nunca é apagada de
  // verdade (só desativada, ativa=false), mas se algum dia for, a despesa
  // não pode ficar travada por causa disso — só perde o vínculo estruturado,
  // o texto livre em `categoria` continua intacto.
  categoriaCusto CategoriaCusto? @relation(fields: [categoriaCustoId], references: [id], onDelete: SetNull)

  // Presente quando esta despesa foi gerada a partir de "marcar comissão
  // como paga" (ver marcarComissaoPaga em src/app/financeiro/comissoes/actions.ts)
  // — deixa o pagamento aparecer no relatório/exportação financeira normal
  // sem duplicar os campos de Comissao aqui.
  comissao Comissao?

  // Presente quando esta despesa foi gerada a partir de uma RECARGA de conta
  // prepaga (ver lancarMovimentacaoContaPrepaga em
  // src/app/financeiro/contas-prepagas/actions.ts) — mesmo padrão de
  // Despesa.comissao acima, pra recarga de carteira (ex: Lalamove) não ficar
  // de fora do relatório/exportação financeira.
  movimentacaoContaPrepaga MovimentacaoContaPrepaga?

  // Trava contra duplicata em `gerarDespesasRecorrentesPendentes`: duas
  // requisições concorrentes (duas abas, dois usuários abrindo /financeiro
  // ao mesmo tempo) podem ambas decidir gerar a ocorrência do mesmo mês
  // pra mesma série — essa constraint faz a segunda tentativa falhar no
  // banco em vez de criar uma despesa duplicada (ver catch de P2002 lá).
  @@unique([serieRecorrenciaId, vencimento])
  @@index([graficaId])
  @@index([graficaId, status, vencimento])
  @@index([graficaId, serieRecorrenciaId])
  @@map("despesas")
}

// Saldo prepago tipo "vale" (ex: carteira de um serviço de entrega como
// Lalamove) — diferente de Despesa, que é conta a pagar; aqui o dinheiro já
// saiu antes, numa recarga, e cada uso (corrida, envio) só debita de um
// saldo que a gráfica precisa monitorar pra não ficar negativo/zerado.
// saldoAtual é cache redundante da soma de MovimentacaoContaPrepaga — existe
// só pra não recalcular a soma inteira em toda leitura da tela; sempre
// atualizado na MESMA transação que cria a movimentação.
model ContaPrepaga {
  id         String   @id @default(cuid())
  graficaId  String
  nome       String // ex: "Lalamove"
  saldoAtual Decimal  @default(0) @db.Decimal(12, 2)
  ativa      Boolean  @default(true)
  createdAt  DateTime @default(now())

  grafica       Grafica                    @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  movimentacoes MovimentacaoContaPrepaga[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("contas_prepagas")
}

enum TipoMovimentacaoContaPrepaga {
  RECARGA
  DEBITO
}

model MovimentacaoContaPrepaga {
  id          String                       @id @default(cuid())
  contaId     String
  tipo        TipoMovimentacaoContaPrepaga
  valor       Decimal                      @db.Decimal(12, 2)
  motivo      String?
  criadoPorId String?
  createdAt   DateTime                     @default(now())

  // Despesa gerada quando tipo=RECARGA (só recarga é dinheiro saindo da
  // gráfica de verdade; débito só consome saldo já lançado antes) — ver
  // comentário em Despesa.movimentacaoContaPrepaga acima. Null pra DEBITO.
  despesaId String? @unique

  conta   ContaPrepaga @relation(fields: [contaId], references: [id], onDelete: Cascade)
  despesa Despesa?     @relation(fields: [despesaId], references: [id], onDelete: SetNull)

  @@index([contaId, createdAt])
  @@map("movimentacoes_conta_prepaga")
}

enum StatusContaReceber {
  PENDENTE
  RECEBIDO
  CANCELADO
}

// Uma parcela/pagamento esperado de um Orcamento aprovado — o par simétrico
// de Despesa (que é dinheiro SAINDO), mas pro dinheiro que o CLIENTE ainda
// deve. Pode haver várias linhas por orçamento (parcelamento). Não gerado
// automaticamente na aprovação — o vendedor/financeiro cadastra as parcelas
// manualmente na tela do orçamento aprovado (condicoesPagamento já é texto
// livre, isso aqui é o registro estruturado equivalente).
//
// Diferente de Pagamento (que registra dinheiro JÁ recebido, sem noção de
// "esperado"/"vencimento"): ContaReceber é o lado da EXPECTATIVA — o que
// ainda falta cobrar e quando. Até 2026-08-15 os dois conviviam sem se
// referenciar; revisto porque isso deixava a exportação financeira (ver
// src/app/financeiro/exportar/route.ts, que só lê Pagamento) subestimando
// receita sempre que o recebimento era registrado por aqui (marcarComoRecebido)
// em vez de um Pagamento lançado manualmente na tela do orçamento. Agora
// marcarComoRecebido cria o Pagamento espelhado — ver pagamentoId abaixo.
//
// status/recebidoEm nunca são editados por um form genérico — só pelas
// actions marcarComoRecebido/cancelarContaReceber (ver
// src/app/financeiro/contas-receber/actions.ts), mesmo cuidado de Despesa
// pra nunca existir "recebido sem data de recebimento".
model ContaReceber {
  id          String             @id @default(cuid())
  graficaId   String
  orcamentoId String
  descricao   String // ex: "Parcela 1/3", "Entrada", "Pagamento único"
  valor       Decimal            @db.Decimal(12, 2)
  vencimento  DateTime // data-pura (meia-noite UTC), mesmo padrão de Despesa.vencimento
  status      StatusContaReceber @default(PENDENTE)
  recebidoEm  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Pagamento gerado quando marcada como recebida (opcional — só existe
  // depois do recebimento) — ver comentário em Pagamento.contaReceber acima.
  pagamentoId String? @unique

  grafica   Grafica    @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamento Orcamento  @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  pagamento Pagamento? @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)

  @@index([graficaId, status, vencimento])
  @@index([orcamentoId])
  @@map("contas_a_receber")
}

enum StatusComissao {
  PENDENTE
  PAGA
}

// Comissão de um vendedor sobre um orçamento aprovado — registro histórico
// (nunca recalculado): guarda SNAPSHOT da taxa do usuário e da política de
// cálculo da gráfica no momento da aprovação, pra não mudar retroativamente
// se o dono trocar a config depois. Ver src/lib/comissao.ts (cálculo puro) e
// o gatilho em src/app/orcamento/[id]/actions.ts (atualizarStatusOrcamento).
model Comissao {
  id                 String         @id @default(cuid())
  graficaId          String
  orcamentoId        String         @unique // no máximo 1 comissão por orçamento
  usuarioId          String // vendedor — snapshot de Orcamento.usuarioId
  baseCalculo        BaseComissao // snapshot de ParametrosGrafica.comissaoVendedorBase
  percentualAplicado Decimal        @db.Decimal(5, 4) // snapshot de Usuario.comissaoPercent
  valorBase          Decimal        @db.Decimal(12, 2) // total ou lucro, conforme baseCalculo
  valorComissao      Decimal        @db.Decimal(12, 2)
  status             StatusComissao @default(PENDENTE)
  pagoEm             DateTime?
  createdAt          DateTime       @default(now())

  // Despesa gerada quando marcada como paga (opcional — só existe depois do
  // pagamento) — ver comentário em Despesa.comissao acima.
  despesaId String? @unique

  grafica   Grafica   @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id])
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])
  despesa   Despesa?  @relation(fields: [despesaId], references: [id], onDelete: SetNull)

  @@index([graficaId, status])
  @@index([usuarioId])
  @@map("comissoes")
}

// Trilha de auditoria financeira: quem alterou o quê. usuarioNome é um
// snapshot (não FK em Usuario) de propósito — o log tem que continuar legível
// mesmo que o usuário seja removido da gráfica no futuro. entidadeId também
// não é FK (mesmo motivo: excluirDespesa é hard delete, o log tem que
// sobreviver ao registro que ele descreve).
model LogAuditoria {
  id          String   @id @default(cuid())
  graficaId   String
  usuarioId   String
  usuarioNome String
  acao        String
  entidade    String
  entidadeId  String
  descricao   String
  createdAt   DateTime @default(now())

  // O QUE mudou, não só que mudou. Sem estes dois, "Fulano editou a despesa
  // X" não resolve nenhuma investigação — o que resolve é "mudou de R$ 300
  // pra R$ 100". Guardados como texto legível por humano (não JSON cru),
  // porque quem lê isto é o dono da gráfica na tela de auditoria, não um
  // programa. Nulos em ação que não é edição (criar, excluir, aprovar).
  valorAnterior String?
  valorNovo     String?

  // IP de quem fez a ação. Existe pra responder "foi mesmo esse funcionário
  // ou alguém usando a conta dele" — a pergunta que o dono faz quando algo
  // dá errado. Nulo quando não foi possível resolver o IP.
  ip String?

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@index([graficaId, createdAt])
  @@map("logs_auditoria")
}

enum TipoDesconto {
  PERCENTUAL
  VALOR_ABSOLUTO
  PRECO_FINAL // usuário digita o preço fechado, sistema deriva o desconto
}

model OrcamentoItem {
  id              String          @id @default(cuid())
  orcamentoId     String
  itemGraficaId   String
  quantidade      Int
  larguraCm       Decimal?        @db.Decimal(8, 2)
  alturaCm        Decimal?        @db.Decimal(8, 2)
  // Unidade em que o usuário efetivamente DIGITOU largura/altura deste item
  // (mm/cm/m — ver src/lib/unidade-dimensao.ts) — congelada no momento da
  // criação do item, nunca lida dinamicamente de Grafica.unidadePadraoDimensao
  // depois: trocar o padrão da gráfica não deve reinterpretar itens já salvos.
  // larguraCm/alturaCm acima continuam SEMPRE em centímetros; isto é só a
  // unidade de ENTRADA/EXIBIÇÃO. Default CM preserva o comportamento de toda
  // linha existente (nunca teve outra unidade).
  unidadeDimensao UnidadeDimensao @default(CM)
  cores           String? // ex: "4x0", "4x4" — snapshot legível, sempre preenchido
  acabamento      String? // texto livre, modo SIMPLES apenas

  // precoUnitario/precoTotal continuam sendo o VALOR VENDIDO (deliberado —
  // PDF, link público, pagamentos e relatórios já leem estes campos). O
  // preço sugerido pelo motor vira campo paralelo, nunca substitui estes.
  precoUnitario Decimal @db.Decimal(12, 2)
  precoTotal    Decimal @db.Decimal(12, 2)

  // Preço sugerido vs. negociado (ver fase-custo-real.md §2.4, §4.2) — nulo em
  // item sem desconto registrado, o que inclui todo item criado antes desta
  // fase (renderiza normalmente, sem "erosão por desconto" pra mostrar).
  precoSugeridoUnitario Decimal?      @db.Decimal(12, 4)
  descontoTipo          TipoDesconto?
  descontoValor         Decimal?      @db.Decimal(12, 4)
  motivoDesconto        String?       @db.VarChar(300)
  // Preenchido quando o desconto passa de ParametrosGrafica.descontoMaxSemAprovacao
  // e um DONO/ADMIN aprova — texto livre de "quem", não FK (mesmo padrão de
  // LogAuditoria.usuarioNome: sobrevive à remoção do usuário).
  aprovadoPorId         String?

  // Motor avançado (M2/OFFSET/FLEXOGRAFIA): snapshot do modelo usado + árvore de
  // custo auditável (spec §0d). Fica null pra itens SIMPLES — nada muda no caminho
  // existente.
  modeloCalculo    ModeloCalculo @default(SIMPLES)
  corFrente        Int?
  corVerso         Int?
  // Nº de cores da arte — modeloCalculo=FLEXOGRAFIA only. Deliberadamente separado
  // de corFrente/corVerso (que têm semântica de "frente/verso de folha", lida em
  // ~20 lugares — PDF, webhook-tinta.ts, pedido-aprovacao.ts) pra não arriscar bug
  // silencioso de significado errado nesses consumidores.
  numeroCoresFlexo Int?
  breakdown        Json?

  orcamento   Orcamento   @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  itemGrafica ItemGrafica @relation(fields: [itemGraficaId], references: [id])

  acabamentos          OrcamentoItemAcabamento[]
  etiqueta             OrcamentoItemEtiqueta?
  tinta                OrcamentoItemTinta?
  precificacaoEtiqueta OrcamentoItemPrecificacaoEtiqueta?

  @@index([orcamentoId])
  @@map("orcamento_itens")
}

enum MaterialSubstrato {
  PAPEL_TERMICO
  COUCHE_C_ROT
  BOPP_METALIZADO_ROT
  BOPP_BCO_PEROLIZADO
  BOPP_BCO_FOSCO
  BOPP_TRANSPARENTE
  L2_SEM_ADESIVO
  POLIETILENO_BRANCO
  POLIETILENO_TRANSPARENTE
  POLIESTER_BRANCO
  POLIESTER_TRANSPARENTE
  POLIESTER_CROMO_FOSCO
  ELETROSTATICO_SEM_COLA
  OUTRO
}

// OUTRO em cada enum abaixo (exceto TipoRotulagem, que descreve um PROCESSO
// binário — manual ou automático — não um catálogo de material/técnica de
// fornecedor) + campo de texto livre pareado em OrcamentoItemEtiqueta/
// OrcamentoItemHotStamping — sem isso, uma gráfica cujo adesivo/laminação/
// verniz real não está nesta lista fixa (montada a partir do catálogo de UM
// fornecedor específico) simplesmente não conseguia cadastrar o item.
enum TipoAdesivo {
  ACRILICO_20G
  ACRILICO_30G
  BORRACHA_20G
  BORRACHA_25G
  BORRACHA_30G
  BORRACHA_50G
  OUTRO
}

enum SuperficieAplicacao {
  VIDRO
  PLASTICO
  METAL
  PAPEL
  PAPELAO
  OUTROS
}

enum TipoRotulagem {
  MANUAL
  AUTOMATICA
}

enum TipoSerrilha {
  SERRILHA
  MICRO_SERRILHA
  GAP
  OUTRO
}

enum TipoLaminacao {
  BRILHO
  FOSCO
  OUTRO
}

enum TipoAcabamentoVerniz {
  BRILHO
  FOSCO
  RIBBON
  OUTRO
}

enum TipoHotStamping {
  HOT
  COLD
  OUTRO
}

enum LadoEtiqueta {
  ROTULO
  CONTRA_ROTULO
}

// Detalhe descritivo/de produção de etiqueta (rótulo adesivo) — só relevante
// pra item com modeloCalculo=M2 (flexografia). Não entra na conta de preço
// (o motor M2 em src/lib/pricing/m2.ts só usa geometria + custo por m²) —
// isso aqui é 100% dado de especificação técnica pra imprimir/produzir, uma
// tabela separada (não colunas em OrcamentoItem) pra não deixar ~18 colunas
// sempre nulas em todo item SIMPLES/OFFSET, mesmo raciocínio que já levou
// OrcamentoItemAcabamento a ser tabela própria.
model OrcamentoItemEtiqueta {
  id              String @id @default(cuid())
  orcamentoItemId String @unique

  materialSubstrato        MaterialSubstrato?
  materialSubstratoOutro   String? // só usado quando materialSubstrato = OUTRO
  tipoAdesivo              TipoAdesivo?
  tipoAdesivoOutro         String? // só usado quando tipoAdesivo = OUTRO
  superficieAplicacao      SuperficieAplicacao?
  superficieAplicacaoOutro String? // só usado quando superficieAplicacao = OUTROS
  formatoEtiqueta          String?

  coresRotulo       Int?
  coresContraRotulo Int?

  embalagemQtdPorRolo Int?
  tubeteMedida        String?

  rotulagem     TipoRotulagem?
  serrilha      TipoSerrilha?
  serrilhaOutro String? // só usado quando serrilha = OUTRO

  vernizRotuloTotal           Boolean               @default(false)
  vernizRotuloReserva         Boolean               @default(false)
  vernizRotuloTipo            TipoAcabamentoVerniz?
  vernizRotuloTipoOutro       String? // só usado quando vernizRotuloTipo = OUTRO
  vernizContraRotuloTotal     Boolean               @default(false)
  vernizContraRotuloReserva   Boolean               @default(false)
  vernizContraRotuloTipo      TipoAcabamentoVerniz?
  vernizContraRotuloTipoOutro String? // só usado quando vernizContraRotuloTipo = OUTRO

  laminacaoRotulo            TipoLaminacao?
  laminacaoRotuloOutro       String? // só usado quando laminacaoRotulo = OUTRO
  laminacaoContraRotulo      TipoLaminacao?
  laminacaoContraRotuloOutro String? // só usado quando laminacaoContraRotulo = OUTRO

  rebobinamento Int? // 1-8, validado em app (src/lib/orcamento-etiqueta.ts) — sem nome pras opções ainda

  orcamentoItem OrcamentoItem              @relation(fields: [orcamentoItemId], references: [id], onDelete: Cascade)
  hotStampings  OrcamentoItemHotStamping[]

  @@map("orcamento_item_etiquetas")
}

// Hot/cold stamping pode ter mais de uma variação no mesmo item (ex: dois
// hots diferentes, cada um com sua própria medida/cor) — por isso é tabela
// 1:N, diferente de verniz/laminação (que são "um valor por lado", únicos).
model OrcamentoItemHotStamping {
  id                      String @id @default(cuid())
  orcamentoItemEtiquetaId String

  lado      LadoEtiqueta
  tipo      TipoHotStamping
  tipoOutro String? // só usado quando tipo = OUTRO
  medida    String?
  cor       String?

  orcamentoItemEtiqueta OrcamentoItemEtiqueta @relation(fields: [orcamentoItemEtiquetaId], references: [id], onDelete: Cascade)

  @@index([orcamentoItemEtiquetaId])
  @@map("orcamento_item_hot_stampings")
}

// Snapshot dos dados que ENTRAM na conta de preço de um item M2 com motor de
// clichê (ConfiguracaoClicheEtiqueta) — separado de OrcamentoItemEtiqueta de
// propósito (aquela é 100% descritiva/produção, nunca mexe no motor de preço,
// ver comentário dela acima; misturar quebraria esse invariante). Criada só
// quando o produto tem a config de clichê presente; nunca recalculada depois
// — mesmo espírito de OrcamentoItemAcabamento.
model OrcamentoItemPrecificacaoEtiqueta {
  id                   String   @id @default(cuid())
  orcamentoItemId      String   @unique
  papelId              String // matéria-prima (ItemGrafica tipo=MATERIA_PRIMA) escolhida NESTE orçamento
  quantidadeCores      Int // nº de cores da arte → nº de clichês
  custoClicheCalculado Decimal  @db.Decimal(12, 4) // snapshot = quantidadeCores × custoClicheUnitario no momento do cálculo
  custoFaca            Decimal? @db.Decimal(12, 4) // opcional, R$ livre (ferramental de corte)
  custoFrete           Decimal? @db.Decimal(12, 4) // opcional, R$ livre
  createdAt            DateTime @default(now())

  orcamentoItem OrcamentoItem @relation(fields: [orcamentoItemId], references: [id], onDelete: Cascade)
  papel         ItemGrafica   @relation("PapelDoItemOrcamentoEtiqueta", fields: [papelId], references: [id], onDelete: Restrict)

  @@map("orcamento_item_precificacao_etiquetas")
}

// Acabamentos estruturados aplicados a um item de orçamento no motor avançado
// (substitui o texto livre "acabamento" quando modeloCalculo != SIMPLES).
model OrcamentoItemAcabamento {
  id              String  @id @default(cuid())
  orcamentoItemId String
  itemGraficaId   String // o SERVICO usado como acabamento
  qtdBase         Decimal @db.Decimal(12, 4) // snapshot da base de cobrança usada
  custoCalculado  Decimal @db.Decimal(12, 4)

  orcamentoItem OrcamentoItem @relation(fields: [orcamentoItemId], references: [id], onDelete: Cascade)
  itemGrafica   ItemGrafica   @relation(fields: [itemGraficaId], references: [id])

  @@index([orcamentoItemId])
  @@map("orcamento_item_acabamentos")
}

enum StatusPedido {
  FILA
  IMPRESSAO
  ACABAMENTO
  PRONTO
  ENTREGUE
  // Terminal, assim como ENTREGUE — mas ao contrário dela, cancelar um
  // pedido que já passou por FILA→IMPRESSAO estorna automaticamente a
  // matéria-prima baixada (ver cancelarPedido em src/app/producao/actions.ts).
  // Só alcançável a partir de FILA/IMPRESSAO/ACABAMENTO/PRONTO — nunca de
  // ENTREGUE (produto já saiu, cancelar não desfaz uma entrega física).
  CANCELADO
}

// Pedido nasce quando um Orcamento é aprovado: acompanha a produção física.
model Pedido {
  id          String       @id @default(cuid())
  graficaId   String
  orcamentoId String       @unique
  status      StatusPedido @default(FILA)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Data pura (meia-noite UTC, mesmo padrão de Despesa.vencimento — ver
  // src/lib/data.ts), definida na aprovação do orçamento. Opcional: nem todo
  // pedido tem prazo prometido, e sem prazo nunca gera alerta de atraso.
  prazoEntrega          DateTime?
  // Dedup do evento pedido_atrasado (webhook-automacao.ts): uma vez enviado
  // o alerta pra este pedido, nunca reenviar — evita spam a cada
  // carregamento de /producao enquanto o pedido continua atrasado. Canal
  // separado do campo abaixo: este dispara pro webhook de AUTOMAÇÃO da
  // própria gráfica (n8n), só depois do prazo já vencido.
  alertaAtrasoEnviadoEm DateTime?

  // Limiar mais urgente (5, 3 ou 0 dias até o prazo) já avisado por E-MAIL
  // ao vendedor do orçamento + DONO da gráfica (ver
  // src/lib/alerta-prazo-email.ts, rodando no cron diário). Cascata que só
  // anda pra frente — 5 → 3 → 0 — nunca reenvia um limiar já ultrapassado,
  // mas pula direto pro mais urgente ainda não avisado se o cron perder um
  // dia (ex: de "não avisado" direto pra 0 se o pedido já venceu no
  // primeiro run). Null = nenhum alerta de prazo ainda enviado por e-mail.
  alertaPrazoUltimoLimiarDias Int?

  // Aprovação de arte: opt-in por pedido — se a gráfica nunca envia uma
  // arte (arteUrl null), o pedido avança normalmente sem nenhum gate. Uma
  // vez enviada, avancarPedido bloqueia a saída de FILA até arteAprovadaEm
  // ser preenchido (ver src/app/producao/actions.ts). arteLinkToken é
  // gerado sob demanda (mesmo padrão de Orcamento.linkPublicoToken) e
  // reaproveitado entre reenvios do mesmo pedido — só o token muda de
  // "significado" (aprovado/pendente), nunca de valor, então o link que a
  // gráfica já mandou pro cliente continua válido após um reenvio.
  arteUrl               String?
  arteAprovadaEm        DateTime?
  arteComentarioCliente String?
  arteLinkToken         String?   @unique
  // Mesmo campo/formato de Orcamento.preflightAvisos (ver comentário lá) —
  // quando a arte do orçamento é copiada pro Pedido na aprovação, os
  // achados de preflight são copiados junto (não recalculados, é o mesmo
  // arquivo); um reenvio de arte na Produção recalcula do zero.
  preflightAvisos       Json?
  // Nome DECLARADO por quem respondeu pelo link público — não é verificado
  // (quem tem o link digita o que quiser), vale como registro, igual a uma
  // assinatura em formulário de papel. Nunca escrever "confirmado por" na
  // tela a partir disto, só "aprovado por". Mesmo par existe em Orcamento
  // (respostaPublicaNome/Em) pro aceite do orçamento.
  arteRespondidaPor     String?

  // Link público evergreen: "confirmar a etapa atual deste pedido", sem
  // login (ver ResponsavelEstagio e src/app/p/[token]). Gerado na criação
  // do Pedido e NUNCA rotacionado — como o status é um FSM estritamente
  // linear e só existe uma etapa viva por vez, o token não precisa saber
  // "qual" etapa confirma, só lê o status atual. Deixa de fazer sentido
  // quando o pedido chega em ENTREGUE/CANCELADO (terminal) — a página trata
  // isso como "nada pra confirmar agora", não como link inválido.
  producaoLinkToken String? @unique

  // Data da aprovação do orçamento (autenticada ou pelo link público) — até
  // esta fase, o dashboard somava faturamento por createdAt do orçamento
  // porque este campo não existia. Também é o gatilho que congela
  // PedidoCustoPrevisto e os três snapshots abaixo (ver fase-custo-real.md §1.2, §3.1).
  aprovadoEm DateTime?

  // Snapshots tirados no momento de aprovadoEm — nunca recalculados depois,
  // mesmo que o motor de precificação ou o preço de matéria-prima mudem.
  precoSugeridoTotal  Decimal? @db.Decimal(12, 2)
  valorNegociadoTotal Decimal? @db.Decimal(12, 2)
  custoPrevistoTotal  Decimal? @db.Decimal(12, 2)

  // Fechamento é ato explícito (tela /pedidos/{id}/fechamento), não
  // automático ao entrar em Entregue — custo atrasado (frete que chega na
  // semana seguinte) é regra, não exceção. Reabrir exige permissão
  // custosVerLucro e gera auditoria.
  fechadoEm    DateTime?
  fechadoPorId String?

  grafica   Grafica   @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id])

  movimentacoes  MovimentacaoEstoque[]
  custos         CustoPedido[]
  custosPrevisto PedidoCustoPrevisto[]

  @@index([graficaId])
  @@map("pedidos")
}

// Categoria de custo configurável por gráfica, usada pra lançar custos reais
// de produção num pedido específico (papel, ferramental/faca, laminação,
// clichê, impressão, frete, mão de obra, retrabalho etc — inspirado na
// planilha real de controle de uma gráfica cliente). NUNCA fixo no código —
// mesmo princípio já aplicado a UnidadeDimensao: cada gráfica tem seu
// próprio jeito de separar custo, então isto é só um rótulo configurável,
// com um conjunto padrão sugerido na primeira vez que a gráfica abre a tela
// (ver bootstrapCategoriasCustoPadrao), nunca um enum travado.
model CategoriaCusto {
  id        String   @id @default(cuid())
  graficaId String
  nome      String
  ordem     Int      @default(0)
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())

  grafica         Grafica               @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  custos          CustoPedido[]
  custosPrevistos PedidoCustoPrevisto[]
  itensGrafica    ItemGrafica[]
  despesas        Despesa[]

  @@unique([graficaId, nome])
  @@index([graficaId])
  @@map("categorias_custo")
}

enum OrigemCusto {
  MANUAL
  CONSUMO_ESTOQUE
  COMISSAO
  SERVICO_INSUMO
}

// Um lançamento de custo REAL incorrido num pedido específico — diferente do
// custo ESTIMADO pelo motor de precificação (OrcamentoItem.breakdown), que é
// uma previsão feita na hora do orçamento. Isto aqui é o gasto de verdade,
// lançado manualmente durante/depois da produção (ex: "paguei R$ 60 de faca
// nova pra este pedido"). Alimenta lucro por pedido (receita do orçamento
// aprovado − soma destes custos) e o gráfico de custos por categoria do Meu
// Negócio. graficaId duplicado de pedido.graficaId de propósito — mesmo
// padrão usado em Comissao/MovimentacaoEstoque, evita join extra pra
// escopar por tenant em toda query de relatório.
model CustoPedido {
  id               String   @id @default(cuid())
  graficaId        String
  pedidoId         String
  categoriaCustoId String
  valor            Decimal  @db.Decimal(12, 2)
  observacao       String?
  createdAt        DateTime @default(now())

  // De onde veio este lançamento (ver fase-custo-real.md §1.4). CONSUMO_ESTOQUE
  // é gerado automaticamente na baixa Fila→Impressão e nunca duplicado
  // (movimentacaoEstoqueId é único). Se já existir custo MANUAL na mesma
  // categoria/pedido quando o automático nasce, ele vem com
  // possivelDuplicidade=true em vez de somar calado.
  origem                OrigemCusto @default(MANUAL)
  movimentacaoEstoqueId String?     @unique
  valorCalculado        Decimal?    @db.Decimal(12, 2) // o que o sistema apurou, antes de qualquer edição manual
  editadoManualmente    Boolean     @default(false)
  possivelDuplicidade   Boolean     @default(false)

  criadoPorId String?
  // Cancelamento de pedido: nunca deleta custo de origem automática, só
  // marca estornadoEm e exclui da soma (mesmo princípio do estorno de
  // estoque, que já usa histórico real em vez de recalcular). Custo manual
  // não é estornado automaticamente (frete pago é frete pago).
  estornadoEm DateTime?

  grafica             Grafica              @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  pedido              Pedido               @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  // Restrict: não deixa apagar uma categoria ainda referenciada por um
  // lançamento de custo — a gráfica precisa desativar (ativa=false) em vez
  // de excluir, preservando o histórico de custos já lançados.
  categoriaCusto      CategoriaCusto       @relation(fields: [categoriaCustoId], references: [id], onDelete: Restrict)
  movimentacaoEstoque MovimentacaoEstoque? @relation(fields: [movimentacaoEstoqueId], references: [id], onDelete: SetNull)

  @@index([graficaId])
  @@index([pedidoId])
  @@index([categoriaCustoId])
  @@map("custos_pedido")
}

enum OrigemPrevisao {
  MOTOR_PRECIFICACAO
  FICHA_TECNICA
  MANUAL
}

// Previsão de custo por categoria, congelada no momento em que o orçamento
// é aprovado (ver fase-custo-real.md §2.3, §3.1). Existe pra responder
// "orçado vs. realizado" por categoria — não um total só, porque um total
// diz "estourei R$ 780" e por categoria diz "o papel veio 34% acima do
// previsto e apareceu um frete não orçado". Nunca recalculada depois: se o
// preço da matéria-prima mudar após a aprovação, esta linha não se altera.
model PedidoCustoPrevisto {
  id               String         @id @default(cuid())
  graficaId        String
  pedidoId         String
  categoriaCustoId String
  valor            Decimal        @db.Decimal(12, 2)
  origem           OrigemPrevisao
  detalhe          String? // ex: "Papel Couché 150g — 420 folhas"
  createdAt        DateTime       @default(now())

  grafica        Grafica        @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  pedido         Pedido         @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  categoriaCusto CategoriaCusto @relation(fields: [categoriaCustoId], references: [id], onDelete: Restrict)

  @@index([graficaId, pedidoId])
  @@index([categoriaCustoId])
  @@map("pedido_custo_previsto")
}

// Atribuição gráfica-wide (não por Pedido individual) de quem é responsável
// por cada etapa de produção — configurada em /usuarios. Usada em dois
// pontos: (1) e-mail automático quando um Pedido ENTRA nesse status (ver
// avancarStatusPedido em src/app/producao/status-transicao.ts), (2) bypass
// de permissão pra confirmar em app sem precisar de PRODUCAO.podeEditar
// completo (ver podeConfirmarEstagio em src/lib/auth/permissoes.ts). Só
// cobre as 3 etapas "vivas" atribuíveis (IMPRESSAO/ACABAMENTO/PRONTO, ver
// ESTAGIOS_ATRIBUIVEIS) — FILA fica de fora (decisão do produto: evita
// expor a tela de perda de material do estoque a um link sem login) e
// ENTREGUE/CANCELADO são terminais, sem transição de "confirmar" alguma.
model ResponsavelEstagio {
  id        String       @id @default(cuid())
  usuarioId String
  status    StatusPedido

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, status])
  @@index([status])
  @@map("responsaveis_estagio")
}

// Área ADMINISTRATIVA (não é etapa de produção — por isso não reaproveita
// ResponsavelEstagio/StatusPedido, que é o motor de estado do Pedido) que
// pode ter um ou mais responsáveis atribuídos. Hoje só NOTA_FISCAL existe
// (pedido do usuário em 2026-08-15/16: notificar quem emite a NF-e quando um
// orçamento é aprovado e já está pronto pra emitir) — enum deixado aberto
// pra outras áreas administrativas futuras (cobrança, etc.) sem precisar de
// migration nova, só adicionar valor ao enum + linha na UI.
enum AreaAdministrativa {
  NOTA_FISCAL
}

model ResponsavelAdministrativo {
  id        String             @id @default(cuid())
  usuarioId String
  area      AreaAdministrativa

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, area])
  @@index([area])
  @@map("responsaveis_administrativo")
}

// Rate limit da confirmação pública de etapa (src/app/p/[token]) — tabela
// separada de TentativaRespostaArte pra não misturar os dois orçamentos de
// tentativa (abuso num fluxo não deve travar o outro).
model TentativaConfirmacaoEstagio {
  id        String   @id @default(cuid())
  pedidoId  String
  ip        String
  createdAt DateTime @default(now())

  @@index([pedidoId, createdAt])
  @@index([ip, createdAt])
  @@map("tentativas_confirmacao_estagio")
}

// Rate limit da resposta pública ao orçamento (src/app/o/[token]) — mesmo
// padrão de TentativaRespostaArte/TentativaConfirmacaoEstagio, tabela
// própria pra não misturar o orçamento de tentativas dos três fluxos
// públicos por token.
model TentativaRespostaOrcamento {
  id          String   @id @default(cuid())
  orcamentoId String
  ip          String
  createdAt   DateTime @default(now())

  @@index([orcamentoId, createdAt])
  @@index([ip, createdAt])
  @@map("tentativas_resposta_orcamento")
}

enum TipoArquivoArmazenado {
  ARTE_PEDIDO
  ARTE_ORCAMENTO
  LOGO_GRAFICA
  ANALISE_TINTA // reservado pra Cálculo de gasto de tinta com IA
  PLANILHA_IMPORTACAO // reservado pro Importador de planilha com IA (ver ImportacaoPlanilha)
}

enum TipoImportacaoPlanilha {
  CLIENTES
  CATALOGO
  PEDIDOS
}

enum StatusImportacaoPlanilha {
  MAPEANDO // arquivo recebido, aguardando/mostrando sugestão da IA
  CONFIRMADO // usuário confirmou o mapeamento, escrita ainda não começou
  PROCESSANDO // escrita em andamento
  CONCLUIDO // terminou (mesmo com linhas com erro — ver linhasComErro)
  ERRO // falhou antes de terminar (webhook, arquivo expirado etc.)
}

// Um upload de planilha do Importador com IA — serve tanto de registro de
// auditoria/resultado quanto de CONTADOR DE COTA MENSAL (ver
// src/lib/billing/limite-importacao.ts): a linha é criada ao pedir a
// sugestão de mapeamento, ANTES da chamada ao webhook de IA (mesmo
// raciocínio de AnaliseTintaLog — falha de rede depois ainda consome cota,
// porque a plataforma já pagou a chamada). Cota é compartilhada entre os 3
// tipos (contada por graficaId+createdAt do mês corrente, não por tipo).
model ImportacaoPlanilha {
  id        String @id @default(cuid())
  graficaId String
  usuarioId String

  tipo   TipoImportacaoPlanilha
  status StatusImportacaoPlanilha @default(MAPEANDO)

  nomeArquivo     String
  // Pathname no store PRIVADO do Blob — null depois que o arquivo é apagado
  // ao concluir a importação ou expirar sem confirmação (ver
  // expirarImportacoesAbandonadas em src/lib/lifecycle-cron.ts).
  arquivoPathname String?

  linhasTotal      Int
  linhasImportadas Int @default(0)
  linhasComErro    Int @default(0)

  // Sugestão da IA (passo 1) e o que o usuário de fato CONFIRMOU (passo 2) —
  // { "Coluna A": "nome", "Coluna B": "ignorar", ... }, uma entrada por
  // COLUNA da planilha, nunca por linha — cabe folgado num Json.
  mapeamentoSugerido   Json?
  mapeamentoConfirmado Json?

  // Até 50 mensagens de erro por linha ("Linha 12: e-mail inválido") —
  // capado na aplicação, nunca guarda as linhas originais aqui.
  erros Json?

  // Preenchido só quando status=ERRO (falha de webhook, arquivo expirado
  // sem confirmação etc.).
  mensagemErro String?

  createdAt   DateTime  @default(now())
  concluidoEm DateTime?

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  // [graficaId, createdAt]: cota mensal (conta linhas do mês corrente, mesmo
  // padrão de inicioDoMesUTC em billing/uso.ts). [status, createdAt]: cron
  // de expiração de mapeamento abandonado.
  @@index([graficaId, createdAt])
  @@index([status, createdAt])
  @@map("importacoes_planilha")
}

// Razão de TODO arquivo que a gráfica sobe pro Vercel Blob (arte de pedido,
// logo, imagem de análise de tinta) — existe pra sustentar a cota de
// armazenamento por plano (ver src/lib/billing/limite-armazenamento.ts),
// não pra guardar o arquivo em si (isso continua no Blob; aqui só o
// tamanho e a referência). Uma linha por arquivo VIVO: ao substituir uma
// arte/logo, a linha antiga é apagada na mesma operação que confirma a
// nova (ver src/lib/billing/armazenamento.ts), nunca acumula histórico.
//
// url null = reserva pendente (a soma da cota já conta esta linha antes do
// put() no Blob terminar, pra duas escritas concorrentes não furarem o
// limite — ver reservarEspaco). Uma reserva que nunca vira upload de
// verdade (crash entre reservar e subir) é varrida pelo cron de
// reconciliação (src/lib/lifecycle-cron.ts) depois de 1h.
//
// onDelete: Cascade em graficaId apaga as LINHAS quando a Grafica é
// apagada, mas não os blobs — eles viram órfão e são recolhidos pela mesma
// reconciliação (varre o Blob inteiro, não só o razão).
model ArquivoArmazenado {
  id           String                @id @default(cuid())
  graficaId    String
  tipo         TipoArquivoArmazenado
  referenciaId String // pedidoId | graficaId | orcamentoItemId, conforme o tipo
  bytes        Int
  url          String?               @unique
  pathname     String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@index([graficaId])
  @@index([tipo, referenciaId])
  @@map("arquivos_armazenados")
}

// Estimativa de gasto de tinta gerada por IA a partir de uma imagem da arte
// (recurso de plano pago — ver src/lib/billing/recursos-pagos.ts,
// "calculo_tinta_ia" — disparado manualmente pelo usuário). Tabela separada
// da OrcamentoItem pelo mesmo motivo de OrcamentoItemEtiqueta: colunas que
// ficariam nulas na esmagadora maioria dos itens. 1:1 com substituição —
// refazer a análise sobrescreve esta linha e apaga a imagem antiga do Blob,
// mesma semântica de Pedido.arteUrl. Histórico de USO (pra rate limit) vive
// em AnaliseTintaLog, não aqui.
model OrcamentoItemTinta {
  id              String @id @default(cuid())
  orcamentoItemId String @unique

  // Blob PRIVADO (diferente de Pedido.arteUrl, que é público de propósito —
  // esta imagem nunca é vista fora do tenant). pathname guardado à parte
  // pra assinar/apagar sem precisar reparsear a URL.
  imagemUrl      String
  imagemPathname String
  imagemTipo     String

  coberturaPercentual Decimal  @db.Decimal(5, 2)
  coberturaCiano      Decimal? @db.Decimal(5, 2)
  coberturaMagenta    Decimal? @db.Decimal(5, 2)
  coberturaAmarelo    Decimal? @db.Decimal(5, 2)
  coberturaPreto      Decimal? @db.Decimal(5, 2)

  consumoMlPorPeca Decimal @db.Decimal(12, 6)
  consumoMlTotal   Decimal @db.Decimal(12, 3)

  // String, não enum: valor vem de um LLM externo, normalizado na aplicação
  // (ALTA/MEDIA/BAIXA, com MEDIA como fallback) — um enum quebraria se a IA
  // devolvesse um valor inesperado.
  confianca String

  observacao String? @db.Text
  modeloIa   String?

  // Snapshot do que foi analisado — o item é editável em RASCUNHO, e sem
  // isso mudar a quantidade/medida depois transforma consumoMlTotal numa
  // mentira silenciosa (ver aviso de desatualização na UI).
  quantidadeSnapshot Int
  larguraCmSnapshot  Decimal? @db.Decimal(8, 2)
  alturaCmSnapshot   Decimal? @db.Decimal(8, 2)

  criadoPorUsuarioId String
  createdAt          DateTime @default(now())

  orcamentoItem OrcamentoItem @relation(fields: [orcamentoItemId], references: [id], onDelete: Cascade)

  @@map("orcamento_item_tinta")
}

// Log de USO (não de conteúdo) do cálculo de tinta com IA — mesmo padrão de
// PerguntaAssistenteLog, existe só pra sustentar o rate limit (ver
// src/lib/rate-limit-tinta.ts): protege o custo de token/imagem da
// PLATAFORMA contra abuso, já que a IA roda numa conta única, não por tenant.
model AnaliseTintaLog {
  id        String   @id @default(cuid())
  graficaId String
  usuarioId String
  createdAt DateTime @default(now())

  @@index([usuarioId, createdAt])
  @@index([graficaId, createdAt])
  @@map("analise_tinta_log")
}
