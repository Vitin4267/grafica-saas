// Como o Pedido soube da transição de etapa — achado B1/B2 da Parte 2
// (Produção) da auditoria de abrangência. APP é o painel autenticado
// (/producao, lista ou Kanban); LINK_PUBLICO é o e-mail sem login pro
// responsável da etapa (/p/[token]); QR_ETIQUETA é a etiqueta física
// escaneada no chão de fábrica (/q/[token]) — os mesmos 3 canais que já
// chamavam avancarStatusPedido antes desta feature.
enum OrigemConfirmacaoEtapa {
  APP
  LINK_PUBLICO
  QR_ETIQUETA
}

// Um registro por ENTRADA numa etapa de um Pedido (StatusPedido) — o rastro
// que faltava antes desta feature: só existia Pedido.status (o estado
// ATUAL), sem nenhum histórico de quando cada etapa começou/terminou, quem
// confirmou ou em qual máquina rodou. Aberto por avancarStatusPedido dentro
// da MESMA transação do CAS que muda Pedido.status (nunca fora dela — uma
// corrida que confirmasse o status sem abrir/fechar o apontamento junto
// deixaria o histórico inconsistente com o status real) e fechado
// (finalizadoEm) no mesmo instante em que o PRÓXIMO apontamento é aberto.
// Backfill: pedidos que já existiam antes desta migração não ganham
// histórico retroativo (aceitável, ver achado B1) — a linha do tempo
// começa a partir de agora. quantidadeBoa/quantidadeRefugo/motivoRefugo
// (achado B3, 2026-09-07) vieram numa rodada posterior — ver comentário
// nos campos abaixo.
model ApontamentoEtapa {
  id        String @id @default(cuid())
  graficaId String
  pedidoId  String

  status StatusPedido

  iniciadoEm   DateTime  @default(now())
  finalizadoEm DateTime?

  // Quem apontou — sem FK direta pra Usuario (mesmo padrão de
  // MovimentacaoEstoque.criadoPorId): não trava o apontamento se o usuário
  // for removido depois. Só preenchido quando origemConfirmacao=APP.
  operadorId            String?
  // Nome DECLARADO por quem confirmou pelo link público/QR sem login (mesmo
  // padrão de Pedido.arteRespondidaPor) — não verificado, vale como
  // registro. Hoje sempre null na prática: nem /p/[token] nem /q/[token]
  // coletam nome ainda (ver relatório da tarefa B1/B2 — deliberadamente
  // fora de escopo desta rodada, o campo só já nasce pronto pra quando
  // alguém construir essa UI).
  operadorNomeDeclarado String?

  origemConfirmacao OrigemConfirmacaoEtapa

  observacao String?

  // 5 FKs opcionais, mesmo padrão de RegistroManutencao — mas AQUI 0
  // preenchidas também é válido, diferente de lá (validado em app via
  // validarSelecaoMaquinaOpcional, src/lib/manutencao-maquina.ts): nem toda
  // etapa tem máquina associada (ARTE, CONFERENCIA, EMBALAGEM, EXPEDICAO,
  // ENTREGUE não têm "motor" nenhum) e os canais público/QR não coletam
  // essa informação ainda. "Mais de uma preenchida" continua sendo sempre
  // erro. onDelete=SetNull (diferente do Cascade de RegistroManutencao):
  // apagar uma máquina do cadastro não pode apagar o HISTÓRICO de produção
  // que passou por ela.
  prensaId              String?
  maquinaFlexografiaId  String?
  equipamentoId         String?
  impressoraDigitalId   String?
  maquinaSetupPorPecaId String?

  // Achado B3 da Parte 2 (Produção) da auditoria de abrangência
  // (2026-09-07) — refugo de produção reportado MANUALMENTE pelo operador
  // ao ENCERRAR uma etapa (avancarStatusPedido grava estes 4 campos no
  // apontamento que está sendo FECHADO — statusAnterior —, não no que
  // acaba de abrir: o refugo aconteceu DURANTE a etapa que o pedido está
  // SAINDO, ver fecharEAbrirApontamento em src/lib/apontamento-etapa.ts).
  // Distinto da perda de calibragem (ItemGrafica.perdaFixaPadrao +
  // resolverPerdasConfirmadas, achado histórico, só na entrada
  // CLICHE_FACA→PRODUCAO): aquela é um valor FIXO por entrada em produção;
  // esta é VARIÁVEL, opcional, e cabe em qualquer etapa física (PRODUCAO,
  // ACABAMENTO, CONFERENCIA...). Todos null em todo apontamento ANTIGO
  // (migração 100% aditiva) e em qualquer apontamento cujo operador não
  // reportou nada (não é obrigatório preencher).
  quantidadeBoa     Int?
  quantidadeRefugo  Int?
  motivoRefugo      MotivoRefugo?
  // Obrigatório quando motivoRefugo=OUTRO (validado em app via
  // parseRefugoFormData, src/lib/refugo-producao.ts — nunca CHECK no
  // banco, mesmo padrão de todo xxxOutro do sistema).
  motivoRefugoOutro String?

  // Achado Prod-D2 da auditoria de abrangência (Parte 2/Produção,
  // pesquisa-abrangencia-modulos.md, "Não existe retorno de etapa") — este
  // apontamento nasceu de um retornarEtapa (src/app/producao/retorno-etapa-actions.ts),
  // não do avanço normal da FSM. Gravado no apontamento que está sendo
  // ABERTO (diferente de motivoRefugo acima, gravado no que está sendo
  // FECHADO) — o retorno é sobre POR QUE o pedido está entrando de novo
  // nesta etapa, não sobre a etapa que ele acabou de deixar. @default(false)
  // preserva 100% o comportamento de todo apontamento já existente e de todo
  // apontamento aberto pelo avanço normal (fecharEAbrirApontamento só marca
  // true quando o chamador passa o parâmetro `retorno`).
  ehRetrabalho       Boolean        @default(false)
  motivoRetorno      MotivoRetorno?
  // Obrigatório quando motivoRetorno=OUTRO — mesmo padrão de
  // motivoRefugoOutro acima.
  motivoRetornoOutro String?

  createdAt DateTime @default(now())

  grafica             Grafica              @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  pedido              Pedido               @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  prensa              Prensa?              @relation(fields: [prensaId], references: [id], onDelete: SetNull)
  maquinaFlexografia  MaquinaFlexografia?  @relation(fields: [maquinaFlexografiaId], references: [id], onDelete: SetNull)
  equipamento         Equipamento?         @relation(fields: [equipamentoId], references: [id], onDelete: SetNull)
  impressoraDigital   ImpressoraDigital?   @relation(fields: [impressoraDigitalId], references: [id], onDelete: SetNull)
  maquinaSetupPorPeca MaquinaSetupPorPeca? @relation(fields: [maquinaSetupPorPecaId], references: [id], onDelete: SetNull)
  // Achado C2 da auditoria de abrangência (Parte 2/Produção) — lado inverso
  // de ParadaPedido.apontamentoEtapaId (opcional: nem toda parada aponta pra
  // um apontamento específico, ver comentário lá).
  paradas             ParadaPedido[]
  // Achado D1 da auditoria de abrangência (Parte 2/Produção) — lado inverso
  // de AprovacaoProducao.apontamentoEtapaId (opcional: nem toda aprovação
  // consegue se amarrar limpo a UM apontamento específico, ver comentário
  // lá).
  aprovacoesProducao  AprovacaoProducao[]

  @@index([graficaId])
  @@index([pedidoId])
  @@index([prensaId])
  @@index([maquinaFlexografiaId])
  @@index([equipamentoId])
  @@index([impressoraDigitalId])
  @@index([maquinaSetupPorPecaId])
  @@map("apontamentos_etapa")
}

// Achado B3 da auditoria de abrangência (Parte 2/Produção,
// pesquisa-abrangencia-modulos.md, 2026-09-07) — motivo do refugo reportado
// num ApontamentoEtapa.quantidadeRefugo. Fechado + OUTRO, mesmo padrão de
// MotivoParada acima.
//
// MATERIAL_DEFEITUOSO é separado de propósito: é o ÚNICO motivo cujo custo é
// potencialmente recuperável do fornecedor (reclamação/estorno junto a
// Fornecedor/SolicitacaoCompra — fluxo de reclamação em si fica fora de
// escopo por ora). Por isso, quando o motivo é este, a baixa OPCIONAL de
// matéria-prima (ver aplicarBaixaRefugo em src/app/producao/status-
// transicao.ts) ainda cria a MovimentacaoEstoque normalmente — o material
// saiu fisicamente do estoque, isso é fato — mas NUNCA gera o CustoPedido
// automático que os outros motivos geram: até a gráfica resolver a
// reclamação com o fornecedor, esse custo não é necessariamente definitivo
// dela, e um CustoPedido automático inflaria o custo/lucro do pedido com
// algo que pode vir a ser ressarcido. A gráfica pode lançar manualmente
// depois se a reclamação não prosperar (lancarCustoPedido, já existente).
enum MotivoRefugo {
  ACERTO_MAQUINA // calibragem — mesmo caso que perdaFixaPadrao já cobre, disponível aqui também pra quem prefere reportar tudo no apontamento
  ERRO_REGISTRO_COR
  FALHA_IMPRESSAO // borrão, falha de tinta, riscos
  ERRO_CORTE_REFILE
  FALHA_ACABAMENTO // laminação bolhada, dobra torta, cola
  MATERIAL_DEFEITUOSO // culpa do fornecedor — ver comentário acima
  ERRO_ARTE_ARQUIVO
  ERRO_OPERACIONAL
  OUTRO
}

// Achado Prod-D2 da auditoria de abrangência (Parte 2/Produção,
// pesquisa-abrangencia-modulos.md, "Não existe retorno de etapa: reprovado
// só pode ser CANCELADO") — motivo do retorno de um Pedido pra uma etapa
// ANTERIOR na sequência (retrabalho), registrado por retornarEtapa
// (src/app/producao/retorno-etapa-actions.ts). Fechado + OUTRO, mesmo
// padrão de MotivoRefugo/MotivoParada acima. Distinto de MotivoRefugo: este
// é sobre por que o PEDIDO INTEIRO volta pra trás na FSM (decisão de quem
// administra a produção), não sobre material refugado numa etapa
// específica.
enum MotivoRetorno {
  REPROVADO_QUALIDADE
  ERRO_ARTE
  MUDANCA_PEDIDO_CLIENTE
  FALTA_MATERIAL
  ERRO_OPERACIONAL
  OUTRO
}

// FSM linear completa do Pedido (visão de produto 2026-08-21): Arte →
// Clichê/Faca → Produção → Acabamento → Conferência → Embalagem → Expedição
// → Entregue — os dois estágios anteriores (Orçamento/Aprovado) são
// StatusOrcamento, não entram aqui, porque um Pedido só nasce quando o
// Orçamento já está Aprovado. Expandido de 5 pros 8 estágios abaixo (mais
// CANCELADO) na migration 20260821230000_expande_status_pedido_10_etapas via
// ALTER TYPE RENAME VALUE (não recriação do enum): FILA→ARTE,
// IMPRESSAO→PRODUCAO, PRONTO→EXPEDICAO preservam o dado de pedidos
// existentes automaticamente; CLICHE_FACA/CONFERENCIA/EMBALAGEM são
// estágios novos, sem pedido nenhum neles até que algum avance até lá pela
// primeira vez. Ver SEQUENCIA_STATUS_PEDIDO em src/lib/producao-estagios.ts
// pra ordem canônica (a ordem de declaração aqui só espelha ela, não é a
// fonte de verdade — a aplicação nunca depende de ordem de enum do Postgres).
enum StatusPedido {
  ARTE
  CLICHE_FACA
  PRODUCAO
  ACABAMENTO
  CONFERENCIA
  EMBALAGEM
  EXPEDICAO
  ENTREGUE
  // Terminal, assim como ENTREGUE — mas ao contrário dela, cancelar um
  // pedido que já passou por Clichê/Faca→Produção estorna automaticamente a
  // matéria-prima baixada (ver cancelarPedido em src/app/producao/actions.ts).
  // Alcançável a partir de qualquer estágio ANTES de ENTREGUE — nunca de
  // ENTREGUE (produto já saiu, cancelar não desfaz uma entrega física).
  CANCELADO
}

// Pedido nasce quando um Orcamento é aprovado: acompanha a produção física.
model Pedido {
  id          String       @id @default(cuid())
  graficaId   String
  orcamentoId String       @unique
  status      StatusPedido @default(ARTE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Data pura (meia-noite UTC, mesmo padrão de Despesa.vencimento — ver
  // src/lib/data.ts), definida na aprovação do orçamento. Opcional: nem todo
  // pedido tem prazo prometido, e sem prazo nunca gera alerta de atraso.
  prazoEntrega          DateTime?
  // Dedup do evento pedido_atrasado (webhook-automacao.ts): uma vez enviado
  // o alerta pra este pedido, nunca reenviar — evita spam a cada
  // carregamento de /producao enquanto o pedido continua atrasado. Canal
  // separado do campo abaixo: este dispara pro webhook de AUTOMAÇÃO da
  // própria gráfica (n8n), só depois do prazo já vencido.
  alertaAtrasoEnviadoEm DateTime?

  // Limiar mais urgente (5, 3 ou 0 dias até o prazo) já avisado por E-MAIL
  // ao vendedor do orçamento + DONO da gráfica (ver
  // src/lib/alerta-prazo-email.ts, rodando no cron diário). Cascata que só
  // anda pra frente — 5 → 3 → 0 — nunca reenvia um limiar já ultrapassado,
  // mas pula direto pro mais urgente ainda não avisado se o cron perder um
  // dia (ex: de "não avisado" direto pra 0 se o pedido já venceu no
  // primeiro run). Null = nenhum alerta de prazo ainda enviado por e-mail.
  alertaPrazoUltimoLimiarDias Int?

  // Aprovação de arte: opt-in por pedido — se a gráfica nunca envia uma
  // arte (arteUrl null), o pedido avança normalmente sem nenhum gate. Uma
  // vez enviada, avancarPedido bloqueia a saída de FILA até arteAprovadaEm
  // ser preenchido (ver src/app/producao/actions.ts). arteLinkToken é
  // gerado sob demanda (mesmo padrão de Orcamento.linkPublicoToken) e
  // reaproveitado entre reenvios do mesmo pedido — só o token muda de
  // "significado" (aprovado/pendente), nunca de valor, então o link que a
  // gráfica já mandou pro cliente continua válido após um reenvio.
  arteUrl               String?
  arteAprovadaEm        DateTime?
  arteComentarioCliente String?
  arteLinkToken         String?   @unique
  // Mesmo campo/formato de Orcamento.preflightAvisos (ver comentário lá) —
  // quando a arte do orçamento é copiada pro Pedido na aprovação, os
  // achados de preflight são copiados junto (não recalculados, é o mesmo
  // arquivo); um reenvio de arte na Produção recalcula do zero.
  preflightAvisos       Json?
  // Nome DECLARADO por quem respondeu pelo link público — não é verificado
  // (quem tem o link digita o que quiser), vale como registro, igual a uma
  // assinatura em formulário de papel. Nunca escrever "confirmado por" na
  // tela a partir disto, só "aprovado por". Mesmo par existe em Orcamento
  // (respostaPublicaNome/Em) pro aceite do orçamento.
  arteRespondidaPor     String?

  // Link público evergreen: "confirmar a etapa atual deste pedido", sem
  // login (ver ResponsavelEstagio e src/app/p/[token]). Gerado na criação
  // do Pedido e NUNCA rotacionado — como o status é um FSM estritamente
  // linear e só existe uma etapa viva por vez, o token não precisa saber
  // "qual" etapa confirma, só lê o status atual. Deixa de fazer sentido
  // quando o pedido chega em ENTREGUE/CANCELADO (terminal) — a página trata
  // isso como "nada pra confirmar agora", não como link inválido.
  producaoLinkToken String? @unique

  // QR físico colado no produto, pra atualizar status direto do chão de
  // fábrica sem voltar ao desktop (ver src/app/q/[token]). Mesmo princípio
  // de producaoLinkToken (token evergreen, "credencial" = posse do token),
  // mas token PRÓPRIO e deliberadamente mais permissivo: só existe depois
  // que um usuário autenticado da gráfica baixa a etiqueta pela primeira vez
  // (gerado inline em src/app/producao/[pedidoId]/etiqueta/route.tsx — nunca
  // em massa na criação do Pedido, só sob demanda), e a tela /q/[token]
  // (src/app/q/[token]/actions.ts) não aplica rate limit nem a checagem de
  // "etapaEsperada" que producaoLinkToken tem (ver confirmarEstagioPublico)
  // — a etiqueta impressa circula só
  // fisicamente dentro da própria gráfica, ao contrário do link por e-mail
  // que pode ficar aberto numa aba esquecida por dias. Mesma restrição de
  // ESTAGIOS_ATRIBUIVEIS continua valendo (nunca avança a partir de FILA por
  // aqui — essa transição baixa estoque e exige a tela de confirmação de
  // perda de material, que não existe nesta versão mobile).
  qrToken String? @unique

  // Data da aprovação do orçamento (autenticada ou pelo link público) — até
  // esta fase, o dashboard somava faturamento por createdAt do orçamento
  // porque este campo não existia. Também é o gatilho que congela
  // PedidoCustoPrevisto e os três snapshots abaixo (ver fase-custo-real.md §1.2, §3.1).
  aprovadoEm DateTime?

  // Snapshots tirados no momento de aprovadoEm — nunca recalculados depois,
  // mesmo que o motor de precificação ou o preço de matéria-prima mudem.
  precoSugeridoTotal  Decimal? @db.Decimal(12, 2)
  valorNegociadoTotal Decimal? @db.Decimal(12, 2)
  custoPrevistoTotal  Decimal? @db.Decimal(12, 2)

  // Fechamento é ato explícito (tela /pedidos/{id}/fechamento), não
  // automático ao entrar em Entregue — custo atrasado (frete que chega na
  // semana seguinte) é regra, não exceção. Reabrir exige permissão
  // custosVerLucro e gera auditoria.
  fechadoEm    DateTime?
  fechadoPorId String?

  // Achado C1 da Parte 2 (Produção) da auditoria de abrangência
  // (pesquisa-abrangencia-modulos.md, 2026-09-07): quanto MAIOR, mais
  // prioritário — ordena o Kanban (prioridade desc, prazoEntrega asc,
  // createdAt asc, ver compararPrioridadePedido em
  // src/lib/prioridade-pedido.ts) junto com as demais colunas que decidem a
  // fila hoje. @default(0) = "Normal" (ver NIVEIS_PRIORIDADE_PEDIDO no
  // mesmo arquivo) — TODO pedido existente nasce com este valor, então a
  // ordenação atual (por prazo/data) não muda pra ninguém até alguém de
  // fato marcar um pedido como Baixa/Alta/Urgente. Editado pela Server
  // Action alterarPrioridadePedido (src/app/producao/actions.ts), validada
  // contra os 4 valores fixos — nunca um número livre vindo do form.
  prioridade Int @default(0)

  // Achado Prod-D2 da auditoria de abrangência (Parte 2/Produção,
  // pesquisa-abrangencia-modulos.md, "Não existe retorno de etapa") — trava
  // contra baixa DUPLICADA de matéria-prima. O bloco de baixa automática em
  // avancarStatusPedido (src/app/producao/status-transicao.ts, branch
  // `proximoStatus === "PRODUCAO"`) só verificava o DESTINO da transição, não
  // se o pedido já tinha passado por ali antes — sem esta trava, um pedido
  // que RETORNA de etapa (retornarEtapa, ver enum MotivoRetorno acima) e
  // reentra em PRODUCAO pela sequência normal seria descontado uma SEGUNDA
  // vez pelo MESMO material já consumido na primeira passagem (o material
  // físico já saiu do estoque; retrabalho consome MAIS, não de novo do
  // zero). Setado UMA ÚNICA VEZ, junto com o CAS que muda status pra
  // PRODUCAO na PRIMEIRA vez — nunca tocado por retornarEtapa (que muda
  // status livremente sem mexer neste campo) nem por nenhuma passagem
  // seguinte por PRODUCAO. null = "ainda não baixou" (todo pedido nasce
  // assim; o gate roda normalmente).
  //
  // BACKFILL (migration 20260912__retorno_etapa_producao, aditiva): todo
  // Pedido cujo status atual já está numa etapa POSTERIOR a PRODUCAO na
  // sequência canônica (ACABAMENTO/CONFERENCIA/EMBALAGEM/EXPEDICAO/ENTREGUE)
  // OU que já tem QUALQUER MovimentacaoEstoque tipo SAIDA_PRODUCAO vinculada
  // (cobre também CANCELADO que chegou a entrar em produção antes de ser
  // cancelado, e um pedido hoje parado exatamente EM PRODUCAO com material de
  // verdade já baixado) nasceu com este campo já preenchido — com o
  // createdAt da PRIMEIRA SAIDA_PRODUCAO daquele pedido quando existe (fonte
  // mais precisa: é o instante real da baixa), ou Pedido.updatedAt como
  // aproximação documentada quando não há nenhuma SAIDA_PRODUCAO pra amarrar
  // (caso residual: pedido chegou a uma etapa pós-PRODUCAO sem nenhum
  // material com ficha técnica pra descontar — nada a proteger de verdade
  // nesse caso, mas o campo nasce preenchido por consistência/segurança). Sem
  // este backfill, TODO pedido histórico que um dia passasse por
  // retornarEtapa e reentrasse em PRODUCAO ficaria vulnerável à baixa dupla —
  // a trava só protege pedido NOVO se o campo não nascer retroativamente
  // preenchido pros que já passaram por produção antes desta migration.
  baixaEstoqueRealizadaEm DateTime?

  grafica   Grafica   @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id])

  movimentacoes       MovimentacaoEstoque[]
  custos              CustoPedido[]
  custosPrevisto      PedidoCustoPrevisto[]
  // Achado B1/B2 da Parte 2 (Produção) — histórico de transição de etapa,
  // ver ApontamentoEtapa.
  apontamentos        ApontamentoEtapa[]
  entrega             Entrega?
  filaGangRun         FilaGangRun[]
  // Lado inverso de SolicitacaoCompra.pedidoId — compras feitas
  // especificamente pra este pedido (origem=PEDIDO_ESPECIFICO, achado A3 da
  // auditoria de abrangência, Parte 3/Compras).
  solicitacoesCompra  SolicitacaoCompra[]
  // Achado E1 da auditoria de abrangência (Parte 2/Produção) — etapas deste
  // pedido enviadas pra terceirização (laminação, UV, acabamento de livro
  // etc.), ver model EtapaTerceirizada.
  etapasTerceirizadas EtapaTerceirizada[]
  // Achado C2 da auditoria de abrangência (Parte 2/Produção) — intervalos em
  // que este pedido ficou PARADO (aguardando material, aprovação do
  // cliente, etc.), ver model ParadaPedido.
  paradas             ParadaPedido[]
  // Achado F5 da auditoria de abrangência (Parte 7) — arte por item deste
  // pedido, ver comentário completo no model ArteItem
  // (prisma/schema/09-orcamento.prisma). [] pra TODO pedido que nunca usou
  // arte por item (opt-in) — comportamento de sempre, sem migração nenhuma.
  arteItens           ArteItem[]
  // Achado Fin-A1 da Parte 4 da auditoria de abrangência (2026-09-11) — lado
  // inverso de Despesa.pedidoId (vínculo opcional "essa despesa é sobre ESTE
  // pedido", ver comentário completo no model Despesa,
  // prisma/schema/11-financeiro.prisma). [] pra TODO pedido que nunca teve
  // uma despesa vinculada — comportamento de sempre, sem migração de dado.
  despesas            Despesa[]
  // Achado D1 da auditoria de abrangência (Parte 2/Produção) — aprovações
  // de qualidade registradas DENTRO da produção (OK de máquina, inspeção,
  // prova de contrato...), ver model AprovacaoProducao. [] pra TODO pedido
  // de gráfica que nunca ligou EtapaGrafica.exigeAprovacaoQualidade em
  // nenhuma etapa (comportamento padrão, opt-in) ou que simplesmente nunca
  // teve uma aprovação registrada manualmente.
  aprovacoesProducao  AprovacaoProducao[]

  @@index([graficaId])
  @@map("pedidos")
}

// Achado C2 da auditoria de abrangência (Parte 2/Produção,
// pesquisa-abrangencia-modulos.md, 2026-09-01): um job travado esperando
// papel chegar, ou esperando o cliente responder uma dúvida, era
// indistinguível de um job sendo produzido de verdade — ambos apareciam
// simplesmente como o StatusPedido atual (ex: PRODUCAO), o que envenena
// qualquer métrica de lead time e faz o alerta de atraso
// (Pedido.alertaAtrasoEnviadoEm/alertaPrazoUltimoLimiarDias) culpar a
// produção por uma espera que não é dela. RegistroManutencao cobre "a
// MÁQUINA parou"; nada cobria "o PEDIDO parou" (por um motivo que pode nem
// envolver máquina nenhuma, ex: aguardando o cliente responder).
enum MotivoParada {
  AGUARDANDO_MATERIAL
  AGUARDANDO_APROVACAO_CLIENTE
  AGUARDANDO_ARTE_CLIENTE
  MAQUINA_PARADA
  AGUARDANDO_TERCEIRO
  FALTA_OPERADOR
  OUTRO
}

// Um intervalo em que um Pedido ficou parado — nasce em iniciadaEm, fecha em
// finalizadaEm (null = ainda ATIVA/em andamento agora). Deliberadamente NÃO
// muda StatusPedido nem interfere na FSM de produção (achado B1/B2): o
// pedido continua "oficialmente" no mesmo status enquanto parado, só ganha
// este registro paralelo — um pedido em PRODUCAO parado por falta de
// material continua um ApontamentoEtapa aberto em PRODUCAO, e GANHA também
// uma ParadaPedido aberta ao mesmo tempo.
//
// Regra "no máximo 1 parada ATIVA por pedido" (enunciado do achado): impo-
// sta em DOIS níveis — a Server Action (iniciarParadaPedido, ver
// src/app/producao/parada-actions.ts) checa antes de criar, e o banco
// garante de verdade com um índice único PARCIAL escrito à mão na migration
// (`CREATE UNIQUE INDEX ... ON "paradas_pedido" ("pedidoId") WHERE
// "finalizadaEm" IS NULL` — Prisma declarativo não tem sintaxe pra WHERE em
// @@unique/@@index, então este índice existe no banco mas não tem
// representação aqui embaixo; qualquer migration futura escrita à mão
// precisa preservá-lo).
model ParadaPedido {
  id        String @id @default(cuid())
  graficaId String
  pedidoId  String

  // Etapa (ApontamentoEtapa) ABERTA no momento em que a parada começou —
  // resolvida automaticamente pela action (não escolhida pelo usuário no
  // formulário), opcional porque pedidos criados antes do achado B1/B2 (sem
  // backfill retroativo) podem não ter nenhum apontamento aberto. SetNull:
  // apagar o histórico de apontamento (hoje sem fluxo de exclusão) nunca
  // apaga o registro da parada, só perde essa referência cruzada.
  apontamentoEtapaId String?

  motivo      MotivoParada
  // Texto livre só usado quando motivo=OUTRO — mesmo padrão de
  // origemOutro em SolicitacaoCompra/Grafica.segmentoOutro.
  motivoOutro String?

  // Achado C2 (proposta original): AGUARDANDO_MATERIAL pode apontar pra a
  // SolicitacaoCompra que o pedido está esperando — "esse pedido está
  // parado por causa dessa compra" é a resposta que o dono da gráfica mais
  // quer. Opcional mesmo quando motivo=AGUARDANDO_MATERIAL (a gráfica pode
  // não ter formalizado a compra no sistema ainda) e sem restrição de
  // motivo em nível de banco/aplicação — nada impede vincular uma compra a
  // qualquer motivo, a UI só oferece o campo quando motivo=AGUARDANDO_MATERIAL
  // por ser o caso de uso natural. SetNull: cancelar/apagar a solicitação
  // nunca apaga o histórico da parada.
  solicitacaoCompraId String?

  iniciadaEm   DateTime  @default(now())
  finalizadaEm DateTime?

  // Observação livre — motivo detalhado, ou nota de quando/como a parada foi
  // resolvida (preenchível tanto ao iniciar quanto ao finalizar).
  observacao String?

  criadoPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica           Grafica            @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  pedido            Pedido             @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  apontamentoEtapa  ApontamentoEtapa?  @relation(fields: [apontamentoEtapaId], references: [id], onDelete: SetNull)
  solicitacaoCompra SolicitacaoCompra? @relation(fields: [solicitacaoCompraId], references: [id], onDelete: SetNull)

  @@index([graficaId])
  @@index([pedidoId])
  @@index([apontamentoEtapaId])
  @@index([solicitacaoCompraId])
  // Acelera "existe parada ativa pra este pedido?" (a garantia de
  // exclusividade em si é o índice único parcial da migration, ver
  // comentário grande acima do model).
  @@index([pedidoId, finalizadaEm])
  @@map("paradas_pedido")
}

// Achado A1 da auditoria de abrangência (Parte 2/Produção, pesquisa-
// abrangencia-modulos.md, 2026-09-01), Fase 1 (barata): liga/desliga e
// renomeia, por tenant, cada um dos 8 estágios de StatusPedido que fazem
// parte de SEQUENCIA_STATUS_PEDIDO (CANCELADO fica de fora — é terminal,
// alcançável de qualquer estágio, nunca parte do caminho linear). Bootstrap
// lazy na primeira leitura (ver garantirEtapasGraficaPadrao em
// src/lib/etapa-grafica.ts), mesmo padrão de garantirCategoriasCustoPadrao
// em src/lib/custo-pedido.ts: as 8 linhas só são criadas quando uma gráfica
// realmente precisa, todas ativa=true/rotulo=null/ordem=posição atual — uma
// gráfica que nunca abriu esta tela se comporta EXATAMENTE como antes desta
// feature (resolverSequencia cai no array literal quando não há linha
// nenhuma, ver mesmo arquivo).
//
// ativa=false remove o status da sequência que avancarStatusPedido usa pra
// decidir "qual é o próximo válido" — pula direto pro próximo ativo.
// ARTE/PRODUCAO/ENTREGUE NUNCA podem ficar ativa=false (ver
// ETAPAS_SEMPRE_ATIVAS em src/lib/etapa-grafica.ts, validado nas actions
// desta tela, não só na UI): ARTE é o status @default(ARTE) de todo Pedido
// novo (desligá-lo quebraria a criação de pedido); PRODUCAO é a etapa de
// destino cuja ENTRADA dispara a baixa de estoque automática (ver
// status-transicao.ts) — sem ela sempre presente e sempre alcançável, a
// baixa de estoque poderia nunca disparar; ENTREGUE é o status terminal que
// vários outros pontos do código conferem literalmente (alertas de atraso,
// filtro de "pedidos finalizados") — desligá-lo faria um pedido desta
// gráfica nunca alcançar esse status de verdade.
//
// rotulo=null usa o rótulo padrão do sistema (ROTULOS_STATUS_PEDIDO); um
// valor customizado aparece no Kanban, na lista de produção, no e-mail ao
// responsável de etapa e nas telas públicas (/p/[token], /q/[token]) no
// lugar do padrão — ex: serigrafia renomeia CLICHE_FACA pra "Queima de
// tela", comunicação visual renomeia EXPEDICAO pra "Instalação".
model EtapaGrafica {
  id        String       @id @default(cuid())
  graficaId String
  status    StatusPedido
  ativa     Boolean      @default(true)
  rotulo    String?
  ordem     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Achado D1 da auditoria de abrangência (Parte 2/Produção,
  // pesquisa-abrangencia-modulos.md, 2026-09-11) — gate opt-in, MESMO
  // formato/espírito dos dois gates de arte que já existem em
  // avancarStatusPedido (src/app/producao/status-transicao.ts): "só bloqueia
  // quem usa a feature". Quando true, avancarStatusPedido passa a exigir
  // pelo menos uma AprovacaoProducao com resultado APROVADO/
  // APROVADO_COM_RESSALVA pra este pedido antes de deixar SAIR deste
  // status. @default(false) em TODAS as linhas (bootstrap e migração) —
  // uma gráfica que nunca abre esta opção continua 100% igual a hoje.
  //
  // Deliberadamente NÃO amarrado a um model de "fluxo configurável" (a
  // proposta original do achado D1 falava em EtapaFluxo.exigeAprovacaoQualidade,
  // que dependeria de uma Fase 2 estrutural do achado A1 nunca construída) —
  // EtapaGrafica já dá a granularidade certa (uma linha por etapa/status de
  // cada gráfica), ver correção registrada no relatório desta rodada.
  exigeAprovacaoQualidade Boolean @default(false)

  grafica Grafica @relation(fields: [graficaId], references: [id], onDelete: Cascade)

  @@unique([graficaId, status])
  @@index([graficaId])
  @@map("etapas_grafica")
}

// Achado D1 da auditoria de abrangência (Parte 2/Produção,
// pesquisa-abrangencia-modulos.md, 2026-09-11) — hoje existe aprovação de
// ARTE (Pedido.arteUrl/arteAprovadaEm/arteLinkToken, voltada ao CLIENTE,
// pré-produção — gate em status === "ARTE") mas nada DENTRO da produção:
// nenhum "aprovar a primeira folha antes de rodar as outras 20 mil"
// (prática padrão de mercado — após ajustes de máquina, roda-se uma
// impressão de teste; só depois da aprovação desse teste a máquina roda em
// grande quantidade), nenhuma inspeção final registrada, nenhuma foto de
// conferência. A etapa CONFERENCIA existia só como nome de coluna no
// Kanban, sem guardar nenhum dado de conferência — este model é esse dado.
//
// ESCOPO DELIBERADAMENTE REDUZIDO nesta rodada: os 5 tipos abaixo são
// registrados INTERNAMENTE, por um usuário do sistema — nunca pelo
// cliente. AMOSTRA_CLIENTE (BAT/boneco físico aprovado pelo CLIENTE via
// link público, reaproveitando o padrão /a/[token] que a aprovação de arte
// já tem) fica FORA de escopo: é uma superfície pública NOVA (token, rota,
// e-mail) que multiplica o raio de teste/segurança por pouco ganho
// imediato — o gate interno já resolve a parte que mais dói ("não deixar
// rodar 20 mil folhas sem alguém aprovar a primeira"). O valor de enum fica
// cadastrado (não custa nada, evita migration futura só pra isso), mas sem
// nenhuma tela pública nem link/token construído pra ele — se alguém
// registrar um AMOSTRA_CLIENTE hoje, é só um registro interno igual aos
// outros, sem fluxo de cliente nenhum por trás.
enum TipoAprovacaoProducao {
  OK_MAQUINA // primeira folha/peça, aprovação interna — o caso de uso central deste achado
  PROVA_CONTRATO // prova digital calibrada aprovada pelo cliente — registrada aqui internamente nesta rodada (sem fluxo público próprio)
  AMOSTRA_CLIENTE // BAT/boneco físico — fluxo público/token FORA DE ESCOPO nesta rodada, ver comentário acima
  INSPECAO_PROCESSO
  INSPECAO_FINAL
  OUTRO
}

enum ResultadoAprovacao {
  APROVADO
  APROVADO_COM_RESSALVA
  REPROVADO
}

// Um registro de aprovação/inspeção de qualidade DENTRO da produção — não
// confundir com a aprovação de ARTE (pré-produção, cliente, ver
// Pedido.arteUrl acima). O gate opt-in em avancarStatusPedido (ver
// EtapaGrafica.exigeAprovacaoQualidade) exige pelo menos um registro
// aqui com resultado APROVADO/APROVADO_COM_RESSALVA antes de sair da
// etapa marcada — REPROVADO nunca libera a transição.
model AprovacaoProducao {
  id        String @id @default(cuid())
  graficaId String
  pedidoId  String

  // Qual passagem pela etapa gerou esta aprovação, quando dá pra amarrar
  // limpo — resolvido pela action como "o ApontamentoEtapa ABERTO
  // (finalizadoEm null) do pedido no momento do registro", mesmo critério
  // já usado por ParadaPedido.apontamentoEtapaId. Opcional: pedidos sem
  // nenhum apontamento aberto (raro, ex: dado legado) ainda podem registrar
  // aprovação vinculada só por pedidoId — decisão de escopo desta rodada
  // (documentada no relatório), o gate em avancarStatusPedido sempre
  // valida por pedidoId + status atual, nunca exige o vínculo fino.
  apontamentoEtapaId String?

  tipo      TipoAprovacaoProducao
  // Obrigatório quando tipo=OUTRO — validado em app (nunca CHECK no banco),
  // mesmo padrão de todo xxxOutro do sistema (ex: MotivoRefugoOutro acima).
  tipoOutro String?

  resultado ResultadoAprovacao

  // Usuario que registrou, quando é um usuário cadastrado logado — SetNull
  // preserva o histórico se o usuário for removido depois.
  aprovadoPorId String?
  // Snapshot de nome quando NÃO é um Usuario cadastrado que registrou (ex:
  // operador do chão de fábrica sem login próprio no sistema) — não
  // verificado, vale como registro. Mesmo padrão de
  // ApontamentoEtapa.operadorNomeDeclarado.
  aprovadoPorNomeDeclarado String?

  // Foto opcional da folha/peça aprovada, reaproveitando ArquivoArmazenado
  // (razão de armazenamento/cota já usado por arte e logo — ver
  // src/lib/billing/armazenamento.ts). referenciaId da linha em
  // ArquivoArmazenado correspondente é O ID DESTA AprovacaoProducao (não o
  // pedidoId) — ver comentário em TipoArquivoArmazenado.FOTO_APROVACAO_PRODUCAO
  // pro motivo.
  arquivoId String?

  observacao String?

  createdAt DateTime @default(now())

  grafica          Grafica            @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  pedido           Pedido             @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  apontamentoEtapa ApontamentoEtapa?  @relation(fields: [apontamentoEtapaId], references: [id], onDelete: SetNull)
  aprovadoPor      Usuario?           @relation(fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  arquivo          ArquivoArmazenado? @relation(fields: [arquivoId], references: [id], onDelete: SetNull)

  @@index([graficaId, pedidoId])
  @@index([apontamentoEtapaId])
  @@index([aprovadoPorId])
  @@index([arquivoId])
  @@map("aprovacoes_producao")
}

enum StatusEntrega {
  AGUARDANDO
  EM_TRANSITO
  ENTREGUE
  // Estado lateral, alcançável a partir de qualquer status ATIVO
  // (AGUARDANDO ou EM_TRANSITO) — nunca terminal: a tela permite resolver o
  // problema e voltar pro fluxo normal (ver TRANSICOES_VALIDAS em
  // src/lib/entrega-status.ts).
  PROBLEMA
}

// Status ESTRUTURADO da entrega física de um pedido — substitui o texto
// livre que hoje só existe em Orcamento.frete/transportadora/localEntrega
// (preenchido uma vez na aprovação do orçamento, nunca mais atualizado).
// 1:1 com Pedido (não com Orcamento): entrega só faz sentido depois que a
// produção física começou — ver ESTAGIOS_PRE_PRODUCAO em
// src/lib/producao-estagios.ts (Arte/Clichê-Faca ainda não têm nada físico
// pra rastrear). Não confundir com StatusPedido.ENTREGUE (que marca a
// PRODUÇÃO como concluída e fora da fila) — este model é o rastreamento
// OPERACIONAL da entrega em si (motorista, quando saiu, quando chegou),
// independente e mais granular.
model Entrega {
  id        String        @id @default(cuid())
  graficaId String
  pedidoId  String        @unique
  status    StatusEntrega @default(AGUARDANDO)

  // Texto livre, não cadastro relacional — mesmo princípio de
  // Despesa.categoria: motorista de entrega (motoboy da Lalamove, alguém da
  // equipe) não repete o bastante numa gráfica rápida pra justificar uma
  // tabela própria.
  motorista String?

  // Achado D1 da auditoria de abrangência (Parte 4/Qualidade-pessoas) —
  // vínculo INFORMATIVO opcional com um Colaborador cadastrado
  // (03-usuarios-auth.prisma, tipo=MOTORISTA), ADITIVO ao texto livre acima
  // (mesmo padrão de FK-opcional-lado-a-lado-do-texto usado em
  // contatoClienteId/transportadoraId/condicaoPagamentoId): escolher aqui só
  // PRÉ-PREENCHE `motorista`, que continua existindo, editável e sendo o que
  // de fato é lido em qualquer tela/PDF — nunca a FK direto (protege contra
  // edição/desativação posterior do cadastro). Criar/editar uma entrega sem
  // escolher colaborador continua funcionando exatamente como antes. SetNull
  // (não Restrict): desativar/remover o colaborador não pode travar a
  // entrega nem apagar o snapshot de texto já preenchido.
  motoristaColaboradorId String?

  dataSaida   DateTime?
  dataEntrega DateTime?

  // Detalhe do problema (quando status === PROBLEMA) ou qualquer observação
  // livre sobre a entrega — nunca obrigatório no schema, mas a tela exige
  // preenchido antes de mandar pra PROBLEMA (ver EntregaPedidoSecao.tsx).
  observacoes String?

  // Achado F3 da auditoria de abrangência (Parte 7/Documento e transação) —
  // dados de transporte físico, todos opcionais (schema-only nesta rodada,
  // sem UI própria ainda em EntregaPedidoSecao.tsx — ver
  // pesquisa-abrangencia-modulos.md). transportadoraId é um vínculo
  // INFORMATIVO separado de Orcamento.transportadoraId (a mesma
  // transportadora pode ser escolhida nos dois lugares, mas nada aqui é
  // copiado automaticamente de lá) — SetNull, mesmo raciocínio de
  // Orcamento.transportadoraId. especieVolume é texto livre de propósito
  // (ex: "caixa", "rolo", "pallet") — sem repertório fechado validado ainda,
  // mesmo princípio de Entrega.motorista acima (config prematura).
  transportadoraId String?
  volumes          Int?
  pesoBrutoKg      Decimal? @db.Decimal(10, 3)
  especieVolume    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica              Grafica         @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  pedido               Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  transportadora       Transportadora? @relation(fields: [transportadoraId], references: [id], onDelete: SetNull)
  motoristaColaborador Colaborador?    @relation("EntregaMotoristaColaborador", fields: [motoristaColaboradorId], references: [id], onDelete: SetNull)

  @@index([graficaId])
  @@index([transportadoraId])
  @@index([motoristaColaboradorId])
  @@map("entregas")
}

// Achado E1 da auditoria de abrangência (Parte 2/Produção,
// pesquisa-abrangencia-modulos.md, 2026-09-01): nada no schema modelava um
// pedido que sai FISICAMENTE da gráfica pra uma operação terceirizada
// (laminação, UV, acabamento de livro etc.) e volta depois — o card ficava
// parado numa etapa (geralmente ACABAMENTO) por dias sem ninguém saber se é
// lentidão interna ou se está no terceiro, e o custo do terceiro só entrava
// como CustoPedido origem=MANUAL, sem prazo, sem fornecedor vinculado, sem
// alerta. Forma fiscal correspondente no Brasil: remessa para
// industrialização por encomenda (CFOP 5901/6901), retorno (5902/6902) —
// notaRemessa/notaRetorno abaixo guardam só o Nº da nota, mesmo papel de
// SolicitacaoCompra.documento (não emitem nota, só registram).
enum SituacaoTerceirizacao {
  AGUARDANDO_ENVIO
  ENVIADO
  RETORNADO
  PROBLEMA
}

model EtapaTerceirizada {
  id        String @id @default(cuid())
  graficaId String
  pedidoId  String

  // Etapa do PEDIDO em que a terceirização aconteceu (ex: ACABAMENTO) —
  // congelado no momento da criação deste registro, nunca acompanha se o
  // Pedido avançar de status depois (mesmo princípio de
  // ApontamentoEtapa.status).
  status StatusPedido

  // Fornecedor formal (Fornecedor já existe no schema, usado por
  // SolicitacaoCompra) OU nome livre pra terceiro não cadastrado — mesmo par
  // estruturado/escape já usado em vários textos livres do schema (ex:
  // Despesa.categoria). Validado na action pra nunca nascer com os dois
  // vazios ao mesmo tempo (não é constraint de banco).
  fornecedorId   String?
  fornecedorNome String?

  situacao SituacaoTerceirizacao @default(AGUARDANDO_ENVIO)

  enviadoEm       DateTime?
  // Data pura (meia-noite UTC), mesmo padrão de Pedido.prazoEntrega — ver
  // src/lib/data.ts.
  previsaoRetorno DateTime?
  retornadoEm     DateTime?

  valorAcordado Decimal? @db.Decimal(10, 2)
  valorFinal    Decimal? @db.Decimal(10, 2)

  // CFOP 5901/6901 (remessa) e 5902/6902 (retorno) — só o Nº da nota, mesmo
  // papel informativo de SolicitacaoCompra.documento. Continuam existindo
  // INTACTOS depois do achado R3 abaixo — quem prefere digitar o número de
  // uma nota emitida fora do sistema (ou não tem Focus NFe configurado)
  // nunca perde esse caminho.
  notaRemessa String?
  notaRetorno String?

  // Achado R3 da auditoria de abrangência (Parte 2/Produção, rodada 20,
  // 2026-09-03) — resultado ESTRUTURADO da emissão da NF-e de REMESSA (CFOP
  // 5901/6901, ver resolverCfopTerceirizacao em src/lib/nota-fiscal.ts)
  // quando emitida direto do sistema via Focus NFe, em vez de só o número
  // digitado em notaRemessa acima. Campos FLAT aqui (não um relacionamento
  // pra NotaFiscal) porque NotaFiscal é 1:1 com Orcamento
  // (orcamentoId String @unique NOT NULL, ver model abaixo) e não existe
  // Orcamento nenhum pra uma remessa de terceirização — reaproveitar aquele
  // model exigiria tornar orcamentoId opcional/reestruturar, fora do escopo
  // deste achado (ver resumo da rodada 20/R3).
  //
  // Só a REMESSA tem emissão real pelo sistema. O RETORNO (CFOP 5902/6902)
  // é, pela tabela CFOP oficial, uma SAÍDA do ESTABELECIMENTO TERCEIRIZADO
  // (quem devolve a mercadoria já industrializada) — nunca da gráfica, que
  // só o RECEBE de volta (entrada 1902/2902 do lado dela). Como este
  // sistema só tem acesso à conta Focus NFe da PRÓPRIA gráfica (nunca a do
  // terceiro), não há como emitir essa nota por aqui — notaRetorno continua
  // sendo só o número digitado da nota que veio do terceiro junto com a
  // mercadoria, comportamento inalterado.
  remessaNfeStatus       StatusNotaFiscal?
  remessaNfeNumero       String?
  remessaNfeSerie        String?
  remessaNfeChaveAcesso  String?
  remessaNfeXmlUrl       String?
  remessaNfeDanfeUrl     String?
  remessaNfeMensagemErro String?           @db.Text

  // Preenchido quando situacao=PROBLEMA — mesmo princípio de
  // Entrega.observacoes (a tela exige preenchido antes de mandar pra
  // PROBLEMA, ver avancarStatusEntrega em producao/entrega-transicao.ts).
  observacao String? @db.Text

  // Dedup do alerta de retorno atrasado (verificarEDispararAlertasAtraso,
  // src/lib/alerta-atraso.ts) — mesmo papel de Pedido.alertaAtrasoEnviadoEm,
  // campo PRÓPRIO porque o vencimento aqui é previsaoRetorno (não
  // Pedido.prazoEntrega): os dois podem estar atrasados em momentos
  // diferentes, e uma terceirização atrasada não implica pedido atrasado.
  alertaAtrasoEnviadoEm DateTime?

  criadoPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grafica           Grafica      @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  // Cascade: pedidoId é obrigatório (mesmo raciocínio de CustoPedido.pedido
  // acima) — hoje não existe fluxo que apague um Pedido, mas um FK NOT NULL
  // não pode usar SetNull de qualquer forma.
  pedido            Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  // SetNull, mesmo raciocínio de SolicitacaoCompra.fornecedor: apagar/
  // desativar um Fornecedor não pode apagar o histórico da terceirização, só
  // perde a referência de qual fornecedor formal a atendeu (fornecedorNome
  // preserva o registro textual independente disso).
  fornecedor        Fornecedor?  @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  // Lado inverso de CustoPedido.etapaTerceirizadaId — o CustoPedido origem
  // TERCEIRIZACAO gerado quando valorFinal é preenchido.
  custoPedidoGerado CustoPedido?

  @@index([graficaId])
  @@index([pedidoId])
  @@index([fornecedorId])
  @@map("etapas_terceirizadas")
}

enum OrigemPrevisao {
  MOTOR_PRECIFICACAO
  FICHA_TECNICA
  MANUAL
}

// Previsão de custo por categoria, congelada no momento em que o orçamento
// é aprovado (ver fase-custo-real.md §2.3, §3.1). Existe pra responder
// "orçado vs. realizado" por categoria — não um total só, porque um total
// diz "estourei R$ 780" e por categoria diz "o papel veio 34% acima do
// previsto e apareceu um frete não orçado". Nunca recalculada depois: se o
// preço da matéria-prima mudar após a aprovação, esta linha não se altera.
model PedidoCustoPrevisto {
  id               String         @id @default(cuid())
  graficaId        String
  pedidoId         String
  categoriaCustoId String
  valor            Decimal        @db.Decimal(12, 2)
  origem           OrigemPrevisao
  detalhe          String? // ex: "Papel Couché 150g — 420 folhas"
  createdAt        DateTime       @default(now())

  grafica        Grafica        @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  pedido         Pedido         @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  categoriaCusto CategoriaCusto @relation(fields: [categoriaCustoId], references: [id], onDelete: Restrict)

  @@index([graficaId, pedidoId])
  @@index([categoriaCustoId])
  @@map("pedido_custo_previsto")
}

enum StatusFilaGangRun {
  // Esperando outros itens compatíveis aparecerem — aparece na tela
  // /producao/gang-run agrupado com outros candidatos do mesmo
  // papel+gramatura+prensa+folha+cores.
  AGUARDANDO
  // Um operador decidiu rodar o grupo junto (ver GrupoGangRun) — o rateio
  // de chapa/acerto já foi lançado como CustoPedido (origem=GANG_RUN).
  COMBINADO
  // Saiu da fila sem ser combinado: o pedido foi cancelado, ou avançou pra
  // IMPRESSAO sozinho (o operador decidiu não esperar, ver
  // cancelarCandidatosDoPedido em src/lib/gang-run-servico.ts).
  CANCELADO
}

// Achado F1 da auditoria de abrangência (pesquisa-abrangencia-modulos.md,
// "F. Escopo travado no perfil da gráfica de referência", "Gang run só
// existe para OFFSET") — generaliza gang run/agrupamento de jobs pra além
// de Offset. Ganging (combinar jobs pequenos de pedidos diferentes numa
// mesma peça física pra dividir custo fixo de setup) é uma técnica de
// APROVEITAMENTO DE SUBSTRATO, não exclusiva de offset — cada processo tem
// sua PRÓPRIA lógica de "o que é fisicamente compatível pra juntar" (ver
// chaveGrupoGangRun em src/lib/gang-run.ts, um branch por tipoAgrupamento).
// MVP desta rodada implementa 2 dos 5 rótulos: FOLHA_2D (Offset, já
// existia) e BOBINA_1D (Flexografia/grande formato, novo — reaproveita o
// nesting 1D que calcularFlexografia já calcula em
// src/lib/pricing/flexografia.ts, mesmo espírito de BobinaMaterial/
// MaquinaFlexografia.larguraMaquinaM/passoCilindroM já existentes).
// TELA_MATRIZ (serigrafia — mesma matriz/tela pra várias artes) e
// MESA_PLANA (digital grande formato/corte a laser) ficam
// DELIBERADAMENTE fora de escopo nesta rodada — enum já reserva o rótulo
// pra não recriar migration depois, documentado aqui como próximo passo,
// mesmo espírito de outros achados desta auditoria que fazem MVP parcial
// de propósito (ex: Rota 2 do achado A10/Editorial). OUTRO é o escape
// padrão do repo pra processo de impressão ainda não coberto.
enum TipoAgrupamentoGangRun {
  FOLHA_2D // Offset — chapa/folha (comportamento original, único até esta rodada)
  BOBINA_1D // Flexografia/grande formato — nesting 1D na largura da bobina
  TELA_MATRIZ // Serigrafia — NÃO IMPLEMENTADO nesta rodada, ver comentário acima
  MESA_PLANA // Digital grande formato / corte a laser — NÃO IMPLEMENTADO nesta rodada
  OUTRO
}

// Um evento de "rodar junto" — quando um operador decide, na tela
// /producao/gang-run, combinar um grupo de candidatos fisicamente
// compatíveis (chave definida pelo tipoAgrupamento, ver
// TipoAgrupamentoGangRun acima) numa mesma peça física. Existe como
// registro próprio (não só um campo em FilaGangRun) pra guardar o custo
// TOTAL do setup compartilhado rateado entre os itens combinados —
// auditável depois (ver combinarGrupoGangRun em
// src/lib/gang-run-servico.ts).
//
// MVP: não otimiza automaticamente QUAIS candidatos combinar nem em quantas
// peças físicas eles cabem juntos (bin-packing é NP-difícil) — o operador
// escolhe manualmente quando o grupo já tem candidatos suficientes pra
// valer a pena rodar, e o sistema assume que 1 peça física (chapa OU
// revolução de bobina) é compartilhada entre todos os itens do grupo (ver
// custoChapasTotal/custoSetupTotal abaixo, que já são fixos por rodada no
// motor de precificação de cada processo, independentes da quantidade —
// ver src/lib/pricing/offset.ts e flexografia.ts).
model GrupoGangRun {
  id        String @id @default(cuid())
  graficaId String

  // Achado F1 — qual "sabor" de compatibilidade este grupo usa; decide
  // quais dos dois blocos de campos abaixo estão preenchidos (validado em
  // app, sem CHECK no banco — mesmo padrão do resto do schema). Default
  // FOLHA_2D preserva 100% o comportamento de todo grupo já combinado antes
  // desta migration.
  tipoAgrupamento TipoAgrupamentoGangRun @default(FOLHA_2D)

  // Chave de compatibilidade física FOLHA_2D (Offset) — mesma folha/
  // prensa/papel/cores, ver comentário de FilaGangRun abaixo. Preenchidos
  // só quando tipoAgrupamento=FOLHA_2D. Ficaram OPCIONAIS nesta migration
  // (eram NOT NULL) só pra abrir espaço pra grupos BOBINA_1D, que não têm
  // papel/prensa/folha/cores no sentido de Offset — relaxar NOT NULL é
  // sempre seguro pra dado já existente (nenhum grupo FOLHA_2D perde
  // valor).
  papelId      String?
  gramaturaGm2 Decimal? @db.Decimal(6, 1)
  prensaId     String?
  folhaId      String?
  corFrente    Int?
  corVerso     Int?

  // Chave de compatibilidade física BOBINA_1D (Flexografia/grande formato)
  // — material (aqui, o ItemGrafica do PRODUTO flexo em si: BobinaMaterial
  // não tem uma matéria-prima separada como o papelId do Offset, a bobina é
  // cadastrada direto no produto — ver model BobinaMaterial) + largura
  // nominal da bobina escolhida pelo nesting 1D + máquina flexográfica.
  // Preenchidos só quando tipoAgrupamento=BOBINA_1D — campos NOVOS,
  // propositalmente separados dos de FOLHA_2D acima (cada tipoAgrupamento
  // tem sua própria lógica de compatibilidade, sem forçar os dois a
  // compartilhar campo).
  itemGraficaMaterialId String?
  larguraBobinaNominal  Decimal? @db.Decimal(6, 3)
  maquinaFlexografiaId  String?

  // Custo TOTAL compartilhado da rodada — pago UMA vez pelo grupo inteiro
  // (não por item), rateado proporcionalmente ao espaço de cada item (ver
  // FilaGangRun.custoRateado). Snapshot de um dos itens do grupo no momento
  // da combinação (todos têm o mesmo valor, por construção da chave acima).
  // Reaproveitados como estão pros dois tipos, sem coluna nova: FOLHA_2D
  // usa os dois (chapa física + acerto de prensa); BOBINA_1D não tem custo
  // de "chapa" individual neste MVP — custoChapasTotal fica sempre 0.00
  // pra grupos BOBINA_1D, só custoSetupTotal (acerto de máquina
  // compartilhado) é usado (ver registrarCandidatosGangRun/
  // combinarGrupoGangRun em src/lib/gang-run-servico.ts).
  custoChapasTotal Decimal @db.Decimal(12, 2)
  custoSetupTotal  Decimal @db.Decimal(12, 2)

  combinadoEm    DateTime @default(now())
  combinadoPorId String?

  grafica Grafica       @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  itens   FilaGangRun[]

  @@index([graficaId])
  @@map("grupos_gang_run")
}

// Candidato a gang run: um item de orçamento cujo processo suporta
// agrupamento/nesting (OFFSET via FOLHA_2D, FLEXOGRAFIA via BOBINA_1D —
// achado F1, ver TipoAgrupamentoGangRun acima) cuja quantidade sozinha não
// preenche uma peça física inteira (fracaoFolha < 1, ver
// ehCandidatoGangRun em src/lib/gang-run.ts) — em vez de rodar uma peça
// exclusiva só pra ele, fica esperando outros pedidos da MESMA gráfica com
// a MESMA chave de compatibilidade do seu tipoAgrupamento (ver
// chaveGrupoGangRun) pra dividir o custo fixo compartilhado. Criado uma
// vez, na aprovação do orçamento (junto com o Pedido, ver
// registrarCandidatosGangRun) — nunca recalculado depois, mesmo que o
// motor de precificação mude.
//
// 1:1 com OrcamentoItem (um item entra na fila no máximo uma vez).
// pedidoId é denormalizado do Orcamento (Pedido.orcamentoId é @unique) só
// pra não precisar de join toda vez que a fila lê/atualiza por pedido (ex:
// cancelarPedido cancelando os candidatos deste pedido).
model FilaGangRun {
  id              String            @id @default(cuid())
  graficaId       String
  orcamentoItemId String            @unique
  pedidoId        String
  status          StatusFilaGangRun @default(AGUARDANDO)

  // Achado F1 — qual "sabor" de compatibilidade este candidato usa; decide
  // quais dos dois blocos de campos abaixo estão preenchidos (validado em
  // app, sem CHECK no banco — mesmo padrão do resto do schema). Default
  // FOLHA_2D preserva 100% o comportamento de todo candidato já criado
  // antes desta migration.
  tipoAgrupamento TipoAgrupamentoGangRun @default(FOLHA_2D)

  // Chave de compatibilidade física FOLHA_2D (Offset): só itens com os
  // MESMOS seis valores abaixo podem compartilhar uma chapa/folha (ver
  // chaveGrupoGangRun em src/lib/gang-run.ts). papelId/prensaId vêm de
  // ItemGrafica (matéria-prima e prensa do produto, ver schema de
  // ItemGrafica); folhaId é o FormatoFolha que o motor de nesting ESCOLHEU
  // pra este item específico (metricas.folhaEscolhida.id do breakdown
  // salvo em OrcamentoItem — produtos com mais de um formato cadastrado
  // podem escolher formatos diferentes conforme o tamanho da peça). Sem FK
  // formal pra papel/prensa/folha de propósito: isto é um snapshot de
  // agrupamento, não um vínculo que precise ser mantido consistente se o
  // cadastro mudar depois (mesmo princípio de CategoriaCusto.nome livre em
  // Despesa). Preenchidos só quando tipoAgrupamento=FOLHA_2D — ficaram
  // OPCIONAIS nesta migration (eram NOT NULL, prensaId inclusive — achado
  // F1 pedia isso especificamente) só pra abrir espaço pra candidatos
  // BOBINA_1D, que não têm papel/prensa/folha/cores no sentido de Offset;
  // relaxar NOT NULL é sempre seguro pra dado já existente.
  papelId      String?
  gramaturaGm2 Decimal? @db.Decimal(6, 1)
  prensaId     String?
  folhaId      String?
  corFrente    Int?
  corVerso     Int?

  // Chave de compatibilidade física BOBINA_1D (Flexografia/grande formato,
  // achado F1) — material (o ItemGrafica do PRODUTO flexo em si:
  // BobinaMaterial é cadastrada direto no produto, sem uma matéria-prima
  // separada como o papelId do Offset — ver model BobinaMaterial) +
  // largura nominal da bobina que o nesting 1D ESCOLHEU pra este item
  // (metricas.bobinaEscolhida do breakdown, mesmo princípio de folhaId
  // acima — ver calcularFlexografia em src/lib/pricing/flexografia.ts) +
  // máquina flexográfica. Preenchidos só quando tipoAgrupamento=BOBINA_1D —
  // campos NOVOS, propositalmente separados dos de FOLHA_2D acima (cada
  // tipoAgrupamento tem sua própria lógica de compatibilidade, sem forçar
  // os dois a compartilhar campo).
  itemGraficaMaterialId String?
  larguraBobinaNominal  Decimal? @db.Decimal(6, 3)
  maquinaFlexografiaId  String?

  // nUp = quantas peças deste item cabem numa "rodada" física — folha
  // inteira (FOLHA_2D) ou uma volta do cilindro na largura da bobina
  // (BOBINA_1D, ver numRevolucoes/nUp em calcularFlexografia). fracaoFolha
  // = quantidade/nUp — quanto da capacidade de UMA rodada este item sozinho
  // ocupa (< 1 é o que faz dele um candidato, ver ehCandidatoGangRun). Soma
  // de fracaoFolha do grupo >= 1 é o sinal (informativo, não automático) de
  // "já dá pra encher uma rodada juntando estes pedidos". Nome do campo
  // mantido "Folha" por compatibilidade com o código/UI FOLHA_2D já
  // existente — vale pra BOBINA_1D também (uma "revolução" no lugar de uma
  // "folha").
  nUpPeca        Int
  quantidadePeca Int
  fracaoFolha    Decimal @db.Decimal(8, 4)

  // Snapshot do que o custo fixo compartilhado custaria se este item
  // rodasse SOZINHO (igual ao que já foi orçado em
  // OrcamentoItem.breakdown.detalhes) — usado só pra mostrar "quanto está
  // economizando" na tela depois de combinado; nunca é o valor efetivamente
  // cobrado (esse é custoRateado, abaixo). custoChapasIndividual é sempre
  // 0.00 pra tipoAgrupamento=BOBINA_1D (flexografia não tem custo de chapa
  // individual neste MVP — reaproveita os mesmos dois campos NOT NULL em
  // vez de criar colunas novas só pra "zero sempre", ver
  // registrarCandidatosGangRun em src/lib/gang-run-servico.ts);
  // custoSetupIndividual carrega detalhes.setup nos dois tipos (chave
  // compartilhada entre os breakdowns de Offset e Flexografia, ver
  // compor.ts).
  custoChapasIndividual Decimal @db.Decimal(12, 2)
  custoSetupIndividual  Decimal @db.Decimal(12, 2)

  grupoGangRunId String?
  // Fatia do GrupoGangRun.custoChapasTotal+custoSetupTotal atribuída a este
  // item (proporcional a fracaoFolha, ver ratearCustoSetup) — preenchido só
  // quando status=COMBINADO. O mesmo valor é lançado como CustoPedido
  // (origem=GANG_RUN) no Pedido deste item.
  custoRateado   Decimal? @db.Decimal(12, 2)

  criadoEm           DateTime  @default(now())
  canceladoEm        DateTime?
  motivoCancelamento String?

  grafica       Grafica       @relation(fields: [graficaId], references: [id], onDelete: Cascade)
  orcamentoItem OrcamentoItem @relation(fields: [orcamentoItemId], references: [id], onDelete: Cascade)
  pedido        Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  grupo         GrupoGangRun? @relation(fields: [grupoGangRunId], references: [id], onDelete: SetNull)

  @@index([graficaId, status])
  @@index([graficaId, papelId, gramaturaGm2, prensaId, folhaId, corFrente, corVerso, status])
  @@index([graficaId, itemGraficaMaterialId, larguraBobinaNominal, maquinaFlexografiaId, status])
  @@index([pedidoId])
  @@map("fila_gang_run")
}

// Atribuição gráfica-wide (não por Pedido individual) de quem é responsável
// por cada etapa de produção — configurada em /usuarios. Usada em dois
// pontos: (1) e-mail automático quando um Pedido ENTRA nesse status (ver
// avancarStatusPedido em src/app/producao/status-transicao.ts), (2) bypass
// de permissão pra confirmar em app sem precisar de PRODUCAO.podeEditar
// completo (ver podeConfirmarEstagio em src/lib/auth/permissoes.ts). Só
// cobre as 5 etapas "vivas" atribuíveis (PRODUCAO/ACABAMENTO/CONFERENCIA/
// EMBALAGEM/EXPEDICAO, ver ESTAGIOS_ATRIBUIVEIS) — ARTE (estágio inicial) e
// CLICHE_FACA (etapa que baixa matéria-prima do estoque ao ser deixada)
// ficam de fora (decisão do produto: evita expor a tela de perda de
// material do estoque a um link sem login) e ENTREGUE/CANCELADO são
// terminais, sem transição de "confirmar" alguma.
model ResponsavelEstagio {
  id        String       @id @default(cuid())
  usuarioId String
  status    StatusPedido

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, status])
  @@index([status])
  @@map("responsaveis_estagio")
}

// Rate limit da confirmação pública de etapa (src/app/p/[token]) — tabela
// separada de TentativaRespostaArte pra não misturar os dois orçamentos de
// tentativa (abuso num fluxo não deve travar o outro).
model TentativaConfirmacaoEstagio {
  id        String   @id @default(cuid())
  pedidoId  String
  ip        String
  createdAt DateTime @default(now())

  @@index([pedidoId, createdAt])
  @@index([ip, createdAt])
  @@map("tentativas_confirmacao_estagio")
}

// Rate limit da resposta pública ao orçamento (src/app/o/[token]) — mesmo
// padrão de TentativaRespostaArte/TentativaConfirmacaoEstagio, tabela
// própria pra não misturar o orçamento de tentativas dos três fluxos
// públicos por token.
model TentativaRespostaOrcamento {
  id          String   @id @default(cuid())
  orcamentoId String
  ip          String
  createdAt   DateTime @default(now())

  @@index([orcamentoId, createdAt])
  @@index([ip, createdAt])
  @@map("tentativas_resposta_orcamento")
}
