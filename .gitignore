# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# dumps de backup do banco (dado real, nunca deve ir pro git)
/backups/*
!/backups/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# dossiê/relatório de análise pra colar em outro chat — não é código do projeto
RELATORIO-DOSSIE-FABLE5.md

# permissões locais do Claude Code (pessoal, não é config do time)
.claude/settings.local.json
